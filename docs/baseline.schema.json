{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://elisa-lang.org/schemas/profile-baseline-v1.json",
  "title": "Elisa profiler local baseline metadata",
  "description": "Audit metadata emitted by explicit native baseline promotion.",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "name",
    "capture",
    "capture_sha256",
    "source",
    "source_sha256",
    "compiler_branch",
    "compiler_commit",
    "collection_mode",
    "outcome",
    "reason"
  ],
  "properties": {
    "kind": { "const": "elisa_profiler_baseline" },
    "schema_version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "capture": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}\\.elisaprof$" },
    "capture_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": { "type": "string", "minLength": 1 },
    "source_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "compiler_branch": { "type": "string", "minLength": 1 },
    "compiler_commit": { "type": "string", "minLength": 1 },
    "collection_mode": { "type": "string", "minLength": 1 },
    "outcome": { "const": "success" },
    "reason": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
