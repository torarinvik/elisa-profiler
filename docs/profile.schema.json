{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://elisa-lang.org/schemas/profile-v2.json",
  "title": "Elisa profiler report",
  "description": "Machine-readable output from the Elisa profiler --format json CLI.",
  "type": "object",
  "required": [
    "schema_version",
    "envelope",
    "source",
    "compiler",
    "summary",
    "quality",
    "source_mapping",
    "run",
    "functions",
    "call_edges",
    "stacks",
    "locations"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "envelope": {
      "type": "object",
      "required": ["major", "minor", "kind", "compatibility"],
      "properties": {
        "major": { "const": 2 },
        "minor": { "const": 0 },
        "kind": { "const": "profile" },
        "compatibility": { "const": "backward-compatible-v1" }
      },
      "additionalProperties": false
    },
    "source": { "type": "string" },
    "source_snapshot": {
      "type": "object",
      "required": ["sha256", "content"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "content": { "type": "string" }
      },
      "additionalProperties": false
    },
    "compiler": {
      "type": "object",
      "required": ["root", "branch", "commit", "dirty", "runtime_object"],
      "properties": {
        "root": { "type": "string" },
        "branch": { "type": "string" },
        "commit": { "type": "string" },
        "dirty": { "type": "boolean" },
        "dirty_files": { "type": "array", "items": { "type": "string" } },
        "status_sha256": { "type": "string" },
        "stage1_binary": { "type": "string" },
        "stage1_sha256": { "type": ["string", "null"] },
        "runtime_object": { "type": "string" },
        "runtime_object_sha256": { "type": ["string", "null"] },
        "host": { "type": "object", "additionalProperties": true },
        "toolchain": { "type": "object", "additionalProperties": true },
        "build_options": { "type": "object", "additionalProperties": true },
        "runtime_build": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "host": {
      "type": ["object", "null"],
      "properties": {
        "os": { "type": ["string", "null"] },
        "architecture": { "type": ["string", "null"] },
        "load_average_1m": { "type": ["number", "null"] },
        "load_average_source": { "type": ["string", "null"] },
        "affinity": {
          "type": "object",
          "required": ["policy", "changed"],
          "properties": {
            "policy": { "type": "string", "enum": ["inherited"] },
            "changed": { "const": false }
          },
          "additionalProperties": false
        },
        "power_thermal": { "type": ["object", "null"], "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "events",
        "locations",
        "dropped",
        "statement_events",
        "value_events",
        "function_events",
        "max_stack_depth",
        "stack_overflow_entries",
        "thread_count"
      ],
      "properties": {
        "events": { "type": "integer", "minimum": 0 },
        "locations": { "type": "integer", "minimum": 0 },
        "dropped": { "type": "integer", "minimum": 0 },
        "statement_events": { "type": "integer", "minimum": 0 },
        "value_events": { "type": "integer", "minimum": 0 },
        "function_events": { "type": "integer", "minimum": 0 },
        "max_stack_depth": { "type": "integer", "minimum": 0 },
        "stack_overflow_entries": { "type": "integer", "minimum": 0 },
        "thread_count": { "type": "integer", "minimum": 0 },
        "location_limit": { "type": "integer", "minimum": 0 },
        "call_edge_limit": { "type": "integer", "minimum": 0 },
        "stack_limit": { "type": "integer", "minimum": 0 },
        "capture_byte_limit": { "type": "integer", "minimum": 0 },
        "capture_bytes_used": { "type": "integer", "minimum": 0 },
        "capture_bytes_dropped": { "type": "integer", "minimum": 0 },
        "frame_dropped": { "type": "integer", "minimum": 0 },
        "valid_frames": { "type": "integer", "minimum": 0 },
        "valid_capture_bytes": { "type": "integer", "minimum": 0 },
        "detail_budget_exceeded": { "type": "boolean" },
        "dropped_call_edges": { "type": "integer", "minimum": 0 },
        "dropped_stacks": { "type": "integer", "minimum": 0 },
        "crash_signal": { "type": ["integer", "null"], "minimum": 1 },
        "capture_started": { "type": "boolean" },
        "capture_complete": { "type": "boolean" }
        ,"trace_events_captured": { "type": "integer", "minimum": 0 }
        ,"trace_events_omitted": { "type": "integer", "minimum": 0 }
        ,"trace_event_limit": { "type": ["integer", "null"], "minimum": 0 }
        ,"trace_complete": { "type": ["boolean", "null"] }
      },
      "additionalProperties": true
    },
    "capture": {
      "type": "object",
      "required": ["process", "threads", "tasks", "repetition", "clock"],
      "properties": {
        "process": {
          "type": "object",
          "required": ["scope", "lifetime"],
          "properties": {
            "scope": { "const": "single_profiled_child" },
            "lifetime": { "const": "launch_to_wait" }
          },
          "additionalProperties": false
        },
        "threads": {
          "type": "object",
          "required": ["scope", "lifetime", "identity"],
          "properties": {
            "scope": { "const": "registered_collector_threads" },
            "lifetime": { "const": "capture_only" },
            "identity": { "const": "local_capture_thread_id" }
          },
          "additionalProperties": false
        },
        "tasks": {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "const": "not_recorded" } },
          "additionalProperties": false
        },
        "repetition": {
          "type": "object",
          "required": ["scope", "warmups_excluded"],
          "properties": {
            "scope": { "const": "run.repetitions" },
            "warmups_excluded": { "const": true }
          },
          "additionalProperties": false
        },
        "clock": {
          "type": "object",
          "required": ["domain", "unit", "source"],
          "properties": {
            "domain": { "const": "wall" },
            "unit": { "const": "ns" },
            "source": { "const": "CLOCK_MONOTONIC" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "numeric_encoding": {
      "type": "object",
      "required": ["integer", "large_integer_policy", "viewer_metric_parser", "javascript_safe_integer"],
      "properties": {
        "integer": { "const": "decimal_json_integer" },
        "large_integer_policy": { "const": "preserve_decimal_text" },
        "viewer_metric_parser": { "const": "raw_json_to_BigInt" },
        "javascript_safe_integer": { "const": "2^53_minus_1" }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["capture", "detail", "event_counts", "completeness", "reasons"],
      "properties": {
        "capture": {
          "type": "string",
          "enum": ["complete", "target_exit", "target_signal", "timeout", "profiler_failure", "recovered"]
        },
        "detail": { "type": "string", "enum": ["complete", "degraded"] },
        "event_counts": { "type": "string", "enum": ["exact", "partial"] },
        "completeness": {
          "type": "object",
          "required": ["events", "locations", "functions", "call_edges", "stacks", "timings"],
          "properties": {
            "events": { "type": "string", "enum": ["exact", "partial"] },
            "locations": { "type": "string", "enum": ["exact", "partial"] },
            "functions": { "type": "string", "enum": ["exact", "partial"] },
            "call_edges": { "type": "string", "enum": ["exact", "partial"] },
            "stacks": { "type": "string", "enum": ["exact", "partial"] },
            "timings": { "type": "string", "enum": ["exact", "partial"] }
          },
          "additionalProperties": true
        },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "source_mapping": {
      "type": "object",
      "required": ["mode", "mapped_locations", "unmapped_locations"],
      "properties": {
        "mode": { "type": "string" },
        "mapped_locations": { "type": "integer", "minimum": 0 },
        "unmapped_locations": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" }
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": [
        "exit_code",
        "signal",
        "location_timing",
        "timing_clock",
        "event_trace_enabled",
        "opt_level",
        "execution_ms",
        "timeout_s",
        "execution_ms_min",
        "execution_ms_mean",
        "execution_ms_max",
        "execution_ms_median",
        "execution_ms_stdev",
        "execution_ms_ci95_low",
        "execution_ms_ci95_high",
        "execution_ci95_available",
        "cpu_user_ms",
        "cpu_system_ms",
        "cpu_ms",
        "peak_rss_bytes",
        "warmup_ms",
        "warmup_repetitions",
        "requested_repetitions",
        "completed_repetitions",
        "successful_repetitions",
        "failed_repetitions",
        "measurement_repetitions",
        "measurement_basis",
        "repetitions",
        "compile_ms"
      ],
      "properties": {
        "collection_mode": { "type": "string", "enum": ["full", "functions", "statements", "values", "diagnostic"] },
        "outcome": { "type": "string", "enum": ["success", "target_exit", "target_signal", "timeout", "profiler_failure", "incomplete_capture", "incomplete_artifact"] },
        "capabilities": {
          "type": "object",
          "required": ["event_classes", "trace", "recent_path", "timing", "sampling", "detail_limits"],
          "properties": {
            "event_classes": { "type": "array", "items": { "type": "string", "enum": ["function", "statement", "value"] }, "minItems": 1, "uniqueItems": true },
            "trace": { "type": "string", "enum": ["full", "disabled"] },
            "transport": {
              "type": "object",
              "required": ["framing", "checksum", "sequence"],
              "properties": {
                "framing": { "type": "string", "enum": ["record"] },
                "checksum": { "type": "string", "enum": ["fnv1a64"] },
                "sequence": { "type": "string", "enum": ["strict"] }
              },
              "additionalProperties": false
            },
            "recent_path": { "type": "string", "enum": ["last_256", "disabled"] },
            "timing": { "type": "string", "enum": ["wall"] },
            "sampling": { "type": "string", "enum": ["unsupported"] },
            "sampling_detail": { "$ref": "#/$defs/capability_detail" },
            "allocation": { "$ref": "#/$defs/capability_detail" },
            "tasks": { "$ref": "#/$defs/capability_detail" },
            "identity": { "$ref": "#/$defs/capability_detail" },
            "detail_limits": {
              "type": "object",
              "required": ["locations", "call_edges", "stacks", "capture_bytes"],
              "properties": {
                "locations": { "type": "integer", "minimum": 0 },
                "call_edges": { "type": "integer", "minimum": 0 },
                "stacks": { "type": "integer", "minimum": 0 },
                "capture_bytes": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "exit_code": { "type": ["integer", "null"] },
        "signal": { "type": ["integer", "null"] },
        "location_timing": { "type": "boolean" },
        "timing_clock": { "type": ["string", "null"], "enum": ["wall", "cpu", null] },
        "event_trace_enabled": { "type": "boolean" },
        "trace_events_captured": { "type": "integer", "minimum": 0 },
        "trace_events_omitted": { "type": "integer", "minimum": 0 },
        "trace_event_limit": { "type": ["integer", "null"], "minimum": 0 },
        "trace_complete": { "type": ["boolean", "null"] },
        "opt_level": { "type": "string", "enum": ["-O0", "-O1", "-O2", "-O3"] },
        "execution_ms": { "type": "number", "minimum": 0 },
        "timeout_s": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "execution_ms_min": { "type": "number", "minimum": 0 },
        "execution_ms_mean": { "type": "number", "minimum": 0 },
        "execution_ms_max": { "type": "number", "minimum": 0 },
        "execution_ms_median": { "type": "number", "minimum": 0 },
        "execution_ms_stdev": { "type": "number", "minimum": 0 },
        "execution_ms_ci95_low": { "type": "number", "minimum": 0 },
        "execution_ms_ci95_high": { "type": "number", "minimum": 0 },
        "execution_ci95_available": { "type": "boolean" },
        "cpu_user_ms": { "type": ["number", "null"], "minimum": 0 },
        "cpu_system_ms": { "type": ["number", "null"], "minimum": 0 },
        "cpu_ms": { "type": ["number", "null"], "minimum": 0 },
        "peak_rss_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "warmup_ms": { "type": "number", "minimum": 0 },
        "warmup_repetitions": { "type": "integer", "minimum": 0 },
        "requested_repetitions": { "type": "integer", "minimum": 1 },
        "completed_repetitions": { "type": "integer", "minimum": 1 },
        "successful_repetitions": { "type": "integer", "minimum": 0 },
        "failed_repetitions": { "type": "integer", "minimum": 0 },
        "measurement_repetitions": { "type": "integer", "minimum": 1 },
        "measurement_basis": { "type": "string", "enum": ["successful", "all_completed"] },
        "repetitions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/repetition" }
        },
        "compile_ms": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "functions": {
      "type": "array",
      "items": { "$ref": "#/$defs/function" }
    },
    "call_edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/call_edge" }
    },
    "stacks": {
      "type": "array",
      "items": { "$ref": "#/$defs/stack" }
    },
    "locations": {
      "type": "array",
      "items": { "$ref": "#/$defs/location" }
    },
    "thread_loss": {
      "type": "array",
      "items": { "$ref": "#/$defs/thread_loss" }
    },
    "recent_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/recent_event" }
    },
    "active_stack": { "$ref": "#/$defs/active_stack" },
    "program_stdout": { "type": "string" },
    "program_stdout_truncated": { "type": "boolean" },
    "program_stderr": { "type": "string" },
    "program_stderr_truncated": { "type": "boolean" },
    "workload": {
      "type": "object",
      "properties": {
        "source_sha256": { "type": ["string", "null"] },
        "source_tree_sha256": { "type": ["string", "null"] },
        "source_size_bytes": { "type": "integer", "minimum": 0 },
        "working_directory": { "type": "string" },
        "stdin": {
          "type": ["object", "null"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": ["string", "null"] },
            "size_bytes": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "environment_override_keys": {
          "type": "array",
          "items": { "type": "string" }
        },
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reproducibility": {
          "type": "object",
          "required": ["random_seed", "random_seed_source", "environment_values", "inputs_hashed"],
          "properties": {
            "random_seed": { "type": ["integer", "string", "null"] },
            "random_seed_source": { "type": "string", "enum": ["not_controlled", "cli", "environment", "target"] },
            "environment_values": { "type": "string", "enum": ["redacted"] },
            "inputs_hashed": { "const": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "artifacts": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "capability_detail": {
      "type": "object",
      "required": ["status", "reason", "scope"],
      "properties": {
        "status": { "type": "string", "enum": ["unsupported", "source_name_fallback", "compiler_stable_ids"] },
        "reason": { "type": "string", "minLength": 1 },
        "namespace": { "type": ["string", "null"], "minLength": 1 },
        "version": { "type": ["integer", "null"], "minimum": 1 },
        "scope": { "type": "string", "enum": ["none", "capture"] }
      },
      "additionalProperties": false
    },
    "repetition": {
      "type": "object",
      "required": [
        "repetition",
        "requested_repetitions",
        "exit_code",
        "signal",
        "execution_ms",
        "timed_out",
        "cpu_user_ms",
        "cpu_system_ms",
        "cpu_ms",
        "peak_rss_bytes",
        "trace_events",
        "trace_locations",
        "detail_records",
        "trace_dropped",
        "trace_threads",
        "trace_max_stack_depth",
        "trace_stack_overflow_entries"
      ],
      "properties": {
        "repetition": { "type": "integer", "minimum": 1 },
        "requested_repetitions": { "type": "integer", "minimum": 1 },
        "exit_code": { "type": ["integer", "null"] },
        "signal": { "type": ["integer", "null"] },
        "execution_ms": { "type": "number", "minimum": 0 },
        "timed_out": { "type": "boolean" },
        "capture_started": { "type": "boolean" },
        "capture_complete": { "type": "boolean" },
        "completeness": {
          "type": "object",
          "required": ["events", "locations", "functions", "call_edges", "stacks", "timings", "resources"],
          "properties": {
            "events": { "type": "string", "enum": ["exact", "partial"] },
            "locations": { "type": "string", "enum": ["exact", "partial"] },
            "functions": { "type": "string", "enum": ["exact", "partial"] },
            "call_edges": { "type": "string", "enum": ["exact", "partial"] },
            "stacks": { "type": "string", "enum": ["exact", "partial"] },
            "timings": { "type": "string", "enum": ["exact", "partial"] },
            "resources": { "type": "string", "enum": ["exact", "unavailable"] }
          },
          "additionalProperties": false
        },
        "cpu_user_ms": { "type": ["number", "null"], "minimum": 0 },
        "cpu_system_ms": { "type": ["number", "null"], "minimum": 0 },
        "cpu_ms": { "type": ["number", "null"], "minimum": 0 },
        "peak_rss_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "trace_events": { "type": "integer", "minimum": 0 },
        "trace_locations": { "type": "integer", "minimum": 0 },
        "detail_records": {
          "type": "object",
          "required": ["locations", "functions", "call_edges", "stacks"],
          "properties": {
            "locations": { "type": "integer", "minimum": 0 },
            "functions": { "type": "integer", "minimum": 0 },
            "call_edges": { "type": "integer", "minimum": 0 },
            "stacks": { "type": "integer", "minimum": 0 },
            "thread_loss": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "trace_dropped": { "type": "integer", "minimum": 0 },
        "trace_threads": { "type": "integer", "minimum": 0 },
        "trace_max_stack_depth": { "type": "integer", "minimum": 0 },
        "trace_stack_overflow_entries": { "type": "integer", "minimum": 0 },
        "location_limit": { "type": "integer", "minimum": 0 },
        "call_edge_limit": { "type": "integer", "minimum": 0 },
        "stack_limit": { "type": "integer", "minimum": 0 },
        "capture_byte_limit": { "type": "integer", "minimum": 0 },
        "capture_bytes_used": { "type": "integer", "minimum": 0 },
        "capture_bytes_dropped": { "type": "integer", "minimum": 0 },
        "frame_dropped": { "type": "integer", "minimum": 0 },
        "detail_budget_exceeded": { "type": "boolean" },
        "dropped_call_edges": { "type": "integer", "minimum": 0 },
        "dropped_stacks": { "type": "integer", "minimum": 0 },
        "crash_signal": { "type": ["integer", "null"], "minimum": 1 },
        "trace_events_captured": { "type": "integer", "minimum": 0 },
        "trace_events_omitted": { "type": "integer", "minimum": 0 },
        "trace_event_limit": { "type": ["integer", "null"], "minimum": 0 },
        "trace_complete": { "type": ["boolean", "null"] },
        "recent_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/recent_event" }
        },
        "event_trace": {
          "type": "array",
          "items": { "$ref": "#/$defs/recent_event" }
        }
      },
      "additionalProperties": true
    },
    "definition": {
      "type": "object",
      "required": ["source", "line", "compiler_line", "source_text"],
      "properties": {
        "source": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "compiler_line": { "type": "integer", "minimum": 1 },
        "source_text": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "function": {
      "type": "object",
      "required": [
        "function",
        "events",
        "statement_events",
        "value_events",
        "call_events",
        "locations",
        "interval_ns",
        "max_interval_ns",
        "inclusive_ns",
        "self_ns",
        "completed_calls",
        "definitions",
        "mean_inclusive_ns",
        "mean_self_ns",
        "inclusive_percent",
        "self_percent"
      ],
      "properties": {
        "function": { "type": "string" },
        "events": { "type": "integer", "minimum": 0 },
        "statement_events": { "type": "integer", "minimum": 0 },
        "value_events": { "type": "integer", "minimum": 0 },
        "call_events": { "type": "integer", "minimum": 0 },
        "locations": { "type": "integer", "minimum": 0 },
        "interval_ns": { "type": "integer", "minimum": 0 },
        "max_interval_ns": { "type": "integer", "minimum": 0 },
        "inclusive_ns": { "type": "integer", "minimum": 0 },
        "self_ns": { "type": "integer", "minimum": 0 },
        "completed_calls": { "type": "integer", "minimum": 0 },
        "definitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/definition" }
        },
        "mean_inclusive_ns": { "type": "integer", "minimum": 0 },
        "mean_self_ns": { "type": "integer", "minimum": 0 },
        "inclusive_percent": { "type": ["number", "null"], "minimum": 0 },
        "self_percent": { "type": ["number", "null"], "minimum": 0 }
        ,"identity_id": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "call_edge": {
      "type": "object",
      "required": ["caller", "callee", "call_events", "completed_calls", "inclusive_ns"],
      "properties": {
        "caller": { "type": "string" },
        "callee": { "type": "string" },
        "call_events": { "type": "integer", "minimum": 0 },
        "completed_calls": { "type": "integer", "minimum": 0 },
        "inclusive_ns": { "type": "integer", "minimum": 0 }
        ,"caller_id": { "type": "integer", "minimum": 1 }
        ,"callee_id": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "stack": {
      "type": "object",
      "required": ["stack", "call_events", "completed_calls", "self_ns"],
      "properties": {
        "stack": { "type": "string" },
        "call_events": { "type": "integer", "minimum": 0 },
        "completed_calls": { "type": "integer", "minimum": 0 },
        "self_ns": { "type": "integer", "minimum": 0 }
        ,"stack_ids": { "type": "string", "pattern": "^[0-9]+(;[0-9]+)*$" }
      },
      "additionalProperties": true
    },
    "location": {
      "type": "object",
      "required": [
        "kind",
        "function",
        "line",
        "count",
