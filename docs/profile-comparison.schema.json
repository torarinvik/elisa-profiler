{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://elisa-lang.org/schemas/profile-comparison-v2.json",
  "title": "Elisa profiler comparison",
  "description": "Summary comparison emitted by the Elisa-native profiler compare command.",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "envelope",
    "baseline",
    "candidate",
    "workload_metadata_match",
    "collection_mode_match",
    "sampling_configuration_match",
    "functions",
    "call_edges",
    "stacks",
    "locations",
    "metrics",
    "warnings",
    "status"
  ],
  "properties": {
    "kind": { "const": "profile_comparison" },
    "schema_version": { "const": 2 },
    "envelope": {
      "type": "object",
      "required": ["major", "minor", "kind", "compatibility"],
      "properties": {
        "major": { "const": 2 },
        "minor": { "const": 0 },
        "kind": { "const": "comparison" },
        "compatibility": { "const": "backward-compatible-v1" }
      },
      "additionalProperties": false
    },
    "baseline": { "$ref": "#/$defs/identity" },
    "candidate": { "$ref": "#/$defs/identity" },
    "workload_metadata_match": { "type": "boolean" },
    "collection_mode_match": { "type": "boolean" },
    "sampling_configuration_match": { "type": "boolean" },
    "functions": {
      "type": "array",
      "items": { "$ref": "#/$defs/function_change" }
    },
    "call_edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/call_edge_change" }
    },
    "stacks": {
      "type": "array",
      "items": { "$ref": "#/$defs/stack_change" }
    },
    "locations": {
      "type": "array",
      "items": { "$ref": "#/$defs/location_change" }
    },
    "metrics": {
      "type": "object",
      "required": [
        "execution_ms_mean",
        "compile_ms",
        "cpu_ms",
        "peak_rss_bytes",
        "events",
        "locations",
        "dropped_events",
        "thread_count",
        "stack_overflow_entries",
        "trace_events_omitted",
        "sample_count",
        "sample_missed",
        "sample_period_microseconds",
        "sampling_setup_failed"
      ],
      "properties": {
        "execution_ms_mean": { "$ref": "#/$defs/timed_metric" },
        "compile_ms": { "$ref": "#/$defs/timed_metric" },
        "cpu_ms": { "$ref": "#/$defs/resource_timed_metric" },
        "peak_rss_bytes": { "$ref": "#/$defs/resource_count_metric" },
        "events": { "$ref": "#/$defs/count_metric" },
        "locations": { "$ref": "#/$defs/count_metric" },
        "dropped_events": { "$ref": "#/$defs/count_metric" },
        "thread_count": { "$ref": "#/$defs/count_metric" },
        "stack_overflow_entries": { "$ref": "#/$defs/count_metric" },
        "trace_events_omitted": { "$ref": "#/$defs/count_metric" },
        "sample_count": { "$ref": "#/$defs/count_metric" },
        "sample_missed": { "$ref": "#/$defs/count_metric" },
        "sample_period_microseconds": { "$ref": "#/$defs/count_metric" },
        "sampling_setup_failed": { "$ref": "#/$defs/count_metric" }
      },
      "additionalProperties": false
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["ok", "warning"] },
    "thresholds": {
      "type": "object",
      "required": [
        "wall_regression_percent",
        "wall_max_ms",
        "cpu_regression_percent",
        "cpu_max_ms",
        "rss_regression_percent",
        "rss_max_bytes",
        "function_self_regression_percent"
      ],
      "properties": {
        "wall_regression_percent": { "type": ["integer", "null"], "minimum": 0 },
        "wall_max_ms": { "type": ["number", "null"], "minimum": 0 },
        "cpu_regression_percent": { "type": ["integer", "null"], "minimum": 0 },
        "cpu_max_ms": { "type": ["number", "null"], "minimum": 0 },
        "rss_regression_percent": { "type": ["integer", "null"], "minimum": 0 },
        "rss_max_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "function_self_regression_percent": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["status", "violations"],
      "properties": {
        "status": { "type": "string", "enum": ["not_requested", "pass", "fail", "inconclusive"] },
        "violations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["path", "source", "compiler_commit", "opt_level", "collection_mode", "identity", "identity_namespace", "identity_version", "exit_code"],
      "properties": {
        "path": { "type": "string" },
        "source": { "type": "string" },
        "compiler_commit": { "type": "string" },
        "opt_level": { "type": "string" },
        "collection_mode": { "type": "string" },
        "identity": { "type": "string", "enum": ["compiler_stable_ids", "source_name_fallback"] },
        "identity_namespace": { "type": ["string", "null"], "minLength": 1 },
        "identity_version": { "type": ["integer", "null"], "minimum": 1 },
        "exit_code": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "timed_metric": {
      "type": "object",
      "required": ["baseline", "candidate", "delta_micros"],
      "properties": {
        "baseline": { "type": "number", "minimum": 0 },
        "candidate": { "type": "number", "minimum": 0 },
        "delta_micros": { "type": "integer" },
        "relative_delta_basis_points": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "resource_timed_metric": {
      "type": "object",
      "required": ["baseline", "candidate", "delta_micros"],
      "properties": {
        "baseline": { "type": ["number", "null"], "minimum": 0 },
        "candidate": { "type": ["number", "null"], "minimum": 0 },
        "delta_micros": { "type": ["integer", "null"] },
        "relative_delta_basis_points": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "resource_count_metric": {
      "type": "object",
      "required": ["baseline", "candidate", "delta"],
      "properties": {
        "baseline": { "type": ["integer", "null"], "minimum": 0 },
        "candidate": { "type": ["integer", "null"], "minimum": 0 },
        "delta": { "type": ["integer", "null"] },
        "relative_delta_basis_points": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "count_metric": {
      "type": "object",
      "required": ["baseline", "candidate", "delta"],
      "properties": {
        "baseline": { "type": "integer", "minimum": 0 },
        "candidate": { "type": "integer", "minimum": 0 },
        "delta": { "type": "integer" },
        "relative_delta_basis_points": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "function_change": {
      "type": "object",
      "required": ["function", "events", "call_events", "completed_calls", "inclusive_ns", "self_ns", "interval_ns", "max_interval_ns"],
      "properties": {
        "function": { "type": "string", "minLength": 1 },
        "events": { "$ref": "#/$defs/resource_count_metric" },
        "call_events": { "$ref": "#/$defs/resource_count_metric" },
        "completed_calls": { "$ref": "#/$defs/resource_count_metric" },
        "inclusive_ns": { "$ref": "#/$defs/resource_count_metric" },
        "self_ns": { "$ref": "#/$defs/resource_count_metric" },
        "interval_ns": { "$ref": "#/$defs/resource_count_metric" },
        "max_interval_ns": { "$ref": "#/$defs/resource_count_metric" }
      },
      "additionalProperties": false
    },
    "call_edge_change": {
      "type": "object",
      "required": ["caller", "callee", "call_events", "completed_calls", "inclusive_ns"],
      "properties": {
        "caller": { "type": "string", "minLength": 1 },
        "callee": { "type": "string", "minLength": 1 },
        "call_events": { "$ref": "#/$defs/resource_count_metric" },
        "completed_calls": { "$ref": "#/$defs/resource_count_metric" },
        "inclusive_ns": { "$ref": "#/$defs/resource_count_metric" }
      },
      "additionalProperties": false
    },
    "stack_change": {
      "type": "object",
      "required": ["stack", "call_events", "completed_calls", "self_ns"],
      "properties": {
        "stack": { "type": "string", "minLength": 1 },
        "call_events": { "$ref": "#/$defs/resource_count_metric" },
        "completed_calls": { "$ref": "#/$defs/resource_count_metric" },
        "self_ns": { "$ref": "#/$defs/resource_count_metric" }
      },
      "additionalProperties": false
    },
    "location_change": {
      "type": "object",
      "required": ["source", "line", "function", "kind", "variable", "signed", "count", "interval_ns", "max_interval_ns"],
      "properties": {
        "source": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"], "minimum": 0 },
        "function": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["statement", "value", "function"] },
        "variable": { "type": ["string", "null"] },
        "signed": { "type": "boolean" },
        "count": { "$ref": "#/$defs/resource_count_metric" },
        "interval_ns": { "$ref": "#/$defs/resource_count_metric" },
        "max_interval_ns": { "$ref": "#/$defs/resource_count_metric" }
      },
      "additionalProperties": false
    }
  }
}
