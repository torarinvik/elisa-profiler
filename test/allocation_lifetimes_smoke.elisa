include "../src/profiler/allocation_lifetimes.elisa"

module AllocationLifetimesSmoke:
    private:
        const ARENA: u64 = 16
        const OTHER_ARENA: u64 = 32
        const ADDRESS: u64 = 64
        const OTHER_ADDRESS: u64 = 128
        const THIRD_ADDRESS: u64 = 256
        const FOURTH_ADDRESS: u64 = 512
        const THREE_SLOTS: usize = 3
        const BYTES: u64 = 8
        const CAPACITY: usize = 2
        const SINGLE_SLOT: usize = 1
        const CHURN_COUNT: usize = 64
        const ZERO: u64 = 0
        const ONE: u64 = 1
        const FIRST_ENTRY: usize = 0
        const U64_MAX: u64 = 18446744073709551615

    public:
        def run() -> i64:
            state: mutable ElisaProfilerAllocationLifetimes::State = ElisaProfilerAllocationLifetimes::create(CAPACITY)
            first: u64 = ElisaProfilerAllocationLifetimes::observe_allocation(&state, ARENA, ADDRESS, BYTES)
            assert first != ZERO
            assert ElisaProfilerAllocationLifetimes::observe_release(&state, ARENA, ADDRESS)
            second: u64 = ElisaProfilerAllocationLifetimes::observe_allocation(&state, ARENA, ADDRESS, BYTES)
            assert second > first
            assert state.entries.count == 1
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&state, OTHER_ARENA, OTHER_ADDRESS, BYTES) > second
            assert state.live_bytes == BYTES + BYTES
            ElisaProfilerAllocationLifetimes::observe_arena_reset(&state, ARENA)
            ElisaProfilerAllocationLifetimes::observe_arena_reset(&state, ARENA)
            assert state.live_bytes == BYTES
            moved: mutable ElisaProfilerAllocationLifetimes::State = ElisaProfilerAllocationLifetimes::create(CAPACITY)
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&moved, ARENA, ADDRESS, BYTES) != ZERO
            destination_generation: u64 = ElisaProfilerAllocationLifetimes::observe_allocation(&moved, ARENA, OTHER_ADDRESS, BYTES + BYTES)
            assert destination_generation != ZERO
            assert ElisaProfilerAllocationLifetimes::observe_move(&moved, ARENA, ADDRESS, OTHER_ADDRESS, BYTES, BYTES + BYTES)
            assert moved.live_bytes == BYTES + BYTES
            assert moved.allocated_bytes == BYTES + BYTES + BYTES
            assert moved.peak_live_bytes == BYTES + BYTES + BYTES
            assert moved.allocation_count == CAPACITY.u64()
            assert not ElisaProfilerAllocationLifetimes::observe_move(&moved, ARENA, ADDRESS, OTHER_ADDRESS, BYTES, BYTES + BYTES)
            assert moved.quality == ElisaProfilerAllocationLifetimes::QUALITY_IDENTITY
            assert moved.live_bytes == BYTES + BYTES
            reclaimed: mutable ElisaProfilerAllocationLifetimes::State = ElisaProfilerAllocationLifetimes::create(CAPACITY)
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&reclaimed, ARENA, ADDRESS, BYTES) != ZERO
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&reclaimed, ARENA, OTHER_ADDRESS, BYTES + BYTES) != ZERO
            assert ElisaProfilerAllocationLifetimes::observe_release(&reclaimed, ARENA, ADDRESS)
            assert ElisaProfilerAllocationLifetimes::observe_move(&reclaimed, ARENA, ADDRESS, OTHER_ADDRESS, BYTES, BYTES + BYTES)
            assert reclaimed.live_bytes == BYTES + BYTES
            assert reclaimed.allocation_count == CAPACITY.u64()
            reused: mutable ElisaProfilerAllocationLifetimes::State = ElisaProfilerAllocationLifetimes::create(THREE_SLOTS)
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&reused, ARENA, ADDRESS, BYTES) != ZERO
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&reused, ARENA, OTHER_ADDRESS, BYTES) != ZERO
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&reused, ARENA, THIRD_ADDRESS, BYTES) != ZERO
            assert ElisaProfilerAllocationLifetimes::observe_release(&reused, ARENA, ADDRESS)
            assert ElisaProfilerAllocationLifetimes::observe_release(&reused, ARENA, THIRD_ADDRESS)
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&reused, ARENA, THIRD_ADDRESS, BYTES) != ZERO
            assert ElisaProfilerAllocationLifetimes::observe_release(&reused, ARENA, OTHER_ADDRESS)
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&reused, ARENA, FOURTH_ADDRESS, BYTES + BYTES) != ZERO
            assert ElisaProfilerAllocationLifetimes::observe_move(&reused, ARENA, THIRD_ADDRESS, FOURTH_ADDRESS, BYTES, BYTES + BYTES)
            assert reused.live_bytes == BYTES + BYTES
            assert reused.quality == ElisaProfilerAllocationLifetimes::QUALITY_EXACT
            erased: mutable ElisaProfilerAllocationLifetimes::State = ElisaProfilerAllocationLifetimes::create(SINGLE_SLOT)
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&erased, ARENA, ADDRESS, BYTES) != ZERO
            assert ElisaProfilerAllocationLifetimes::observe_release(&erased, ARENA, ADDRESS)
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&erased, ARENA, OTHER_ADDRESS, BYTES + BYTES) != ZERO
            assert not ElisaProfilerAllocationLifetimes::observe_move(&erased, ARENA, ADDRESS, OTHER_ADDRESS, BYTES, BYTES + BYTES)
            assert erased.quality == ElisaProfilerAllocationLifetimes::QUALITY_MISSING_EVENT
            assert erased.live_bytes == BYTES + BYTES
            after_reset: mutable ElisaProfilerAllocationLifetimes::State = ElisaProfilerAllocationLifetimes::create(CAPACITY)
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&after_reset, ARENA, ADDRESS, BYTES) != ZERO
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&after_reset, ARENA, OTHER_ADDRESS, BYTES) != ZERO
            assert ElisaProfilerAllocationLifetimes::observe_release(&after_reset, ARENA, OTHER_ADDRESS)
            ElisaProfilerAllocationLifetimes::observe_arena_reset(&after_reset, ARENA)
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&after_reset, ARENA, THIRD_ADDRESS, BYTES) != ZERO
            assert not ElisaProfilerAllocationLifetimes::observe_move(&after_reset, ARENA, OTHER_ADDRESS, THIRD_ADDRESS, BYTES, BYTES)
            assert after_reset.quality == ElisaProfilerAllocationLifetimes::QUALITY_MISSING_EVENT
            assert after_reset.live_bytes == BYTES
            resized: mutable ElisaProfilerAllocationLifetimes::State = ElisaProfilerAllocationLifetimes::create(SINGLE_SLOT)
            resized_generation: u64 = ElisaProfilerAllocationLifetimes::observe_allocation(&resized, ARENA, ADDRESS, BYTES)
            assert ElisaProfilerAllocationLifetimes::observe_resize(&resized, ARENA, ADDRESS, BYTES, BYTES + BYTES)
            assert resized.live_bytes == BYTES + BYTES
            assert resized.allocated_bytes == BYTES + BYTES
            assert resized.entries[FIRST_ENTRY].generation == resized_generation
            assert resized.allocation_count == ONE
            assert ElisaProfilerAllocationLifetimes::observe_resize(&resized, ARENA, ADDRESS, BYTES + BYTES, BYTES + BYTES)
            assert resized.allocated_bytes == BYTES + BYTES
            assert ElisaProfilerAllocationLifetimes::observe_resize(&resized, ARENA, ADDRESS, BYTES + BYTES, ZERO)
            assert resized.live_bytes == ZERO
            assert resized.allocated_bytes == BYTES + BYTES
            assert resized.entries[FIRST_ENTRY].live
            assert ElisaProfilerAllocationLifetimes::observe_resize(&resized, ARENA, ADDRESS, ZERO, BYTES)
            assert resized.allocated_bytes == BYTES + BYTES + BYTES
            assert not ElisaProfilerAllocationLifetimes::observe_resize(&resized, ARENA, ADDRESS, ZERO, BYTES)
            assert resized.quality == ElisaProfilerAllocationLifetimes::QUALITY_SIZE_MISMATCH
            assert resized.live_bytes == BYTES
            resize_overflow: mutable ElisaProfilerAllocationLifetimes::State = ElisaProfilerAllocationLifetimes::create(SINGLE_SLOT)
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&resize_overflow, ARENA, ADDRESS, U64_MAX) != ZERO
            assert ElisaProfilerAllocationLifetimes::observe_resize(&resize_overflow, ARENA, ADDRESS, U64_MAX, ZERO)
            assert not ElisaProfilerAllocationLifetimes::observe_resize(&resize_overflow, ARENA, ADDRESS, ZERO, BYTES)
            assert resize_overflow.quality == ElisaProfilerAllocationLifetimes::QUALITY_OVERFLOW
            assert resize_overflow.live_bytes == ZERO
            assert resize_overflow.entries[FIRST_ENTRY].size_bytes == ZERO
            assert resize_overflow.allocated_bytes == U64_MAX
            churn: mutable ElisaProfilerAllocationLifetimes::State = ElisaProfilerAllocationLifetimes::create(SINGLE_SLOT)
            previous_generation: mutable u64 = ZERO
            for index in 0..<CHURN_COUNT |churn, previous_generation|:
                generation: u64 = ElisaProfilerAllocationLifetimes::observe_allocation(&churn, ARENA, ADDRESS, BYTES)
                assert generation > previous_generation
                previous_generation <- generation
                assert ElisaProfilerAllocationLifetimes::observe_release(&churn, ARENA, ADDRESS)
                assert churn.entries.count == SINGLE_SLOT
            assert churn.live_bytes == ZERO
            assert churn.allocation_count == CHURN_COUNT.u64()
            assert churn.allocated_bytes == CHURN_COUNT.u64() * BYTES
            duplicate: mutable ElisaProfilerAllocationLifetimes::State = ElisaProfilerAllocationLifetimes::create(CAPACITY)
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&duplicate, ARENA, ADDRESS, BYTES) != ZERO
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&duplicate, ARENA, ADDRESS, BYTES) == ZERO
            assert duplicate.quality == ElisaProfilerAllocationLifetimes::QUALITY_IDENTITY
            assert duplicate.live_bytes == BYTES
            missing: mutable ElisaProfilerAllocationLifetimes::State = ElisaProfilerAllocationLifetimes::create(CAPACITY)
            assert not ElisaProfilerAllocationLifetimes::observe_release(&missing, ARENA, ADDRESS)
            assert missing.quality == ElisaProfilerAllocationLifetimes::QUALITY_MISSING_EVENT
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&missing, ARENA, ADDRESS, BYTES) == ZERO
            overflowing: mutable ElisaProfilerAllocationLifetimes::State = ElisaProfilerAllocationLifetimes::create(CAPACITY)
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&overflowing, ARENA, ADDRESS, U64_MAX) != ZERO
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&overflowing, ARENA, OTHER_ADDRESS, BYTES) == ZERO
            assert overflowing.quality == ElisaProfilerAllocationLifetimes::QUALITY_OVERFLOW
            assert overflowing.live_bytes == U64_MAX
            assert overflowing.allocated_bytes == U64_MAX
            disabled: mutable ElisaProfilerAllocationLifetimes::State = ElisaProfilerAllocationLifetimes::create(0)
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&disabled, ARENA, ADDRESS, BYTES) == ZERO
            assert disabled.quality == ElisaProfilerAllocationLifetimes::QUALITY_CAPACITY
            assert state.peak_live_bytes == BYTES + BYTES
            assert state.allocated_bytes == BYTES + BYTES + BYTES
            assert state.quality == ElisaProfilerAllocationLifetimes::QUALITY_EXACT
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&state, ARENA, ADDRESS, ZERO) > second
            assert ElisaProfilerAllocationLifetimes::observe_allocation(&state, ARENA, OTHER_ADDRESS, BYTES) == ZERO
            assert state.quality == ElisaProfilerAllocationLifetimes::QUALITY_CAPACITY
            ElisaProfilerAllocationLifetimes::observe_arena_reset(&state, OTHER_ARENA)
            assert state.live_bytes == BYTES
            return 0

def main() -> i64:
    return AllocationLifetimesSmoke::run()
