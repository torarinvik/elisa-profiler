include "../../elisa-compiler-worktrees/profiler/elisacore_std/collections.elisa"
include "../src/profiler/profiler_linkmap.elisa"

module LinkMapSmoke:
    private:
        const EXPECTED_ADDRESS: u64 = 0x100000680
        const EXPECTED_SIZE: u64 = 0x118
        const MAX_ADDRESS: u64 = 0xffffffffffffffff

        def check(text: sview, valid: bool) -> ElisaProfilerLinkMap::SymbolRow can[Abort.Panic, Memory.Allocate]:
            bytes: mutable darray[u8] = []
            for index in 0..<text.len |bytes, text|:
                bytes.push(text[index])
            row: mutable ElisaProfilerLinkMap::SymbolRow = zeroed
            row.address <- MAX_ADDRESS
            assert ElisaProfilerLinkMap::parse_symbol_row(bytes, &row) == valid
            if not valid:
                assert row.address == 0 and row.size == 0 and row.name_size == 0
            return row

    public:
        def run() -> i64 can[Abort.Panic, Memory.Allocate]:
            row: ElisaProfilerLinkMap::SymbolRow = check("0x100000680\t0x118\t[  1] l_new_region_backend", true)
            assert row.address == EXPECTED_ADDRESS and row.size == EXPECTED_SIZE
            assert row.name_size == "l_new_region_backend".len
            assert row.name_start == "0x100000680\t0x118\t[  1] ".len
            _ = check("0x0 0xA [123] name with spaces", true)
            _ = check("0xffffffffffffffff 0x0 [0] end", true)
            _ = check("0xffffffffffffffff 0x1 [0] overflow", false)
            _ = check("0x10000000000000000 0x0 [0] overflow", false)
            _ = check("0x 0x1 [0] missing", false)
            _ = check("0", false)
            _ = check("0x1", false)
            _ = check("0x1 0x10000000000000000 [0] overflow", false)
            _ = check("0x1 0x2 [1 name", false)
            _ = check("0x1 0x2 [1]name", false)
            _ = check("0x1 0x2 [] missing", false)
            _ = check("0x1 0x2 [-1] invalid", false)
            _ = check("0x1 0x2 [1]", false)
            _ = check("0x1 0x2 [1] bad\nname", false)
            _ = check("# Dead Stripped Symbols:", false)
            _ = check("", false)
            return 0

def main() -> i64:
    return LinkMapSmoke::run()
