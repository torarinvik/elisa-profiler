include "../../elisa-compiler-worktrees/profiler/elisacore_std/collections.elisa"
include "../src/profiler/profiler_model.elisa"
include "../src/profiler/profiler_macho.elisa"
include "../src/profiler/profiler_macho_map.elisa"
include "../src/profiler/profiler_macho_functions.elisa"
include "macho_map_cases.elisa"
include "macho_functions_cases.elisa"

@link_name("read")
extern macho_test_read(fd: i64, buffer: u8&, count: usize) -> i64 can[Console]

extend ProfilerNative:
    private:
        const MACHO_TEST_BYTES: usize = 128
        const MACHO_TEST_SYMBOLS: usize = 104
        const MACHO_TEST_STRINGS: usize = 120
        const MACHO_TEST_STRING_BYTES: u32 = 8
        const MACHO_TEST_CPU: u32 = 0x0100000c
        const MACHO_TEST_UNKNOWN_MAGIC: u32 = 0xcafebabe
        const MACHO_TEST_MAX_WORD: u32 = 0xffffffff
        const MACHO_TEST_MAX_VALUE: u64 = 0xffffffffffffffff
        const MACHO_TEST_BYTE_MASK: u32 = 255
        const MACHO_TEST_READ_BYTES: usize = 4096
        const MACHO_TEST_VM_ADDRESS: u32 = 4096
        const MACHO_TEST_VM_SIZE: u32 = 8192

        def macho_test_word(data: mutable darray[u8]&, offset: usize, value: u32) -> void:
            for index in NATIVE_ZERO.usize()..<MACHO_WORD_BYTES |data, offset, value|:
                data[offset + index] <- ((value >> (index.u32() * MACHO_BYTE_BITS)) & MACHO_TEST_BYTE_MASK).u8()

        def macho_test_change(data: mutable darray[u8]&, offset: usize, value: u32, expected: MachOIndexStatus) -> void:
            original: u32 = macho_word(data, offset)
            macho_test_word(data, offset, value)
            indexed: mutable MachOIndex = zeroed
            assert index_macho(data, &indexed) == expected
            assert not indexed.has_uuid and not indexed.has_symbols
            macho_test_word(data, offset, original)

    public:
        def macho_segment_smoke() -> i64 can[Abort.Panic, Memory.Allocate]:
            data: mutable darray[u8] = [NATIVE_ZERO.u8() for _ in NATIVE_ZERO.usize()..<(MACHO_HEADER_BYTES + MACHO_SEGMENT_BYTES)]
            command: usize = MACHO_HEADER_BYTES
            macho_test_word(&data, NATIVE_ZERO.usize(), MACHO_MAGIC_64)
            macho_test_word(&data, MACHO_COMMAND_COUNT_OFFSET, NATIVE_ONE.u32())
            macho_test_word(&data, MACHO_COMMAND_BYTES_OFFSET, MACHO_SEGMENT_BYTES.u32())
            macho_test_word(&data, command, MACHO_SEGMENT_COMMAND)
            macho_test_word(&data, command + MACHO_WORD_BYTES, MACHO_SEGMENT_BYTES.u32())
            macho_test_word(&data, command + MACHO_SEGMENT_VM_OFFSET, MACHO_TEST_VM_ADDRESS)
            macho_test_word(&data, command + MACHO_SEGMENT_SIZE_OFFSET, MACHO_TEST_VM_SIZE)
            macho_test_word(&data, command + MACHO_SEGMENT_FILE_SIZE_OFFSET, data.count.u32())
            macho_test_word(&data, command + MACHO_SEGMENT_PROTECTION_OFFSET, MACHO_EXECUTE_PROTECTION)
            indexed: mutable MachOIndex = zeroed
            segment: mutable MachOSegment = zeroed
            assert index_macho(data, &indexed) == MachOIndexStatus.Indexed
            assert indexed.segment_count == NATIVE_ONE.usize()
            assert macho_segment(data, command, &segment)
            assert segment.file_size == data.count.u64()
            assert segment.protection == MACHO_EXECUTE_PROTECTION
            assert macho_segment_contains(segment, MACHO_TEST_VM_ADDRESS.u64())
            assert macho_segment_contains(segment, (MACHO_TEST_VM_ADDRESS + MACHO_TEST_VM_SIZE - NATIVE_ONE.u32()).u64())
            assert not macho_segment_contains(segment, (MACHO_TEST_VM_ADDRESS - NATIVE_ONE.u32()).u64())
            assert not macho_segment_contains(segment, (MACHO_TEST_VM_ADDRESS + MACHO_TEST_VM_SIZE).u64())
            macho_test_change(&data, command + MACHO_SEGMENT_SECTIONS_OFFSET, NATIVE_ONE.u32(), MachOIndexStatus.Malformed)
            macho_test_change(&data, command + MACHO_SEGMENT_FILE_OFFSET, MACHO_TEST_MAX_WORD, MachOIndexStatus.Malformed)
            macho_test_change(&data, command + MACHO_SEGMENT_FILE_SIZE_OFFSET, MACHO_TEST_MAX_WORD, MachOIndexStatus.Malformed)
            macho_test_change(&data, command + MACHO_SEGMENT_SIZE_OFFSET, NATIVE_ZERO.u32(), MachOIndexStatus.Malformed)
            macho_test_word(&data, command + MACHO_SEGMENT_VM_OFFSET, MACHO_TEST_MAX_WORD)
            macho_test_change(&data, command + MACHO_SEGMENT_VM_OFFSET + MACHO_WORD_BYTES, MACHO_TEST_MAX_WORD, MachOIndexStatus.Malformed)
            assert not macho_segment(data, data.count, &segment)
            assert segment.vm_address == NATIVE_ZERO.u64()
            macho_test_word(&data, command + MACHO_SEGMENT_VM_OFFSET, MACHO_TEST_VM_ADDRESS)
            original_count: usize = data.count
            for length in NATIVE_ZERO.usize()..<original_count |data, command, segment|:
                data.count <- length
                assert not macho_segment(data, command, &segment)
                assert segment.vm_address == NATIVE_ZERO.u64()
            data.count <- original_count
            # A zero-fill segment has no file bytes; an empty VM range must not
            # accidentally match its starting address.
            macho_test_word(&data, command + MACHO_SEGMENT_FILE_SIZE_OFFSET, NATIVE_ZERO.u32())
            assert macho_segment(data, command, &segment)
            macho_test_word(&data, command + MACHO_SEGMENT_SIZE_OFFSET, NATIVE_ZERO.u32())
            assert macho_segment(data, command, &segment)
            assert not macho_segment_contains(segment, MACHO_TEST_VM_ADDRESS.u64())
            return NATIVE_ZERO

        def macho_stdin_smoke() -> i64 can[Abort.Panic, Memory.Allocate, Console]:
            data: mutable darray[u8] = []
            chunk: mutable darray[u8] = [NATIVE_ZERO.u8() for _ in NATIVE_ZERO.usize()..<MACHO_TEST_READ_BYTES]
            while true |data, chunk|:
                amount: i64 = macho_test_read(NATIVE_ZERO, &chunk[NATIVE_ZERO.usize()], MACHO_TEST_READ_BYTES)
                return NATIVE_ONE if amount < NATIVE_ZERO
                break if amount == NATIVE_ZERO
                for index in NATIVE_ZERO.usize()..<amount.usize() |data, chunk|:
                    data.push(chunk[index])
            if data.count > NATIVE_ZERO.usize():
                indexed: mutable MachOIndex = zeroed
                assert index_macho(data, &indexed) == MachOIndexStatus.Indexed
                assert indexed.has_uuid and indexed.has_symbols
                assert indexed.symbol_count > NATIVE_ZERO.usize()
                assert indexed.segment_count > NATIVE_ZERO.usize()
                starts: mutable darray[u64] = []
                assert decode_macho_function_starts(data, indexed, &starts) == MachOIndexStatus.Indexed
                assert starts.count > NATIVE_ZERO.usize()
                for entry in NATIVE_ONE.usize()..<starts.count |starts|:
                    assert starts[entry] > starts[entry - NATIVE_ONE.usize()]
                symbol: mutable MachOSymbol = zeroed
                for ordinal in NATIVE_ZERO.usize()..<indexed.symbol_count |data, indexed, symbol|:
                    assert macho_symbol(data, indexed, ordinal, &symbol)
                mappings: mutable darray[MachOMapping] = []
                assert build_macho_map(data, MACHO_TEST_RUNTIME_HEADER, &mappings) == MachOIndexStatus.Indexed
                assert mappings.count > NATIVE_ZERO.usize()
                resolved: mutable u64 = NATIVE_ZERO.u64()
                for entry in NATIVE_ZERO.usize()..<mappings.count |mappings, resolved|:
                    if (mappings[entry].protection & MACHO_EXECUTE_PROTECTION) != NATIVE_ZERO.u32():
                        assert lookup_macho_address(mappings, mappings[entry].runtime_address, &resolved) == MachOAddressStatus.Mapped
                        assert resolved == mappings[entry].image_address
            return NATIVE_ZERO

        def macho_smoke() -> i64 can[Abort.Panic, Memory.Allocate]:
            data: mutable darray[u8] = []
            for unused in NATIVE_ZERO.usize()..<MACHO_TEST_BYTES |data|:
                data.push(NATIVE_ZERO.u8())
            uuid_command: usize = MACHO_HEADER_BYTES
            symbols_command: usize = uuid_command + MACHO_UUID_COMMAND_BYTES
            macho_test_word(&data, NATIVE_ZERO.usize(), MACHO_MAGIC_64)
            macho_test_word(&data, MACHO_CPU_OFFSET, MACHO_TEST_CPU)
            macho_test_word(&data, MACHO_COMMAND_COUNT_OFFSET, NATIVE_TWO.u32())
            macho_test_word(&data, MACHO_COMMAND_BYTES_OFFSET, (MACHO_UUID_COMMAND_BYTES + MACHO_SYMTAB_COMMAND_BYTES).u32())
            macho_test_word(&data, uuid_command, MACHO_UUID_COMMAND)
            macho_test_word(&data, uuid_command + MACHO_WORD_BYTES, MACHO_UUID_COMMAND_BYTES.u32())
            macho_test_word(&data, symbols_command, MACHO_SYMTAB_COMMAND)
            macho_test_word(&data, symbols_command + MACHO_WORD_BYTES, MACHO_SYMTAB_COMMAND_BYTES.u32())
            macho_test_word(&data, symbols_command + MACHO_SYMBOL_OFFSET, MACHO_TEST_SYMBOLS.u32())
            macho_test_word(&data, symbols_command + MACHO_SYMBOL_COUNT_OFFSET, NATIVE_ONE.u32())
            macho_test_word(&data, symbols_command + MACHO_STRINGS_OFFSET, MACHO_TEST_STRINGS.u32())
            macho_test_word(&data, symbols_command + MACHO_STRINGS_SIZE_OFFSET, MACHO_TEST_STRING_BYTES)
            indexed: mutable MachOIndex = zeroed
            assert index_macho(data, &indexed) == MachOIndexStatus.Indexed
            assert indexed.cpu_type == MACHO_TEST_CPU
            assert indexed.has_uuid and indexed.uuid_offset == uuid_command + MACHO_COMMAND_HEADER_BYTES
            assert indexed.has_symbols and indexed.symbol_count == NATIVE_ONE.usize()
            assert indexed.symbol_offset == MACHO_TEST_SYMBOLS and indexed.strings_offset == MACHO_TEST_STRINGS
            for length in NATIVE_ZERO.usize()..<MACHO_TEST_BYTES |data, indexed|:
                data.count <- length
                assert index_macho(data, &indexed) == MachOIndexStatus.Truncated
                assert not indexed.has_uuid and not indexed.has_symbols
            data.count <- MACHO_TEST_BYTES
            macho_test_change(&data, NATIVE_ZERO.usize(), MACHO_TEST_UNKNOWN_MAGIC, MachOIndexStatus.Unsupported)
            macho_test_change(&data, MACHO_COMMAND_COUNT_OFFSET, MACHO_TEST_MAX_WORD, MachOIndexStatus.Malformed)
            macho_test_change(&data, uuid_command + MACHO_WORD_BYTES, NATIVE_ZERO.u32(), MachOIndexStatus.Malformed)
            macho_test_change(&data, uuid_command + MACHO_WORD_BYTES, (MACHO_UUID_COMMAND_BYTES - MACHO_WORD_BYTES).u32(), MachOIndexStatus.Malformed)
            macho_test_change(&data, symbols_command, MACHO_UUID_COMMAND, MachOIndexStatus.Malformed)
            macho_test_change(&data, uuid_command, MACHO_SYMTAB_COMMAND, MachOIndexStatus.Malformed)
            macho_test_change(&data, symbols_command + MACHO_SYMBOL_COUNT_OFFSET, MACHO_TEST_MAX_WORD, MachOIndexStatus.Truncated)
            macho_test_change(&data, symbols_command + MACHO_STRINGS_OFFSET, MACHO_TEST_MAX_WORD, MachOIndexStatus.Truncated)
            macho_test_change(&data, symbols_command + MACHO_SYMBOL_OFFSET, NATIVE_ZERO.u32(), MachOIndexStatus.Malformed)
            macho_test_change(&data, symbols_command + MACHO_STRINGS_OFFSET, MACHO_TEST_SYMBOLS.u32(), MachOIndexStatus.Malformed)
            assert index_macho(data, &indexed) == MachOIndexStatus.Indexed
            symbol: mutable MachOSymbol = zeroed
            assert macho_symbol(data, indexed, NATIVE_ZERO.usize(), &symbol)
            assert symbol.name_start == symbol.name_stop
            macho_test_word(&data, MACHO_TEST_SYMBOLS, NATIVE_ONE.u32())
            data[MACHO_TEST_STRINGS + NATIVE_ONE.usize()] <- MACHO_TEST_BYTE_MASK.u8()
            data[MACHO_TEST_SYMBOLS + MACHO_SYMBOL_TYPE_OFFSET] <- MACHO_TEST_BYTE_MASK.u8()
            data[MACHO_TEST_SYMBOLS + MACHO_SYMBOL_SECTION_OFFSET] <- NATIVE_ONE.u8()
            macho_test_word(&data, MACHO_TEST_SYMBOLS + MACHO_SYMBOL_VALUE_OFFSET, MACHO_TEST_MAX_WORD)
            macho_test_word(&data, MACHO_TEST_SYMBOLS + MACHO_SYMBOL_VALUE_OFFSET + MACHO_WORD_BYTES, MACHO_TEST_MAX_WORD)
            assert macho_symbol(data, indexed, NATIVE_ZERO.usize(), &symbol)
            assert symbol.value == MACHO_TEST_MAX_VALUE
            assert symbol.kind == MACHO_TEST_BYTE_MASK.u8() and symbol.section == NATIVE_ONE.u8()
            assert symbol.name_stop - symbol.name_start == NATIVE_ONE.usize()
            assert not macho_symbol(data, indexed, indexed.symbol_count, &symbol)
            assert symbol.value == NATIVE_ZERO.u64()
            macho_test_word(&data, MACHO_TEST_SYMBOLS, MACHO_TEST_STRING_BYTES)
            assert not macho_symbol(data, indexed, NATIVE_ZERO.usize(), &symbol)
            macho_test_word(&data, MACHO_TEST_SYMBOLS, MACHO_TEST_STRING_BYTES - NATIVE_ONE.u32())
            data[MACHO_TEST_BYTES - NATIVE_ONE.usize()] <- MACHO_TEST_BYTE_MASK.u8()
            assert not macho_symbol(data, indexed, NATIVE_ZERO.usize(), &symbol)
            macho_test_word(&data, MACHO_TEST_SYMBOLS, NATIVE_ZERO.u32())
            indexed.strings_size <- NATIVE_ZERO.usize()
            assert macho_symbol(data, indexed, NATIVE_ZERO.usize(), &symbol)
            data.count <- MACHO_TEST_SYMBOLS
            assert not macho_symbol(data, indexed, NATIVE_ZERO.usize(), &symbol)
            data.count <- MACHO_TEST_BYTES
            return NATIVE_ZERO

def main() -> i64 can[Abort.Panic, Memory.Allocate, Console]:
    assert ProfilerNative::macho_smoke() == 0
    assert ProfilerNative::macho_segment_smoke() == 0
    assert ProfilerNative::macho_map_smoke() == 0
    assert ProfilerNative::macho_functions_smoke() == 0
    return ProfilerNative::macho_stdin_smoke()
