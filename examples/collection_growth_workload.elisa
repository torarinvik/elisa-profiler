# Real dictionary/set growth: verify every value survives repeated rehashes.
include "../../Elisa-compiler/elisacore_std/elisacore_runtime.elisa"

module CollectionGrowthWorkload:
    private:
        const KEY_COUNT: usize = 80
        const VALUE_FACTOR: i64 = 3
        const SUCCESS: i64 = 0
        const FAILURE: i64 = 1

    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic]:
            values: mutable dict[u64, i64] = {}
            keys: mutable set[u64] = {}
            for index in 0..<KEY_COUNT |values, keys| -> values, keys:
                values <- values.put(index.u64(), index.i64() * VALUE_FACTOR)
                keys <- keys.add(index.u64())
            return FAILURE if values.count != KEY_COUNT or keys.count != KEY_COUNT
            for index in 0..<KEY_COUNT |values, keys|:
                return FAILURE if not (index.u64() in keys)
                if values.get(index.u64()) is value:
                    return FAILURE if value != index.i64() * VALUE_FACTOR
                else:
                    return FAILURE
            return SUCCESS

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return CollectionGrowthWorkload::run()
