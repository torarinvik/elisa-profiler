# Including the default runtime must not make trace callbacks call themselves
# or hide the collector behind private runtime callback definitions.
include "../../elisa-compiler-worktrees/profiler/elisacore_std/elisacore_runtime.elisa"

module RuntimeTraceWorkload:
    private:
        const INPUT_VALUE: i64 = 21
        const SCALE: i64 = 2
        const EXPECTED_VALUE: i64 = 42
        const SUCCESS_STATUS: i64 = 0
        const FAILURE_STATUS: i64 = 1

        def compute(value: i64) -> i64:
            return value * SCALE

    public:
        def run() -> i64:
            return SUCCESS_STATUS if compute(INPUT_VALUE) == EXPECTED_VALUE else FAILURE_STATUS

def main() -> i64:
    return RuntimeTraceWorkload::run()
