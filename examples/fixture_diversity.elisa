# Fixture-diversity workload. The UTF-8 identifier and two same-basename
# includes exercise source identity without relying on generated source maps.

include "fixture_left/worker.elisa"
include "fixture_right/worker.elisa"

const DIVERSITY_EXPECTED: i64 = 4

def café(value: i64) -> i64:
    return value + 1

def main() -> i64:
    left: i64 = FixtureLeft::worker(1)
    right: i64 = FixtureRight::worker(1)
    return 0 if café(left + right) == DIVERSITY_EXPECTED else 1
