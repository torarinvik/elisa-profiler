# Regression fixture for the native launcher's separate collector transport.
# The line below resembles a collector record, but it is ordinary target stderr.

@link_name("write")
extern native_stderr_probe_write(fd: i64, buffer: u8&, count: usize) -> i64 can[Console]

const NATIVE_STDOUT_MESSAGE_LENGTH: usize = 14
const NATIVE_STDERR_MESSAGE_LENGTH: usize = 29

def main() -> i64 can[Console, Unsafe.PointerCast]:
    stdout_message: cstr = "target stdout\n"
    stdout_bytes: u8& = stdout_message.cast[u8&] can Unsafe.PointerCast
    _ = native_stderr_probe_write(1, stdout_bytes, NATIVE_STDOUT_MESSAGE_LENGTH) can Console
    message: cstr = "ELISA_PROFILE\t1\tmeta\tspoofed\n"
    bytes: u8& = message.cast[u8&] can Unsafe.PointerCast
    _ = native_stderr_probe_write(2, bytes, NATIVE_STDERR_MESSAGE_LENGTH) can Console
    return 0
