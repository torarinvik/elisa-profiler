# A reset releases logical allocations while retaining reusable region backing.
include "../../elisa-compiler-worktrees/profiler/elisacore_std/arena.elisa"

module ArenaResetWorkload:
    private:
        const CAPACITY_SLOTS: usize = 16
        const ALLOCATION_SLOTS: usize = 4
        const EMPTY_SLOTS: usize = 0
        const FIRST_REGION: usize = 0
        const SUCCESS_STATUS: i64 = 0
        const FAILURE_STATUS: i64 = 1

    public:
        def run() -> i64:
            backing: mutable heap Region& = new_region_backend(CAPACITY_SLOTS, ARENA_STRATEGY_FIXED)
            arena: mutable Arena = Arena{begin: backing, end: backing, end_index: FIRST_REGION, strategy: ARENA_STRATEGY_FIXED}
            initial: mutable heap void& = arena_alloc(&arena, ALLOCATION_SLOTS * size_of(uintptr))
            initial_address: uintptr = initial.cast[uintptr]
            arena_reset(&arena)
            reset_correct: bool = backing.count == EMPTY_SLOTS and arena.end_index == FIRST_REGION
            replacement: mutable heap void& = arena_alloc(&arena, ALLOCATION_SLOTS * size_of(uintptr))
            correct: bool = reset_correct and replacement.cast[uintptr] == initial_address and backing.count == ALLOCATION_SLOTS
            arena_free(&arena)
            return SUCCESS_STATUS if correct else FAILURE_STATUS

def main() -> i64:
    return ArenaResetWorkload::run()
