        def native_saturating_add(left: i64, right: i64) -> i64:
            return NATIVE_I64_MAX if right > NATIVE_ZERO and left > NATIVE_I64_MAX - right
            return NATIVE_I64_MIN if right < NATIVE_ZERO and left < NATIVE_I64_MIN - right
            return left + right


        def native_saturating_mul_nonnegative(left: i64, right: i64) -> i64:
            return NATIVE_ZERO if left <= NATIVE_ZERO or right <= NATIVE_ZERO
            return NATIVE_I64_MAX if left > NATIVE_I64_MAX / right
            return left * right


        def native_saturating_square(value: i64) -> i64:
            return NATIVE_I64_MAX if value == NATIVE_I64_MIN
            return NATIVE_ZERO if value == NATIVE_ZERO
            magnitude: i64 = -value if value < NATIVE_ZERO else value
            return NATIVE_I64_MAX if magnitude > NATIVE_I64_MAX / magnitude
            return magnitude * magnitude


        def native_signed_delta(left: i64, right: i64) -> i64:
            return left - right if left >= right
            return -(right - left)


        def native_confidence_half_width(value_stdev_ns: i64, sample_count: i64) -> i64:
            # A single observation has no estimate of dispersion. The caller
            # serializes equal bounds with `available: false` in that case.
            return NATIVE_ZERO if sample_count < NATIVE_MIN_CONFIDENCE_SAMPLES or value_stdev_ns <= NATIVE_ZERO
            scaled_count: i64 = native_saturating_mul_nonnegative(sample_count, native_saturating_mul_nonnegative(NATIVE_CONFIDENCE_SCALE, NATIVE_CONFIDENCE_SCALE))
            scaled_root: i64 = integer_sqrt(scaled_count)
            return NATIVE_ZERO if scaled_root <= NATIVE_ZERO
            numerator: i64 = native_saturating_mul_nonnegative(value_stdev_ns, NATIVE_CONFIDENCE_Z95_SCALE)
            return numerator / scaled_root

        struct TargetRunResult:
            status: i64
            collector_status: mutable i64
            elapsed_ns: i64
            timed_out: bool
            resource_available: bool
            cpu_user_ns: i64
            cpu_system_ns: i64
            peak_rss_bytes: i64

        struct NativeHostMetadata:
            available: mutable bool
            os: mutable darray[u8]
            architecture: mutable darray[u8]
            load_average_1m: mutable f64
            load_average_available: mutable bool

        struct NativeBuildCache:
            enabled: mutable bool
            hit: mutable bool
            key: mutable darray[u8]
            status: mutable darray[u8]
            explanation: mutable darray[u8]

        def empty_native_build_cache() -> NativeBuildCache:
            return NativeBuildCache{
                enabled: false,
                hit: false,
                key: [],
                status: "disabled",
                explanation: "not applicable to this capture",
            }

        # Fully validated offline profile data shared by every presentation
        # renderer. The JSON module owns construction; renderers only consume
        # this normalized model and therefore cannot accidentally implement a
        # second, format-specific parser.
        struct NativeOfflineProfile:
            source: mutable darray[u8]
            source_snapshot: mutable darray[u8]
            source_digest: mutable darray[u8]
            source_digest_available: mutable bool
            workload: mutable darray[u8]
            outcome: mutable darray[u8]
            exit_code: mutable i64
            events: mutable i64
            locations: mutable i64
            statement_events: mutable i64
            value_events: mutable i64
            function_events: mutable i64
            dropped: mutable i64
            thread_count: mutable i64
            call_edge_dropped: mutable i64
            stack_dropped: mutable i64
            frame_dropped: mutable i64
            capture_bytes_dropped: mutable i64
            stack_overflow_entries: mutable i64
            trace_omitted: mutable i64
            sample_count: mutable i64
            sample_missed: mutable i64
            sample_period_microseconds: mutable i64
            sampling_setup_failed: mutable i64
            collector_status: mutable i64
            crash_signal: mutable i64
            crash_signal_available: mutable bool
            capture_complete: mutable bool
            capture_complete_available: mutable bool
            execution_mean_micros: mutable i64
            execution_mean_available: mutable bool
            cpu_micros: mutable i64
            cpu_available: mutable bool
            peak_rss_bytes: mutable i64
            peak_rss_available: mutable bool
            completed_repetitions: mutable i64
            successful_repetitions: mutable i64
            host: mutable NativeHostMetadata
            location_timing: mutable bool
            functions: mutable darray[u8]
            call_edges: mutable darray[u8]
            stacks: mutable darray[u8]
            location_records: mutable darray[u8]
            thread_loss: mutable darray[u8]
            folded_records: mutable darray[u8]
            sample_records: mutable darray[u8]

        def empty_native_offline_profile() -> NativeOfflineProfile:
            return NativeOfflineProfile{
                source: [], source_snapshot: [], source_digest: [], source_digest_available: false,
                workload: [], outcome: [], exit_code: NATIVE_ZERO,
                events: NATIVE_ZERO, locations: NATIVE_ZERO, statement_events: NATIVE_ZERO,
                value_events: NATIVE_ZERO, function_events: NATIVE_ZERO, dropped: NATIVE_ZERO,
                thread_count: NATIVE_ZERO, call_edge_dropped: NATIVE_ZERO, stack_dropped: NATIVE_ZERO,
                frame_dropped: NATIVE_ZERO, capture_bytes_dropped: NATIVE_ZERO,
                stack_overflow_entries: NATIVE_ZERO, trace_omitted: NATIVE_ZERO,
                sample_count: NATIVE_ZERO, sample_missed: NATIVE_ZERO,
                sample_period_microseconds: NATIVE_ZERO, sampling_setup_failed: NATIVE_ZERO,
                collector_status: NATIVE_COLLECTOR_STATUS_UNKNOWN,
                crash_signal: NATIVE_ZERO, crash_signal_available: false,
                capture_complete: false, capture_complete_available: false,
                execution_mean_micros: NATIVE_ZERO, execution_mean_available: false,
                cpu_micros: NATIVE_ZERO, cpu_available: false,
                peak_rss_bytes: NATIVE_ZERO, peak_rss_available: false,
                completed_repetitions: NATIVE_ZERO, successful_repetitions: NATIVE_ZERO,
                host: NativeHostMetadata{available: false, os: [], architecture: [], load_average_1m: NATIVE_ZERO_F64, load_average_available: false},
                location_timing: false, functions: [], call_edges: [], stacks: [],
                location_records: [], thread_loss: [], folded_records: [], sample_records: [],
            }

        struct NativePathMap:
            from: mutable darray[u8]
            replacement: mutable darray[u8]

        def native_path_has_prefix(path: darray[u8]&, prefix: darray[u8]&) -> bool can[Abort.Panic]:
            return false if prefix.count == NATIVE_ZERO.usize() or path.count < prefix.count
            for index in 0..<prefix.count |path, prefix|:
                return false if path[index] != prefix[index]
            return true if path.count == prefix.count
            return path[prefix.count] == NATIVE_BYTE_SLASH


        def native_remap_display_path(path: darray[u8]&, mappings: darray[NativePathMap]&) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
            selected: mutable i64 = NATIVE_NEGATIVE_ONE
            for mapping_index in 0..<mappings.count |mapping_index, mappings, path, selected|:
                if native_path_has_prefix(path, mappings[mapping_index].from) and (selected < NATIVE_ZERO or mappings[mapping_index].from.count > mappings[selected.usize()].from.count):
                    selected <- mapping_index.i64()
            result: mutable darray[u8] = []
            if selected < NATIVE_ZERO:
                result.extend(path)
                return result
            result.extend(mappings[selected.usize()].replacement)
            for index in mappings[selected.usize()].from.count..<path.count |result, path|:
                result.push(path[index])
            return result

        struct NativeSourceMap:
            available: mutable bool
            flat_lines: mutable darray[i64]
            source_lines: mutable darray[i64]

        struct CaptureSummary:
            events: mutable i64
            locations: mutable i64
            statement_events: mutable i64
            value_events: mutable i64
            function_events: mutable i64
            location_record_count: mutable i64
