        # floating-point value. A value of 10000 therefore means +100.00%.
        const NATIVE_RELATIVE_BASIS_POINTS_PER_PERCENT: i64 = 100
        const NATIVE_RELATIVE_BASIS_POINTS_SCALE: i64 = 10000
