# Shared data model and policy constants for the native Elisa profiler.
#
# This file is the canonical declaration of `ProfilerNative`. Feature files extend
# that module with private implementation details, while the executable facade keeps
# its public entry point in main.elisa. Keeping the model in one named module prevents
# include order from accidentally exporting implementation helpers.
module ProfilerNative:
    private:
        # All implementation details stay private to the profiler facade. The only
        # source-level API exported by this module is `run`; libc symbols above are
        # deliberately aliased to keep the global FFI namespace collision-free.
        const NATIVE_ZERO: i64 = 0
        const NATIVE_ONE: i64 = 1
        const NATIVE_TWO: i64 = 2
        const NATIVE_THREE: i64 = 3
        const NATIVE_NEGATIVE_ONE: i64 = -1
        const NATIVE_CHILD_FAILURE_STATUS: i64 = 127
        const NATIVE_WAIT_NO_OPTIONS: i64 = 0
        const NATIVE_WAIT_NO_HANG: i64 = 1
        const NATIVE_WAIT_POLL_MICROSECONDS: u32 = 1000
        const NATIVE_TIMEOUT_GRACE_MILLISECONDS: i64 = 2000
        const NATIVE_ENV_OVERWRITE: i64 = 1
        const NATIVE_ACCESS_EXECUTE: i64 = 1
        const NATIVE_EXIT_STATUS_BASE: i64 = 256
        const NATIVE_SIGNAL_STATUS_BASE: i64 = 128
        const NATIVE_SIGNAL_EXIT_BASE: i64 = 128
        const NATIVE_DECIMAL_BASE: i64 = 10
        const NATIVE_HEX_BASE: i64 = 16
        const NATIVE_HEX_DIGIT_ALPHA_VALUE: i64 = 10
        const NATIVE_I64_MAX: i64 = 9223372036854775807
        const NATIVE_I64_MIN: i64 = -9223372036854775807 - 1
        const NATIVE_NANOS_PER_SECOND: i64 = 1000000000
        const NATIVE_NANOS_PER_MILLISECOND: i64 = 1000000
        const NATIVE_NANOS_PER_MICROSECOND: i64 = 1000
        const NATIVE_TIMEOUT_FRACTION_DIGITS: i64 = 9
        const NATIVE_TIMEOUT_FRACTION_FIRST_DIVISOR: i64 = 100000000
        const NATIVE_MICROSECONDS_PER_MILLISECOND: i64 = 1000
        const NATIVE_MILLIS_HUNDREDS_DIVISOR: i64 = 100
        const NATIVE_DECIMAL_TENS_DIVISOR: i64 = 10
        const NATIVE_READ_CHUNK_BYTES: usize = 8192
        const NATIVE_MAX_FILE_BYTES: usize = 134217728
        const NATIVE_MAX_JSON_NESTING_DEPTH: i64 = 128
        const NATIVE_DEFAULT_TRACE_LIMIT: i64 = 1000000
        const NATIVE_DEFAULT_CAPTURE_BYTES: i64 = 67108864
        const NATIVE_DIRECTORY_MODE: i64 = 448
        const NATIVE_COMMAND_ARGUMENT_INDEX: i64 = 1
