        const NATIVE_PROFILE_EVENT_TRACE_ENVIRONMENT: cstr = "ELISA_PROFILE_EVENT_TRACE"
        const NATIVE_PROFILE_EVENT_TRACE_LIMIT_ENVIRONMENT: cstr = "ELISA_PROFILE_EVENT_TRACE_LIMIT"
        const NATIVE_PROFILE_MAX_CAPTURE_BYTES_ENVIRONMENT: cstr = "ELISA_PROFILE_MAX_CAPTURE_BYTES"
        const NATIVE_PROFILE_RECENT_PATH_ENVIRONMENT: cstr = "ELISA_PROFILE_RECENT_PATH"
        const NATIVE_ACCESS_EXECUTE: i64 = 1
        const NATIVE_EXIT_STATUS_BASE: i64 = 256
        const NATIVE_SIGNAL_STATUS_BASE: i64 = 128
        const NATIVE_SIGNAL_EXIT_BASE: i64 = 128
        const NATIVE_DECIMAL_BASE: i64 = 10
        const NATIVE_HEX_BASE: i64 = 16
        const NATIVE_HEX_DIGIT_ALPHA_VALUE: i64 = 10
        const NATIVE_I64_MAX: i64 = 9223372036854775807
        const NATIVE_I64_MIN: i64 = -9223372036854775807 - 1
        const NATIVE_I64_MIN_TEXT: cstr = "-9223372036854775808"
        const NATIVE_U64_MAX: u64 = 18446744073709551615
        const NATIVE_NANOS_PER_SECOND: i64 = 1000000000
        const NATIVE_NANOS_PER_MILLISECOND: i64 = 1000000
        const NATIVE_NANOS_PER_MICROSECOND: i64 = 1000
        const NATIVE_MICROSECONDS_PER_SECOND: i64 = 1000000
        # Approximate 95% confidence intervals use a two-sided normal critical
        # value of 1.96. Fixed-point arithmetic keeps the native report free of
        # floating-point rounding differences while preserving sub-second data.
        const NATIVE_CONFIDENCE_SCALE: i64 = 1000
        const NATIVE_CONFIDENCE_Z95_SCALE: i64 = 1960
        const NATIVE_MIN_CONFIDENCE_SAMPLES: i64 = 2
        const NATIVE_TIMEOUT_FRACTION_DIGITS: i64 = 9
        const NATIVE_TIMEOUT_FRACTION_FIRST_DIVISOR: i64 = 100000000
