# Shared data model and policy constants for the native Elisa profiler.
#
# This file is the canonical declaration of `ProfilerNative`. Feature files extend
# that module with private implementation details, while the executable facade keeps
# its public entry point in main.elisa. Keeping the model in one named module prevents
# include order from accidentally exporting implementation helpers.
module ProfilerNative:
    private:
        # All implementation details stay private to the profiler facade. The only
        # source-level API exported by this module is `run`; libc symbols above are
        # deliberately aliased to keep the global FFI namespace collision-free.
        const NATIVE_ZERO: i64 = 0
        const NATIVE_ZERO_F64: f64 = 0.0
        const NATIVE_ONE: i64 = 1
        const NATIVE_TWO: i64 = 2
        const NATIVE_THREE: i64 = 3
        const NATIVE_NEGATIVE_ONE: i64 = -1
        const NATIVE_CHILD_FAILURE_STATUS: i64 = 127
        const NATIVE_COLLECTOR_FAILURE_STATUS: i64 = 126
        # Stable profiler-owned exit codes. Target exit/signal values remain
        # represented inside a successful capture; these values describe the
        # command's ability to produce or gate a comparison report.
        const NATIVE_EXIT_COMPARISON_INCONCLUSIVE: i64 = 4
        const NATIVE_EXIT_COMPARISON_REGRESSION: i64 = 5
        const NATIVE_ERROR_SCHEMA_VERSION: i64 = 1
        const NATIVE_ERROR_ENVELOPE_MAJOR: i64 = 1
        const NATIVE_ERROR_ENVELOPE_MINOR: i64 = 0
        const NATIVE_WAIT_NO_OPTIONS: i64 = 0
        const NATIVE_WAIT_NO_HANG: i64 = 1
        const NATIVE_WAIT_POLL_MICROSECONDS: u32 = 1000
        const NATIVE_TOOL_TIMEOUT_SECONDS: i64 = 300
        const NATIVE_TOOL_TIMEOUT_NS: i64 = 300000000000
        const NATIVE_TIMEOUT_GRACE_MILLISECONDS: i64 = 2000
        const NATIVE_ENV_OVERWRITE: i64 = 1
        const NATIVE_PROFILE_FD_ENVIRONMENT: cstr = "ELISA_PROFILE_FD"
        const NATIVE_PROFILE_STATUS_FD_ENVIRONMENT: cstr = "ELISA_PROFILE_STATUS_FD"
        const NATIVE_PROFILE_FRAMED_ENVIRONMENT: cstr = "ELISA_PROFILE_FRAMED"
        const NATIVE_PROFILE_THREAD_RECORDS_ENVIRONMENT: cstr = "ELISA_PROFILE_THREAD_RECORDS"
        const NATIVE_PROFILE_MODE_ENVIRONMENT: cstr = "ELISA_PROFILE_MODE"
        const NATIVE_PROFILE_EVENT_TRACE_ENVIRONMENT: cstr = "ELISA_PROFILE_EVENT_TRACE"
