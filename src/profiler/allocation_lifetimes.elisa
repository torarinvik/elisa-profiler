# Bounded logical allocation state. Callers must first order and reconcile raw
# events; this module does not infer lifetimes from an incomplete event stream.
module ElisaProfilerAllocationLifetimes:
    private:
        const ZERO: u64 = 0
        const ONE: u64 = 1
        const U64_MAX: u64 = 18446744073709551615

    public:
        const QUALITY_EXACT: u32 = 0
        const QUALITY_CAPACITY: u32 = 1
        const QUALITY_OVERFLOW: u32 = 2
        const QUALITY_IDENTITY: u32 = 3
        const QUALITY_MISSING_EVENT: u32 = 4
        const QUALITY_SIZE_MISMATCH: u32 = 5
        const DEFAULT_CAPACITY: usize = 4096

        struct Entry:
            arena: mutable u64
            address: u64
            generation: u64
            size_bytes: mutable u64
            live: mutable bool
            move_reconciled: mutable bool
            released: mutable bool

        struct State:
            entries: mutable darray[Entry]
            capacity: usize
            next_generation: mutable u64
            live_bytes: mutable u64
            peak_live_bytes: mutable u64
            allocated_bytes: mutable u64
            allocation_count: mutable u64
            quality: mutable u32

        def create(capacity: usize) -> State:
            return State{entries: [], capacity: capacity, next_generation: ONE,
                live_bytes: ZERO, peak_live_bytes: ZERO, allocated_bytes: ZERO,
                allocation_count: ZERO, quality: QUALITY_EXACT}

        # Preserve the first loss reason. Once evidence is unreliable, freeze
        # state rather than silently publishing plausible exact-looking totals.
        def invalidate(state: mutable State&, reason: u32) -> void:
            state.quality <- reason if state.quality == QUALITY_EXACT and reason != QUALITY_EXACT

        # Zero is reserved for failure; generations never depend on addresses.
        def observe_allocation(state: mutable State&, arena: u64, address: u64, size_bytes: u64) -> u64 can[Abort.Panic, Memory.Allocate]:
            return ZERO if state.quality != QUALITY_EXACT
            if arena == ZERO or address == ZERO:
                invalidate(state, QUALITY_IDENTITY)
                return ZERO
            reusable: mutable usize = state.entries.count
            for index in 0..<state.entries.count |state, arena, address, reusable|:
                if state.entries[index].live:
                    if state.entries[index].arena == arena and state.entries[index].address == address:
                        invalidate(state, QUALITY_IDENTITY)
                        return ZERO
                elif reusable == state.entries.count:
                    reusable <- index
            if reusable == state.entries.count and state.entries.count >= state.capacity:
                invalidate(state, QUALITY_CAPACITY)
                return ZERO
            if state.next_generation == U64_MAX or size_bytes > U64_MAX - state.live_bytes or size_bytes > U64_MAX - state.allocated_bytes or state.allocation_count == U64_MAX:
                invalidate(state, QUALITY_OVERFLOW)
                return ZERO
            generation: u64 = state.next_generation
            entry: Entry = Entry{arena: arena, address: address, generation: generation, size_bytes: size_bytes, live: true, move_reconciled: false, released: false}
            if reusable == state.entries.count:
                state.entries.push(entry)
            else:
                state.entries[reusable] <- entry
            state.next_generation <- generation + ONE
            state.live_bytes <- state.live_bytes + size_bytes
            state.allocated_bytes <- state.allocated_bytes + size_bytes
            state.allocation_count <- state.allocation_count + ONE
            state.peak_live_bytes <- state.live_bytes if state.live_bytes > state.peak_live_bytes
            return generation

        # A successful in-place resize keeps its generation. Traffic counts
        # only additional requested bytes; shrinking does not undo past traffic.
        # A zero-sized resize retains identity until an explicit release/reset.
        def observe_resize(state: mutable State&, arena: u64, address: u64, old_size: u64, new_size: u64) -> bool can[Abort.Panic]:
            return false if state.quality != QUALITY_EXACT
            for index in 0..<state.entries.count |state, arena, address, old_size, new_size|:
                if state.entries[index].live and state.entries[index].arena == arena and state.entries[index].address == address:
                    if state.entries[index].size_bytes != old_size:
                        invalidate(state, QUALITY_SIZE_MISMATCH)
                        return false
                    if new_size > old_size:
                        growth: u64 = new_size - old_size
                        if growth > U64_MAX - state.live_bytes or growth > U64_MAX - state.allocated_bytes:
                            invalidate(state, QUALITY_OVERFLOW)
                            return false
                        state.live_bytes <- state.live_bytes + growth
                        state.allocated_bytes <- state.allocated_bytes + growth
                        state.peak_live_bytes <- state.live_bytes if state.live_bytes > state.peak_live_bytes
                    else:
                        state.live_bytes <- state.live_bytes - (old_size - new_size)
                    state.entries[index].size_bytes <- new_size
                    return true
            invalidate(state, QUALITY_MISSING_EVENT)
            return false

        # The raw runtime emits allocation(new), optional reclaim(old), then
        # move(old,new). Reconcile those existing entries; never allocate again.
        # Retired source evidence must still be retained. If slot reuse erased
        # it, fail closed rather than assuming that a release was observed.
        def observe_move(state: mutable State&, arena: u64, old_address: u64, new_address: u64, old_size: u64, new_size: u64) -> bool can[Abort.Panic]:
            return false if state.quality != QUALITY_EXACT
            if old_address == new_address:
                invalidate(state, QUALITY_IDENTITY)
                return false
            old_index: mutable usize = state.entries.count
            new_index: mutable usize = state.entries.count
            for index in 0..<state.entries.count |state, arena, old_address, new_address, old_index, new_index|:
                if state.entries[index].arena == arena:
                    if state.entries[index].address == old_address:
                        if old_index == state.entries.count or state.entries[index].generation > state.entries[old_index].generation:
                            old_index <- index
                    if state.entries[index].address == new_address and state.entries[index].live:
                        new_index <- index
            if old_index == state.entries.count or new_index == state.entries.count:
                invalidate(state, QUALITY_MISSING_EVENT)
                return false
            if state.entries[new_index].move_reconciled or state.entries[old_index].generation >= state.entries[new_index].generation:
                invalidate(state, QUALITY_IDENTITY)
                return false
            if not state.entries[old_index].live and not state.entries[old_index].released:
                invalidate(state, QUALITY_MISSING_EVENT)
                return false
            if state.entries[old_index].size_bytes != old_size or state.entries[new_index].size_bytes != new_size:
                invalidate(state, QUALITY_SIZE_MISMATCH)
                return false
            if state.entries[old_index].live:
                state.live_bytes <- state.live_bytes - old_size
                state.entries[old_index].live <- false
            state.entries[old_index].released <- false
            state.entries[new_index].move_reconciled <- true
            return true

        def observe_release(state: mutable State&, arena: u64, address: u64) -> bool can[Abort.Panic]:
            return false if state.quality != QUALITY_EXACT
            for index in 0..<state.entries.count |state, arena, address|:
                if state.entries[index].live and state.entries[index].arena == arena and state.entries[index].address == address:
                    state.live_bytes <- state.live_bytes - state.entries[index].size_bytes
                    state.entries[index].live <- false
                    state.entries[index].released <- true
                    return true
            invalidate(state, QUALITY_MISSING_EVENT)
            return false

        # Ownership transfer does not allocate or release logical bytes. Check
        # all collisions before mutation so a rejected transfer is transactional.
        # Region-index remapping is the raw-event reconciler's responsibility.
        def observe_adoption(state: mutable State&, parent: u64, child: u64) -> bool can[Abort.Panic]:
            return false if state.quality != QUALITY_EXACT
            if parent == ZERO or child == ZERO or parent == child:
                invalidate(state, QUALITY_IDENTITY)
                return false
            for source_index in 0..<state.entries.count |state, parent, child|:
                if state.entries[source_index].arena == child and state.entries[source_index].live:
                    for destination_index in 0..<state.entries.count |state, parent, source_index|:
                        if state.entries[destination_index].arena == parent and state.entries[destination_index].live and state.entries[destination_index].address == state.entries[source_index].address:
                            invalidate(state, QUALITY_IDENTITY)
                            return false
            for index in 0..<state.entries.count |state, parent, child|:
                if state.entries[index].arena == child:
                    state.entries[index].arena <- parent
                    # A retired source cannot be consumed as a pending realloc
                    # after crossing an ownership boundary without more evidence.
                    state.entries[index].released <- false
            return true

        # Release a verified half-open region/suffix range. The caller owns
        # region-layout validation; never derive this range from a header size.
        # A live allocation crossing either boundary means the evidence cannot
        # describe whole logical lifetimes. Reject before releasing any entry.
        def observe_range_release(state: mutable State&, arena: u64, start: u64, stop: u64) -> bool can[Abort.Panic]:
            return false if state.quality != QUALITY_EXACT
            if arena == ZERO or stop < start:
                invalidate(state, QUALITY_IDENTITY)
                return false
            return true if start == stop
            for index in 0..<state.entries.count |state, arena, start, stop|:
                if state.entries[index].arena == arena and state.entries[index].live:
                    address: u64 = state.entries[index].address
                    size: u64 = state.entries[index].size_bytes
                    if address < start:
                        if size > start - address:
                            invalidate(state, QUALITY_SIZE_MISMATCH)
                            return false
                    elif address < stop and size > stop - address:
                        invalidate(state, QUALITY_SIZE_MISMATCH)
                        return false
            for index in 0..<state.entries.count |state, arena, start, stop|:
                if state.entries[index].arena == arena:
                    address: u64 = state.entries[index].address
                    if address >= start and address < stop:
                        if state.entries[index].live:
                            state.live_bytes <- state.live_bytes - state.entries[index].size_bytes
                            state.entries[index].live <- false
                        state.entries[index].released <- false
                    elif address < start and state.entries[index].size_bytes > start - address:
                        state.entries[index].released <- false
            return true

        # Empty and repeated resets are valid. This is a logical release, not
        # a claim that the arena returned its backing memory to the OS.
        def observe_arena_reset(state: mutable State&, arena: u64) -> void can[Abort.Panic]:
            return if state.quality != QUALITY_EXACT
            if arena == ZERO:
                invalidate(state, QUALITY_IDENTITY)
                return
            for index in 0..<state.entries.count |state, arena|:
                if state.entries[index].arena == arena:
                    if state.entries[index].live:
                        state.live_bytes <- state.live_bytes - state.entries[index].size_bytes
                        state.entries[index].live <- false
                    state.entries[index].released <- false
