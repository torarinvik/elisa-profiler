# Native collector protocol decoding for the Elisa profiler.
#
# The decoder is private to ProfilerNative. It normalizes the versioned wire
# records into bounded JSON fragments consumed by the aggregation/rendering layer.
extend ProfilerNative:
    private:
        def line_prefix(data: darray[u8]&, start: usize, stop: usize, prefix: sview) -> bool can[Abort.Panic]:
            prefix_length: usize = profiler_ffi_sview_len(prefix)
            false return if start + prefix_length > stop
            for index in 0..<prefix_length |data, prefix|:
                false return if data[start + index] != profiler_ffi_sview_at(prefix, index)
            return true


        def protocol_field_into(data: darray[u8]&, start: usize, stop: usize, destination: mutable darray[u8]&) -> usize can[Abort.Panic, Memory.Allocate]:
            field_end: mutable usize = start
            while field_end < stop |field_end, data|:
                break if data[field_end] == NATIVE_BYTE_TAB
                field_end <- field_end + NATIVE_ONE.usize()
            for index in start..<field_end |destination, data|:
                destination.push(data[index])
            return field_end + NATIVE_ONE.usize() if field_end < stop and data[field_end] == NATIVE_BYTE_TAB else field_end


        def protocol_remaining_field_count(data: darray[u8]&, start: usize, stop: usize) -> usize:
            count: mutable usize = NATIVE_ZERO.usize()
            cursor: mutable usize = start
            while cursor < stop |count, cursor, data|:
                count <- count + NATIVE_ONE.usize()
                while cursor < stop |cursor, data|:
                    break if data[cursor] == NATIVE_BYTE_TAB
                    cursor <- cursor + NATIVE_ONE.usize()
                cursor <- cursor + NATIVE_ONE.usize() if cursor < stop
            return count


        def protocol_field_is(value: darray[u8]&, expected: sview) -> bool can[Abort.Panic]:
            false return if value.count != profiler_ffi_sview_len(expected)
            for index in 0..<value.count |value, expected|:
                false return if value[index] != profiler_ffi_sview_at(expected, index)
            return true


        def protocol_unsigned(value: darray[u8]&) -> bool can[Abort.Panic]:
            false return if value.count == NATIVE_ZERO.usize()
            false return if value.count > NATIVE_ONE.usize() and value[NATIVE_ZERO.usize()] == NATIVE_BYTE_ASCII_ZERO
            parsed: mutable i64 = NATIVE_ZERO
            for index in 0..<value.count |value, parsed|:
                false return if value[index] < NATIVE_BYTE_ASCII_ZERO or value[index] > NATIVE_BYTE_ASCII_NINE
                digit: i64 = (value[index] - NATIVE_BYTE_ASCII_ZERO).i64()
                false return if parsed > (NATIVE_I64_MAX - digit) / NATIVE_DECIMAL_BASE
                parsed <- parsed * NATIVE_DECIMAL_BASE + digit
            return true


        def protocol_unsigned_u64(value: darray[u8]&) -> bool can[Abort.Panic]:
            false return if value.count == NATIVE_ZERO.usize()
            false return if value.count > NATIVE_ONE.usize() and value[NATIVE_ZERO.usize()] == NATIVE_BYTE_ASCII_ZERO
            parsed: mutable u64 = NATIVE_ZERO.u64()
            for index in 0..<value.count |value, parsed|:
                false return if value[index] < NATIVE_BYTE_ASCII_ZERO or value[index] > NATIVE_BYTE_ASCII_NINE
                digit: u64 = (value[index] - NATIVE_BYTE_ASCII_ZERO).u64()
                false return if parsed > (NATIVE_U64_MAX - digit) / NATIVE_DECIMAL_BASE.u64()
                parsed <- parsed * NATIVE_DECIMAL_BASE.u64() + digit
            return true


        def protocol_u64_number_field(value: darray[u8]&) -> u64 can[Abort.Panic]:
            return NATIVE_ZERO.u64() if not protocol_unsigned_u64(value)
            result: mutable u64 = NATIVE_ZERO.u64()
            for index in 0..<value.count |result, value|:
                result <- result * NATIVE_DECIMAL_BASE.u64() + (value[index] - NATIVE_BYTE_ASCII_ZERO).u64()
            return result


        def protocol_identity_path(value: darray[u8]&) -> bool can[Abort.Panic]:
            false return if value.count == NATIVE_ZERO.usize()
            digits: mutable usize = NATIVE_ZERO.usize()
            for index in 0..<value.count |value, digits|:
                if value[index] == NATIVE_BYTE_SEMICOLON:
                    false return if digits == NATIVE_ZERO.usize()
                    digits <- NATIVE_ZERO.usize()
                else:
                    false return if value[index] < NATIVE_BYTE_ASCII_ZERO or value[index] > NATIVE_BYTE_ASCII_NINE
                    digits <- digits + NATIVE_ONE.usize()
            return digits > NATIVE_ZERO.usize()


        def frame_checksum(data: darray[u8]&, start: usize, stop: usize) -> u64 can[Abort.Panic]:
            checksum: mutable u64 = NATIVE_FRAME_FNV_OFFSET
            for index in start..<stop |checksum, data|:
                checksum <- (checksum ^ data[index].u64()) * NATIVE_FRAME_FNV_PRIME
            return checksum


        def frame_tail_is_incomplete(frame_length: i64, frame_cursor: usize, line_stop: usize, checksum_field: darray[u8]&) -> bool can[Abort.Panic]:
            # Recovery may ignore an actually incomplete final frame, but it must
            # reject a complete frame whose checksum, length, or other integrity
            # fields disagree. A missing/invalid header field is still recoverable
            # because there is no complete frame boundary to trust.
            return false if frame_length > NATIVE_MAX_PROTOCOL_FRAME_BYTES.i64()
            return true if frame_length < NATIVE_ZERO
            return true if frame_cursor > line_stop
            return true if not protocol_unsigned_u64(checksum_field)
            available_payload: i64 = (line_stop - frame_cursor).i64()
            return true if frame_length > available_payload
            return false


        def protocol_signed(value: darray[u8]&, allow_overflow: bool) -> bool can[Abort.Panic]:
            return true if allow_overflow and protocol_field_is(value, "overflow")
            false return if value.count == NATIVE_ZERO.usize()
            start: mutable usize = NATIVE_ZERO.usize()
            negative: mutable bool = false
            if value[NATIVE_ZERO.usize()] == NATIVE_BYTE_MINUS:
                negative <- true
                start <- NATIVE_ONE.usize()
            false return if start == value.count
            false return if value.count - start > NATIVE_ONE.usize() and value[start] == NATIVE_BYTE_ASCII_ZERO
            parsed: mutable i64 = NATIVE_ZERO
            for index in start..<value.count |value, parsed, negative|:
                false return if value[index] < NATIVE_BYTE_ASCII_ZERO or value[index] > NATIVE_BYTE_ASCII_NINE
                digit: i64 = (value[index] - NATIVE_BYTE_ASCII_ZERO).i64()
                permits_signed_minimum: bool = negative and index + NATIVE_ONE.usize() == value.count and parsed == NATIVE_I64_MAX / NATIVE_DECIMAL_BASE and digit == NATIVE_ONE + NATIVE_I64_MAX % NATIVE_DECIMAL_BASE
                false return if parsed > (NATIVE_I64_MAX - digit) / NATIVE_DECIMAL_BASE and not permits_signed_minimum
                parsed <- parsed * NATIVE_DECIMAL_BASE + digit if not permits_signed_minimum
            return true


        def append_record_separator(records: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            records.push(NATIVE_BYTE_COMMA) if records.count > NATIVE_ZERO.usize()


        def append_folded_separator(records: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            records.push(NATIVE_BYTE_NEWLINE) if records.count > NATIVE_ZERO.usize()


        def append_protocol_number(records: mutable darray[u8]&, value: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            records.extend(value)


        def protocol_record_limit_reached(summary: mutable CaptureSummary&, count: i64, error_code: i64, limit: i64) -> bool:
            return false if count < limit
            summary.malformed <- true
            summary.malformed_code <- error_code
            return true


        def protocol_number_field(value: darray[u8]&) -> i64 can[Abort.Panic]:
            return NATIVE_NEGATIVE_ONE if not protocol_unsigned(value)
            result: mutable i64 = NATIVE_ZERO
            for index in 0..<value.count |result, value|:
                result <- result * NATIVE_DECIMAL_BASE + (value[index] - NATIVE_BYTE_ASCII_ZERO).i64()
            return result


        def append_location_record(summary: mutable CaptureSummary&, location_records: mutable darray[u8]&, function_records: mutable darray[u8]&, data: darray[u8]&, cursor: mutable usize&, stop: usize, source: darray[u8]&, path_maps: darray[NativePathMap]&, source_map_data: darray[u8]&, source_map_flat_lines: darray[i64]&, source_map_source_lines: darray[i64]&, repetition: i64) -> void can[Abort.Panic, Memory.Allocate]:
            return if protocol_record_limit_reached(summary, summary.location_record_count, NATIVE_PROTOCOL_ERROR_LOCATION, NATIVE_MAX_PROTOCOL_DETAIL_RECORDS)
            kind_field: mutable darray[u8] = []
            function_field: mutable darray[u8] = []
            line_field: mutable darray[u8] = []
            count_field: mutable darray[u8] = []
            variable_field: mutable darray[u8] = []
            signed_field: mutable darray[u8] = []
            field_min: mutable darray[u8] = []
            field_max: mutable darray[u8] = []
            field_sum: mutable darray[u8] = []
            field_last: mutable darray[u8] = []
            field_interval: mutable darray[u8] = []
            field_max_interval: mutable darray[u8] = []
            identity_field: mutable darray[u8] = []
            cursor <- protocol_field_into(data, cursor, stop, &kind_field)
            cursor <- protocol_field_into(data, cursor, stop, &function_field)
            cursor <- protocol_field_into(data, cursor, stop, &line_field)
            cursor <- protocol_field_into(data, cursor, stop, &count_field)
            cursor <- protocol_field_into(data, cursor, stop, &variable_field)
            cursor <- protocol_field_into(data, cursor, stop, &signed_field)
            cursor <- protocol_field_into(data, cursor, stop, &field_min)
            cursor <- protocol_field_into(data, cursor, stop, &field_max)
            cursor <- protocol_field_into(data, cursor, stop, &field_sum)
            cursor <- protocol_field_into(data, cursor, stop, &field_last)
            cursor <- protocol_field_into(data, cursor, stop, &field_interval)
            cursor <- protocol_field_into(data, cursor, stop, &field_max_interval)
            if cursor < stop:
                cursor <- protocol_field_into(data, cursor, stop, &identity_field)
            if cursor != stop:
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_LOCATION
                return
            kind_name: mutable sview = ""
            if protocol_number_field(kind_field) == NATIVE_PROTOCOL_KIND_STATEMENT:
                kind_name <- "statement"
            elif protocol_number_field(kind_field) == NATIVE_PROTOCOL_KIND_VALUE:
                kind_name <- "value"
            elif protocol_number_field(kind_field) == NATIVE_PROTOCOL_KIND_FUNCTION:
                kind_name <- "function"
            else:
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_LOCATION
                return
            valid: mutable bool = function_field.count > NATIVE_ZERO.usize() and protocol_unsigned(line_field) and protocol_unsigned(count_field)
            valid <- valid and (identity_field.count == NATIVE_ZERO.usize() or protocol_unsigned_u64(identity_field))
            valid <- valid and (protocol_number_field(signed_field) == NATIVE_PROTOCOL_SIGNED_FALSE or protocol_number_field(signed_field) == NATIVE_PROTOCOL_SIGNED_TRUE)
            valid <- valid and protocol_unsigned(field_interval) and protocol_unsigned(field_max_interval)
            if kind_name == "function":
                valid <- valid and protocol_unsigned(field_min) and protocol_unsigned(field_max) and protocol_unsigned(field_sum) and protocol_unsigned(field_last)
            elif kind_name == "value":
                signed_value: bool = protocol_number_field(signed_field) == NATIVE_PROTOCOL_SIGNED_TRUE
                valid <- valid and protocol_signed(field_min, false) and protocol_signed(field_max, false)
                valid <- valid and protocol_signed(field_sum, true) and protocol_signed(field_last, false)
                valid <- valid and (protocol_field_is(variable_field, "-") or variable_field.count > NATIVE_ZERO.usize())
                if not signed_value:
                    valid <- valid and protocol_unsigned(field_min) and protocol_unsigned(field_max) and protocol_unsigned(field_last)
            else:
                valid <- valid and protocol_unsigned(field_min) and protocol_unsigned(field_max) and protocol_unsigned(field_sum) and protocol_unsigned(field_last)
            if valid:
                interval_number: i64 = protocol_number_field(field_interval)
                max_interval_number: i64 = protocol_number_field(field_max_interval)
                valid <- max_interval_number <= interval_number
                if kind_name == "function":
                    inclusive_number: i64 = protocol_number_field(field_min)
                    self_number: i64 = protocol_number_field(field_max)
                    completed_number: i64 = protocol_number_field(field_sum)
                    call_number: i64 = protocol_number_field(count_field)
                    valid <- valid and self_number <= inclusive_number and completed_number <= call_number
            if not valid:
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_LOCATION
                return

            append_record_separator(location_records)
            append_text(location_records, "{\"kind\":\"")
            append_text(location_records, kind_name)
            append_text(location_records, "\",\"function\":")
            append_json_string(location_records, function_field)
            append_text(location_records, ",\"repetition\":")
            append_i64(location_records, repetition)
            append_text(location_records, ",\"line\":")
            compiler_line_number: i64 = protocol_number_field(line_field)
            append_i64(location_records, source_map_line_for(source_map_flat_lines, source_map_source_lines, compiler_line_number))
            append_text(location_records, ",\"count\":")
            append_protocol_number(location_records, count_field)
            count_number: i64 = protocol_number_field(count_field)
            if kind_name == "statement":
                summary.statement_events <- native_saturating_add(summary.statement_events, count_number)
            elif kind_name == "value":
                summary.value_events <- native_saturating_add(summary.value_events, count_number)
            else:
                summary.function_events <- native_saturating_add(summary.function_events, count_number)
            summary.location_record_count <- native_saturating_add(summary.location_record_count, NATIVE_ONE)
            if source_map_flat_lines.count > NATIVE_ZERO.usize() and compiler_line_number < source_map_flat_lines[NATIVE_ZERO.usize()]:
                summary.source_mapping_unmapped <- native_saturating_add(summary.source_mapping_unmapped, NATIVE_ONE)
            else:
                summary.source_mapping_mapped <- native_saturating_add(summary.source_mapping_mapped, NATIVE_ONE)
            if kind_name == "value":
                append_text(location_records, ",\"variable\":")
                if protocol_field_is(variable_field, "-"):
                    append_text(location_records, "null")
                else:
                    append_json_string(location_records, variable_field)
                append_text(location_records, ",\"signed\":")
                append_text(location_records, "true" if protocol_number_field(signed_field) == NATIVE_PROTOCOL_SIGNED_TRUE else "false")
                append_text(location_records, ",\"minimum\":")
                append_protocol_number(location_records, field_min)
                append_text(location_records, ",\"maximum\":")
                append_protocol_number(location_records, field_max)
                append_text(location_records, ",\"sum\":")
                if protocol_field_is(field_sum, "overflow"):
                    append_text(location_records, "null,\"sum_overflow\":true")
                else:
                    append_protocol_number(location_records, field_sum)
                append_text(location_records, ",\"last\":")
                append_protocol_number(location_records, field_last)
            elif kind_name == "function":
                append_text(location_records, ",\"inclusive_ns\":")
                append_protocol_number(location_records, field_min)
                append_text(location_records, ",\"self_ns\":")
                append_protocol_number(location_records, field_max)
                append_text(location_records, ",\"completed_calls\":")
                append_protocol_number(location_records, field_sum)
            append_text(location_records, ",\"interval_ns\":")
            append_protocol_number(location_records, field_interval)
            append_text(location_records, ",\"max_interval_ns\":")
            append_protocol_number(location_records, field_max_interval)
            if identity_field.count > NATIVE_ZERO.usize() and protocol_u64_number_field(identity_field) != NATIVE_ZERO.u64():
                summary.stable_ids_available <- true
                append_text(location_records, ",\"identity_id\":")
                append_protocol_number(location_records, identity_field)
            append_text(location_records, ",\"compiler_line\":")
            append_protocol_number(location_records, line_field)
            append_text(location_records, ",\"source\":")
            mapped_source: darray[u8] = source_map_path_for(source_map_data, compiler_line_number)
            location_source: mutable darray[u8] = []
            if mapped_source.count == NATIVE_ZERO.usize():
                location_source.extend(source)
            else:
                location_source.extend(mapped_source)
            display_location_source: darray[u8] = native_remap_display_path(location_source, path_maps)
            append_json_string(location_records, display_location_source)
            append_text(location_records, ",\"source_text\":null")
            append_text(location_records, "}")
            if kind_name == "function":
                summary.function_record_count <- native_saturating_add(summary.function_record_count, NATIVE_ONE)
                append_record_separator(function_records)
                append_text(function_records, "{\"function\":")
                append_json_string(function_records, function_field)
                append_text(function_records, ",\"repetition\":")
                append_i64(function_records, repetition)
                append_text(function_records, ",\"events\":")
                append_protocol_number(function_records, count_field)
                append_text(function_records, ",\"statement_events\":")
                append_i64(function_records, NATIVE_ZERO)
                append_text(function_records, ",\"value_events\":")
                append_i64(function_records, NATIVE_ZERO)
                append_text(function_records, ",\"call_events\":")
                append_protocol_number(function_records, count_field)
                append_text(function_records, ",\"locations\":")
                append_i64(function_records, NATIVE_ONE)
                append_text(function_records, ",\"interval_ns\":")
                append_protocol_number(function_records, field_interval)
                append_text(function_records, ",\"max_interval_ns\":")
                append_protocol_number(function_records, field_max_interval)
                append_text(function_records, ",\"inclusive_ns\":")
                append_protocol_number(function_records, field_min)
                append_text(function_records, ",\"self_ns\":")
                append_protocol_number(function_records, field_max)
                append_text(function_records, ",\"completed_calls\":")
                append_protocol_number(function_records, field_sum)
                if identity_field.count > NATIVE_ZERO.usize() and protocol_u64_number_field(identity_field) != NATIVE_ZERO.u64():
                    append_text(function_records, ",\"identity_id\":")
                    append_protocol_number(function_records, identity_field)
                append_text(function_records, ",\"definitions\":[],\"mean_inclusive_ns\":")
                append_i64(function_records, NATIVE_ZERO)
                append_text(function_records, ",\"mean_self_ns\":")
                append_i64(function_records, NATIVE_ZERO)
                append_text(function_records, ",\"inclusive_percent\":")
                append_text(function_records, "null")
                append_text(function_records, ",\"self_percent\":")
                append_text(function_records, "null")
                append_text(function_records, "}")


        def append_call_record(summary: mutable CaptureSummary&, call_edge_records: mutable darray[u8]&, data: darray[u8]&, cursor: mutable usize&, stop: usize, repetition: i64) -> void can[Abort.Panic, Memory.Allocate]:
            return if protocol_record_limit_reached(summary, summary.call_edge_record_count, NATIVE_PROTOCOL_ERROR_CALL, NATIVE_MAX_PROTOCOL_DETAIL_RECORDS)
            caller_field: mutable darray[u8] = []
            callee_field: mutable darray[u8] = []
            calls_field: mutable darray[u8] = []
            completed_field: mutable darray[u8] = []
            inclusive_field: mutable darray[u8] = []
            caller_id_field: mutable darray[u8] = []
            callee_id_field: mutable darray[u8] = []
            cursor <- protocol_field_into(data, cursor, stop, &caller_field)
            cursor <- protocol_field_into(data, cursor, stop, &callee_field)
            cursor <- protocol_field_into(data, cursor, stop, &calls_field)
            cursor <- protocol_field_into(data, cursor, stop, &completed_field)
            cursor <- protocol_field_into(data, cursor, stop, &inclusive_field)
            if cursor < stop:
                cursor <- protocol_field_into(data, cursor, stop, &caller_id_field)
                if cursor < stop:
                    cursor <- protocol_field_into(data, cursor, stop, &callee_id_field)
            if cursor != stop:
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_CALL
                return
            if caller_field.count == NATIVE_ZERO.usize() or callee_field.count == NATIVE_ZERO.usize() or not protocol_unsigned(calls_field) or not protocol_unsigned(completed_field) or not protocol_unsigned(inclusive_field):
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_CALL
                return
            if caller_id_field.count != NATIVE_ZERO.usize() and (not protocol_unsigned_u64(caller_id_field) or callee_id_field.count == NATIVE_ZERO.usize() or not protocol_unsigned_u64(callee_id_field)):
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_CALL
                return
            call_number: i64 = protocol_number_field(calls_field)
            completed_number: i64 = protocol_number_field(completed_field)
            if completed_number > call_number:
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_CALL
                return
            append_record_separator(call_edge_records)
            append_text(call_edge_records, "{\"caller\":")
            append_json_string(call_edge_records, caller_field)
            append_text(call_edge_records, ",\"callee\":")
            append_json_string(call_edge_records, callee_field)
            append_text(call_edge_records, ",\"repetition\":")
            append_i64(call_edge_records, repetition)
            append_text(call_edge_records, ",\"call_events\":")
            append_protocol_number(call_edge_records, calls_field)
            append_text(call_edge_records, ",\"completed_calls\":")
            append_protocol_number(call_edge_records, completed_field)
            append_text(call_edge_records, ",\"inclusive_ns\":")
            append_protocol_number(call_edge_records, inclusive_field)
            if caller_id_field.count > NATIVE_ZERO.usize() and (protocol_u64_number_field(caller_id_field) != NATIVE_ZERO.u64() or protocol_u64_number_field(callee_id_field) != NATIVE_ZERO.u64()):
                summary.stable_ids_available <- true
                append_text(call_edge_records, ",\"caller_id\":")
                append_protocol_number(call_edge_records, caller_id_field)
                append_text(call_edge_records, ",\"callee_id\":")
                append_protocol_number(call_edge_records, callee_id_field)
            append_text(call_edge_records, "}")
            summary.call_edge_record_count <- native_saturating_add(summary.call_edge_record_count, NATIVE_ONE)


        def append_stack_record(summary: mutable CaptureSummary&, stack_records: mutable darray[u8]&, folded_records: mutable darray[u8]&, data: darray[u8]&, cursor: mutable usize&, stop: usize, repetition: i64, location_timing: bool) -> void can[Abort.Panic, Memory.Allocate]:
            return if protocol_record_limit_reached(summary, summary.stack_record_count, NATIVE_PROTOCOL_ERROR_STACK, NATIVE_MAX_PROTOCOL_DETAIL_RECORDS)
            stack_field: mutable darray[u8] = []
            calls_field: mutable darray[u8] = []
            completed_field: mutable darray[u8] = []
            self_field: mutable darray[u8] = []
            stack_ids_field: mutable darray[u8] = []
            cursor <- protocol_field_into(data, cursor, stop, &stack_field)
            cursor <- protocol_field_into(data, cursor, stop, &calls_field)
            cursor <- protocol_field_into(data, cursor, stop, &completed_field)
            cursor <- protocol_field_into(data, cursor, stop, &self_field)
            if cursor < stop:
                cursor <- protocol_field_into(data, cursor, stop, &stack_ids_field)
            if cursor != stop:
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_STACK
                return
            if stack_field.count == NATIVE_ZERO.usize() or not protocol_unsigned(calls_field) or not protocol_unsigned(completed_field) or not protocol_unsigned(self_field):
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_STACK
                return
            if stack_ids_field.count > NATIVE_ZERO.usize() and not protocol_identity_path(stack_ids_field):
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_STACK
                return
            call_number: i64 = protocol_number_field(calls_field)
            completed_number: i64 = protocol_number_field(completed_field)
            if completed_number > call_number:
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_STACK
                return
            append_record_separator(stack_records)
            append_text(stack_records, "{\"stack\":")
            append_json_string(stack_records, stack_field)
            append_text(stack_records, ",\"repetition\":")
            append_i64(stack_records, repetition)
            append_text(stack_records, ",\"call_events\":")
            append_protocol_number(stack_records, calls_field)
            append_text(stack_records, ",\"completed_calls\":")
            append_protocol_number(stack_records, completed_field)
            append_text(stack_records, ",\"self_ns\":")
            append_protocol_number(stack_records, self_field)
            if stack_ids_field.count > NATIVE_ZERO.usize():
                summary.stable_ids_available <- true
                append_text(stack_records, ",\"stack_ids\":")
                append_json_string(stack_records, stack_ids_field)
            append_text(stack_records, "}")
            folded_weight: i64 = protocol_number_field(self_field) if location_timing else protocol_number_field(calls_field)
            if folded_weight > NATIVE_ZERO:
                append_folded_separator(folded_records)
                for index in 0..<stack_field.count |folded_records, stack_field|:
                    folded_records.push(stack_field[index])
                folded_records.push(NATIVE_BYTE_SPACE)
                append_i64(folded_records, folded_weight)
            summary.stack_record_count <- native_saturating_add(summary.stack_record_count, NATIVE_ONE)


        def append_sample_record(summary: mutable CaptureSummary&, sample_records: mutable darray[u8]&, folded_records: mutable darray[u8]&, data: darray[u8]&, cursor: mutable usize&, stop: usize, repetition: i64) -> void can[Abort.Panic, Memory.Allocate]:
            return if protocol_record_limit_reached(summary, summary.sample_record_count, NATIVE_PROTOCOL_ERROR_SAMPLE, NATIVE_MAX_PROTOCOL_SAMPLE_RECORDS)
            sequence_field: mutable darray[u8] = []
            thread_field: mutable darray[u8] = []
            depth_field: mutable darray[u8] = []
            overflow_field: mutable darray[u8] = []
            stack_field: mutable darray[u8] = []
            cursor <- protocol_field_into(data, cursor, stop, &sequence_field)
            cursor <- protocol_field_into(data, cursor, stop, &thread_field)
            cursor <- protocol_field_into(data, cursor, stop, &depth_field)
            cursor <- protocol_field_into(data, cursor, stop, &overflow_field)
            cursor <- protocol_field_into(data, cursor, stop, &stack_field)
            valid: bool = cursor == stop and protocol_unsigned(sequence_field) and (protocol_field_is(thread_field, "-") or protocol_unsigned(thread_field)) and protocol_unsigned(depth_field) and protocol_unsigned(overflow_field) and (protocol_field_is(stack_field, "-") or stack_field.count > NATIVE_ZERO.usize())
            if not valid:
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_SAMPLE
                return
            depth: i64 = protocol_number_field(depth_field)
            overflow_depth: i64 = protocol_number_field(overflow_field)
            append_record_separator(sample_records)
            append_text(sample_records, "{\"sequence\":")
            append_protocol_number(sample_records, sequence_field)
            append_text(sample_records, ",\"thread_id\":")
            if protocol_field_is(thread_field, "-"):
                append_text(sample_records, "null")
            else:
                append_protocol_number(sample_records, thread_field)
            append_text(sample_records, ",\"depth\":")
            append_i64(sample_records, depth)
            append_text(sample_records, ",\"overflow_depth\":")
            append_i64(sample_records, overflow_depth)
            append_text(sample_records, ",\"stack\":")
            if protocol_field_is(stack_field, "-"):
                append_text(sample_records, "\"<root>\"")
            else:
                append_json_string(sample_records, stack_field)
            append_text(sample_records, ",\"repetition\":")
            append_i64(sample_records, repetition)
            append_text(sample_records, "}")
            append_folded_separator(folded_records)
            if protocol_field_is(stack_field, "-"):
                append_text(folded_records, "<root>")
            else:
                for index in 0..<stack_field.count |folded_records, stack_field|:
                    folded_records.push(stack_field[index])
            folded_records.push(NATIVE_BYTE_SPACE)
            append_i64(folded_records, NATIVE_ONE)
            summary.sample_record_count <- native_saturating_add(summary.sample_record_count, NATIVE_ONE)


        def append_event_record(summary: mutable CaptureSummary&, event_records: mutable darray[u8]&, data: darray[u8]&, cursor: mutable usize&, stop: usize, source: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            return if protocol_record_limit_reached(summary, summary.event_record_count, NATIVE_PROTOCOL_ERROR_EVENT, NATIVE_MAX_PROTOCOL_EVENT_RECORDS)
            sequence_field: mutable darray[u8] = []
            kind_field: mutable darray[u8] = []
            function_field: mutable darray[u8] = []
            line_field: mutable darray[u8] = []
            variable_field: mutable darray[u8] = []
            signed_field: mutable darray[u8] = []
            value_field: mutable darray[u8] = []
            identity_field: mutable darray[u8] = []
            thread_field: mutable darray[u8] = []
            timestamp_field: mutable darray[u8] = []
            cursor <- protocol_field_into(data, cursor, stop, &sequence_field)
            cursor <- protocol_field_into(data, cursor, stop, &kind_field)
            cursor <- protocol_field_into(data, cursor, stop, &function_field)
            cursor <- protocol_field_into(data, cursor, stop, &line_field)
            cursor <- protocol_field_into(data, cursor, stop, &variable_field)
            cursor <- protocol_field_into(data, cursor, stop, &signed_field)
            cursor <- protocol_field_into(data, cursor, stop, &value_field)
            optional_fields: usize = protocol_remaining_field_count(data, cursor, stop)
            if optional_fields == NATIVE_ONE.usize():
                cursor <- protocol_field_into(data, cursor, stop, &identity_field)
            elif optional_fields == NATIVE_THREE.usize():
                cursor <- protocol_field_into(data, cursor, stop, &identity_field)
                cursor <- protocol_field_into(data, cursor, stop, &thread_field)
                cursor <- protocol_field_into(data, cursor, stop, &timestamp_field)
            elif optional_fields != NATIVE_ZERO.usize():
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_EVENT
                return
            kind_name: mutable sview = ""
            if protocol_number_field(kind_field) == NATIVE_PROTOCOL_KIND_STATEMENT:
                kind_name <- "statement"
            elif protocol_number_field(kind_field) == NATIVE_PROTOCOL_KIND_VALUE:
                kind_name <- "value"
            elif protocol_number_field(kind_field) == NATIVE_PROTOCOL_KIND_FUNCTION:
                kind_name <- "function"
            else:
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_EVENT
                return
            signed_value: bool = protocol_number_field(signed_field) == NATIVE_PROTOCOL_SIGNED_TRUE
            valid: mutable bool = protocol_unsigned(sequence_field) and function_field.count > NATIVE_ZERO.usize() and protocol_unsigned(line_field)
            valid <- valid and (identity_field.count == NATIVE_ZERO.usize() or protocol_unsigned_u64(identity_field))
            valid <- valid and (thread_field.count == NATIVE_ZERO.usize() or protocol_unsigned_u64(thread_field))
            valid <- valid and (timestamp_field.count == NATIVE_ZERO.usize() or protocol_unsigned_u64(timestamp_field))
            valid <- valid and (protocol_number_field(signed_field) == NATIVE_PROTOCOL_SIGNED_FALSE or signed_value)
            valid <- valid and protocol_signed(value_field, false)
            if not signed_value:
                valid <- valid and protocol_unsigned(value_field)
            if not valid:
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_EVENT
                return
            append_record_separator(event_records)
            append_text(event_records, "{\"sequence\":")
            append_protocol_number(event_records, sequence_field)
            append_text(event_records, ",\"kind\":\"")
            append_text(event_records, kind_name)
            append_text(event_records, "\",\"function\":")
            append_json_string(event_records, function_field)
            append_text(event_records, ",\"line\":")
            append_protocol_number(event_records, line_field)
            append_text(event_records, ",\"variable\":")
            if protocol_field_is(variable_field, "-"):
                append_text(event_records, "null")
            else:
                append_json_string(event_records, variable_field)
            append_text(event_records, ",\"signed\":")
            append_text(event_records, "true" if signed_value else "false")
            append_text(event_records, ",\"value\":")
            append_protocol_number(event_records, value_field)
            if identity_field.count > NATIVE_ZERO.usize() and protocol_u64_number_field(identity_field) != NATIVE_ZERO.u64():
                summary.stable_ids_available <- true
                append_text(event_records, ",\"identity_id\":")
                append_protocol_number(event_records, identity_field)
            if thread_field.count > NATIVE_ZERO.usize():
                append_text(event_records, ",\"thread_id\":")
                append_protocol_number(event_records, thread_field)
                append_text(event_records, ",\"timestamp_ns\":")
                append_protocol_number(event_records, timestamp_field)
            append_text(event_records, ",\"compiler_line\":")
            append_protocol_number(event_records, line_field)
            append_text(event_records, ",\"source\":")
            append_json_string(event_records, source)
            append_text(event_records, ",\"source_text\":null")
            append_text(event_records, "}")
            summary.event_record_count <- native_saturating_add(summary.event_record_count, NATIVE_ONE)


        def append_thread_loss_record(summary: mutable CaptureSummary&, records: mutable darray[u8]&, data: darray[u8]&, cursor: mutable usize&, stop: usize, repetition: i64) -> void can[Abort.Panic, Memory.Allocate]:
            return if protocol_record_limit_reached(summary, summary.thread_loss_record_count, NATIVE_PROTOCOL_ERROR_THREAD, NATIVE_MAX_PROTOCOL_THREAD_RECORDS)
            thread_id: mutable darray[u8] = []
            events: mutable darray[u8] = []
            location_dropped: mutable darray[u8] = []
            call_edge_dropped: mutable darray[u8] = []
            stack_dropped: mutable darray[u8] = []
            trace_dropped: mutable darray[u8] = []
            bytes_dropped: mutable darray[u8] = []
            event_start: mutable darray[u8] = []
            event_end: mutable darray[u8] = []
            lifecycle_ended: mutable darray[u8] = []
            end_event: mutable darray[u8] = []
            cursor <- protocol_field_into(data, cursor, stop, &thread_id)
            cursor <- protocol_field_into(data, cursor, stop, &events)
            cursor <- protocol_field_into(data, cursor, stop, &location_dropped)
            cursor <- protocol_field_into(data, cursor, stop, &call_edge_dropped)
            cursor <- protocol_field_into(data, cursor, stop, &stack_dropped)
            cursor <- protocol_field_into(data, cursor, stop, &trace_dropped)
            cursor <- protocol_field_into(data, cursor, stop, &bytes_dropped)
            if cursor < stop:
                cursor <- protocol_field_into(data, cursor, stop, &event_start)
                cursor <- protocol_field_into(data, cursor, stop, &event_end)
            lifecycle_available: mutable bool = false
            if cursor < stop:
                cursor <- protocol_field_into(data, cursor, stop, &lifecycle_ended)
                cursor <- protocol_field_into(data, cursor, stop, &end_event)
                lifecycle_available <- true
            event_range_available: bool = event_start.count > NATIVE_ZERO.usize() and event_end.count > NATIVE_ZERO.usize() and not protocol_field_is(event_start, "-") and not protocol_field_is(event_end, "-")
            event_range_missing: bool = event_start.count == NATIVE_ZERO.usize() and event_end.count == NATIVE_ZERO.usize() or (protocol_field_is(event_start, "-") and protocol_field_is(event_end, "-"))
            valid: mutable bool = cursor == stop and protocol_unsigned(thread_id) and protocol_unsigned(events) and protocol_unsigned(location_dropped) and protocol_unsigned(call_edge_dropped) and protocol_unsigned(stack_dropped) and protocol_unsigned(trace_dropped) and protocol_unsigned(bytes_dropped)
            valid <- valid and (event_range_missing or event_range_available)
            valid <- valid and (not event_range_available or (protocol_unsigned(event_start) and protocol_unsigned(event_end) and protocol_number_field(event_start) <= protocol_number_field(event_end)))
            valid <- valid and (not lifecycle_available or (protocol_unsigned(lifecycle_ended) and (protocol_number_field(lifecycle_ended) == NATIVE_ZERO or protocol_number_field(lifecycle_ended) == NATIVE_ONE) and (protocol_field_is(end_event, "-") or protocol_unsigned(end_event))))
            valid <- valid and (not lifecycle_available or protocol_number_field(lifecycle_ended) == NATIVE_ZERO or protocol_unsigned(end_event))
            if not valid:
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_THREAD
                return
            append_record_separator(records)
            append_text(records, "{\"repetition\":")
            append_i64(records, repetition)
            append_text(records, ",\"thread_id\":")
            append_protocol_number(records, thread_id)
            append_text(records, ",\"events\":")
            append_protocol_number(records, events)
            append_text(records, ",\"location_dropped\":")
            append_protocol_number(records, location_dropped)
            append_text(records, ",\"call_edge_dropped\":")
            append_protocol_number(records, call_edge_dropped)
            append_text(records, ",\"stack_dropped\":")
            append_protocol_number(records, stack_dropped)
            append_text(records, ",\"trace_dropped\":")
            append_protocol_number(records, trace_dropped)
            append_text(records, ",\"bytes_dropped\":")
            append_protocol_number(records, bytes_dropped)
            append_text(records, ",\"event_start\":")
            if event_range_available:
                append_protocol_number(records, event_start)
            else:
                append_text(records, "null")
            append_text(records, ",\"event_end\":")
            if event_range_available:
                append_protocol_number(records, event_end)
            else:
                append_text(records, "null")
            if lifecycle_available:
                append_text(records, ",\"ended\":")
                append_text(records, "true" if protocol_number_field(lifecycle_ended) == NATIVE_ONE else "false")
                append_text(records, ",\"end_event\":")
                if protocol_field_is(end_event, "-"):
                    append_text(records, "null")
                else:
                    append_protocol_number(records, end_event)
            append_text(records, "}")
            summary.thread_loss_record_count <- native_saturating_add(summary.thread_loss_record_count, NATIVE_ONE)


        def parse_protocol_number(data: darray[u8]&, cursor: mutable usize&, stop: usize) -> i64:
            value: mutable i64 = NATIVE_ZERO
            valid: mutable bool = true
            digits: mutable usize = NATIVE_ZERO.usize()
            position: mutable usize = cursor
            number_start: usize = cursor
            while position < stop and data[position] != NATIVE_BYTE_TAB |position, value, valid, digits, data|:
                if data[position] < NATIVE_BYTE_ASCII_ZERO or data[position] > NATIVE_BYTE_ASCII_NINE:
                    valid <- false
                elif valid:
                    digit: i64 = (data[position] - NATIVE_BYTE_ASCII_ZERO).i64()
                    valid <- false if value > (NATIVE_I64_MAX - digit) / NATIVE_DECIMAL_BASE
                    value <- value * NATIVE_DECIMAL_BASE + digit if valid
                digits <- digits + NATIVE_ONE.usize()
                position <- position + NATIVE_ONE.usize()
            position <- position + NATIVE_ONE.usize() if position < stop and data[position] == NATIVE_BYTE_TAB
            cursor <- position
            return NATIVE_NEGATIVE_ONE if not valid or digits == NATIVE_ZERO.usize()
            return NATIVE_NEGATIVE_ONE if digits > NATIVE_ONE.usize() and data[number_start] == NATIVE_BYTE_ASCII_ZERO
            return value
        
        
        def parse_capture(data: darray[u8]&, source: darray[u8]&, path_maps: darray[NativePathMap]&, source_map_data: darray[u8]&, source_map_flat_lines: darray[i64]&, source_map_source_lines: darray[i64]&, allow_partial_tail: bool, repetition: i64, location_timing: bool) -> CaptureSummary:
            summary: mutable CaptureSummary = CaptureSummary{
                events: NATIVE_ZERO,
                locations: NATIVE_ZERO,
                statement_events: NATIVE_ZERO,
                value_events: NATIVE_ZERO,
                function_events: NATIVE_ZERO,
                location_record_count: NATIVE_ZERO,
                function_record_count: NATIVE_ZERO,
                call_edge_record_count: NATIVE_ZERO,
                stack_record_count: NATIVE_ZERO,
                event_record_count: NATIVE_ZERO,
                thread_loss_record_count: NATIVE_ZERO,
                sample_record_count: NATIVE_ZERO,
                dropped: NATIVE_ZERO,
                max_stack_depth: NATIVE_ZERO,
                stack_overflow_entries: NATIVE_ZERO,
                thread_count: NATIVE_ZERO,
                trace_enabled: NATIVE_ZERO,
                trace_captured: NATIVE_ZERO,
                trace_omitted: NATIVE_ZERO,
                trace_limit: NATIVE_ZERO,
                sample_count: NATIVE_ZERO,
                sample_missed: NATIVE_ZERO,
                sample_period_microseconds: NATIVE_ZERO,
                sampling_setup_failed: NATIVE_ZERO,
                collector_status: NATIVE_COLLECTOR_STATUS_UNKNOWN,
                source_mapping_available: source_map_flat_lines.count > NATIVE_ZERO.usize(),
                source_mapping_mapped: NATIVE_ZERO,
                source_mapping_unmapped: NATIVE_ZERO,
                location_limit: NATIVE_ZERO,
                call_edge_limit: NATIVE_ZERO,
                stack_limit: NATIVE_ZERO,
                capture_byte_limit: NATIVE_ZERO,
                capture_bytes_used: NATIVE_ZERO,
                capture_bytes_dropped: NATIVE_ZERO,
                frame_dropped: NATIVE_ZERO,
                valid_frames: NATIVE_ZERO,
                valid_capture_bytes: NATIVE_ZERO,
                budget_exceeded: NATIVE_ZERO,
                call_edge_dropped: NATIVE_ZERO,
                stack_dropped: NATIVE_ZERO,
                crash_signal: NATIVE_ZERO,
                stable_ids_available: false,
                active_stack_available: false,
                active_stack_tracked_depth: NATIVE_ZERO,
                active_stack_overflow_depth: NATIVE_ZERO,
                active_stack_path: [],
                capture_started: false,
                capture_complete: false,
                location_records: [],
                function_records: [],
                call_edge_records: [],
                stack_records: [],
                folded_records: [],
                event_records: [],
                thread_loss_records: [],
                sample_records: [],
                malformed: false,
                malformed_code: NATIVE_ZERO,
            }
            location_records: mutable darray[u8] = []
            function_records: mutable darray[u8] = []
            call_edge_records: mutable darray[u8] = []
            stack_records: mutable darray[u8] = []
            event_records: mutable darray[u8] = []
            thread_loss_records: mutable darray[u8] = []
            folded_records: mutable darray[u8] = []
            sample_records: mutable darray[u8] = []
            begin_prefix: sview = "ELISA_PROFILE\t1\tbegin\t"
            end_prefix: sview = "ELISA_PROFILE\t1\tend\t"
            meta_prefix: sview = "ELISA_PROFILE\t1\tmeta\t"
            trace_prefix: sview = "ELISA_PROFILE\t1\ttrace\t"
            thread_prefix: sview = "ELISA_PROFILE\t1\tthread\t"
            crash_prefix: sview = "ELISA_PROFILE\t1\tcrash\t"
            frame_prefix: sview = "ELISA_PROFILE\t1\tframe\t"
            extension_prefix: sview = "ELISA_PROFILE\t1\textension\t"
            sample_prefix: sview = "ELISA_PROFILE\t1\tsample\t"
            protocol_prefix: sview = "ELISA_PROFILE\t1\t"
            line_start: mutable usize = NATIVE_ZERO.usize()
            line_count: mutable usize = NATIVE_ZERO.usize()
            framed_capture: mutable bool = false
            next_frame_sequence: mutable i64 = NATIVE_ZERO
            while line_start < data.count |line_start, line_count, data, summary|:
                if line_count >= NATIVE_MAX_PROTOCOL_LINES:
                    summary.malformed <- true
                    summary.malformed_code <- NATIVE_PROTOCOL_ERROR_META
                    break
                line_count <- line_count + NATIVE_ONE.usize()
                line_stop: mutable usize = line_start
                while line_stop < data.count and data[line_stop] != NATIVE_BYTE_NEWLINE |line_stop, data|:
                    line_stop <- line_stop + NATIVE_ONE.usize()
                if line_stop - line_start > NATIVE_MAX_PROTOCOL_LINE_BYTES:
                    summary.malformed <- true
                    summary.malformed_code <- NATIVE_PROTOCOL_ERROR_META
                else:
                    record_start: mutable usize = line_start
                    frame_valid: mutable bool = true
                    if line_prefix(data, line_start, line_stop, frame_prefix):
                        framed_capture <- true
                        frame_cursor: mutable usize = line_start + profiler_ffi_sview_len(frame_prefix)
                        frame_sequence: i64 = parse_protocol_number(data, &frame_cursor, line_stop)
                        frame_length: i64 = parse_protocol_number(data, &frame_cursor, line_stop)
                        checksum_field: mutable darray[u8] = []
                        frame_cursor <- protocol_field_into(data, frame_cursor, line_stop, &checksum_field)
                        frame_valid <- frame_sequence == next_frame_sequence and frame_sequence >= NATIVE_ZERO
                        frame_valid <- frame_valid and frame_length >= NATIVE_ZERO and frame_length <= NATIVE_MAX_PROTOCOL_FRAME_BYTES.i64() and frame_cursor <= line_stop
                        frame_valid <- frame_valid and protocol_unsigned_u64(checksum_field)
                        frame_valid <- frame_valid and frame_length == (line_stop - frame_cursor).i64()
                        frame_valid <- frame_valid and frame_checksum(data, frame_cursor, line_stop) == protocol_u64_number_field(checksum_field)
                        if frame_valid:
                            if summary.valid_frames >= NATIVE_MAX_PROTOCOL_FRAMES:
                                summary.malformed <- true
                                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_FRAME
                                frame_valid <- false
                            else:
                                record_start <- frame_cursor
                                next_frame_sequence <- next_frame_sequence + NATIVE_ONE
                                summary.valid_frames <- summary.valid_frames + NATIVE_ONE
                                summary.valid_capture_bytes <- (line_stop + (NATIVE_ONE.usize() if line_stop < data.count else NATIVE_ZERO.usize())).i64()
                        else:
                            truncated_tail: bool = allow_partial_tail and line_stop == data.count and line_stop > line_start and frame_tail_is_incomplete(frame_length, frame_cursor, line_stop, checksum_field)
                            if truncated_tail:
                                break
                            next_line_start: usize = line_stop + NATIVE_ONE.usize()
                            next_line_stop: mutable usize = next_line_start
                            while next_line_stop < data.count and data[next_line_stop] != NATIVE_BYTE_NEWLINE |next_line_stop, data|:
                                next_line_stop <- next_line_stop + NATIVE_ONE.usize()
                            if not (framed_capture and next_line_start < data.count and line_prefix(data, next_line_start, next_line_stop, crash_prefix)):
                                summary.malformed <- true
                                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_FRAME
                    elif framed_capture and line_start != line_stop and not line_prefix(data, line_start, line_stop, crash_prefix):
                        frame_valid <- false
                        summary.malformed <- true
                        summary.malformed_code <- NATIVE_PROTOCOL_ERROR_FRAME
                    if frame_valid and line_prefix(data, record_start, line_stop, begin_prefix):
                        cursor: mutable usize = record_start + profiler_ffi_sview_len(begin_prefix)
                        marker: i64 = parse_protocol_number(data, &cursor, line_stop)
                        if cursor != line_stop or marker != NATIVE_ONE or line_count != NATIVE_ONE.usize() or summary.capture_started or summary.capture_complete:
                            summary.malformed <- true
                            summary.malformed_code <- NATIVE_PROTOCOL_ERROR_META
                        else:
                            summary.capture_started <- true
                    elif frame_valid and line_prefix(data, record_start, line_stop, end_prefix):
                        cursor: mutable usize = record_start + profiler_ffi_sview_len(end_prefix)
                        marker: i64 = parse_protocol_number(data, &cursor, line_stop)
                        if cursor != line_stop or marker != NATIVE_ONE or not summary.capture_started or summary.capture_complete:
                            summary.malformed <- true
                            summary.malformed_code <- NATIVE_PROTOCOL_ERROR_META
                        else:
                            summary.capture_complete <- true
                    elif frame_valid and summary.capture_complete and line_prefix(data, record_start, line_stop, protocol_prefix):
                        summary.malformed <- true
                        summary.malformed_code <- NATIVE_PROTOCOL_ERROR_META
                    elif frame_valid and line_prefix(data, record_start, line_stop, meta_prefix):
                        cursor: mutable usize = record_start + profiler_ffi_sview_len(meta_prefix)
                        summary.events <- parse_protocol_number(data, &cursor, line_stop)
                        summary.locations <- parse_protocol_number(data, &cursor, line_stop)
                        summary.dropped <- parse_protocol_number(data, &cursor, line_stop)
                        summary.max_stack_depth <- parse_protocol_number(data, &cursor, line_stop)
                        summary.stack_overflow_entries <- parse_protocol_number(data, &cursor, line_stop)
                        summary.thread_count <- parse_protocol_number(data, &cursor, line_stop)
                        summary.location_limit <- parse_protocol_number(data, &cursor, line_stop)
                        summary.call_edge_limit <- parse_protocol_number(data, &cursor, line_stop)
                        summary.stack_limit <- parse_protocol_number(data, &cursor, line_stop)
                        summary.budget_exceeded <- parse_protocol_number(data, &cursor, line_stop)
                        summary.call_edge_dropped <- parse_protocol_number(data, &cursor, line_stop)
                        summary.stack_dropped <- parse_protocol_number(data, &cursor, line_stop)
                        if cursor < line_stop:
                            summary.capture_byte_limit <- parse_protocol_number(data, &cursor, line_stop)
                            summary.capture_bytes_used <- parse_protocol_number(data, &cursor, line_stop)
                            summary.capture_bytes_dropped <- parse_protocol_number(data, &cursor, line_stop)
                        if framed_capture and cursor < line_stop:
                            summary.frame_dropped <- parse_protocol_number(data, &cursor, line_stop)
                        if cursor < line_stop:
                            summary.sample_count <- parse_protocol_number(data, &cursor, line_stop)
                        if cursor < line_stop:
                            summary.sample_missed <- parse_protocol_number(data, &cursor, line_stop)
                        if cursor < line_stop:
                            summary.sample_period_microseconds <- parse_protocol_number(data, &cursor, line_stop)
                        if cursor < line_stop:
                            summary.sampling_setup_failed <- parse_protocol_number(data, &cursor, line_stop)
                        if cursor != line_stop:
                            summary.malformed <- true
                            summary.malformed_code <- NATIVE_PROTOCOL_ERROR_META
                        if summary.events < NATIVE_ZERO or summary.locations < NATIVE_ZERO or summary.dropped < NATIVE_ZERO or summary.max_stack_depth < NATIVE_ZERO or summary.stack_overflow_entries < NATIVE_ZERO or summary.thread_count < NATIVE_ZERO or summary.location_limit < NATIVE_ZERO or summary.call_edge_limit < NATIVE_ZERO or summary.stack_limit < NATIVE_ZERO or summary.budget_exceeded < NATIVE_ZERO or summary.call_edge_dropped < NATIVE_ZERO or summary.stack_dropped < NATIVE_ZERO or summary.capture_byte_limit < NATIVE_ZERO or summary.capture_bytes_used < NATIVE_ZERO or summary.capture_bytes_dropped < NATIVE_ZERO or summary.frame_dropped < NATIVE_ZERO or summary.sample_count < NATIVE_ZERO or summary.sample_missed < NATIVE_ZERO or summary.sample_period_microseconds < NATIVE_ZERO or summary.sampling_setup_failed < NATIVE_ZERO:
                            summary.malformed <- true
                            summary.malformed_code <- NATIVE_PROTOCOL_ERROR_META
                    elif frame_valid and line_prefix(data, record_start, line_stop, trace_prefix):
                        cursor: mutable usize = record_start + profiler_ffi_sview_len(trace_prefix)
                        summary.trace_enabled <- parse_protocol_number(data, &cursor, line_stop)
                        summary.trace_captured <- parse_protocol_number(data, &cursor, line_stop)
                        summary.trace_omitted <- parse_protocol_number(data, &cursor, line_stop)
                        summary.trace_limit <- parse_protocol_number(data, &cursor, line_stop)
                        if cursor != line_stop:
                            summary.malformed <- true
                            summary.malformed_code <- NATIVE_PROTOCOL_ERROR_META
                        if summary.trace_enabled < NATIVE_ZERO or summary.trace_captured < NATIVE_ZERO or summary.trace_omitted < NATIVE_ZERO or summary.trace_limit < NATIVE_ZERO:
                            summary.malformed <- true
                            summary.malformed_code <- NATIVE_PROTOCOL_ERROR_META
                    elif frame_valid and line_prefix(data, record_start, line_stop, thread_prefix):
                        cursor: mutable usize = record_start + profiler_ffi_sview_len(thread_prefix)
                        append_thread_loss_record(&summary, &thread_loss_records, data, &cursor, line_stop, repetition)
                    elif frame_valid and line_prefix(data, record_start, line_stop, crash_prefix):
                        cursor: mutable usize = record_start + profiler_ffi_sview_len(crash_prefix)
                        summary.crash_signal <- parse_protocol_number(data, &cursor, line_stop)
                        if cursor < line_stop:
                            summary.active_stack_tracked_depth <- parse_protocol_number(data, &cursor, line_stop)
                            summary.active_stack_overflow_depth <- parse_protocol_number(data, &cursor, line_stop)
                            summary.active_stack_path <- []
                            cursor <- protocol_field_into(data, cursor, line_stop, &summary.active_stack_path)
                            summary.active_stack_available <- summary.active_stack_tracked_depth >= NATIVE_ZERO and summary.active_stack_overflow_depth >= NATIVE_ZERO and summary.active_stack_path.count > NATIVE_ZERO.usize()
                        if cursor != line_stop:
                            summary.malformed <- true
                            summary.malformed_code <- NATIVE_PROTOCOL_ERROR_META
                        if summary.crash_signal < NATIVE_ZERO or (summary.active_stack_available == false and cursor != record_start + profiler_ffi_sview_len(crash_prefix)):
                            summary.malformed <- true
                            summary.malformed_code <- NATIVE_PROTOCOL_ERROR_META
                    elif frame_valid and line_prefix(data, record_start, line_stop, "ELISA_PROFILE\t1\tlocation\t"):
                        cursor: mutable usize = record_start + profiler_ffi_sview_len("ELISA_PROFILE\t1\tlocation\t")
                        append_location_record(&summary, &location_records, &function_records, data, &cursor, line_stop, source, path_maps, source_map_data, source_map_flat_lines, source_map_source_lines, repetition)
                    elif frame_valid and line_prefix(data, record_start, line_stop, "ELISA_PROFILE\t1\tcall\t"):
                        cursor: mutable usize = record_start + profiler_ffi_sview_len("ELISA_PROFILE\t1\tcall\t")
                        append_call_record(&summary, &call_edge_records, data, &cursor, line_stop, repetition)
                    elif frame_valid and line_prefix(data, record_start, line_stop, "ELISA_PROFILE\t1\tstack\t"):
                        cursor: mutable usize = record_start + profiler_ffi_sview_len("ELISA_PROFILE\t1\tstack\t")
                        append_stack_record(&summary, &stack_records, &folded_records, data, &cursor, line_stop, repetition, location_timing)
                    elif frame_valid and line_prefix(data, record_start, line_stop, sample_prefix):
                        cursor: mutable usize = record_start + profiler_ffi_sview_len(sample_prefix)
                        append_sample_record(&summary, &sample_records, &folded_records, data, &cursor, line_stop, repetition)
                    elif frame_valid and line_prefix(data, record_start, line_stop, "ELISA_PROFILE\t1\tpath\t"):
                        cursor: mutable usize = record_start + profiler_ffi_sview_len("ELISA_PROFILE\t1\tpath\t")
                        append_event_record(&summary, &event_records, data, &cursor, line_stop, source)
                    elif frame_valid and line_prefix(data, record_start, line_stop, extension_prefix):
                        # Extensions are transport-level records. Their framing,
                        # sequence, length, and checksum have already been
                        # validated above; an older profiler deliberately ignores
                        # the payload while preserving the surrounding evidence.
                        pass
                    elif frame_valid and line_prefix(data, record_start, line_stop, protocol_prefix):
                        summary.malformed <- true
                        summary.malformed_code <- NATIVE_PROTOCOL_ERROR_META
                line_start <- line_stop + NATIVE_ONE.usize()
            summary.location_records <- location_records
            summary.function_records <- function_records
            summary.call_edge_records <- call_edge_records
            summary.stack_records <- stack_records
            summary.folded_records <- folded_records
            summary.event_records <- event_records
            summary.thread_loss_records <- thread_loss_records
            summary.sample_records <- sample_records
            return summary
