# Self-contained SHA-256 for reproducible workload provenance.
#
# This private module deliberately hashes bytes already owned by the native
# profiler. It keeps source/stdin identity independent of external scripts and
# command-line hashing tools.
extend ProfilerNative:
    private:
        const SHA256_MESSAGE_WORDS: usize = 16
        const SHA256_SCHEDULE_START: usize = 16
        const SHA256_SCHEDULE_OFFSET_TWO: usize = 2
        const SHA256_SCHEDULE_OFFSET_SEVEN: usize = 7
        const SHA256_SCHEDULE_OFFSET_FIFTEEN: usize = 15
        const SHA256_SCHEDULE_OFFSET_SIXTEEN: usize = 16
        const SHA256_HEX_DIGITS_PER_WORD: usize = 8
        const SHA256_HEX_LAST_INDEX: usize = 7
        const SHA256_HEX_BITS_PER_DIGIT: usize = 4
        const SHA256_DECIMAL_DIGITS: u32 = 10
        const SHA256_PADDING_BYTE: u8 = 128
        const SHA256_BYTE_BITS: usize = 8
        const SHA256_BYTE_MASK: u32 = 255
        const SHA256_HEX_MASK: u32 = 15
        const SHA256_WORD_SHIFT_24: u32 = 24
        const SHA256_WORD_SHIFT_16: u32 = 16
        const SHA256_WORD_SHIFT_8: u32 = 8
        const SHA256_ROTATE_ZERO_A: u32 = 2
        const SHA256_ROTATE_ZERO_B: u32 = 13
        const SHA256_ROTATE_ZERO_C: u32 = 22
        const SHA256_ROTATE_ONE_A: u32 = 6
        const SHA256_ROTATE_ONE_B: u32 = 11
        const SHA256_ROTATE_ONE_C: u32 = 25
        const SHA256_SMALL_ZERO_A: u32 = 7
        const SHA256_SMALL_ZERO_B: u32 = 18
        const SHA256_SMALL_ZERO_SHIFT: u32 = 3
        const SHA256_SMALL_ONE_A: u32 = 17
        const SHA256_SMALL_ONE_B: u32 = 19
        const SHA256_SMALL_ONE_SHIFT: u32 = 10

        def sha256_rotate_right(value: u32, amount: u32) -> u32:
            return (value >> amount) | (value << (NATIVE_SHA256_WORD_BITS - amount))


        def sha256_small_sigma_zero(value: u32) -> u32:
            return sha256_rotate_right(value, SHA256_SMALL_ZERO_A) ^ sha256_rotate_right(value, SHA256_SMALL_ZERO_B) ^ (value >> SHA256_SMALL_ZERO_SHIFT)


        def sha256_small_sigma_one(value: u32) -> u32:
            return sha256_rotate_right(value, SHA256_SMALL_ONE_A) ^ sha256_rotate_right(value, SHA256_SMALL_ONE_B) ^ (value >> SHA256_SMALL_ONE_SHIFT)


        def sha256_big_sigma_zero(value: u32) -> u32:
            return sha256_rotate_right(value, SHA256_ROTATE_ZERO_A) ^ sha256_rotate_right(value, SHA256_ROTATE_ZERO_B) ^ sha256_rotate_right(value, SHA256_ROTATE_ZERO_C)


        def sha256_big_sigma_one(value: u32) -> u32:
            return sha256_rotate_right(value, SHA256_ROTATE_ONE_A) ^ sha256_rotate_right(value, SHA256_ROTATE_ONE_B) ^ sha256_rotate_right(value, SHA256_ROTATE_ONE_C)


        def sha256_choose(left: u32, middle: u32, right: u32) -> u32:
            return (left & middle) ^ ((~left) & right)


        def sha256_majority(left: u32, middle: u32, right: u32) -> u32:
            return (left & middle) ^ (left & right) ^ (middle & right)


        def sha256_hex_digit(value: u32) -> u8:
            return (NATIVE_BYTE_ASCII_ZERO.i64() + value.i64()).u8() if value < SHA256_DECIMAL_DIGITS else (NATIVE_BYTE_ASCII_LOWER_A.i64() + value.i64() - SHA256_DECIMAL_DIGITS.i64()).u8()


        def sha256_hex(data: darray[u8]) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
            round_constants: darray[u32] = [
                0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
                0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
                0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
                0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
                0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
                0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
                0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
                0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
                0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
                0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
                0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
                0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
                0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
                0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
                0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
                0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
            ]
            padded: mutable darray[u8] = []
            padded.extend(data)
            padded.push(SHA256_PADDING_BYTE)
            while (padded.count + NATIVE_SHA256_LENGTH_BYTES) % NATIVE_SHA256_BLOCK_BYTES != NATIVE_ZERO.usize() |padded|:
                padded.push(NATIVE_BYTE_NUL)
            bit_length: u64 = data.count.u64() * SHA256_BYTE_BITS.u64()
            for length_index in 0..<NATIVE_SHA256_LENGTH_BYTES |padded, bit_length|:
                shift: u32 = ((NATIVE_SHA256_LENGTH_BYTES - NATIVE_ONE.usize() - length_index) * SHA256_BYTE_BITS).u32()
                padded.push(((bit_length >> shift) & SHA256_BYTE_MASK.u64()).u8())

            state: mutable darray[u32] = [
                0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
                0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
            ]
            block_start: mutable usize = NATIVE_ZERO.usize()
            while block_start < padded.count |block_start, padded, state, round_constants|:
                schedule: mutable darray[u32] = []
                for word_index in 0..<SHA256_MESSAGE_WORDS |schedule, padded, block_start|:
                    byte_index: usize = block_start + word_index * NATIVE_SHA256_WORD_BYTES
                    word: u32 = (padded[byte_index].u32() << SHA256_WORD_SHIFT_24) | (padded[byte_index + NATIVE_ONE.usize()].u32() << SHA256_WORD_SHIFT_16) | (padded[byte_index + NATIVE_TWO.usize()].u32() << SHA256_WORD_SHIFT_8) | padded[byte_index + NATIVE_THREE.usize()].u32()
                    schedule.push(word)
                for word_index in SHA256_SCHEDULE_START..<NATIVE_SHA256_ROUNDS |schedule|:
                    schedule.push(sha256_small_sigma_one(schedule[word_index - SHA256_SCHEDULE_OFFSET_TWO]) + schedule[word_index - SHA256_SCHEDULE_OFFSET_SEVEN] + sha256_small_sigma_zero(schedule[word_index - SHA256_SCHEDULE_OFFSET_FIFTEEN]) + schedule[word_index - SHA256_SCHEDULE_OFFSET_SIXTEEN])
                a: mutable u32 = state[0]
                b: mutable u32 = state[1]
                c: mutable u32 = state[2]
                d: mutable u32 = state[3]
                e: mutable u32 = state[4]
                f: mutable u32 = state[5]
                g: mutable u32 = state[6]
                h: mutable u32 = state[7]
                for round_index in 0..<NATIVE_SHA256_ROUNDS |a, b, c, d, e, f, g, h, schedule, round_constants|:
                    temporary_one: u32 = h + sha256_big_sigma_one(e) + sha256_choose(e, f, g) + round_constants[round_index] + schedule[round_index]
                    temporary_two: u32 = sha256_big_sigma_zero(a) + sha256_majority(a, b, c)
                    h <- g
                    g <- f
                    f <- e
                    e <- d + temporary_one
                    d <- c
                    c <- b
                    b <- a
                    a <- temporary_one + temporary_two
                state[0] <- state[0] + a
                state[1] <- state[1] + b
                state[2] <- state[2] + c
                state[3] <- state[3] + d
                state[4] <- state[4] + e
                state[5] <- state[5] + f
                state[6] <- state[6] + g
                state[7] <- state[7] + h
                block_start <- block_start + NATIVE_SHA256_BLOCK_BYTES

            result: mutable darray[u8] = []
            for word_index in 0..<NATIVE_SHA256_DIGEST_WORDS |result, state|:
                word: u32 = state[word_index]
                for nibble_index in 0..<SHA256_HEX_DIGITS_PER_WORD |result, word|:
                    shift: u32 = ((SHA256_HEX_LAST_INDEX - nibble_index) * SHA256_HEX_BITS_PER_DIGIT).u32()
                    result.push(sha256_hex_digit((word >> shift) & SHA256_HEX_MASK))
            return result
