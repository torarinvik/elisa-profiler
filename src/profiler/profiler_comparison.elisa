# Baseline/candidate comparison policy and output for the Elisa profiler.
#
# Comparison is private to ProfilerNative and consumes the validated capture model;
# it never compares raw protocol or JSON text directly.
extend ProfilerNative:
    private:
        def comparison_policy_requested(policy: ComparisonPolicy) -> bool:
            return policy.max_wall_regression_percent >= NATIVE_ZERO or policy.max_wall_micros >= NATIVE_ZERO or policy.max_cpu_regression_percent >= NATIVE_ZERO or policy.max_cpu_micros >= NATIVE_ZERO or policy.max_rss_regression_percent >= NATIVE_ZERO or policy.max_rss_bytes >= NATIVE_ZERO or policy.max_function_self_regression_percent >= NATIVE_ZERO


        def comparison_percent_exceeded(baseline: i64, candidate: i64, percent: i64, available: bool) -> bool:
            return false if not available or percent < NATIVE_ZERO
            allowed_delta: i64 = native_saturating_mul_nonnegative(baseline, percent) / NATIVE_PERCENT_DENOMINATOR
            allowed_value: i64 = native_saturating_add(baseline, allowed_delta)
            return candidate > allowed_value


        def comparison_absolute_exceeded(candidate: i64, maximum: i64, available: bool) -> bool:
            return available and maximum >= NATIVE_ZERO and candidate > maximum


        def comparison_function_self_exceeded(baseline: darray[ComparisonFunctionRecord]&, candidate: darray[ComparisonFunctionRecord]&, percent: i64) -> bool can[Abort.Panic]:
            return false if percent < NATIVE_ZERO
            for baseline_index in 0..<baseline.count |baseline_index, baseline, candidate, percent|:
                candidate_index: i64 = comparison_function_index(candidate, baseline[baseline_index])
                continue if candidate_index < NATIVE_ZERO
                baseline_record: ComparisonFunctionRecord = baseline[baseline_index]
                candidate_record: ComparisonFunctionRecord = candidate[candidate_index.usize()]
                return true if comparison_percent_exceeded(baseline_record.self_ns, candidate_record.self_ns, percent, true)
            return false


        def comparison_has_shared_function(baseline: darray[ComparisonFunctionRecord]&, candidate: darray[ComparisonFunctionRecord]&) -> bool can[Abort.Panic]:
            for baseline_index in 0..<baseline.count |baseline_index, baseline, candidate|:
                return true if comparison_function_index(candidate, baseline[baseline_index]) >= NATIVE_ZERO
            return false


        def comparison_gate_inconclusive(policy: ComparisonPolicy, source_mismatch: bool, workload_mismatch: bool, collection_mode_mismatch: bool, compiler_mismatch: bool, optimization_mismatch: bool, identity_mismatch: bool, resource_metrics_mismatch: bool, target_failure: bool, evidence_loss: bool, baseline: ComparisonCapture, candidate: ComparisonCapture) -> bool can[Abort.Panic]:
            return false if not comparison_policy_requested(policy)
            return true if source_mismatch or workload_mismatch or collection_mode_mismatch or compiler_mismatch or optimization_mismatch or identity_mismatch or target_failure or evidence_loss
            return true if (policy.max_cpu_regression_percent >= NATIVE_ZERO or policy.max_cpu_micros >= NATIVE_ZERO) and (resource_metrics_mismatch or not baseline.resource_metrics_available or not candidate.resource_metrics_available)
            return true if (policy.max_rss_regression_percent >= NATIVE_ZERO or policy.max_rss_bytes >= NATIVE_ZERO) and (resource_metrics_mismatch or not baseline.resource_metrics_available or not candidate.resource_metrics_available)
            return true if policy.max_function_self_regression_percent >= NATIVE_ZERO and not comparison_has_shared_function(baseline.functions, candidate.functions)
            return false


        def append_comparison_threshold(buffer: mutable darray[u8]&, value: i64) -> void can[Abort.Panic, Memory.Allocate]:
            append_i64(buffer, value) if value >= NATIVE_ZERO
            append_text(buffer, "null") if value < NATIVE_ZERO


        def append_comparison_gate_json(buffer: mutable darray[u8]&, policy: ComparisonPolicy, gate_inconclusive: bool, gate_failed: bool, wall_percent_failed: bool, wall_absolute_failed: bool, cpu_percent_failed: bool, cpu_absolute_failed: bool, rss_percent_failed: bool, rss_absolute_failed: bool, function_failed: bool) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, ",\"thresholds\":{\"wall_regression_percent\":")
            append_comparison_threshold(buffer, policy.max_wall_regression_percent)
            append_text(buffer, ",\"wall_max_ms\":")
            if policy.max_wall_micros >= NATIVE_ZERO:
                append_micros_as_millis(buffer, policy.max_wall_micros)
            else:
                append_text(buffer, "null")
            append_text(buffer, ",\"cpu_regression_percent\":")
            append_comparison_threshold(buffer, policy.max_cpu_regression_percent)
            append_text(buffer, ",\"cpu_max_ms\":")
            if policy.max_cpu_micros >= NATIVE_ZERO:
                append_micros_as_millis(buffer, policy.max_cpu_micros)
            else:
                append_text(buffer, "null")
            append_text(buffer, ",\"rss_regression_percent\":")
            append_comparison_threshold(buffer, policy.max_rss_regression_percent)
            append_text(buffer, ",\"rss_max_bytes\":")
            append_comparison_threshold(buffer, policy.max_rss_bytes)
            append_text(buffer, ",\"function_self_regression_percent\":")
            append_comparison_threshold(buffer, policy.max_function_self_regression_percent)
            append_text(buffer, "},\"gate\":{\"status\":\"")
            append_text(buffer, "inconclusive" if gate_inconclusive else "fail" if gate_failed else "pass" if comparison_policy_requested(policy) else "not_requested")
            append_text(buffer, "\",\"violations\":[")
            first: mutable bool = true
            if wall_percent_failed:
                append_text(buffer, "\"wall_regression_percent\"")
                first <- false
            if wall_absolute_failed:
                append_text(buffer, "," if not first else "")
                append_text(buffer, "\"wall_max_ms\"")
                first <- false
            if cpu_percent_failed:
                append_text(buffer, "," if not first else "")
                append_text(buffer, "\"cpu_regression_percent\"")
                first <- false
            if cpu_absolute_failed:
                append_text(buffer, "," if not first else "")
                append_text(buffer, "\"cpu_max_ms\"")
                first <- false
            if rss_percent_failed:
                append_text(buffer, "," if not first else "")
                append_text(buffer, "\"rss_regression_percent\"")
                first <- false
            if rss_absolute_failed:
                append_text(buffer, "," if not first else "")
                append_text(buffer, "\"rss_max_bytes\"")
                first <- false
            if function_failed:
                append_text(buffer, "," if not first else "")
                append_text(buffer, "\"function_self_regression_percent\"")
            append_text(buffer, "]}")


        def comparison_gate_exit_code(policy: ComparisonPolicy, gate_inconclusive: bool, gate_failed: bool) -> i64:
            return NATIVE_EXIT_COMPARISON_INCONCLUSIVE if gate_inconclusive
            return NATIVE_EXIT_COMPARISON_REGRESSION if gate_failed
            return NATIVE_ZERO


        def parse_nonnegative_integer(value: cstr) -> i64 can[Unsafe.PointerCast]:
            bytes: u8& = value.cast[u8&] can Unsafe.PointerCast
            cursor: mutable i64 = NATIVE_ZERO
            result: mutable i64 = NATIVE_ZERO
            saw_digit: mutable bool = false
            while true |bytes, cursor, result, saw_digit|:
                byte_ref: u8& = bytes + cursor
                byte: u8 = byte_ref
                break if byte == NATIVE_BYTE_NUL
                return NATIVE_NEGATIVE_ONE if byte < NATIVE_BYTE_ASCII_ZERO or byte > NATIVE_BYTE_ASCII_NINE
                digit: i64 = (byte - NATIVE_BYTE_ASCII_ZERO).i64()
                return NATIVE_NEGATIVE_ONE if result > (NATIVE_I64_MAX - digit) / NATIVE_DECIMAL_BASE
                result <- result * NATIVE_DECIMAL_BASE + digit
                saw_digit <- true
                cursor <- cursor + NATIVE_ONE
            return NATIVE_NEGATIVE_ONE if not saw_digit
            return result


        def append_comparison_warning_json(buffer: mutable darray[u8]&, warning: sview, include: bool, first: mutable bool&) -> i64 can[Abort.Panic, Memory.Allocate]:
            return NATIVE_ZERO if not include
            buffer.push(NATIVE_BYTE_COMMA) if not first
            warning_value: mutable darray[u8] = []
            append_text(warning_value, warning)
            append_json_string(buffer, warning_value)
            first <- false
            return NATIVE_ONE


        def append_comparison_warning_text(buffer: mutable darray[u8]&, warning: sview, include: bool) -> void can[Abort.Panic, Memory.Allocate]:
            return if not include
            append_text(buffer, "  - ")
            append_text(buffer, warning)
            append_text(buffer, "\n")


        def append_comparison_nullable_timed_metric(buffer: mutable darray[u8]&, baseline: i64, candidate: i64, baseline_available: bool, candidate_available: bool) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "{\"baseline\":")
            append_micros_as_millis(buffer, baseline) if baseline_available
            append_text(buffer, "null") if not baseline_available
            append_text(buffer, ",\"candidate\":")
            append_micros_as_millis(buffer, candidate) if candidate_available
            append_text(buffer, "null") if not candidate_available
            append_text(buffer, ",\"delta_micros\":")
            append_i64(buffer, native_signed_delta(candidate, baseline)) if baseline_available and candidate_available
            append_text(buffer, "null") if not baseline_available or not candidate_available
            append_text(buffer, "}")


        def append_comparison_nullable_count_metric(buffer: mutable darray[u8]&, baseline: i64, candidate: i64, baseline_available: bool, candidate_available: bool) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "{\"baseline\":")
            append_i64(buffer, baseline) if baseline_available
            append_text(buffer, "null") if not baseline_available
            append_text(buffer, ",\"candidate\":")
            append_i64(buffer, candidate) if candidate_available
            append_text(buffer, "null") if not candidate_available
            append_text(buffer, ",\"delta\":")
            append_i64(buffer, native_signed_delta(candidate, baseline)) if baseline_available and candidate_available
            append_text(buffer, "null") if not baseline_available or not candidate_available
            append_text(buffer, "}")


        def comparison_function_index(records: darray[ComparisonFunctionRecord]&, subject: ComparisonFunctionRecord) -> i64 can[Abort.Panic]:
            for index in 0..<records.count |index, records, subject|:
                candidate: ComparisonFunctionRecord = records[index]
                if subject.identity_id.count > NATIVE_ZERO.usize():
                    return index.i64() if candidate.identity_id.count > NATIVE_ZERO.usize() and byte_arrays_equal(candidate.identity_id, subject.identity_id)
                return index.i64() if candidate.identity_id.count == NATIVE_ZERO.usize() and byte_arrays_equal(candidate.function, subject.function)
            return NATIVE_NEGATIVE_ONE


        def comparison_missing_function_count(records: darray[ComparisonFunctionRecord]&, other: darray[ComparisonFunctionRecord]&) -> i64 can[Abort.Panic]:
            missing: mutable i64 = NATIVE_ZERO
            for index in 0..<records.count |index, records, other, missing|:
                missing <- missing + NATIVE_ONE if comparison_function_index(other, records[index]) < NATIVE_ZERO
            return missing


        def append_comparison_function_change_rows_html(buffer: mutable darray[u8]&, records: darray[ComparisonFunctionRecord]&, other: darray[ComparisonFunctionRecord]&, label: sview, emitted: mutable i64&) -> void can[Abort.Panic, Memory.Allocate]:
            for index in 0..<records.count |index, records, other, label, emitted, buffer|:
                continue if comparison_function_index(other, records[index]) >= NATIVE_ZERO
                if emitted < NATIVE_COMPARISON_HTML_DETAIL_LIMIT:
                    append_text(buffer, "<tr><th scope='row'>")
                    append_text(buffer, label)
                    append_text(buffer, "</th><td><code>")
                    append_html_escaped(buffer, records[index].function)
                    append_text(buffer, "</code></td></tr>")
                    emitted <- emitted + NATIVE_ONE


        def append_comparison_function_changes_html(buffer: mutable darray[u8]&, baseline: darray[ComparisonFunctionRecord]&, candidate: darray[ComparisonFunctionRecord]&) -> void can[Abort.Panic, Memory.Allocate]:
            removed: i64 = comparison_missing_function_count(baseline, candidate)
            added: i64 = comparison_missing_function_count(candidate, baseline)
            append_text(buffer, "<details><summary>Function identity changes</summary>")
            if removed == NATIVE_ZERO and added == NATIVE_ZERO:
                append_text(buffer, "<p>No added or removed function identities.</p>")
            else:
                append_text(buffer, "<p>Removed: ")
                append_i64(buffer, removed)
                append_text(buffer, "; added: ")
                append_i64(buffer, added)
                append_text(buffer, ". Matching uses the readable function identity available in this capture.</p><div class='table-scroll'><table><thead><tr><th scope='col'>Change</th><th scope='col'>Function</th></tr></thead><tbody>")
                emitted: mutable i64 = NATIVE_ZERO
                append_comparison_function_change_rows_html(buffer, baseline, candidate, "Removed", emitted)
                append_comparison_function_change_rows_html(buffer, candidate, baseline, "Added", emitted)
                append_text(buffer, "</tbody></table></div>")
                total_changes: i64 = removed + added
                if total_changes > emitted:
                    append_text(buffer, "<p>Showing the first ")
                    append_i64(buffer, emitted)
                    append_text(buffer, " of ")
                    append_i64(buffer, total_changes)
                    append_text(buffer, " changes; the raw comparison JSON retains the complete bounded detail.</p>")
            append_text(buffer, "</details>")


        def append_comparison_function_json(buffer: mutable darray[u8]&, baseline: darray[ComparisonFunctionRecord]&, baseline_index: i64, candidate: darray[ComparisonFunctionRecord]&, candidate_index: i64) -> void can[Abort.Panic, Memory.Allocate]:
            baseline_available: bool = baseline_index >= NATIVE_ZERO
            candidate_available: bool = candidate_index >= NATIVE_ZERO
            baseline_name: mutable darray[u8] = []
            candidate_name: mutable darray[u8] = []
            baseline_events: mutable i64 = NATIVE_ZERO
            candidate_events: mutable i64 = NATIVE_ZERO
            baseline_call_events: mutable i64 = NATIVE_ZERO
            candidate_call_events: mutable i64 = NATIVE_ZERO
            baseline_completed_calls: mutable i64 = NATIVE_ZERO
            candidate_completed_calls: mutable i64 = NATIVE_ZERO
            baseline_inclusive_ns: mutable i64 = NATIVE_ZERO
            candidate_inclusive_ns: mutable i64 = NATIVE_ZERO
            baseline_self_ns: mutable i64 = NATIVE_ZERO
            candidate_self_ns: mutable i64 = NATIVE_ZERO
            baseline_interval_ns: mutable i64 = NATIVE_ZERO
            candidate_interval_ns: mutable i64 = NATIVE_ZERO
            baseline_max_interval_ns: mutable i64 = NATIVE_ZERO
            candidate_max_interval_ns: mutable i64 = NATIVE_ZERO
            if baseline_available:
                baseline_record: ComparisonFunctionRecord = baseline[baseline_index.usize()]
                baseline_name <- baseline_record.function
                baseline_events <- baseline_record.events
                baseline_call_events <- baseline_record.call_events
                baseline_completed_calls <- baseline_record.completed_calls
                baseline_inclusive_ns <- baseline_record.inclusive_ns
                baseline_self_ns <- baseline_record.self_ns
                baseline_interval_ns <- baseline_record.interval_ns
                baseline_max_interval_ns <- baseline_record.max_interval_ns
            if candidate_available:
                candidate_record: ComparisonFunctionRecord = candidate[candidate_index.usize()]
                candidate_name <- candidate_record.function
                candidate_events <- candidate_record.events
                candidate_call_events <- candidate_record.call_events
                candidate_completed_calls <- candidate_record.completed_calls
                candidate_inclusive_ns <- candidate_record.inclusive_ns
                candidate_self_ns <- candidate_record.self_ns
                candidate_interval_ns <- candidate_record.interval_ns
                candidate_max_interval_ns <- candidate_record.max_interval_ns
            function_name: darray[u8] = baseline_name if baseline_available else candidate_name
            append_text(buffer, "{\"function\":")
            append_json_string(buffer, function_name)
            append_text(buffer, ",\"events\":")
            append_comparison_nullable_count_metric(buffer, baseline_events, candidate_events, baseline_available, candidate_available)
            append_text(buffer, ",\"call_events\":")
            append_comparison_nullable_count_metric(buffer, baseline_call_events, candidate_call_events, baseline_available, candidate_available)
            append_text(buffer, ",\"completed_calls\":")
            append_comparison_nullable_count_metric(buffer, baseline_completed_calls, candidate_completed_calls, baseline_available, candidate_available)
            append_text(buffer, ",\"inclusive_ns\":")
            append_comparison_nullable_count_metric(buffer, baseline_inclusive_ns, candidate_inclusive_ns, baseline_available, candidate_available)
            append_text(buffer, ",\"self_ns\":")
            append_comparison_nullable_count_metric(buffer, baseline_self_ns, candidate_self_ns, baseline_available, candidate_available)
            append_text(buffer, ",\"interval_ns\":")
            append_comparison_nullable_count_metric(buffer, baseline_interval_ns, candidate_interval_ns, baseline_available, candidate_available)
            append_text(buffer, ",\"max_interval_ns\":")
            append_comparison_nullable_count_metric(buffer, baseline_max_interval_ns, candidate_max_interval_ns, baseline_available, candidate_available)
            append_text(buffer, "}")


        def append_comparison_functions_json(buffer: mutable darray[u8]&, baseline: darray[ComparisonFunctionRecord]&, candidate: darray[ComparisonFunctionRecord]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "[")
            first: mutable bool = true
            for baseline_index in 0..<baseline.count |baseline_index, baseline, candidate, first, buffer|:
                candidate_index: i64 = comparison_function_index(candidate, baseline[baseline_index])
                append_text(buffer, ",") if not first
                append_comparison_function_json(buffer, baseline, baseline_index.i64(), candidate, candidate_index)
                first <- false
            for candidate_index in 0..<candidate.count |candidate_index, baseline, candidate, first, buffer|:
                baseline_index: i64 = comparison_function_index(baseline, candidate[candidate_index])
                continue if baseline_index >= NATIVE_ZERO
                append_text(buffer, ",") if not first
                append_comparison_function_json(buffer, baseline, baseline_index, candidate, candidate_index.i64())
                first <- false
            append_text(buffer, "]")


        def comparison_call_edge_index(records: darray[ComparisonCallEdgeRecord]&, subject: ComparisonCallEdgeRecord) -> i64 can[Abort.Panic]:
            for index in 0..<records.count |index, records, subject|:
                candidate: ComparisonCallEdgeRecord = records[index]
                if subject.caller_identity_id.count > NATIVE_ZERO.usize() and subject.callee_identity_id.count > NATIVE_ZERO.usize():
                    return index.i64() if candidate.caller_identity_id.count > NATIVE_ZERO.usize() and candidate.callee_identity_id.count > NATIVE_ZERO.usize() and byte_arrays_equal(candidate.caller_identity_id, subject.caller_identity_id) and byte_arrays_equal(candidate.callee_identity_id, subject.callee_identity_id)
                return index.i64() if candidate.caller_identity_id.count == NATIVE_ZERO.usize() and candidate.callee_identity_id.count == NATIVE_ZERO.usize() and byte_arrays_equal(candidate.caller, subject.caller) and byte_arrays_equal(candidate.callee, subject.callee)
            return NATIVE_NEGATIVE_ONE


        def append_comparison_call_edge_json(buffer: mutable darray[u8]&, baseline: darray[ComparisonCallEdgeRecord]&, baseline_index: i64, candidate: darray[ComparisonCallEdgeRecord]&, candidate_index: i64) -> void can[Abort.Panic, Memory.Allocate]:
            baseline_available: bool = baseline_index >= NATIVE_ZERO
            candidate_available: bool = candidate_index >= NATIVE_ZERO
            baseline_call_events: mutable i64 = NATIVE_ZERO
            candidate_call_events: mutable i64 = NATIVE_ZERO
            baseline_completed_calls: mutable i64 = NATIVE_ZERO
            candidate_completed_calls: mutable i64 = NATIVE_ZERO
            baseline_inclusive_ns: mutable i64 = NATIVE_ZERO
            candidate_inclusive_ns: mutable i64 = NATIVE_ZERO
            if baseline_available:
                baseline_record: ComparisonCallEdgeRecord = baseline[baseline_index.usize()]
                baseline_call_events <- baseline_record.call_events
                baseline_completed_calls <- baseline_record.completed_calls
                baseline_inclusive_ns <- baseline_record.inclusive_ns
            if candidate_available:
                candidate_record: ComparisonCallEdgeRecord = candidate[candidate_index.usize()]
                candidate_call_events <- candidate_record.call_events
                candidate_completed_calls <- candidate_record.completed_calls
                candidate_inclusive_ns <- candidate_record.inclusive_ns
            append_text(buffer, "{\"caller\":")
            append_json_string(buffer, baseline[baseline_index.usize()].caller) if baseline_available
            append_json_string(buffer, candidate[candidate_index.usize()].caller) if not baseline_available
            append_text(buffer, ",\"callee\":")
            append_json_string(buffer, baseline[baseline_index.usize()].callee) if baseline_available
            append_json_string(buffer, candidate[candidate_index.usize()].callee) if not baseline_available
            append_text(buffer, ",\"call_events\":")
            append_comparison_nullable_count_metric(buffer, baseline_call_events, candidate_call_events, baseline_available, candidate_available)
            append_text(buffer, ",\"completed_calls\":")
            append_comparison_nullable_count_metric(buffer, baseline_completed_calls, candidate_completed_calls, baseline_available, candidate_available)
            append_text(buffer, ",\"inclusive_ns\":")
            append_comparison_nullable_count_metric(buffer, baseline_inclusive_ns, candidate_inclusive_ns, baseline_available, candidate_available)
            append_text(buffer, "}")


        def comparison_missing_call_edge_count(records: darray[ComparisonCallEdgeRecord]&, other: darray[ComparisonCallEdgeRecord]&) -> i64 can[Abort.Panic]:
            missing: mutable i64 = NATIVE_ZERO
            for index in 0..<records.count |index, records, other, missing|:
                record: ComparisonCallEdgeRecord = records[index]
                missing <- missing + NATIVE_ONE if comparison_call_edge_index(other, record) < NATIVE_ZERO
            return missing


        def append_comparison_call_edge_change_rows_html(buffer: mutable darray[u8]&, records: darray[ComparisonCallEdgeRecord]&, other: darray[ComparisonCallEdgeRecord]&, label: sview, emitted: mutable i64&) -> void can[Abort.Panic, Memory.Allocate]:
            for index in 0..<records.count |index, records, other, label, emitted, buffer|:
                record: ComparisonCallEdgeRecord = records[index]
                continue if comparison_call_edge_index(other, record) >= NATIVE_ZERO
                if emitted < NATIVE_COMPARISON_HTML_DETAIL_LIMIT:
                    append_text(buffer, "<tr><th scope='row'>")
                    append_text(buffer, label)
                    append_text(buffer, "</th><td><code>")
                    append_html_escaped(buffer, record.caller)
                    append_text(buffer, "</code> -&gt; <code>")
                    append_html_escaped(buffer, record.callee)
                    append_text(buffer, "</code></td></tr>")
                    emitted <- emitted + NATIVE_ONE


        def append_comparison_call_edge_changes_html(buffer: mutable darray[u8]&, baseline: darray[ComparisonCallEdgeRecord]&, candidate: darray[ComparisonCallEdgeRecord]&) -> void can[Abort.Panic, Memory.Allocate]:
            removed: i64 = comparison_missing_call_edge_count(baseline, candidate)
            added: i64 = comparison_missing_call_edge_count(candidate, baseline)
            append_text(buffer, "<details><summary>Call-edge identity changes</summary>")
            if removed == NATIVE_ZERO and added == NATIVE_ZERO:
                append_text(buffer, "<p>No added or removed caller-to-callee identities.</p>")
            else:
                append_text(buffer, "<p>Removed: ")
                append_i64(buffer, removed)
                append_text(buffer, "; added: ")
                append_i64(buffer, added)
                append_text(buffer, ".</p><div class='table-scroll'><table><thead><tr><th scope='col'>Change</th><th scope='col'>Caller -&gt; callee</th></tr></thead><tbody>")
                emitted: mutable i64 = NATIVE_ZERO
                append_comparison_call_edge_change_rows_html(buffer, baseline, candidate, "Removed", emitted)
                append_comparison_call_edge_change_rows_html(buffer, candidate, baseline, "Added", emitted)
                append_text(buffer, "</tbody></table></div>")
                total_changes: i64 = removed + added
                if total_changes > emitted:
                    append_text(buffer, "<p>Showing the first ")
                    append_i64(buffer, emitted)
                    append_text(buffer, " of ")
                    append_i64(buffer, total_changes)
                    append_text(buffer, " changes; the raw comparison JSON retains the complete bounded detail.</p>")
            append_text(buffer, "</details>")


        def append_comparison_call_edges_json(buffer: mutable darray[u8]&, baseline: darray[ComparisonCallEdgeRecord]&, candidate: darray[ComparisonCallEdgeRecord]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "[")
            first: mutable bool = true
            for baseline_index in 0..<baseline.count |baseline_index, baseline, candidate, first, buffer|:
                candidate_index: i64 = comparison_call_edge_index(candidate, baseline[baseline_index])
                append_text(buffer, ",") if not first
                append_comparison_call_edge_json(buffer, baseline, baseline_index.i64(), candidate, candidate_index)
                first <- false
            for candidate_index in 0..<candidate.count |candidate_index, baseline, candidate, first, buffer|:
                baseline_index: i64 = comparison_call_edge_index(baseline, candidate[candidate_index])
                continue if baseline_index >= NATIVE_ZERO
                append_text(buffer, ",") if not first
                append_comparison_call_edge_json(buffer, baseline, baseline_index, candidate, candidate_index.i64())
                first <- false
            append_text(buffer, "]")


        def comparison_stack_index(records: darray[ComparisonStackRecord]&, subject: ComparisonStackRecord) -> i64 can[Abort.Panic]:
            for index in 0..<records.count |index, records, subject|:
                candidate: ComparisonStackRecord = records[index]
                if subject.identity_path.count > NATIVE_ZERO.usize():
                    return index.i64() if candidate.identity_path.count > NATIVE_ZERO.usize() and byte_arrays_equal(candidate.identity_path, subject.identity_path)
                return index.i64() if candidate.identity_path.count == NATIVE_ZERO.usize() and byte_arrays_equal(candidate.path, subject.path)
            return NATIVE_NEGATIVE_ONE


        def comparison_missing_stack_count(records: darray[ComparisonStackRecord]&, other: darray[ComparisonStackRecord]&) -> i64 can[Abort.Panic]:
            missing: mutable i64 = NATIVE_ZERO
            for index in 0..<records.count |index, records, other, missing|:
                missing <- missing + NATIVE_ONE if comparison_stack_index(other, records[index]) < NATIVE_ZERO
            return missing


        def append_comparison_stack_change_rows_html(buffer: mutable darray[u8]&, records: darray[ComparisonStackRecord]&, other: darray[ComparisonStackRecord]&, label: sview, emitted: mutable i64&) -> void can[Abort.Panic, Memory.Allocate]:
            for index in 0..<records.count |index, records, other, label, emitted, buffer|:
                continue if comparison_stack_index(other, records[index]) >= NATIVE_ZERO
                if emitted < NATIVE_COMPARISON_HTML_DETAIL_LIMIT:
                    append_text(buffer, "<tr><th scope='row'>")
                    append_text(buffer, label)
                    append_text(buffer, "</th><td><code>")
                    append_html_escaped(buffer, records[index].path)
                    append_text(buffer, "</code></td></tr>")
                    emitted <- emitted + NATIVE_ONE


        def append_comparison_stack_changes_html(buffer: mutable darray[u8]&, baseline: darray[ComparisonStackRecord]&, candidate: darray[ComparisonStackRecord]&) -> void can[Abort.Panic, Memory.Allocate]:
            removed: i64 = comparison_missing_stack_count(baseline, candidate)
            added: i64 = comparison_missing_stack_count(candidate, baseline)
            append_text(buffer, "<details><summary>Stack identity changes</summary>")
            if removed == NATIVE_ZERO and added == NATIVE_ZERO:
                append_text(buffer, "<p>No added or removed folded stack identities.</p>")
            else:
                append_text(buffer, "<p>Removed: ")
                append_i64(buffer, removed)
                append_text(buffer, "; added: ")
                append_i64(buffer, added)
                append_text(buffer, ".</p><div class='table-scroll'><table><thead><tr><th scope='col'>Change</th><th scope='col'>Folded stack</th></tr></thead><tbody>")
                emitted: mutable i64 = NATIVE_ZERO
                append_comparison_stack_change_rows_html(buffer, baseline, candidate, "Removed", emitted)
                append_comparison_stack_change_rows_html(buffer, candidate, baseline, "Added", emitted)
                append_text(buffer, "</tbody></table></div>")
                total_changes: i64 = removed + added
                if total_changes > emitted:
                    append_text(buffer, "<p>Showing the first ")
                    append_i64(buffer, emitted)
                    append_text(buffer, " of ")
                    append_i64(buffer, total_changes)
                    append_text(buffer, " changes; the raw comparison JSON retains the complete bounded detail.</p>")
            append_text(buffer, "</details>")


        def append_comparison_stack_json(buffer: mutable darray[u8]&, baseline: darray[ComparisonStackRecord]&, baseline_index: i64, candidate: darray[ComparisonStackRecord]&, candidate_index: i64) -> void can[Abort.Panic, Memory.Allocate]:
            baseline_available: bool = baseline_index >= NATIVE_ZERO
            candidate_available: bool = candidate_index >= NATIVE_ZERO
            baseline_call_events: mutable i64 = NATIVE_ZERO
            candidate_call_events: mutable i64 = NATIVE_ZERO
            baseline_completed_calls: mutable i64 = NATIVE_ZERO
            candidate_completed_calls: mutable i64 = NATIVE_ZERO
            baseline_self_ns: mutable i64 = NATIVE_ZERO
            candidate_self_ns: mutable i64 = NATIVE_ZERO
            if baseline_available:
                baseline_record: ComparisonStackRecord = baseline[baseline_index.usize()]
                baseline_call_events <- baseline_record.call_events
                baseline_completed_calls <- baseline_record.completed_calls
                baseline_self_ns <- baseline_record.self_ns
            if candidate_available:
                candidate_record: ComparisonStackRecord = candidate[candidate_index.usize()]
                candidate_call_events <- candidate_record.call_events
                candidate_completed_calls <- candidate_record.completed_calls
                candidate_self_ns <- candidate_record.self_ns
            append_text(buffer, "{\"stack\":")
            append_json_string(buffer, baseline[baseline_index.usize()].path) if baseline_available
            append_json_string(buffer, candidate[candidate_index.usize()].path) if not baseline_available
            append_text(buffer, ",\"call_events\":")
            append_comparison_nullable_count_metric(buffer, baseline_call_events, candidate_call_events, baseline_available, candidate_available)
            append_text(buffer, ",\"completed_calls\":")
            append_comparison_nullable_count_metric(buffer, baseline_completed_calls, candidate_completed_calls, baseline_available, candidate_available)
            append_text(buffer, ",\"self_ns\":")
            append_comparison_nullable_count_metric(buffer, baseline_self_ns, candidate_self_ns, baseline_available, candidate_available)
            append_text(buffer, "}")


        def append_comparison_stacks_json(buffer: mutable darray[u8]&, baseline: darray[ComparisonStackRecord]&, candidate: darray[ComparisonStackRecord]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "[")
            first: mutable bool = true
            for baseline_index in 0..<baseline.count |baseline_index, baseline, candidate, first, buffer|:
                candidate_index: i64 = comparison_stack_index(candidate, baseline[baseline_index])
                append_text(buffer, ",") if not first
                append_comparison_stack_json(buffer, baseline, baseline_index.i64(), candidate, candidate_index)
                first <- false
            for candidate_index in 0..<candidate.count |candidate_index, baseline, candidate, first, buffer|:
                baseline_index: i64 = comparison_stack_index(baseline, candidate[candidate_index])
                continue if baseline_index >= NATIVE_ZERO
                append_text(buffer, ",") if not first
                append_comparison_stack_json(buffer, baseline, baseline_index, candidate, candidate_index.i64())
                first <- false
            append_text(buffer, "]")


        def comparison_location_index(records: darray[ComparisonLocationRecord]&, subject: ComparisonLocationRecord) -> i64 can[Abort.Panic]:
            for index in 0..<records.count |index, records, subject|:
                record: ComparisonLocationRecord = records[index]
                if subject.identity_id.count > NATIVE_ZERO.usize():
                    return index.i64() if record.identity_id.count > NATIVE_ZERO.usize() and byte_arrays_equal(record.identity_id, subject.identity_id)
                return index.i64() if record.identity_id.count == NATIVE_ZERO.usize() and record.line == subject.line and record.signed == subject.signed and record.source_available == subject.source_available and record.variable_available == subject.variable_available and byte_arrays_equal(record.source, subject.source) and byte_arrays_equal(record.kind, subject.kind) and byte_arrays_equal(record.function, subject.function) and byte_arrays_equal(record.variable, subject.variable)
            return NATIVE_NEGATIVE_ONE


        def comparison_missing_location_count(records: darray[ComparisonLocationRecord]&, other: darray[ComparisonLocationRecord]&) -> i64 can[Abort.Panic]:
            missing: mutable i64 = NATIVE_ZERO
            for index in 0..<records.count |index, records, other, missing|:
                record: ComparisonLocationRecord = records[index]
                other_index: i64 = comparison_location_index(other, record)
                missing <- missing + NATIVE_ONE if other_index < NATIVE_ZERO
            return missing


        def append_comparison_location_change_rows_html(buffer: mutable darray[u8]&, records: darray[ComparisonLocationRecord]&, other: darray[ComparisonLocationRecord]&, label: sview, emitted: mutable i64&) -> void can[Abort.Panic, Memory.Allocate]:
            for index in 0..<records.count |index, records, other, label, emitted, buffer|:
                record: ComparisonLocationRecord = records[index]
                other_index: i64 = comparison_location_index(other, record)
                continue if other_index >= NATIVE_ZERO
                if emitted < NATIVE_COMPARISON_HTML_DETAIL_LIMIT:
                    append_text(buffer, "<tr><th scope='row'>")
                    append_text(buffer, label)
                    append_text(buffer, "</th><td><code>")
                    append_html_escaped(buffer, record.source)
                    append_text(buffer, ":")
                    append_i64(buffer, record.line)
                    append_text(buffer, "</code> <span>")
                    append_html_escaped(buffer, record.function)
                    if record.variable_available:
                        append_text(buffer, " · ")
                        append_html_escaped(buffer, record.variable)
                    append_text(buffer, "</span></td></tr>")
                    emitted <- emitted + NATIVE_ONE


        def append_comparison_location_changes_html(buffer: mutable darray[u8]&, baseline: darray[ComparisonLocationRecord]&, candidate: darray[ComparisonLocationRecord]&) -> void can[Abort.Panic, Memory.Allocate]:
            removed: i64 = comparison_missing_location_count(baseline, candidate)
            added: i64 = comparison_missing_location_count(candidate, baseline)
            append_text(buffer, "<details><summary>Source-location identity changes</summary>")
            if removed == NATIVE_ZERO and added == NATIVE_ZERO:
                append_text(buffer, "<p>No added or removed source-location identities.</p>")
            else:
                append_text(buffer, "<p>Removed: ")
                append_i64(buffer, removed)
                append_text(buffer, "; added: ")
                append_i64(buffer, added)
                append_text(buffer, ".</p><div class='table-scroll'><table><thead><tr><th scope='col'>Change</th><th scope='col'>Source location</th></tr></thead><tbody>")
                emitted: mutable i64 = NATIVE_ZERO
                append_comparison_location_change_rows_html(buffer, baseline, candidate, "Removed", emitted)
                append_comparison_location_change_rows_html(buffer, candidate, baseline, "Added", emitted)
                append_text(buffer, "</tbody></table></div>")
                total_changes: i64 = removed + added
                if total_changes > emitted:
                    append_text(buffer, "<p>Showing the first ")
                    append_i64(buffer, emitted)
                    append_text(buffer, " of ")
                    append_i64(buffer, total_changes)
                    append_text(buffer, " changes; the raw comparison JSON retains the complete bounded detail.</p>")
            append_text(buffer, "</details>")


        def append_comparison_location_json(buffer: mutable darray[u8]&, baseline: darray[ComparisonLocationRecord]&, baseline_index: i64, candidate: darray[ComparisonLocationRecord]&, candidate_index: i64) -> void can[Abort.Panic, Memory.Allocate]:
            baseline_available: bool = baseline_index >= NATIVE_ZERO
            candidate_available: bool = candidate_index >= NATIVE_ZERO
            baseline_count: mutable i64 = NATIVE_ZERO
            candidate_count: mutable i64 = NATIVE_ZERO
            baseline_interval_ns: mutable i64 = NATIVE_ZERO
            candidate_interval_ns: mutable i64 = NATIVE_ZERO
            baseline_max_interval_ns: mutable i64 = NATIVE_ZERO
            candidate_max_interval_ns: mutable i64 = NATIVE_ZERO
            if baseline_available:
                baseline_record: ComparisonLocationRecord = baseline[baseline_index.usize()]
                baseline_count <- baseline_record.count
                baseline_interval_ns <- baseline_record.interval_ns
                baseline_max_interval_ns <- baseline_record.max_interval_ns
            if candidate_available:
                candidate_record: ComparisonLocationRecord = candidate[candidate_index.usize()]
                candidate_count <- candidate_record.count
                candidate_interval_ns <- candidate_record.interval_ns
                candidate_max_interval_ns <- candidate_record.max_interval_ns
            append_text(buffer, "{\"source\":")
            if baseline_available and baseline[baseline_index.usize()].source_available:
                append_json_string(buffer, baseline[baseline_index.usize()].source)
            elif not baseline_available and candidate[candidate_index.usize()].source_available:
                append_json_string(buffer, candidate[candidate_index.usize()].source)
            else:
                append_text(buffer, "null")
            append_text(buffer, ",\"line\":")
            append_i64(buffer, baseline[baseline_index.usize()].line) if baseline_available
            append_i64(buffer, candidate[candidate_index.usize()].line) if not baseline_available
            append_text(buffer, ",\"function\":")
            append_json_string(buffer, baseline[baseline_index.usize()].function) if baseline_available
            append_json_string(buffer, candidate[candidate_index.usize()].function) if not baseline_available
            append_text(buffer, ",\"kind\":")
            append_json_string(buffer, baseline[baseline_index.usize()].kind) if baseline_available
            append_json_string(buffer, candidate[candidate_index.usize()].kind) if not baseline_available
            append_text(buffer, ",\"variable\":")
            if baseline_available and baseline[baseline_index.usize()].variable_available:
                append_json_string(buffer, baseline[baseline_index.usize()].variable)
            elif not baseline_available and candidate[candidate_index.usize()].variable_available:
                append_json_string(buffer, candidate[candidate_index.usize()].variable)
            else:
                append_text(buffer, "null")
            append_text(buffer, ",\"signed\":")
            append_text(buffer, "true" if baseline[baseline_index.usize()].signed else "false") if baseline_available
            append_text(buffer, "true" if candidate[candidate_index.usize()].signed else "false") if not baseline_available
            append_text(buffer, ",\"count\":")
            append_comparison_nullable_count_metric(buffer, baseline_count, candidate_count, baseline_available, candidate_available)
            append_text(buffer, ",\"interval_ns\":")
            append_comparison_nullable_count_metric(buffer, baseline_interval_ns, candidate_interval_ns, baseline_available, candidate_available)
            append_text(buffer, ",\"max_interval_ns\":")
            append_comparison_nullable_count_metric(buffer, baseline_max_interval_ns, candidate_max_interval_ns, baseline_available, candidate_available)
            append_text(buffer, "}")


        def append_comparison_locations_json(buffer: mutable darray[u8]&, baseline: darray[ComparisonLocationRecord]&, candidate: darray[ComparisonLocationRecord]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "[")
            first: mutable bool = true
            for baseline_index in 0..<baseline.count |baseline_index, baseline, candidate, first, buffer|:
                baseline_record: ComparisonLocationRecord = baseline[baseline_index]
                candidate_index: i64 = comparison_location_index(candidate, baseline_record)
                append_text(buffer, ",") if not first
                append_comparison_location_json(buffer, baseline, baseline_index.i64(), candidate, candidate_index)
                first <- false
            for candidate_index in 0..<candidate.count |candidate_index, baseline, candidate, first, buffer|:
                candidate_record: ComparisonLocationRecord = candidate[candidate_index]
                baseline_index: i64 = comparison_location_index(baseline, candidate_record)
                continue if baseline_index >= NATIVE_ZERO
                append_text(buffer, ",") if not first
                append_comparison_location_json(buffer, baseline, baseline_index, candidate, candidate_index.i64())
                first <- false
            append_text(buffer, "]")


        def append_comparison_report(
            buffer: mutable darray[u8]&, baseline_path: darray[u8]&, candidate_path: darray[u8]&, baseline: ComparisonCapture, candidate: ComparisonCapture, format_json: bool, format_html: bool, policy: ComparisonPolicy
        ) -> i64 can[Abort.Panic, Memory.Allocate]:
            source_mismatch: bool = not byte_arrays_equal(baseline.source, candidate.source)
            collection_mode_mismatch: bool = (baseline.collection_mode.count > NATIVE_ZERO.usize() and candidate.collection_mode.count == NATIVE_ZERO.usize()) or (baseline.collection_mode.count == NATIVE_ZERO.usize() and candidate.collection_mode.count > NATIVE_ZERO.usize()) or (baseline.collection_mode.count > NATIVE_ZERO.usize() and candidate.collection_mode.count > NATIVE_ZERO.usize() and not byte_arrays_equal(baseline.collection_mode, candidate.collection_mode))
            workload_mismatch: mutable bool = false
            if baseline.workload_identity.count > NATIVE_ZERO.usize() or candidate.workload_identity.count > NATIVE_ZERO.usize():
                workload_mismatch <- not byte_arrays_equal(baseline.workload_identity, candidate.workload_identity)
            compiler_mismatch: bool = not byte_arrays_equal(baseline.compiler_commit, candidate.compiler_commit)
            optimization_mismatch: bool = not byte_arrays_equal(baseline.opt_level, candidate.opt_level)
            identity_mismatch: bool = baseline.stable_ids_available != candidate.stable_ids_available
            resource_metrics_mismatch: bool = baseline.resource_metrics_available != candidate.resource_metrics_available
            target_failure: bool = baseline.exit_code != NATIVE_ZERO or candidate.exit_code != NATIVE_ZERO
            evidence_loss: bool = baseline.dropped > NATIVE_ZERO or candidate.dropped > NATIVE_ZERO or baseline.frame_dropped > NATIVE_ZERO or candidate.frame_dropped > NATIVE_ZERO or baseline.dropped_call_edges > NATIVE_ZERO or candidate.dropped_call_edges > NATIVE_ZERO or baseline.dropped_stacks > NATIVE_ZERO or candidate.dropped_stacks > NATIVE_ZERO or baseline.stack_overflow_entries > NATIVE_ZERO or candidate.stack_overflow_entries > NATIVE_ZERO or baseline.trace_events_omitted > NATIVE_ZERO or candidate.trace_events_omitted > NATIVE_ZERO or baseline.detail_budget_exceeded or candidate.detail_budget_exceeded
            cpu_available: bool = baseline.resource_metrics_available and candidate.resource_metrics_available and not resource_metrics_mismatch
            rss_available: bool = cpu_available
            wall_percent_failed: bool = comparison_percent_exceeded(baseline.execution_mean_micros, candidate.execution_mean_micros, policy.max_wall_regression_percent, true)
            wall_absolute_failed: bool = comparison_absolute_exceeded(candidate.execution_mean_micros, policy.max_wall_micros, true)
            cpu_percent_failed: bool = comparison_percent_exceeded(baseline.cpu_micros, candidate.cpu_micros, policy.max_cpu_regression_percent, cpu_available)
            cpu_absolute_failed: bool = comparison_absolute_exceeded(candidate.cpu_micros, policy.max_cpu_micros, cpu_available)
            rss_percent_failed: bool = comparison_percent_exceeded(baseline.peak_rss_bytes, candidate.peak_rss_bytes, policy.max_rss_regression_percent, rss_available)
            rss_absolute_failed: bool = comparison_absolute_exceeded(candidate.peak_rss_bytes, policy.max_rss_bytes, rss_available)
            function_failed: bool = comparison_function_self_exceeded(baseline.functions, candidate.functions, policy.max_function_self_regression_percent)
            gate_inconclusive: bool = comparison_gate_inconclusive(policy, source_mismatch, workload_mismatch, collection_mode_mismatch, compiler_mismatch, optimization_mismatch, identity_mismatch, resource_metrics_mismatch, target_failure, evidence_loss, baseline, candidate)
            gate_failed: bool = wall_percent_failed or wall_absolute_failed or cpu_percent_failed or cpu_absolute_failed or rss_percent_failed or rss_absolute_failed or function_failed
            if format_html:
                json_details: mutable darray[u8] = []
                _ = append_comparison_report(&json_details, baseline_path, candidate_path, baseline, candidate, true, false, policy)
                append_text(buffer, "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Elisa profile comparison</title><style>body{font:15px system-ui,sans-serif;line-height:1.45;max-width:1180px;margin:2rem auto;padding:0 1rem;color:#17202a;background:#f6f8fa}main{background:white;border:1px solid #d0d7de;border-radius:12px;padding:1.5rem;box-shadow:0 4px 20px #0001}h1{margin-top:0}code,pre{font:13px ui-monospace,SFMono-Regular,Menlo,monospace}dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.75rem}dl div{padding:.8rem;background:#f6f8fa;border-radius:8px}dt{color:#57606a;font-size:.8rem}dd{margin:.2rem 0 0;font-weight:650;overflow-wrap:anywhere}table{width:100%;border-collapse:collapse;margin-top:1rem}th,td{padding:.55rem .7rem;border-bottom:1px solid #d8dee4;text-align:left}th{font-size:.8rem;color:#57606a}td:not(:first-child){font-family:ui-monospace,SFMono-Regular,Menlo,monospace}details{margin-top:1rem;border:1px solid #d8dee4;border-radius:8px;padding:.75rem}summary{cursor:pointer;font-weight:650}pre{overflow:auto;white-space:pre-wrap;word-break:break-word;margin:.75rem 0 0}.warning{border-left:4px solid #bf8700;background:#fff8c5;padding:.75rem;margin-top:1rem}@media(prefers-color-scheme:dark){body{color:#e6edf3;background:#0d1117}main{background:#161b22;border-color:#30363d}dl div{background:#21262d}th,td{border-color:#30363d}details{border-color:#30363d}.warning{background:#9a670033}}</style></head><body><main><h1>Elisa profile comparison</h1><p>Native comparison view; identity differences and evidence quality are explicit.</p><dl><div><dt>Baseline</dt><dd><code>")
                append_html_escaped(buffer, baseline_path)
                append_text(buffer, "</code></dd></div><div><dt>Candidate</dt><dd><code>")
                append_html_escaped(buffer, candidate_path)
                append_text(buffer, "</code></dd></div><div><dt>Source identity</dt><dd>")
                append_text(buffer, "same" if not source_mismatch else "different")
                append_text(buffer, "</dd></div><div><dt>Workload identity</dt><dd>")
                append_text(buffer, "same" if not workload_mismatch else "different")
                append_text(buffer, "</dd></div><div><dt>Compiler / optimization</dt><dd>")
                append_text(buffer, "same" if not compiler_mismatch and not optimization_mismatch else "different")
                append_text(buffer, "</dd></div><div><dt>Collection mode</dt><dd>")
                append_text(buffer, "same" if not collection_mode_mismatch else "different")
                append_text(buffer, "</dd></div></dl><table><thead><tr><th scope='col'>Metric</th><th scope='col'>Baseline</th><th scope='col'>Candidate</th><th scope='col'>Delta</th></tr></thead><tbody><tr><th scope='row'>Mean execution</th><td>")
                append_micros_as_millis(buffer, baseline.execution_mean_micros)
                append_text(buffer, " ms</td><td>")
                append_micros_as_millis(buffer, candidate.execution_mean_micros)
                append_text(buffer, " ms</td><td>")
                append_i64(buffer, native_signed_delta(candidate.execution_mean_micros, baseline.execution_mean_micros))
                append_text(buffer, " µs</td></tr><tr><th scope='row'>Compilation</th><td>")
                append_micros_as_millis(buffer, baseline.compile_micros)
                append_text(buffer, " ms</td><td>")
                append_micros_as_millis(buffer, candidate.compile_micros)
                append_text(buffer, " ms</td><td>")
                append_i64(buffer, native_signed_delta(candidate.compile_micros, baseline.compile_micros))
                append_text(buffer, " µs</td></tr><tr><th scope='row'>CPU</th><td>")
                append_micros_as_millis(buffer, baseline.cpu_micros) if baseline.resource_metrics_available else append_text(buffer, "unavailable")
                append_text(buffer, "</td><td>")
                append_micros_as_millis(buffer, candidate.cpu_micros) if candidate.resource_metrics_available else append_text(buffer, "unavailable")
                append_text(buffer, "</td><td>")
                append_i64(buffer, native_signed_delta(candidate.cpu_micros, baseline.cpu_micros)) if baseline.resource_metrics_available and candidate.resource_metrics_available else append_text(buffer, "unavailable")
                append_text(buffer, " µs</td></tr><tr><th scope='row'>Peak RSS</th><td>")
                append_i64(buffer, baseline.peak_rss_bytes) if baseline.resource_metrics_available else append_text(buffer, "unavailable")
                append_text(buffer, " bytes</td><td>")
                append_i64(buffer, candidate.peak_rss_bytes) if candidate.resource_metrics_available else append_text(buffer, "unavailable")
                append_text(buffer, " bytes</td><td>")
                append_i64(buffer, native_signed_delta(candidate.peak_rss_bytes, baseline.peak_rss_bytes)) if baseline.resource_metrics_available and candidate.resource_metrics_available else append_text(buffer, "unavailable")
                append_text(buffer, "</td></tr><tr><th scope='row'>Events</th><td>")
                append_i64(buffer, baseline.events)
                append_text(buffer, "</td><td>")
                append_i64(buffer, candidate.events)
                append_text(buffer, "</td><td>")
                append_i64(buffer, native_signed_delta(candidate.events, baseline.events))
                append_text(buffer, "</td></tr><tr><th scope='row'>Locations</th><td>")
                append_i64(buffer, baseline.locations)
                append_text(buffer, "</td><td>")
                append_i64(buffer, candidate.locations)
                append_text(buffer, "</td><td>")
                append_i64(buffer, native_signed_delta(candidate.locations, baseline.locations))
                append_text(buffer, "</td></tr></tbody></table>")
                append_comparison_function_changes_html(buffer, baseline.functions, candidate.functions)
                append_comparison_call_edge_changes_html(buffer, baseline.call_edges, candidate.call_edges)
                append_comparison_stack_changes_html(buffer, baseline.stacks, candidate.stacks)
                append_comparison_location_changes_html(buffer, baseline.location_records, candidate.location_records)
                append_text(buffer, "<p><strong>Gate:</strong> ")
                append_text(buffer, "inconclusive" if gate_inconclusive else "failed" if gate_failed else "passed" if comparison_policy_requested(policy) else "not requested")
                append_text(buffer, "</p>")
                if source_mismatch or workload_mismatch or collection_mode_mismatch or compiler_mismatch or optimization_mismatch or identity_mismatch or resource_metrics_mismatch or target_failure or evidence_loss:
                    append_text(buffer, "<section class='warning' aria-labelledby='comparison-warnings'><h2 id='comparison-warnings'>Warnings</h2><ul>")
                    append_text(buffer, "<li>Source paths or contents differ.</li>" if source_mismatch else "")
                    append_text(buffer, "<li>Workload metadata differs.</li>" if workload_mismatch else "")
                    append_text(buffer, "<li>Collection modes differ.</li>" if collection_mode_mismatch else "")
                    append_text(buffer, "<li>Compiler commits differ.</li>" if compiler_mismatch else "")
                    append_text(buffer, "<li>Optimization levels differ.</li>" if optimization_mismatch else "")
                    append_text(buffer, "<li>Stable identity coverage differs; readable-name fallback is unsafe for a gated comparison.</li>" if identity_mismatch else "")
                    append_text(buffer, "<li>Resource metrics are not comparable.</li>" if resource_metrics_mismatch else "")
                    append_text(buffer, "<li>One or both target executions failed.</li>" if target_failure else "")
                    append_text(buffer, "<li>One or both captures contain incomplete or bounded evidence.</li>" if evidence_loss else "")
                    append_text(buffer, "</ul></section>")
                append_text(buffer, "<details><summary>Raw comparison JSON</summary><pre>")
                append_html_escaped(buffer, json_details)
                append_text(buffer, "</pre></details></main></body></html>\n")
                return comparison_gate_exit_code(policy, gate_inconclusive, gate_failed)
            if not format_json:
                append_text(buffer, "Elisa profile comparison\n")
                append_text(buffer, "baseline: ")
                for index in 0..<baseline_path.count |buffer, baseline_path|:
                    buffer.push(baseline_path[index])
                append_text(buffer, "\ncandidate: ")
                for index in 0..<candidate_path.count |buffer, candidate_path|:
                    buffer.push(candidate_path[index])
                append_text(buffer, "\nsource: ")
                append_text(buffer, "same\n" if not source_mismatch else "different\n")
                append_text(buffer, "compiler commit: ")
                append_text(buffer, "same\n" if not compiler_mismatch else "different\n")
                append_text(buffer, "optimization: ")
                append_text(buffer, "same\n" if not optimization_mismatch else "different\n")
                append_text(buffer, "workload metadata: ")
                append_text(buffer, "same\n" if not workload_mismatch else "different\n")
                append_text(buffer, "collection mode: ")
                append_text(buffer, "same\n" if not collection_mode_mismatch else "different\n")
                append_text(buffer, "wall mean: baseline=")
                append_micros_as_millis(buffer, baseline.execution_mean_micros)
                append_text(buffer, " ms candidate=")
                append_micros_as_millis(buffer, candidate.execution_mean_micros)
                append_text(buffer, " ms\ncompile: baseline=")
                append_micros_as_millis(buffer, baseline.compile_micros)
                append_text(buffer, " ms candidate=")
                append_micros_as_millis(buffer, candidate.compile_micros)
                append_text(buffer, " ms\n")
                if resource_metrics_mismatch:
                    append_text(buffer, "CPU: unavailable (resource metrics differ)\n")
                elif not baseline.resource_metrics_available:
                    append_text(buffer, "CPU: unavailable\npeak RSS: unavailable\n")
                else:
                    append_text(buffer, "CPU: baseline=")
                    append_micros_as_millis(buffer, baseline.cpu_micros)
                    append_text(buffer, " ms candidate=")
                    append_micros_as_millis(buffer, candidate.cpu_micros)
                    append_text(buffer, " ms\npeak RSS: baseline=")
                    append_i64(buffer, baseline.peak_rss_bytes)
                    append_text(buffer, " bytes candidate=")
                    append_i64(buffer, candidate.peak_rss_bytes)
                    append_text(buffer, " bytes\n")
                append_text(buffer, "events: baseline=")
                append_i64(buffer, baseline.events)
                append_text(buffer, " candidate=")
                append_i64(buffer, candidate.events)
                append_text(buffer, " delta=")
                append_i64(buffer, native_signed_delta(candidate.events, baseline.events))
                append_text(buffer, "\nlocations: baseline=")
                append_i64(buffer, baseline.locations)
                append_text(buffer, " candidate=")
                append_i64(buffer, candidate.locations)
                append_text(buffer, "\nthreads: baseline=")
                append_i64(buffer, baseline.thread_count)
                append_text(buffer, " candidate=")
                append_i64(buffer, candidate.thread_count)
                append_text(buffer, "\ndropped events: baseline=")
                append_i64(buffer, baseline.dropped)
                append_text(buffer, " candidate=")
                append_i64(buffer, candidate.dropped)
                append_text(buffer, "\nstack overflow entries: baseline=")
                append_i64(buffer, baseline.stack_overflow_entries)
                append_text(buffer, " candidate=")
                append_i64(buffer, candidate.stack_overflow_entries)
                append_text(buffer, "\n")
                append_text(buffer, "functions compared: ")
                append_i64(buffer, baseline.functions.count.i64())
                append_text(buffer, " baseline, ")
                append_i64(buffer, candidate.functions.count.i64())
                append_text(buffer, " candidate; edges baseline=")
                append_i64(buffer, baseline.call_edges.count.i64())
                append_text(buffer, " candidate=")
                append_i64(buffer, candidate.call_edges.count.i64())
                append_text(buffer, "; stacks baseline=")
                append_i64(buffer, baseline.stacks.count.i64())
                append_text(buffer, " candidate=")
                append_i64(buffer, candidate.stacks.count.i64())
                append_text(buffer, "; locations baseline=")
                append_i64(buffer, baseline.location_records.count.i64())
                append_text(buffer, " candidate=")
                append_i64(buffer, candidate.location_records.count.i64())
                append_text(buffer, "\n")
                if source_mismatch or workload_mismatch or collection_mode_mismatch or compiler_mismatch or optimization_mismatch or identity_mismatch or resource_metrics_mismatch or target_failure or evidence_loss:
                    append_text(buffer, "warnings:\n")
                    append_comparison_warning_text(buffer, "baseline and candidate use different source paths or contents", source_mismatch)
                    append_comparison_warning_text(buffer, "baseline and candidate use different workload metadata", workload_mismatch)
                    append_comparison_warning_text(buffer, "baseline and candidate use different collection modes", collection_mode_mismatch)
                    append_comparison_warning_text(buffer, "baseline and candidate use different compiler commits", compiler_mismatch)
                    append_comparison_warning_text(buffer, "baseline and candidate use different optimization levels", optimization_mismatch)
                    append_comparison_warning_text(buffer, "baseline and candidate differ in stable identity coverage; readable-name fallback is unsafe for a gated comparison", identity_mismatch)
                    append_comparison_warning_text(buffer, "baseline and candidate differ in resource-metric availability", resource_metrics_mismatch)
                    append_comparison_warning_text(buffer, "baseline or candidate target execution failed", target_failure)
                    append_comparison_warning_text(buffer, "one or both captures contain incomplete or bounded evidence", evidence_loss)
                append_text(buffer, "gate: ")
                append_text(buffer, "inconclusive" if gate_inconclusive else "failed" if gate_failed else "passed" if comparison_policy_requested(policy) else "not requested")
                append_text(buffer, "\n")
                return comparison_gate_exit_code(policy, gate_inconclusive, gate_failed)
            append_text(buffer, "{\"kind\":\"profile_comparison\",\"schema_version\":")
            append_i64(buffer, NATIVE_REPORT_SCHEMA_VERSION)
            append_text(buffer, ",\"baseline\":{\"path\":")
            append_json_string(buffer, baseline_path)
            append_text(buffer, ",\"source\":")
            append_json_string(buffer, baseline.source)
            append_text(buffer, ",\"compiler_commit\":")
            append_json_string(buffer, baseline.compiler_commit)
            append_text(buffer, ",\"opt_level\":")
            append_json_string(buffer, baseline.opt_level)
            append_text(buffer, ",\"collection_mode\":")
            append_json_string(buffer, baseline.collection_mode)
            append_text(buffer, ",\"identity\":\"")
            append_text(buffer, "compiler_stable_ids" if baseline.stable_ids_available else "source_name_fallback")
            append_text(buffer, "\"")
            append_text(buffer, ",\"exit_code\":")
            if baseline.exit_code < NATIVE_ZERO:
                append_text(buffer, "null")
            else:
                append_i64(buffer, baseline.exit_code)
            append_text(buffer, "},\"candidate\":{\"path\":")
            append_json_string(buffer, candidate_path)
            append_text(buffer, ",\"source\":")
            append_json_string(buffer, candidate.source)
            append_text(buffer, ",\"compiler_commit\":")
            append_json_string(buffer, candidate.compiler_commit)
            append_text(buffer, ",\"opt_level\":")
            append_json_string(buffer, candidate.opt_level)
            append_text(buffer, ",\"collection_mode\":")
            append_json_string(buffer, candidate.collection_mode)
            append_text(buffer, ",\"identity\":\"")
            append_text(buffer, "compiler_stable_ids" if candidate.stable_ids_available else "source_name_fallback")
            append_text(buffer, "\"")
            append_text(buffer, ",\"exit_code\":")
            if candidate.exit_code < NATIVE_ZERO:
                append_text(buffer, "null")
            else:
                append_i64(buffer, candidate.exit_code)
            append_text(buffer, "},\"workload_metadata_match\":")
            append_text(buffer, "false" if workload_mismatch else "true")
            append_text(buffer, ",\"collection_mode_match\":")
            append_text(buffer, "false" if collection_mode_mismatch else "true")
            append_text(buffer, ",\"functions\":")
            append_comparison_functions_json(buffer, baseline.functions, candidate.functions)
            append_text(buffer, ",\"call_edges\":")
            append_comparison_call_edges_json(buffer, baseline.call_edges, candidate.call_edges)
            append_text(buffer, ",\"stacks\":")
            append_comparison_stacks_json(buffer, baseline.stacks, candidate.stacks)
            append_text(buffer, ",\"locations\":")
            append_comparison_locations_json(buffer, baseline.location_records, candidate.location_records)
            append_text(buffer, ",\"metrics\":{\"execution_ms_mean\":{\"baseline\":")
            append_micros_as_millis(buffer, baseline.execution_mean_micros)
            append_text(buffer, ",\"candidate\":")
            append_micros_as_millis(buffer, candidate.execution_mean_micros)
            append_text(buffer, ",\"delta_micros\":")
            append_i64(buffer, native_signed_delta(candidate.execution_mean_micros, baseline.execution_mean_micros))
            append_text(buffer, "},\"compile_ms\":{\"baseline\":")
            append_micros_as_millis(buffer, baseline.compile_micros)
            append_text(buffer, ",\"candidate\":")
            append_micros_as_millis(buffer, candidate.compile_micros)
            append_text(buffer, ",\"delta_micros\":")
            append_i64(buffer, native_signed_delta(candidate.compile_micros, baseline.compile_micros))
            append_text(buffer, "},\"cpu_ms\":")
            append_comparison_nullable_timed_metric(buffer, baseline.cpu_micros, candidate.cpu_micros, baseline.resource_metrics_available, candidate.resource_metrics_available)
            append_text(buffer, ",\"peak_rss_bytes\":")
            append_comparison_nullable_count_metric(buffer, baseline.peak_rss_bytes, candidate.peak_rss_bytes, baseline.resource_metrics_available, candidate.resource_metrics_available)
            append_text(buffer, ",\"events\":{\"baseline\":")
            append_i64(buffer, baseline.events)
            append_text(buffer, ",\"candidate\":")
            append_i64(buffer, candidate.events)
            append_text(buffer, ",\"delta\":")
            append_i64(buffer, native_signed_delta(candidate.events, baseline.events))
            append_text(buffer, "},\"locations\":{\"baseline\":")
            append_i64(buffer, baseline.locations)
            append_text(buffer, ",\"candidate\":")
            append_i64(buffer, candidate.locations)
            append_text(buffer, ",\"delta\":")
            append_i64(buffer, native_signed_delta(candidate.locations, baseline.locations))
            append_text(buffer, "},\"dropped_events\":{\"baseline\":")
            append_i64(buffer, baseline.dropped)
            append_text(buffer, ",\"candidate\":")
            append_i64(buffer, candidate.dropped)
            append_text(buffer, ",\"delta\":")
            append_i64(buffer, native_signed_delta(candidate.dropped, baseline.dropped))
            append_text(buffer, "},\"thread_count\":{\"baseline\":")
            append_i64(buffer, baseline.thread_count)
            append_text(buffer, ",\"candidate\":")
            append_i64(buffer, candidate.thread_count)
            append_text(buffer, ",\"delta\":")
            append_i64(buffer, native_signed_delta(candidate.thread_count, baseline.thread_count))
            append_text(buffer, "},\"stack_overflow_entries\":{\"baseline\":")
            append_i64(buffer, baseline.stack_overflow_entries)
            append_text(buffer, ",\"candidate\":")
            append_i64(buffer, candidate.stack_overflow_entries)
            append_text(buffer, ",\"delta\":")
            append_i64(buffer, native_signed_delta(candidate.stack_overflow_entries, baseline.stack_overflow_entries))
            append_text(buffer, "},\"trace_events_omitted\":{\"baseline\":")
            append_i64(buffer, baseline.trace_events_omitted)
            append_text(buffer, ",\"candidate\":")
            append_i64(buffer, candidate.trace_events_omitted)
            append_text(buffer, ",\"delta\":")
            append_i64(buffer, native_signed_delta(candidate.trace_events_omitted, baseline.trace_events_omitted))
            append_text(buffer, "}}")
            append_comparison_gate_json(buffer, policy, gate_inconclusive, gate_failed, wall_percent_failed, wall_absolute_failed, cpu_percent_failed, cpu_absolute_failed, rss_percent_failed, rss_absolute_failed, function_failed)
            append_text(buffer, ",\"warnings\":[")
            warning_first: mutable bool = true
            warning_count: mutable i64 = NATIVE_ZERO
            warning_count <- warning_count + append_comparison_warning_json(buffer, "baseline and candidate use different source paths or contents", source_mismatch, &warning_first)
            warning_count <- warning_count + append_comparison_warning_json(buffer, "baseline and candidate use different workload metadata", workload_mismatch, &warning_first)
            warning_count <- warning_count + append_comparison_warning_json(buffer, "baseline and candidate use different collection modes", collection_mode_mismatch, &warning_first)
            warning_count <- warning_count + append_comparison_warning_json(buffer, "baseline and candidate use different compiler commits", compiler_mismatch, &warning_first)
            warning_count <- warning_count + append_comparison_warning_json(buffer, "baseline and candidate use different optimization levels", optimization_mismatch, &warning_first)
            warning_count <- warning_count + append_comparison_warning_json(buffer, "baseline and candidate differ in stable identity coverage; readable-name fallback is unsafe for a gated comparison", identity_mismatch, &warning_first)
            warning_count <- warning_count + append_comparison_warning_json(buffer, "baseline and candidate differ in resource-metric availability", resource_metrics_mismatch, &warning_first)
            warning_count <- warning_count + append_comparison_warning_json(buffer, "baseline or candidate target execution failed", target_failure, &warning_first)
            warning_count <- warning_count + append_comparison_warning_json(buffer, "one or both captures contain incomplete or bounded evidence", evidence_loss, &warning_first)
            append_text(buffer, "],\"status\":\"")
            append_text(buffer, "warning" if warning_count > NATIVE_ZERO else "ok")
            append_text(buffer, "\"}\n")
            return comparison_gate_exit_code(policy, gate_inconclusive, gate_failed)


        def compare_offline(argc: i64, slots: mutable cstr&&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            return report_error("usage: elisa-profiler compare BASELINE CANDIDATE [--format text|json|html] [--output PATH] [--max-wall-regression-percent N] [--max-wall-ms N] [--max-cpu-regression-percent N] [--max-cpu-ms N] [--max-rss-regression-percent N] [--max-rss-bytes N] [--max-function-self-regression-percent N]") if argc < NATIVE_MIN_COMPARE_ARGUMENTS
            baseline_path: mutable darray[u8] = []
            candidate_path: mutable darray[u8] = []
            output_path: mutable darray[u8] = []
            policy: mutable ComparisonPolicy = ComparisonPolicy{
                max_wall_regression_percent: NATIVE_COMPARISON_THRESHOLD_DISABLED,
                max_wall_micros: NATIVE_COMPARISON_THRESHOLD_DISABLED,
                max_cpu_regression_percent: NATIVE_COMPARISON_THRESHOLD_DISABLED,
                max_cpu_micros: NATIVE_COMPARISON_THRESHOLD_DISABLED,
                max_rss_regression_percent: NATIVE_COMPARISON_THRESHOLD_DISABLED,
                max_rss_bytes: NATIVE_COMPARISON_THRESHOLD_DISABLED,
                max_function_self_regression_percent: NATIVE_COMPARISON_THRESHOLD_DISABLED,
            }
            copy_cstr(baseline_path, slots[NATIVE_COMPARE_BASELINE_INDEX].cast[cstr])
            copy_cstr(candidate_path, slots[NATIVE_COMPARE_CANDIDATE_INDEX].cast[cstr])
            format_json: mutable bool = false
            format_html: mutable bool = false
            index: mutable i64 = NATIVE_COMPARE_FIRST_OPTION_INDEX
            while index < argc |index, slots, output_path, format_json, format_html, policy|:
                argument: cstr = slots[index].cast[cstr]
                if profiler_ffi_strcmp(argument, "--format") == NATIVE_ZERO:
                    return report_error("--format requires text, json, or html") if index + NATIVE_ONE >= argc
                    if profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "json") == NATIVE_ZERO:
                        format_json <- true
                        format_html <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "text") == NATIVE_ZERO:
                        format_json <- false
                        format_html <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "html") == NATIVE_ZERO:
                        format_json <- false
                        format_html <- true
                    else:
                        return report_error("--format requires text, json, or html")
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--output") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "-o") == NATIVE_ZERO:
                    return report_error("--output requires a path") if index + NATIVE_ONE >= argc
                    copy_cstr(output_path, slots[index + NATIVE_ONE].cast[cstr])
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--max-wall-regression-percent") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "--max-wall-regression-pct") == NATIVE_ZERO:
                    return report_error("--max-wall-regression-percent requires a non-negative integer") if index + NATIVE_ONE >= argc
                    value: i64 = parse_nonnegative_integer(slots[index + NATIVE_ONE].cast[cstr])
                    return report_error("--max-wall-regression-percent must be between 0 and 1000000") if value < NATIVE_ZERO or value > NATIVE_COMPARISON_MAX_PERCENT
                    policy.max_wall_regression_percent <- value
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--max-wall-ms") == NATIVE_ZERO:
                    return report_error("--max-wall-ms requires a non-negative integer") if index + NATIVE_ONE >= argc
                    value: i64 = parse_nonnegative_integer(slots[index + NATIVE_ONE].cast[cstr])
                    return report_error("--max-wall-ms requires a non-negative integer") if value < NATIVE_ZERO
                    policy.max_wall_micros <- native_saturating_mul_nonnegative(value, NATIVE_MICROSECONDS_PER_MILLISECOND)
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--max-cpu-regression-percent") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "--max-cpu-regression-pct") == NATIVE_ZERO:
                    return report_error("--max-cpu-regression-percent requires a non-negative integer") if index + NATIVE_ONE >= argc
                    value: i64 = parse_nonnegative_integer(slots[index + NATIVE_ONE].cast[cstr])
                    return report_error("--max-cpu-regression-percent must be between 0 and 1000000") if value < NATIVE_ZERO or value > NATIVE_COMPARISON_MAX_PERCENT
                    policy.max_cpu_regression_percent <- value
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--max-cpu-ms") == NATIVE_ZERO:
                    return report_error("--max-cpu-ms requires a non-negative integer") if index + NATIVE_ONE >= argc
                    value: i64 = parse_nonnegative_integer(slots[index + NATIVE_ONE].cast[cstr])
                    return report_error("--max-cpu-ms requires a non-negative integer") if value < NATIVE_ZERO
                    policy.max_cpu_micros <- native_saturating_mul_nonnegative(value, NATIVE_MICROSECONDS_PER_MILLISECOND)
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--max-rss-regression-percent") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "--max-rss-regression-pct") == NATIVE_ZERO:
                    return report_error("--max-rss-regression-percent requires a non-negative integer") if index + NATIVE_ONE >= argc
                    value: i64 = parse_nonnegative_integer(slots[index + NATIVE_ONE].cast[cstr])
                    return report_error("--max-rss-regression-percent must be between 0 and 1000000") if value < NATIVE_ZERO or value > NATIVE_COMPARISON_MAX_PERCENT
                    policy.max_rss_regression_percent <- value
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--max-rss-bytes") == NATIVE_ZERO:
                    return report_error("--max-rss-bytes requires a non-negative integer") if index + NATIVE_ONE >= argc
                    value: i64 = parse_nonnegative_integer(slots[index + NATIVE_ONE].cast[cstr])
                    return report_error("--max-rss-bytes requires a non-negative integer") if value < NATIVE_ZERO
                    policy.max_rss_bytes <- value
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--max-function-self-regression-percent") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "--max-function-self-regression-pct") == NATIVE_ZERO:
                    return report_error("--max-function-self-regression-percent requires a non-negative integer") if index + NATIVE_ONE >= argc
                    value: i64 = parse_nonnegative_integer(slots[index + NATIVE_ONE].cast[cstr])
                    return report_error("--max-function-self-regression-percent must be between 0 and 1000000") if value < NATIVE_ZERO or value > NATIVE_COMPARISON_MAX_PERCENT
                    policy.max_function_self_regression_percent <- value
                    index <- index + NATIVE_TWO
                    continue
                return report_error("unknown compare option")
            baseline_data: darray[u8] = read_file(baseline_path)
            candidate_data: darray[u8] = read_file(candidate_path)
            return report_error("baseline capture could not be read") if baseline_data.count == NATIVE_ZERO.usize()
            return report_error("candidate capture could not be read") if candidate_data.count == NATIVE_ZERO.usize()
            baseline_capture: mutable darray[u8] = []
            candidate_capture: mutable darray[u8] = []
            return report_error("baseline artifact is malformed or unsupported") if not unwrap_profile_artifact(baseline_data, &baseline_capture)
            return report_error("candidate artifact is malformed or unsupported") if not unwrap_profile_artifact(candidate_data, &candidate_capture)
            return report_error("baseline detail arrays contain invalid accounting") if not json_validate_detail_arrays(baseline_capture)
            return report_error("candidate detail arrays contain invalid accounting") if not json_validate_detail_arrays(candidate_capture)
            baseline: mutable ComparisonCapture = ComparisonCapture{
                source: [], workload_identity: [], collection_mode: [], compiler_branch: [], compiler_commit: [], opt_level: [], events: NATIVE_ZERO, locations: NATIVE_ZERO,
                dropped: NATIVE_ZERO, frame_dropped: NATIVE_ZERO, dropped_call_edges: NATIVE_ZERO, dropped_stacks: NATIVE_ZERO, stack_overflow_entries: NATIVE_ZERO, thread_count: NATIVE_ZERO, trace_events_omitted: NATIVE_ZERO,
                execution_mean_micros: NATIVE_ZERO, compile_micros: NATIVE_ZERO, cpu_micros: NATIVE_ZERO, peak_rss_bytes: NATIVE_ZERO, resource_metrics_available: false, stable_ids_available: false, exit_code: NATIVE_ZERO, detail_budget_exceeded: false, functions: [], call_edges: [], stacks: [], location_records: []
            }
            candidate: mutable ComparisonCapture = ComparisonCapture{
                source: [], workload_identity: [], collection_mode: [], compiler_branch: [], compiler_commit: [], opt_level: [], events: NATIVE_ZERO, locations: NATIVE_ZERO,
                dropped: NATIVE_ZERO, frame_dropped: NATIVE_ZERO, dropped_call_edges: NATIVE_ZERO, dropped_stacks: NATIVE_ZERO, stack_overflow_entries: NATIVE_ZERO, thread_count: NATIVE_ZERO, trace_events_omitted: NATIVE_ZERO,
                execution_mean_micros: NATIVE_ZERO, compile_micros: NATIVE_ZERO, cpu_micros: NATIVE_ZERO, peak_rss_bytes: NATIVE_ZERO, resource_metrics_available: false, stable_ids_available: false, exit_code: NATIVE_ZERO, detail_budget_exceeded: false, functions: [], call_edges: [], stacks: [], location_records: []
            }
            return report_error("baseline capture is not a supported native JSON profile") if not read_comparison_capture(baseline_capture, &baseline)
            return report_error("candidate capture is not a supported native JSON profile") if not read_comparison_capture(candidate_capture, &candidate)
            rendered: mutable darray[u8] = []
            gate_status: i64 = append_comparison_report(&rendered, baseline_path, candidate_path, baseline, candidate, format_json, format_html, policy)
            if output_path.count > NATIVE_ZERO.usize():
                return gate_status if write_file(output_path, rendered)
                return report_error("could not write native comparison report")
            _ = write_all_fd(NATIVE_STANDARD_OUTPUT, rendered) can Console
            return gate_status
