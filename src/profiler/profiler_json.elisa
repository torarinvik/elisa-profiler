            array_stop: i64 = json_array_end(data, array_start.usize(), data.count)
            return false if array_stop < NATIVE_ZERO
            cursor: mutable usize = array_start.usize() + NATIVE_ONE.usize()
            content_stop: usize = array_stop.usize() - NATIVE_ONE.usize()
            record_count: mutable i64 = NATIVE_ZERO
            while cursor < content_stop |cursor, content_stop, data, records, record_count|:
                cursor <- json_skip_whitespace(data, cursor, content_stop)
                break if cursor >= content_stop or data[cursor] == NATIVE_BYTE_RIGHT_BRACKET
                return false if record_count >= NATIVE_MAX_PROTOCOL_DETAIL_RECORDS or data[cursor] != NATIVE_BYTE_LEFT_BRACE
                object_stop: i64 = json_object_end(data, cursor, content_stop)
                return false if object_stop < NATIVE_ZERO
                record: mutable ComparisonLocationRecord = ComparisonLocationRecord{
                    source: [], kind: [], function: [], variable: [], identity_id: [], line: NATIVE_ZERO, signed: false,
                    source_available: false, variable_available: false, count: NATIVE_ZERO, interval_ns: NATIVE_ZERO, max_interval_ns: NATIVE_ZERO
                }
                return false if not json_read_nullable_string_field(data, "source", cursor, object_stop.usize(), &record.source, &record.source_available)
                return false if not json_read_string_field(data, "kind", cursor, object_stop.usize(), &record.kind)
                return false if not protocol_field_is(record.kind, "statement") and not protocol_field_is(record.kind, "value") and not protocol_field_is(record.kind, "function")
                return false if not json_read_string_field(data, "function", cursor, object_stop.usize(), &record.function) or record.function.count == NATIVE_ZERO.usize()
                return false if not json_read_optional_unsigned_text_field(data, "identity_id", cursor, object_stop.usize(), &record.identity_id)
                return false if not json_read_number_field(data, "line", cursor, object_stop.usize(), &record.line)
                return false if not json_read_nullable_string_field(data, "variable", cursor, object_stop.usize(), &record.variable, &record.variable_available)
                return false if not json_read_optional_bool_field(data, "signed", cursor, object_stop.usize(), &record.signed)
                return false if not json_read_number_field(data, "count", cursor, object_stop.usize(), &record.count)
                return false if not json_read_number_field(data, "interval_ns", cursor, object_stop.usize(), &record.interval_ns)
                return false if not json_read_number_field(data, "max_interval_ns", cursor, object_stop.usize(), &record.max_interval_ns)
                return false if record.max_interval_ns > record.interval_ns
                if protocol_field_is(record.kind, "value"):
                    return false if not json_validate_value_statistics(data, cursor, object_stop.usize())
                elif protocol_field_is(record.kind, "function"):
                    inclusive_ns: mutable i64 = NATIVE_ZERO
                    self_ns: mutable i64 = NATIVE_ZERO
                    completed_calls: mutable i64 = NATIVE_ZERO
                    return false if not json_read_number_field(data, "inclusive_ns", cursor, object_stop.usize(), &inclusive_ns)
                    return false if not json_read_number_field(data, "self_ns", cursor, object_stop.usize(), &self_ns)
                    return false if not json_read_number_field(data, "completed_calls", cursor, object_stop.usize(), &completed_calls)
                    return false if self_ns > inclusive_ns or completed_calls > record.count
                records.push(record)
                record_count <- record_count + NATIVE_ONE
                cursor <- object_stop.usize()
                cursor <- json_skip_whitespace(data, cursor, content_stop)
                if cursor < content_stop:
                    return false if data[cursor] != NATIVE_BYTE_COMMA
                    cursor <- cursor + NATIVE_ONE.usize()
            return true


        def json_validate_detail_arrays(data: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if not json_read_detail_array(data, "functions", NATIVE_ZERO.usize(), data.count, NATIVE_DETAIL_ARRAY_FUNCTIONS)
            return false if not json_read_detail_array(data, "call_edges", NATIVE_ZERO.usize(), data.count, NATIVE_DETAIL_ARRAY_CALL_EDGES)
            return false if not json_read_detail_array(data, "stacks", NATIVE_ZERO.usize(), data.count, NATIVE_DETAIL_ARRAY_STACKS)
            return false if not json_read_detail_array(data, "locations", NATIVE_ZERO.usize(), data.count, NATIVE_DETAIL_ARRAY_LOCATIONS)
            thread_start: i64 = json_key_value_start(data, "thread_loss", NATIVE_ZERO.usize(), data.count)
            return true if thread_start < NATIVE_ZERO
            return false if data[thread_start.usize()] != NATIVE_BYTE_LEFT_BRACKET
            thread_stop: i64 = json_array_end(data, thread_start.usize(), data.count)
            return false if thread_stop < NATIVE_ZERO
            cursor: mutable usize = thread_start.usize() + NATIVE_ONE.usize()
            content_stop: usize = thread_stop.usize() - NATIVE_ONE.usize()
            thread_record_count: mutable i64 = NATIVE_ZERO
            while cursor < content_stop |cursor, content_stop, data, thread_record_count|:
                cursor <- json_skip_whitespace(data, cursor, content_stop)
                break if cursor >= content_stop or data[cursor] == NATIVE_BYTE_RIGHT_BRACKET
                return false if thread_record_count >= NATIVE_MAX_PROTOCOL_THREAD_RECORDS
                return false if data[cursor] != NATIVE_BYTE_LEFT_BRACE
                object_stop: i64 = json_object_end(data, cursor, content_stop)
                return false if object_stop < NATIVE_ZERO
                repetition: mutable i64 = NATIVE_ZERO
                thread_id: mutable i64 = NATIVE_ZERO
                events: mutable i64 = NATIVE_ZERO
                location_dropped: mutable i64 = NATIVE_ZERO
                call_edge_dropped: mutable i64 = NATIVE_ZERO
                stack_dropped: mutable i64 = NATIVE_ZERO
                trace_dropped: mutable i64 = NATIVE_ZERO
                bytes_dropped: mutable i64 = NATIVE_ZERO
                return false if not json_read_optional_number_field(data, "repetition", cursor, object_stop.usize(), &repetition)
                return false if not json_read_number_field(data, "thread_id", cursor, object_stop.usize(), &thread_id)
                return false if not json_read_number_field(data, "events", cursor, object_stop.usize(), &events)
                return false if not json_read_number_field(data, "location_dropped", cursor, object_stop.usize(), &location_dropped)
                return false if not json_read_number_field(data, "call_edge_dropped", cursor, object_stop.usize(), &call_edge_dropped)
                return false if not json_read_number_field(data, "stack_dropped", cursor, object_stop.usize(), &stack_dropped)
                return false if not json_read_number_field(data, "trace_dropped", cursor, object_stop.usize(), &trace_dropped)
                return false if not json_read_number_field(data, "bytes_dropped", cursor, object_stop.usize(), &bytes_dropped)
                return false if repetition < NATIVE_ZERO or repetition == NATIVE_ZERO and json_key_value_start(data, "repetition", cursor, object_stop.usize()) >= NATIVE_ZERO or thread_id < NATIVE_ZERO or events < NATIVE_ZERO or location_dropped < NATIVE_ZERO or call_edge_dropped < NATIVE_ZERO or stack_dropped < NATIVE_ZERO or trace_dropped < NATIVE_ZERO or bytes_dropped < NATIVE_ZERO
                thread_record_count <- thread_record_count + NATIVE_ONE
                cursor <- object_stop.usize()
                cursor <- json_skip_whitespace(data, cursor, content_stop)
                if cursor < content_stop:
                    return false if data[cursor] != NATIVE_BYTE_COMMA
                    cursor <- cursor + NATIVE_ONE.usize()
            return true


        def json_validate_sample_array(data: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            array_start: i64 = json_key_value_start(data, "samples", NATIVE_ZERO.usize(), data.count)
            return true if array_start < NATIVE_ZERO
            return false if data[array_start.usize()] != NATIVE_BYTE_LEFT_BRACKET
            array_stop: i64 = json_array_end(data, array_start.usize(), data.count)
            return false if array_stop < NATIVE_ZERO
            cursor: mutable usize = array_start.usize() + NATIVE_ONE.usize()
            content_stop: usize = array_stop.usize() - NATIVE_ONE.usize()
            record_count: mutable i64 = NATIVE_ZERO
            while cursor < content_stop |cursor, content_stop, data, record_count|:
                cursor <- json_skip_whitespace(data, cursor, content_stop)
                break if cursor >= content_stop or data[cursor] == NATIVE_BYTE_RIGHT_BRACKET
                return false if record_count >= NATIVE_MAX_PROTOCOL_SAMPLE_RECORDS or data[cursor] != NATIVE_BYTE_LEFT_BRACE
                object_stop: i64 = json_object_end(data, cursor, content_stop)
                return false if object_stop < NATIVE_ZERO
                sequence: mutable i64 = NATIVE_ZERO
                thread_id: mutable i64 = NATIVE_ZERO
                thread_available: mutable bool = false
                depth: mutable i64 = NATIVE_ZERO
                overflow_depth: mutable i64 = NATIVE_ZERO
                stack_value: mutable darray[u8] = []
                repetition: mutable i64 = NATIVE_ZERO
                return false if not json_read_number_field(data, "sequence", cursor, object_stop.usize(), &sequence)
                return false if not json_read_nullable_number_field(data, "thread_id", cursor, object_stop.usize(), &thread_id, &thread_available)
                return false if not json_read_number_field(data, "depth", cursor, object_stop.usize(), &depth)
                return false if not json_read_number_field(data, "overflow_depth", cursor, object_stop.usize(), &overflow_depth)
                return false if not json_read_string_field(data, "stack", cursor, object_stop.usize(), &stack_value) or stack_value.count == NATIVE_ZERO.usize()
                return false if not json_read_optional_number_field(data, "repetition", cursor, object_stop.usize(), &repetition)
                return false if depth < NATIVE_ZERO or overflow_depth < NATIVE_ZERO or thread_available and thread_id < NATIVE_ZERO or repetition < NATIVE_ZERO
                record_count <- record_count + NATIVE_ONE
                cursor <- object_stop.usize()
                cursor <- json_skip_whitespace(data, cursor, content_stop)
                if cursor < content_stop:
                    return false if data[cursor] != NATIVE_BYTE_COMMA
                    cursor <- cursor + NATIVE_ONE.usize()
            return true


        def json_read_millis_field(data: darray[u8]&, key: sview, start: usize, stop: usize, result: mutable i64&) -> bool can[Abort.Panic]:
            value_start: i64 = json_key_value_start(data, key, start, stop)
            return false if value_start < NATIVE_ZERO
            value: i64 = json_millis_micros_at(data, value_start.usize(), stop)
            return false if value < NATIVE_ZERO
            result <- value
            return true


        def json_read_bool_field(data: darray[u8]&, key: sview, start: usize, stop: usize, result: mutable bool&) -> bool can[Abort.Panic]:
            value_start: i64 = json_key_value_start(data, key, start, stop)
            return false if value_start < NATIVE_ZERO
            return json_bool_into(data, value_start.usize(), stop, result)


        def byte_arrays_equal(left: darray[u8]&, right: darray[u8]&) -> bool can[Abort.Panic]:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            return true


        def json_validate_report_envelope(data: darray[u8]&, schema_version: i64, expected_kind: sview) -> bool can[Abort.Panic, Memory.Allocate]:
            return true if schema_version == NATIVE_LEGACY_REPORT_SCHEMA_VERSION
            return false if schema_version != NATIVE_REPORT_SCHEMA_VERSION
            envelope_start: i64 = json_key_value_start(data, "envelope", NATIVE_ZERO.usize(), data.count)
            return false if envelope_start < NATIVE_ZERO or data[envelope_start.usize()] != NATIVE_BYTE_LEFT_BRACE
            envelope_stop: i64 = json_object_end(data, envelope_start.usize(), data.count)
            return false if envelope_stop < NATIVE_ZERO
            major: mutable i64 = NATIVE_ZERO
            minor: mutable i64 = NATIVE_ZERO
            kind: mutable darray[u8] = []
            compatibility: mutable darray[u8] = []
            return false if not json_read_number_field(data, "major", envelope_start.usize(), envelope_stop.usize(), &major)
            return false if not json_read_number_field(data, "minor", envelope_start.usize(), envelope_stop.usize(), &minor)
            return false if not json_read_string_field(data, "kind", envelope_start.usize(), envelope_stop.usize(), &kind)
            return false if not json_read_string_field(data, "compatibility", envelope_start.usize(), envelope_stop.usize(), &compatibility)
            return false if major != NATIVE_REPORT_ENVELOPE_MAJOR or minor < NATIVE_ZERO or minor > NATIVE_REPORT_ENVELOPE_MINOR
            return false if not protocol_field_is(kind, expected_kind)
            return false if not protocol_field_is(compatibility, "backward-compatible-v1")
            return true


        def json_validate_source_snapshot(data: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            snapshot_start: i64 = json_key_value_start(data, "source_snapshot", NATIVE_ZERO.usize(), data.count)
            return true if snapshot_start < NATIVE_ZERO
            return false if data[snapshot_start.usize()] != NATIVE_BYTE_LEFT_BRACE
            snapshot_stop: i64 = json_object_end(data, snapshot_start.usize(), data.count)
            return false if snapshot_stop < NATIVE_ZERO
            digest: mutable darray[u8] = []
            content: mutable darray[u8] = []
            return false if not json_read_string_field(data, "sha256", snapshot_start.usize(), snapshot_stop.usize(), &digest)
            return false if not json_read_string_field(data, "content", snapshot_start.usize(), snapshot_stop.usize(), &content)
            expected: darray[u8] = sha256_hex(content)
            return byte_arrays_equal(digest, expected)



        # Normalize and validate an offline profile exactly once. Presentation
        # modules receive this model instead of raw JSON so each output format
        # shares the same compatibility, bounds, and optional-field policy.
        def read_offline_profile(data: darray[u8]&, profile: mutable NativeOfflineProfile&) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if not json_document_is_object(data)
            schema_version: mutable i64 = NATIVE_ZERO
            return false if not json_read_number_field(data, "schema_version", NATIVE_ZERO.usize(), data.count, &schema_version)
            return false if not json_validate_report_envelope(data, schema_version, "profile")
            return false if not json_validate_source_snapshot(data)
            return false if not json_validate_detail_arrays(data)
            return false if not json_validate_sample_array(data)

            profile.source <- []
            profile.source_snapshot <- []
            profile.source_digest <- []
            profile.workload <- []
            profile.outcome <- []
            profile.functions <- []
            profile.call_edges <- []
            profile.stacks <- []
            profile.location_records <- []
            profile.thread_loss <- []
            profile.folded_records <- []
            profile.sample_records <- []
            profile.source_digest_available <- false
            profile.crash_signal_available <- false
            profile.capture_complete_available <- false
            profile.execution_mean_available <- false
            profile.cpu_available <- false
            profile.peak_rss_available <- false
            profile.location_timing <- false
            profile.host <- NativeHostMetadata{available: false, os: [], architecture: [], load_average_1m: NATIVE_ZERO_F64, load_average_available: false}

            source_start: i64 = json_source_value_start(data)
            return false if source_start < NATIVE_ZERO
            return false if json_string_into(data, source_start.usize(), data.count, &profile.source) < NATIVE_ZERO

            snapshot_start: i64 = json_key_value_start(data, "source_snapshot", NATIVE_ZERO.usize(), data.count)
            if snapshot_start >= NATIVE_ZERO:
                return false if data[snapshot_start.usize()] != NATIVE_BYTE_LEFT_BRACE
                snapshot_stop: i64 = json_object_end(data, snapshot_start.usize(), data.count)
                return false if snapshot_stop < NATIVE_ZERO
                return false if not json_read_string_field(data, "content", snapshot_start.usize(), snapshot_stop.usize(), &profile.source_snapshot)

            summary_start: i64 = json_key_value_start(data, "summary", NATIVE_ZERO.usize(), data.count)
            run_start: i64 = json_key_value_start(data, "run", NATIVE_ZERO.usize(), data.count)
            return false if summary_start < NATIVE_ZERO or run_start < NATIVE_ZERO
            summary_stop: i64 = json_object_end(data, summary_start.usize(), data.count)
            run_stop: i64 = json_object_end(data, run_start.usize(), data.count)
            return false if summary_stop < NATIVE_ZERO or run_stop < NATIVE_ZERO

            return false if not json_read_number_field(data, "events", summary_start.usize(), summary_stop.usize(), &profile.events)
            return false if not json_read_number_field(data, "locations", summary_start.usize(), summary_stop.usize(), &profile.locations)
            return false if not json_read_number_field(data, "statement_events", summary_start.usize(), summary_stop.usize(), &profile.statement_events)
            return false if not json_read_number_field(data, "value_events", summary_start.usize(), summary_stop.usize(), &profile.value_events)
            return false if not json_read_number_field(data, "function_events", summary_start.usize(), summary_stop.usize(), &profile.function_events)
            return false if not json_read_number_field(data, "dropped", summary_start.usize(), summary_stop.usize(), &profile.dropped)
            return false if not json_read_number_field(data, "thread_count", summary_start.usize(), summary_stop.usize(), &profile.thread_count)
            return false if not json_read_optional_number_field(data, "dropped_call_edges", summary_start.usize(), summary_stop.usize(), &profile.call_edge_dropped)
            return false if not json_read_optional_number_field(data, "dropped_stacks", summary_start.usize(), summary_stop.usize(), &profile.stack_dropped)
            return false if not json_read_optional_number_field(data, "frame_dropped", summary_start.usize(), summary_stop.usize(), &profile.frame_dropped)
            return false if not json_read_optional_number_field(data, "capture_bytes_dropped", summary_start.usize(), summary_stop.usize(), &profile.capture_bytes_dropped)
            return false if not json_read_optional_number_field(data, "stack_overflow_entries", summary_start.usize(), summary_stop.usize(), &profile.stack_overflow_entries)
            return false if not json_read_optional_number_field(data, "trace_events_omitted", summary_start.usize(), summary_stop.usize(), &profile.trace_omitted)
            return false if not json_read_optional_number_field(data, "sample_count", summary_start.usize(), summary_stop.usize(), &profile.sample_count)
            return false if not json_read_optional_number_field(data, "sample_missed", summary_start.usize(), summary_stop.usize(), &profile.sample_missed)
            return false if not json_read_optional_number_field(data, "sample_period_microseconds", summary_start.usize(), summary_stop.usize(), &profile.sample_period_microseconds)
            return false if not json_read_optional_number_field(data, "sampling_setup_failed", summary_start.usize(), summary_stop.usize(), &profile.sampling_setup_failed)
            return false if not json_read_nullable_number_field(data, "crash_signal", summary_start.usize(), summary_stop.usize(), &profile.crash_signal, &profile.crash_signal_available)
            return false if not json_read_exit_code_field(data, run_start.usize(), run_stop.usize(), &profile.exit_code)

            outcome_start: i64 = json_key_value_start(data, "outcome", run_start.usize(), run_stop.usize())
            if outcome_start >= NATIVE_ZERO:
                return false if json_string_into(data, outcome_start.usize(), run_stop.usize(), &profile.outcome) < NATIVE_ZERO
            if profile.outcome.count == NATIVE_ZERO.usize():
                append_text(profile.outcome, "success" if profile.exit_code == NATIVE_ZERO else "target_exit")

            capture_complete_start: i64 = json_key_value_start(data, "capture_complete", summary_start.usize(), summary_stop.usize())
            if capture_complete_start >= NATIVE_ZERO:
                return false if not json_read_bool_field(data, "capture_complete", summary_start.usize(), summary_stop.usize(), &profile.capture_complete)
                profile.capture_complete_available <- true

            workload_start: i64 = json_key_value_start(data, "workload", NATIVE_ZERO.usize(), data.count)
            if workload_start >= NATIVE_ZERO:
                workload_stop: i64 = json_object_end(data, workload_start.usize(), data.count)
                return false if workload_stop < NATIVE_ZERO
                profile.workload <- []
                for index in workload_start.usize()..<workload_stop.usize() |index, data, profile|:
                    profile.workload.push(data[index])
                return false if not json_read_nullable_string_field(data, "source_sha256", workload_start.usize(), workload_stop.usize(), &profile.source_digest, &profile.source_digest_available)

            host_start: i64 = json_key_value_start(data, "host", NATIVE_ZERO.usize(), data.count)
            if host_start >= NATIVE_ZERO and data[host_start.usize()] == NATIVE_BYTE_LEFT_BRACE:
                host_stop: i64 = json_object_end(data, host_start.usize(), data.count)
                return false if host_stop < NATIVE_ZERO
                host_os: mutable darray[u8] = []
                host_architecture: mutable darray[u8] = []
                host_os_available: mutable bool = false
                host_architecture_available: mutable bool = false
                return false if not json_read_nullable_string_field(data, "os", host_start.usize(), host_stop.usize(), &host_os, &host_os_available)
                return false if not json_read_nullable_string_field(data, "architecture", host_start.usize(), host_stop.usize(), &host_architecture, &host_architecture_available)
                profile.host.available <- true
                profile.host.os <- []
                profile.host.architecture <- []
                profile.host.os.extend(host_os)
                profile.host.architecture.extend(host_architecture)
                profile.host.load_average_1m <- NATIVE_ZERO_F64
                profile.host.load_average_available <- false

            execution_start: i64 = json_key_value_start(data, "execution_ms_mean", run_start.usize(), run_stop.usize())
            if execution_start >= NATIVE_ZERO:
                return false if not json_read_millis_field(data, "execution_ms_mean", run_start.usize(), run_stop.usize(), &profile.execution_mean_micros)
                profile.execution_mean_available <- true
            return false if not json_read_nullable_millis_field(data, "cpu_ms", run_start.usize(), run_stop.usize(), &profile.cpu_micros, &profile.cpu_available)
            return false if not json_read_nullable_number_field(data, "peak_rss_bytes", run_start.usize(), run_stop.usize(), &profile.peak_rss_bytes, &profile.peak_rss_available)
            completed_start: i64 = json_key_value_start(data, "completed_repetitions", run_start.usize(), run_stop.usize())
            if completed_start >= NATIVE_ZERO:
                return false if not json_read_number_field(data, "completed_repetitions", run_start.usize(), run_stop.usize(), &profile.completed_repetitions)
            successful_start: i64 = json_key_value_start(data, "successful_repetitions", run_start.usize(), run_stop.usize())
            if successful_start >= NATIVE_ZERO:
                return false if not json_read_number_field(data, "successful_repetitions", run_start.usize(), run_stop.usize(), &profile.successful_repetitions)
            return false if not json_read_location_timing(data, &profile.location_timing)
            return false if not json_read_stacks_to_folded(data, &profile.folded_records, profile.location_timing)
            return false if not json_read_samples_to_folded(data, &profile.folded_records)

            functions_start: i64 = json_key_value_start(data, "functions", NATIVE_ZERO.usize(), data.count)
            return false if functions_start < NATIVE_ZERO or data[functions_start.usize()] != NATIVE_BYTE_LEFT_BRACKET
            functions_stop: i64 = json_array_end(data, functions_start.usize(), data.count)
            return false if functions_stop < NATIVE_ZERO
            profile.functions <- []
            for index in functions_start.usize()..<functions_stop.usize() |index, data, profile|:
                profile.functions.push(data[index])

            call_edges_start: i64 = json_key_value_start(data, "call_edges", NATIVE_ZERO.usize(), data.count)
            return false if call_edges_start < NATIVE_ZERO or data[call_edges_start.usize()] != NATIVE_BYTE_LEFT_BRACKET
            call_edges_stop: i64 = json_array_end(data, call_edges_start.usize(), data.count)
            return false if call_edges_stop < NATIVE_ZERO
            profile.call_edges <- []
            for index in call_edges_start.usize()..<call_edges_stop.usize() |index, data, profile|:
                profile.call_edges.push(data[index])

            stacks_start: i64 = json_key_value_start(data, "stacks", NATIVE_ZERO.usize(), data.count)
            return false if stacks_start < NATIVE_ZERO or data[stacks_start.usize()] != NATIVE_BYTE_LEFT_BRACKET
            stacks_stop: i64 = json_array_end(data, stacks_start.usize(), data.count)
            return false if stacks_stop < NATIVE_ZERO
            profile.stacks <- []
            for index in stacks_start.usize()..<stacks_stop.usize() |index, data, profile|:
                profile.stacks.push(data[index])

            locations_start: i64 = json_key_value_start(data, "locations", NATIVE_ZERO.usize(), data.count)
            return false if locations_start < NATIVE_ZERO or data[locations_start.usize()] != NATIVE_BYTE_LEFT_BRACKET
            locations_stop: i64 = json_array_end(data, locations_start.usize(), data.count)
            return false if locations_stop < NATIVE_ZERO
            profile.location_records <- []
            for index in locations_start.usize()..<locations_stop.usize() |index, data, profile|:
                profile.location_records.push(data[index])

            thread_start: i64 = json_key_value_start(data, "thread_loss", NATIVE_ZERO.usize(), data.count)
            if thread_start >= NATIVE_ZERO:
                return false if data[thread_start.usize()] != NATIVE_BYTE_LEFT_BRACKET
                thread_stop: i64 = json_array_end(data, thread_start.usize(), data.count)
                return false if thread_stop < NATIVE_ZERO
                profile.thread_loss <- []
                for index in thread_start.usize()..<thread_stop.usize() |index, data, profile|:
                    profile.thread_loss.push(data[index])
            sample_start: i64 = json_key_value_start(data, "samples", NATIVE_ZERO.usize(), data.count)
            if sample_start >= NATIVE_ZERO:
                sample_stop: i64 = json_array_end(data, sample_start.usize(), data.count)
                return false if sample_stop < NATIVE_ZERO
                profile.sample_records <- []
                for index in sample_start.usize()..<sample_stop.usize() |index, data, profile|:
                    profile.sample_records.push(data[index])
            return true


        def json_validate_identity_coverage(capture: ComparisonCapture) -> bool:
            function_seen: mutable bool = false
            function_has_identity: mutable bool = false
            for index in 0..<capture.functions.count |index, capture, function_seen, function_has_identity|:
                has_identity: bool = capture.functions[index].identity_id.count > NATIVE_ZERO.usize()
                if not function_seen:
                    function_seen <- true
                    function_has_identity <- has_identity
                else:
                    return false if has_identity != function_has_identity

            edge_seen: mutable bool = false
            edge_has_identity: mutable bool = false
            for index in 0..<capture.call_edges.count |index, capture, edge_seen, edge_has_identity|:
                caller_has_identity: bool = capture.call_edges[index].caller_identity_id.count > NATIVE_ZERO.usize()
                callee_has_identity: bool = capture.call_edges[index].callee_identity_id.count > NATIVE_ZERO.usize()
                return false if caller_has_identity != callee_has_identity
                if not edge_seen:
                    edge_seen <- true
                    edge_has_identity <- caller_has_identity
                else:
                    return false if caller_has_identity != edge_has_identity

            stack_seen: mutable bool = false
            stack_has_identity: mutable bool = false
            for index in 0..<capture.stacks.count |index, capture, stack_seen, stack_has_identity|:
                has_identity: bool = capture.stacks[index].identity_path.count > NATIVE_ZERO.usize()
                if not stack_seen:
                    stack_seen <- true
                    stack_has_identity <- has_identity
                else:
                    return false if has_identity != stack_has_identity

            location_seen: mutable bool = false
            location_has_identity: mutable bool = false
            for index in 0..<capture.location_records.count |index, capture, location_seen, location_has_identity|:
                has_identity: bool = capture.location_records[index].identity_id.count > NATIVE_ZERO.usize()
                if not location_seen:
                    location_seen <- true
                    location_has_identity <- has_identity
                else:
                    return false if has_identity != location_has_identity
            return true


        def read_comparison_capture(data: darray[u8]&, capture: mutable ComparisonCapture&) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if not json_document_is_object(data)
            schema_version: mutable i64 = NATIVE_ZERO
            return false if not json_read_number_field(data, "schema_version", NATIVE_ZERO.usize(), data.count, &schema_version)
            return false if not json_validate_report_envelope(data, schema_version, "profile")
            return false if not json_validate_source_snapshot(data)
            compiler_start: i64 = json_key_value_start(data, "compiler", NATIVE_ZERO.usize(), data.count)
            summary_start: i64 = json_key_value_start(data, "summary", NATIVE_ZERO.usize(), data.count)
            run_start: i64 = json_key_value_start(data, "run", NATIVE_ZERO.usize(), data.count)
            return false if compiler_start < NATIVE_ZERO or summary_start < NATIVE_ZERO or run_start < NATIVE_ZERO
            compiler_stop: i64 = json_object_end(data, compiler_start.usize(), data.count)
            summary_stop: i64 = json_object_end(data, summary_start.usize(), data.count)
            run_stop: i64 = json_object_end(data, run_start.usize(), data.count)
            return false if compiler_stop < NATIVE_ZERO or summary_stop < NATIVE_ZERO or run_stop < NATIVE_ZERO
            source_start: i64 = json_key_value_start(data, "source", NATIVE_ZERO.usize(), data.count)
            return false if source_start < NATIVE_ZERO
            return false if json_string_into(data, source_start.usize(), data.count, &capture.source) < NATIVE_ZERO
            return false if not json_read_optional_object_field(data, "workload", NATIVE_ZERO.usize(), data.count, &capture.workload_identity)
            capture.collection_mode <- []
            mode_start: i64 = json_key_value_start(data, "collection_mode", run_start.usize(), run_stop.usize())
            if mode_start >= NATIVE_ZERO:
                return false if not json_read_string_field(data, "collection_mode", run_start.usize(), run_stop.usize(), &capture.collection_mode)
            return false if not json_read_string_field(data, "branch", compiler_start.usize(), compiler_stop.usize(), &capture.compiler_branch)
            return false if not json_read_string_field(data, "commit", compiler_start.usize(), compiler_stop.usize(), &capture.compiler_commit)
            return false if not json_read_string_field(data, "opt_level", run_start.usize(), run_stop.usize(), &capture.opt_level)
            return false if not json_read_number_field(data, "events", summary_start.usize(), summary_stop.usize(), &capture.events)
            return false if not json_read_number_field(data, "locations", summary_start.usize(), summary_stop.usize(), &capture.locations)
            return false if not json_read_number_field(data, "dropped", summary_start.usize(), summary_stop.usize(), &capture.dropped)
            return false if not json_read_optional_number_field(data, "frame_dropped", summary_start.usize(), summary_stop.usize(), &capture.frame_dropped)
            return false if not json_read_optional_number_field(data, "dropped_call_edges", summary_start.usize(), summary_stop.usize(), &capture.dropped_call_edges)
            return false if not json_read_optional_number_field(data, "dropped_stacks", summary_start.usize(), summary_stop.usize(), &capture.dropped_stacks)
            return false if not json_read_number_field(data, "stack_overflow_entries", summary_start.usize(), summary_stop.usize(), &capture.stack_overflow_entries)
            return false if not json_read_number_field(data, "thread_count", summary_start.usize(), summary_stop.usize(), &capture.thread_count)
            return false if not json_read_number_field(data, "trace_events_omitted", summary_start.usize(), summary_stop.usize(), &capture.trace_events_omitted)
            return false if not json_read_optional_number_field(data, "sample_count", summary_start.usize(), summary_stop.usize(), &capture.sample_count)
            return false if not json_read_optional_number_field(data, "sample_missed", summary_start.usize(), summary_stop.usize(), &capture.sample_missed)
            return false if not json_read_optional_number_field(data, "sample_period_microseconds", summary_start.usize(), summary_stop.usize(), &capture.sample_period_microseconds)
            return false if not json_read_optional_number_field(data, "sampling_setup_failed", summary_start.usize(), summary_stop.usize(), &capture.sampling_setup_failed)
            return false if not json_read_bool_field(data, "detail_budget_exceeded", summary_start.usize(), summary_stop.usize(), &capture.detail_budget_exceeded)
            return false if not json_read_millis_field(data, "execution_ms_mean", run_start.usize(), run_stop.usize(), &capture.execution_mean_micros)
            return false if not json_read_millis_field(data, "compile_ms", run_start.usize(), run_stop.usize(), &capture.compile_micros)
            return false if not json_read_nullable_millis_field(data, "cpu_ms", run_start.usize(), run_stop.usize(), &capture.cpu_micros, &capture.resource_metrics_available)
            peak_rss_available: mutable bool = false
            return false if not json_read_nullable_number_field(data, "peak_rss_bytes", run_start.usize(), run_stop.usize(), &capture.peak_rss_bytes, &peak_rss_available)
            return false if peak_rss_available != capture.resource_metrics_available
            return false if not json_read_exit_code_field(data, run_start.usize(), run_stop.usize(), &capture.exit_code)
            capture.stable_id_namespace <- []
            capture.stable_id_version <- NATIVE_ZERO
            identity_status: mutable darray[u8] = []
            capabilities_start: i64 = json_key_value_start(data, "capabilities", run_start.usize(), run_stop.usize())
            if capabilities_start >= NATIVE_ZERO:
                capabilities_stop: i64 = json_object_end(data, capabilities_start.usize(), run_stop.usize())
                return false if capabilities_stop < NATIVE_ZERO
                identity_object: mutable darray[u8] = []
                return false if not json_read_optional_object_field(data, "identity", capabilities_start.usize(), capabilities_stop.usize(), &identity_object)
                if identity_object.count > NATIVE_ZERO.usize():
                    return false if not json_read_string_field(identity_object, "status", NATIVE_ZERO.usize(), identity_object.count, &identity_status)
                    if protocol_field_is(identity_status, "compiler_stable_ids"):
                        return false if not json_read_string_field(identity_object, "namespace", NATIVE_ZERO.usize(), identity_object.count, &capture.stable_id_namespace)
                        return false if not json_read_number_field(identity_object, "version", NATIVE_ZERO.usize(), identity_object.count, &capture.stable_id_version)
                        return false if capture.stable_id_version < NATIVE_ONE
            return false if not json_read_function_records(data, &capture.functions)
            return false if not json_read_call_edge_records(data, &capture.call_edges)
            return false if not json_read_stack_records(data, &capture.stacks)
            return false if not json_read_location_records(data, &capture.location_records)
            capture.stable_ids_available <- false
            for index in 0..<capture.functions.count |index, capture|:
                capture.stable_ids_available <- true if capture.functions[index].identity_id.count > NATIVE_ZERO.usize()
            for index in 0..<capture.call_edges.count |index, capture|:
                capture.stable_ids_available <- true if capture.call_edges[index].caller_identity_id.count > NATIVE_ZERO.usize()
            for index in 0..<capture.stacks.count |index, capture|:
                capture.stable_ids_available <- true if capture.stacks[index].identity_path.count > NATIVE_ZERO.usize()
            for index in 0..<capture.location_records.count |index, capture|:
                capture.stable_ids_available <- true if capture.location_records[index].identity_id.count > NATIVE_ZERO.usize()
            return false if not json_validate_identity_coverage(capture)
            if protocol_field_is(identity_status, "compiler_stable_ids"):
                return false if not capture.stable_ids_available
            elif protocol_field_is(identity_status, "source_name_fallback"):
                return false if capture.stable_ids_available
            elif identity_status.count > NATIVE_ZERO.usize():
                return false
            capture.stable_id_contract_known <- false
            if capture.stable_ids_available:
                capture.stable_id_contract_known <- capture.stable_id_namespace.count > NATIVE_ZERO.usize() and protocol_field_is(capture.stable_id_namespace, "elisa.compiler.trace") and capture.stable_id_version == NATIVE_TRACE_ID_VERSION
            return true


        def json_read_stacks_to_folded(data: darray[u8]&, folded: mutable darray[u8]&, location_timing: bool) -> bool can[Abort.Panic, Memory.Allocate]:
            array_start: i64 = json_key_value_start(data, "stacks", NATIVE_ZERO.usize(), data.count)
            return false if array_start < NATIVE_ZERO or data[array_start.usize()] != NATIVE_BYTE_LEFT_BRACKET
            array_stop: i64 = json_array_end(data, array_start.usize(), data.count)
            return false if array_stop < NATIVE_ZERO
            cursor: mutable usize = array_start.usize() + NATIVE_ONE.usize()
            stop: usize = array_stop.usize() - NATIVE_ONE.usize()
            while cursor < stop |cursor, stop, data, folded, location_timing|:
                cursor <- json_skip_whitespace(data, cursor, stop)
                break if cursor >= stop or data[cursor] == NATIVE_BYTE_RIGHT_BRACKET
                return false if data[cursor] != NATIVE_BYTE_LEFT_BRACE
                object_stop: i64 = json_object_end(data, cursor, stop)
                return false if object_stop < NATIVE_ZERO
                stack_start: i64 = json_key_value_start(data, "stack", cursor, object_stop.usize())
                calls_start: i64 = json_key_value_start(data, "call_events", cursor, object_stop.usize())
                self_start: i64 = json_key_value_start(data, "self_ns", cursor, object_stop.usize())
                return false if stack_start < NATIVE_ZERO or calls_start < NATIVE_ZERO or self_start < NATIVE_ZERO
                stack_value: mutable darray[u8] = []
                return false if json_string_into(data, stack_start.usize(), object_stop.usize(), &stack_value) < NATIVE_ZERO
                calls: i64 = json_number_at(data, calls_start.usize(), object_stop.usize())
                self_ns: i64 = json_number_at(data, self_start.usize(), object_stop.usize())
                return false if calls < NATIVE_ZERO or self_ns < NATIVE_ZERO
                weight: i64 = self_ns if location_timing else calls
                if weight > NATIVE_ZERO:
                    append_folded_separator(folded)
                    folded.extend(stack_value)
                    folded.push(NATIVE_BYTE_SPACE)
                    append_i64(folded, weight)
                cursor <- object_stop.usize()
                cursor <- cursor + NATIVE_ONE.usize() if cursor < stop and data[cursor] == NATIVE_BYTE_COMMA
            return true


        def json_read_samples_to_folded(data: darray[u8]&, folded: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            array_start: i64 = json_key_value_start(data, "samples", NATIVE_ZERO.usize(), data.count)
            return true if array_start < NATIVE_ZERO
            return false if data[array_start.usize()] != NATIVE_BYTE_LEFT_BRACKET
            array_stop: i64 = json_array_end(data, array_start.usize(), data.count)
            return false if array_stop < NATIVE_ZERO
            cursor: mutable usize = array_start.usize() + NATIVE_ONE.usize()
            stop: usize = array_stop.usize() - NATIVE_ONE.usize()
            while cursor < stop |cursor, stop, data, folded|:
                cursor <- json_skip_whitespace(data, cursor, stop)
                break if cursor >= stop or data[cursor] == NATIVE_BYTE_RIGHT_BRACKET
                return false if data[cursor] != NATIVE_BYTE_LEFT_BRACE
                object_stop: i64 = json_object_end(data, cursor, stop)
                return false if object_stop < NATIVE_ZERO
                stack_value: mutable darray[u8] = []
                return false if not json_read_string_field(data, "stack", cursor, object_stop.usize(), &stack_value) or stack_value.count == NATIVE_ZERO.usize()
                append_folded_separator(folded)
                folded.extend(stack_value)
                folded.push(NATIVE_BYTE_SPACE)
                append_i64(folded, NATIVE_ONE)
                cursor <- object_stop.usize()
                cursor <- json_skip_whitespace(data, cursor, stop)
                if cursor < stop:
                    return false if data[cursor] != NATIVE_BYTE_COMMA
                    cursor <- cursor + NATIVE_ONE.usize()
            return true
