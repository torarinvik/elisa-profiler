# Native report renderers and comparison presentation.
#
# All renderers consume normalized ProfilerNative records. They are private so
# callers cannot bypass validation by reaching into a format-specific writer.
extend ProfilerNative:
    private:
        def append_detail_arrays(buffer: mutable darray[u8]&, summary: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "\"functions\":[")
            buffer.extend(summary.function_records)
            append_text(buffer, "],\"call_edges\":[")
            buffer.extend(summary.call_edge_records)
            append_text(buffer, "],\"stacks\":[")
            buffer.extend(summary.stack_records)
            append_text(buffer, "],\"locations\":[")
            buffer.extend(summary.location_records)
            append_text(buffer, "]")


        def append_folded_report(buffer: mutable darray[u8]&, summary: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            buffer.extend(summary.folded_records)
            buffer.push(NATIVE_BYTE_NEWLINE) if summary.folded_records.count > NATIVE_ZERO.usize()


        def folded_line_end(records: darray[u8]&, start: usize) -> usize:
            cursor: mutable usize = start
            while cursor < records.count |cursor, records|:
                break if records[cursor] == NATIVE_BYTE_NEWLINE
                cursor <- cursor + NATIVE_ONE.usize()
            return cursor


        def folded_line_weight(records: darray[u8]&, start: usize, stop: usize) -> i64 can[Abort.Panic, Memory.Allocate]:
            separator: mutable usize = start
            cursor: mutable usize = start
            while cursor < stop |cursor, separator, records|:
                separator <- cursor if records[cursor] == NATIVE_BYTE_SPACE
                cursor <- cursor + NATIVE_ONE.usize()
            return NATIVE_ZERO if separator == start or separator + NATIVE_ONE.usize() >= stop
            weight: mutable darray[u8] = []
            for index in separator + NATIVE_ONE.usize()..<stop |weight, records|:
                weight.push(records[index])
            return protocol_number_field(weight)


        def folded_stack_stop(records: darray[u8]&, start: usize, stop: usize) -> usize:
            cursor: mutable usize = stop
            while cursor > start |cursor, records|:
                break if records[cursor - NATIVE_ONE.usize()] == NATIVE_BYTE_SPACE
                cursor <- cursor - NATIVE_ONE.usize()
            return cursor


        def append_speedscope_frames(buffer: mutable darray[u8]&, records: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            first_frame: mutable bool = true
            line_start: mutable usize = NATIVE_ZERO.usize()
            while line_start < records.count |line_start, first_frame, records, buffer|:
                line_end: usize = folded_line_end(records, line_start)
                weight: i64 = folded_line_weight(records, line_start, line_end)
                if weight > NATIVE_ZERO:
                    stack_stop: usize = folded_stack_stop(records, line_start, line_end)
                    frame_start: mutable usize = line_start
                    while frame_start < stack_stop |frame_start, stack_stop, first_frame, records, buffer|:
                        frame_end: mutable usize = frame_start
                        while frame_end < stack_stop |frame_end, stack_stop, records|:
                            break if records[frame_end] == NATIVE_BYTE_SEMICOLON
                            frame_end <- frame_end + NATIVE_ONE.usize()
                        frame: mutable darray[u8] = []
                        for index in frame_start..<frame_end |frame, records|:
                            frame.push(records[index])
                        append_record_separator(buffer) if not first_frame
                        append_text(buffer, "{\"name\":")
                        append_json_string(buffer, frame)
                        append_text(buffer, "}")
                        first_frame <- false
                        frame_start <- frame_end + NATIVE_ONE.usize() if frame_end < stack_stop else stack_stop
                line_start <- line_end + NATIVE_ONE.usize() if line_end < records.count else records.count


        def append_speedscope_samples(buffer: mutable darray[u8]&, records: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            first_sample: mutable bool = true
            frame_index: mutable i64 = NATIVE_ZERO
            line_start: mutable usize = NATIVE_ZERO.usize()
            while line_start < records.count |line_start, first_sample, frame_index, records, buffer|:
                line_end: usize = folded_line_end(records, line_start)
                weight: i64 = folded_line_weight(records, line_start, line_end)
                if weight > NATIVE_ZERO:
                    stack_stop: usize = folded_stack_stop(records, line_start, line_end)
                    frame_start: mutable usize = line_start
                    first_frame: mutable bool = true
                    append_record_separator(buffer) if not first_sample
                    buffer.push(NATIVE_BYTE_LEFT_BRACKET)
                    while frame_start < stack_stop |frame_start, stack_stop, frame_index, first_frame, records, buffer|:
                        frame_end: mutable usize = frame_start
                        while frame_end < stack_stop |frame_end, stack_stop, records|:
                            break if records[frame_end] == NATIVE_BYTE_SEMICOLON
                            frame_end <- frame_end + NATIVE_ONE.usize()
                        append_record_separator(buffer) if not first_frame
                        append_i64(buffer, frame_index)
                        first_frame <- false
                        frame_index <- frame_index + NATIVE_ONE
                        frame_start <- frame_end + NATIVE_ONE.usize() if frame_end < stack_stop else stack_stop
                    buffer.push(NATIVE_BYTE_RIGHT_BRACKET)
                    first_sample <- false
                line_start <- line_end + NATIVE_ONE.usize() if line_end < records.count else records.count


        def append_speedscope_weights(buffer: mutable darray[u8]&, records: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            first_weight: mutable bool = true
            line_start: mutable usize = NATIVE_ZERO.usize()
            while line_start < records.count |line_start, first_weight, records, buffer|:
                line_end: usize = folded_line_end(records, line_start)
                weight: i64 = folded_line_weight(records, line_start, line_end)
                if weight > NATIVE_ZERO:
                    append_record_separator(buffer) if not first_weight
                    append_i64(buffer, weight)
                    first_weight <- false
                line_start <- line_end + NATIVE_ONE.usize() if line_end < records.count else records.count


        def folded_total_weight(records: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate]:
            total: mutable i64 = NATIVE_ZERO
            line_start: mutable usize = NATIVE_ZERO.usize()
            while line_start < records.count |line_start, total, records|:
                line_end: usize = folded_line_end(records, line_start)
                weight: i64 = folded_line_weight(records, line_start, line_end)
                total <- total + weight if weight > NATIVE_ZERO
                line_start <- line_end + NATIVE_ONE.usize() if line_end < records.count else records.count
            return total


        def append_speedscope_report(buffer: mutable darray[u8]&, source: darray[u8]&, records: darray[u8]&, location_timing: bool) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "{\"$schema\":\"https://www.speedscope.app/file-format-schema.json\",\"name\":")
            append_json_string(buffer, source)
            append_text(buffer, ",\"activeProfileIndex\":0,\"exporter\":\"elisa-profiler-native\",\"shared\":{\"frames\":[")
            append_speedscope_frames(buffer, records)
            append_text(buffer, "]},\"profiles\":[{\"type\":\"sampled\",\"name\":")
            append_json_string(buffer, source)
            append_text(buffer, ",\"unit\":\"")
            append_text(buffer, "nanoseconds" if location_timing else "none")
            append_text(buffer, "\",\"startValue\":0,\"endValue\":")
            append_i64(buffer, folded_total_weight(records))
            append_text(buffer, ",\"samples\":[")
            append_speedscope_samples(buffer, records)
            append_text(buffer, "],\"weights\":[")
            append_speedscope_weights(buffer, records)
            append_text(buffer, "]}]}\n")


        def append_offline_folded_report(buffer: mutable darray[u8]&, data: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            timing: mutable bool = false
            return false if not json_read_location_timing(data, &timing)
            return false if not json_read_stacks_to_folded(data, buffer, timing)
            buffer.push(NATIVE_BYTE_NEWLINE) if buffer.count > NATIVE_ZERO.usize()
            return true


        def append_offline_speedscope_report(buffer: mutable darray[u8]&, data: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            source: mutable darray[u8] = []
            timing: mutable bool = false
            source_start: i64 = json_source_value_start(data)
            return false if source_start < NATIVE_ZERO
            return false if json_string_into(data, source_start.usize(), data.count, &source) < NATIVE_ZERO
            return false if not json_read_location_timing(data, &timing)
            folded: mutable darray[u8] = []
            return false if not json_read_stacks_to_folded(data, &folded, timing)
            append_speedscope_report(buffer, source, folded, timing)
            return true


        # The browser view keeps metric values as decimal strings until the UI
        # sorts them with BigInt. JSON.parse would round i64 timings above
        # JavaScript's safe-integer range, making a report visually incorrect.
        # The small record scanner therefore extracts only the shallow scalar
        # fields needed by this table and never converts metric text to Number.
        def append_html_function_browser(buffer: mutable darray[u8]&, records: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<style>.panel{margin-top:1.25rem}.panel h2{margin-bottom:.5rem}.panel label{display:block;font-weight:650;margin-bottom:.25rem}.panel input{width:100%;box-sizing:border-box;padding:.55rem .7rem;border:1px solid #8c959f;border-radius:6px;font:inherit;background:inherit;color:inherit}.table-scroll{overflow:auto;margin-top:.75rem}.panel table{width:100%;border-collapse:collapse;min-width:42rem}.panel th,.panel td{padding:.5rem .65rem;border-bottom:1px solid #d8dee4;text-align:left;white-space:nowrap}.panel th{font-size:.8rem;color:#57606a}.panel td:not(:first-child){font-family:ui-monospace,SFMono-Regular,Menlo,monospace;text-align:right}.panel details{margin-top:.75rem}</style><section class='panel' aria-labelledby='hotspots-title'><h2 id='hotspots-title'>Hotspots</h2><label for='function-filter'>Filter functions</label><input id='function-filter' type='search' autocomplete='off' placeholder='name or percentage'><p id='function-status' role='status' aria-live='polite'></p><div class='table-scroll'><table><thead><tr><th scope='col'>Function</th><th scope='col'>Inclusive</th><th scope='col'>Self</th><th scope='col'>Calls</th><th scope='col'>Share</th></tr></thead><tbody id='function-rows'></tbody></table></div><details><summary>Raw function records</summary><pre id='function-records' hidden>")
            append_html_escaped(buffer, records)
            append_text(buffer, "</pre></details></section><script>(function(){'use strict';const raw=document.getElementById('function-records');const body=document.getElementById('function-rows');const filter=document.getElementById('function-filter');const status=document.getElementById('function-status');const quote=String.fromCharCode(34);const maxRows=200;function objects(text){const result=[];let start=-1,depth=0,inString=false,escaped=false;for(let index=0;index<text.length;index+=1){const byte=text.charAt(index);if(inString){if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){inString=false;}continue;}if(byte===quote){inString=true;}else if(byte==='{'){if(depth===0){start=index;}depth+=1;}else if(byte==='}'){depth-=1;if(depth===0&&start>=0){result.push(text.slice(start,index+1));start=-1;}}}return result;}function field(record,name){const marker=quote+name+quote+':';const start=record.indexOf(marker);if(start<0){return '';}let cursor=start+marker.length;while(cursor<record.length&&(record.charAt(cursor)===' '||record.charCodeAt(cursor)===9)){cursor+=1;}if(record.charAt(cursor)===quote){let end=cursor+1,escaped=false;for(;end<record.length;end+=1){const byte=record.charAt(end);if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){break;}}try{return JSON.parse(record.slice(cursor,end+1));}catch(_error){return '';}}let end=cursor;while(end<record.length&&((record.charCodeAt(end)>=48&&record.charCodeAt(end)<=57)||record.charAt(end)==='-')){end+=1;}return record.slice(cursor,end);}function magnitude(value){try{return BigInt(value||'0');}catch(_error){return BigInt(0);}}function render(){const query=(filter.value||'').toLowerCase();const rows=objects(raw.textContent||'').map(function(record){return{name:field(record,'function'),inclusive:field(record,'inclusive_ns'),self:field(record,'self_ns'),calls:field(record,'completed_calls'),share:field(record,'inclusive_percent')};}).filter(function(row){return row.name.toLowerCase().includes(query);}).sort(function(left,right){const a=magnitude(left.inclusive),b=magnitude(right.inclusive);return a===b?left.name.localeCompare(right.name):(a>b?-1:1);});body.replaceChildren();rows.slice(0,maxRows).forEach(function(row){const line=document.createElement('tr');[row.name,row.inclusive+' ns',row.self+' ns',row.calls,row.share+'%'].forEach(function(value){const cell=document.createElement('td');cell.textContent=value;line.appendChild(cell);});body.appendChild(line);});status.textContent=rows.length+' function'+(rows.length===1?'':'s')+' shown'+(rows.length>maxRows?' (first '+maxRows+')':'');}filter.addEventListener('input',render);render();}());</script>")


        def append_html_detail_browsers(buffer: mutable darray[u8]&, call_edges: darray[u8]&, locations: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<section class='panel' aria-labelledby='edges-title'><h2 id='edges-title'>Caller and callee edges</h2><label for='edge-filter'>Filter caller or callee</label><input id='edge-filter' type='search' autocomplete='off' placeholder='caller or callee'><p id='edge-status' role='status' aria-live='polite'></p><div class='table-scroll'><table><thead><tr><th scope='col'>Caller</th><th scope='col'>Callee</th><th scope='col'>Inclusive</th><th scope='col'>Completed calls</th></tr></thead><tbody id='edge-rows'></tbody></table></div><details><summary>Raw call-edge records</summary><pre id='edge-records' hidden>")
            append_html_escaped(buffer, call_edges)
            append_text(buffer, "</pre></details></section><section class='panel' aria-labelledby='locations-title'><h2 id='locations-title'>Source locations</h2><label for='location-filter'>Filter source, function, or variable</label><input id='location-filter' type='search' autocomplete='off' placeholder='source, function, or variable'><p id='location-status' role='status' aria-live='polite'></p><div class='table-scroll'><table><thead><tr><th scope='col'>Source</th><th scope='col'>Line</th><th scope='col'>Function</th><th scope='col'>Variable</th><th scope='col'>Interval</th><th scope='col'>Count</th></tr></thead><tbody id='location-rows'></tbody></table></div><details><summary>Raw source-location records</summary><pre id='location-records' hidden>")
            append_html_escaped(buffer, locations)
            append_text(buffer, "</pre></details></section><script>(function(){'use strict';const quote=String.fromCharCode(34);const maxRows=200;const edgeRaw=document.getElementById('edge-records');const edgeBody=document.getElementById('edge-rows');const edgeFilter=document.getElementById('edge-filter');const edgeStatus=document.getElementById('edge-status');const locationRaw=document.getElementById('location-records');const locationBody=document.getElementById('location-rows');const locationFilter=document.getElementById('location-filter');const locationStatus=document.getElementById('location-status');function objects(text){const result=[];let start=-1,depth=0,inString=false,escaped=false;for(let index=0;index<text.length;index+=1){const byte=text.charAt(index);if(inString){if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){inString=false;}continue;}if(byte===quote){inString=true;}else if(byte==='{'){if(depth===0){start=index;}depth+=1;}else if(byte==='}'){depth-=1;if(depth===0&&start>=0){result.push(text.slice(start,index+1));start=-1;}}}return result;}function field(record,name){const marker=quote+name+quote+':';const start=record.indexOf(marker);if(start<0){return '';}let cursor=start+marker.length;while(cursor<record.length&&(record.charAt(cursor)===' '||record.charCodeAt(cursor)===9)){cursor+=1;}if(record.charAt(cursor)===quote){let end=cursor+1,escaped=false;for(;end<record.length;end+=1){const byte=record.charAt(end);if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){break;}}try{return JSON.parse(record.slice(cursor,end+1));}catch(_error){return '';}}let end=cursor;while(end<record.length&&((record.charCodeAt(end)>=48&&record.charCodeAt(end)<=57)||record.charAt(end)==='-')){end+=1;}return record.slice(cursor,end);}function magnitude(value){try{return BigInt(value||'0');}catch(_error){return BigInt(0);}}function draw(body,rows){body.replaceChildren();rows.slice(0,maxRows).forEach(function(row){const line=document.createElement('tr');row.values.forEach(function(value){const cell=document.createElement('td');cell.textContent=value;line.appendChild(cell);});body.appendChild(line);});}function renderEdges(){const query=(edgeFilter.value||'').toLowerCase();const rows=objects(edgeRaw.textContent||'').map(function(record){const caller=field(record,'caller'),callee=field(record,'callee');return{search:(caller+' '+callee).toLowerCase(),values:[caller,callee,field(record,'inclusive_ns')+' ns',field(record,'completed_calls')]};}).filter(function(row){return row.search.includes(query);}).sort(function(left,right){const a=magnitude(left.values[2]),b=magnitude(right.values[2]);return a===b?left.values[0].localeCompare(right.values[0]):(a>b?-1:1);});draw(edgeBody,rows);edgeStatus.textContent=rows.length+' edge'+(rows.length===1?'':'s')+' shown'+(rows.length>maxRows?' (first '+maxRows+')':'');}function renderLocations(){const query=(locationFilter.value||'').toLowerCase();const rows=objects(locationRaw.textContent||'').map(function(record){const source=field(record,'source'),line=field(record,'line'),func=field(record,'function'),variable=field(record,'variable');return{search:(source+' '+func+' '+variable).toLowerCase(),values:[source,line,func,variable,field(record,'interval_ns')+' ns',field(record,'count')]};}).filter(function(row){return row.search.includes(query);}).sort(function(left,right){const a=magnitude(left.values[4]),b=magnitude(right.values[4]);return a===b?left.values[0].localeCompare(right.values[0]):(a>b?-1:1);});draw(locationBody,rows);locationStatus.textContent=rows.length+' location'+(rows.length===1?'':'s')+' shown'+(rows.length>maxRows?' (first '+maxRows+')':'');}edgeFilter.addEventListener('input',renderEdges);locationFilter.addEventListener('input',renderLocations);renderEdges();renderLocations();}());</script>")


        def append_html_host_summary(buffer: mutable darray[u8]&, host: NativeHostMetadata) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<div><dt>Host</dt><dd>")
            if not host.available:
                append_text(buffer, "unavailable")
            else:
                if host.os.count > NATIVE_ZERO.usize():
                    append_html_escaped(buffer, host.os)
                else:
                    append_text(buffer, "unknown OS")
                append_text(buffer, " / ")
                if host.architecture.count > NATIVE_ZERO.usize():
                    append_html_escaped(buffer, host.architecture)
                else:
                    append_text(buffer, "unknown architecture")
            append_text(buffer, "</dd></div><div><dt>Affinity</dt><dd>")
            append_text(buffer, "inherited; unchanged" if host.available else "unavailable")
            append_text(buffer, "</dd></div><div><dt>Power/thermal</dt><dd>")
            append_text(buffer, "not collected" if host.available else "unavailable")
            append_text(buffer, "</dd></div>")


        def append_offline_html_report(buffer: mutable darray[u8]&, data: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            source: mutable darray[u8] = []
            source_start: i64 = json_source_value_start(data)
            return false if source_start < NATIVE_ZERO
            return false if json_string_into(data, source_start.usize(), data.count, &source) < NATIVE_ZERO
            summary_start: i64 = json_key_value_start(data, "summary", NATIVE_ZERO.usize(), data.count)
            run_start: i64 = json_key_value_start(data, "run", NATIVE_ZERO.usize(), data.count)
            return false if summary_start < NATIVE_ZERO or run_start < NATIVE_ZERO
            summary_stop: i64 = json_object_end(data, summary_start.usize(), data.count)
            run_stop: i64 = json_object_end(data, run_start.usize(), data.count)
            return false if summary_stop < NATIVE_ZERO or run_stop < NATIVE_ZERO
            events: mutable i64 = NATIVE_ZERO
            locations: mutable i64 = NATIVE_ZERO
            dropped: mutable i64 = NATIVE_ZERO
            thread_count: mutable i64 = NATIVE_ZERO
            exit_code: mutable i64 = NATIVE_ZERO
            execution_mean_micros: mutable i64 = NATIVE_ZERO
            execution_mean_available: mutable bool = false
            cpu_micros: mutable i64 = NATIVE_ZERO
            cpu_available: mutable bool = false
            peak_rss_bytes: mutable i64 = NATIVE_ZERO
            peak_rss_available: mutable bool = false
            completed_repetitions: mutable i64 = NATIVE_ZERO
            successful_repetitions: mutable i64 = NATIVE_ZERO
            outcome: mutable darray[u8] = []
            source_digest: mutable darray[u8] = []
            source_digest_available: mutable bool = false
            capture_complete: mutable bool = false
            capture_complete_available: mutable bool = false
            host: mutable NativeHostMetadata = NativeHostMetadata{available: false, os: [], architecture: [], load_average_1m: NATIVE_ZERO_F64, load_average_available: false}
            host_os: mutable darray[u8] = []
            host_architecture: mutable darray[u8] = []
            host_os_available: mutable bool = false
            host_architecture_available: mutable bool = false
            return false if not json_read_number_field(data, "events", summary_start.usize(), summary_stop.usize(), &events)
            return false if not json_read_number_field(data, "locations", summary_start.usize(), summary_stop.usize(), &locations)
            return false if not json_read_number_field(data, "dropped", summary_start.usize(), summary_stop.usize(), &dropped)
            return false if not json_read_number_field(data, "thread_count", summary_start.usize(), summary_stop.usize(), &thread_count)
            return false if not json_read_exit_code_field(data, run_start.usize(), run_stop.usize(), &exit_code)
            outcome_start: i64 = json_key_value_start(data, "outcome", run_start.usize(), run_stop.usize())
            if outcome_start >= NATIVE_ZERO:
                return false if json_string_into(data, outcome_start.usize(), run_stop.usize(), &outcome) < NATIVE_ZERO
            if outcome.count == NATIVE_ZERO.usize():
                append_text(outcome, "success" if exit_code == NATIVE_ZERO else "target_exit")
            capture_complete_start: i64 = json_key_value_start(data, "capture_complete", summary_start.usize(), summary_stop.usize())
            if capture_complete_start >= NATIVE_ZERO:
                return false if not json_read_bool_field(data, "capture_complete", summary_start.usize(), summary_stop.usize(), &capture_complete)
                capture_complete_available <- true
            workload_start: i64 = json_key_value_start(data, "workload", NATIVE_ZERO.usize(), data.count)
            if workload_start >= NATIVE_ZERO and data[workload_start.usize()] == NATIVE_BYTE_LEFT_BRACE:
                workload_stop: i64 = json_object_end(data, workload_start.usize(), data.count)
                return false if workload_stop < NATIVE_ZERO
                return false if not json_read_nullable_string_field(data, "source_sha256", workload_start.usize(), workload_stop.usize(), &source_digest, &source_digest_available)
            host_start: i64 = json_key_value_start(data, "host", NATIVE_ZERO.usize(), data.count)
            if host_start >= NATIVE_ZERO and data[host_start.usize()] == NATIVE_BYTE_LEFT_BRACE:
                host_stop: i64 = json_object_end(data, host_start.usize(), data.count)
                return false if host_stop < NATIVE_ZERO
                return false if not json_read_nullable_string_field(data, "os", host_start.usize(), host_stop.usize(), &host_os, &host_os_available)
                return false if not json_read_nullable_string_field(data, "architecture", host_start.usize(), host_stop.usize(), &host_architecture, &host_architecture_available)
                host <- NativeHostMetadata{available: true, os: host_os, architecture: host_architecture, load_average_1m: NATIVE_ZERO_F64, load_average_available: false}
            execution_mean_start: i64 = json_key_value_start(data, "execution_ms_mean", run_start.usize(), run_stop.usize())
            if execution_mean_start >= NATIVE_ZERO:
                return false if not json_read_millis_field(data, "execution_ms_mean", run_start.usize(), run_stop.usize(), &execution_mean_micros)
                execution_mean_available <- true
            return false if not json_read_nullable_millis_field(data, "cpu_ms", run_start.usize(), run_stop.usize(), &cpu_micros, &cpu_available)
            return false if not json_read_nullable_number_field(data, "peak_rss_bytes", run_start.usize(), run_stop.usize(), &peak_rss_bytes, &peak_rss_available)
            completed_start: i64 = json_key_value_start(data, "completed_repetitions", run_start.usize(), run_stop.usize())
            if completed_start >= NATIVE_ZERO:
                return false if not json_read_number_field(data, "completed_repetitions", run_start.usize(), run_stop.usize(), &completed_repetitions)
            successful_start: i64 = json_key_value_start(data, "successful_repetitions", run_start.usize(), run_stop.usize())
            if successful_start >= NATIVE_ZERO:
                return false if not json_read_number_field(data, "successful_repetitions", run_start.usize(), run_stop.usize(), &successful_repetitions)
            timing: mutable bool = false
            return false if not json_read_location_timing(data, &timing)
            folded: mutable darray[u8] = []
            return false if not json_read_stacks_to_folded(data, &folded, timing)
            functions_start: i64 = json_key_value_start(data, "functions", NATIVE_ZERO.usize(), data.count)
            return false if functions_start < NATIVE_ZERO or data[functions_start.usize()] != NATIVE_BYTE_LEFT_BRACKET
            functions_stop: i64 = json_array_end(data, functions_start.usize(), data.count)
            return false if functions_stop < NATIVE_ZERO
            functions: mutable darray[u8] = []
            for index in functions_start.usize()..<functions_stop.usize() |functions, data|:
                functions.push(data[index])
            call_edges: mutable darray[u8] = []
            call_edges_start: i64 = json_key_value_start(data, "call_edges", NATIVE_ZERO.usize(), data.count)
            if call_edges_start >= NATIVE_ZERO:
                call_edges_stop: i64 = json_array_end(data, call_edges_start.usize(), data.count)
                return false if call_edges_stop < NATIVE_ZERO
                for index in call_edges_start.usize()..<call_edges_stop.usize() |call_edges, data|:
                    call_edges.push(data[index])
            location_records: mutable darray[u8] = []
            location_records_start: i64 = json_key_value_start(data, "locations", NATIVE_ZERO.usize(), data.count)
            if location_records_start >= NATIVE_ZERO:
                location_records_stop: i64 = json_array_end(data, location_records_start.usize(), data.count)
                return false if location_records_stop < NATIVE_ZERO
                for index in location_records_start.usize()..<location_records_stop.usize() |location_records, data|:
                    location_records.push(data[index])
            thread_loss: mutable darray[u8] = []
            thread_loss_start: i64 = json_key_value_start(data, "thread_loss", NATIVE_ZERO.usize(), data.count)
            if thread_loss_start >= NATIVE_ZERO:
                thread_loss_stop: i64 = json_array_end(data, thread_loss_start.usize(), data.count)
                return false if thread_loss_stop < NATIVE_ZERO
                for index in thread_loss_start.usize()..<thread_loss_stop.usize() |thread_loss, data|:
                    thread_loss.push(data[index])
            append_text(buffer, "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Elisa profile</title><style>body{font:15px system-ui,sans-serif;line-height:1.45;max-width:1120px;margin:2rem auto;padding:0 1rem;color:#17202a;background:#f6f8fa}main{background:white;border:1px solid #d0d7de;border-radius:12px;padding:1.5rem;box-shadow:0 4px 20px #0001}code,pre{font:13px ui-monospace,SFMono-Regular,Menlo,monospace}dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.75rem}dl div{padding:.8rem;background:#f6f8fa;border-radius:8px}dt{color:#57606a;font-size:.8rem}dd{margin:.2rem 0 0;font-weight:650}details{margin-top:1rem;border:1px solid #d8dee4;border-radius:8px;padding:.75rem}summary{cursor:pointer;font-weight:650}pre{overflow:auto;white-space:pre-wrap;word-break:break-word;margin:.75rem 0 0}@media(prefers-color-scheme:dark){body{color:#e6edf3;background:#0d1117}main{background:#161b22;border-color:#30363d}dl div{background:#21262d}details{border-color:#30363d}dt{color:#8b949e}}</style></head><body><main><h1>Elisa profile</h1><p>Native Elisa offline renderer; records are escaped and shown as inspectable detail.</p><p><strong>Source:</strong> <code>")
            append_html_escaped(buffer, source)
            append_text(buffer, "</code></p><dl><div><dt>Source SHA-256</dt><dd><code>")
            append_html_escaped(buffer, source_digest) if source_digest_available
            append_text(buffer, "unavailable" if not source_digest_available else "")
            append_text(buffer, "</code></dd></div><div><dt>Status</dt><dd>")
            append_text(buffer, "ok" if exit_code == NATIVE_ZERO else "target failed")
            append_text(buffer, "</dd></div><div><dt>Outcome</dt><dd>")
            append_html_escaped(buffer, outcome)
            append_text(buffer, "</dd></div><div><dt>Mean execution</dt><dd>")
            if execution_mean_available:
                append_micros_as_millis(buffer, execution_mean_micros)
                append_text(buffer, " ms")
            else:
                append_text(buffer, "unavailable")
            append_text(buffer, "</dd></div><div><dt>CPU</dt><dd>")
            if cpu_available:
                append_micros_as_millis(buffer, cpu_micros)
                append_text(buffer, " ms")
            else:
                append_text(buffer, "unavailable")
            append_text(buffer, "</dd></div><div><dt>Peak RSS</dt><dd>")
            if peak_rss_available:
                append_i64(buffer, peak_rss_bytes)
                append_text(buffer, " bytes")
            else:
                append_text(buffer, "unavailable")
            append_text(buffer, "</dd></div><div><dt>Measured repetitions</dt><dd>")
            append_i64(buffer, successful_repetitions if successful_repetitions > NATIVE_ZERO else completed_repetitions)
            append_text(buffer, "</dd></div><div><dt>Capture completeness</dt><dd>")
            append_text(buffer, "complete" if capture_complete_available and capture_complete else "partial" if capture_complete_available else "not recorded")
            append_text(buffer, "</dd></div><div><dt>Events</dt><dd>")
            append_i64(buffer, events)
            append_text(buffer, "</dd></div><div><dt>Locations</dt><dd>")
            append_i64(buffer, locations)
            append_text(buffer, "</dd></div><div><dt>Dropped events</dt><dd>")
            append_i64(buffer, dropped)
            append_text(buffer, "</dd></div><div><dt>Threads</dt><dd>")
            append_i64(buffer, thread_count)
            append_text(buffer, "</dd></div>")
            append_html_host_summary(buffer, host)
            append_text(buffer, "</dl>")
            append_html_function_browser(buffer, functions)
            append_html_detail_browsers(buffer, call_edges, location_records)
            append_html_section(buffer, "Thread loss", thread_loss)
            append_html_section(buffer, "Folded stacks", folded)
            append_text(buffer, "</main></body></html>\n")
            return true


        def append_offline_text_report(buffer: mutable darray[u8]&, data: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            source: mutable darray[u8] = []
            source_start: i64 = json_source_value_start(data)
            return false if source_start < NATIVE_ZERO
            return false if json_string_into(data, source_start.usize(), data.count, &source) < NATIVE_ZERO
            summary_start: i64 = json_key_value_start(data, "summary", NATIVE_ZERO.usize(), data.count)
            run_start: i64 = json_key_value_start(data, "run", NATIVE_ZERO.usize(), data.count)
            return false if summary_start < NATIVE_ZERO or run_start < NATIVE_ZERO
            summary_stop: i64 = json_object_end(data, summary_start.usize(), data.count)
            run_stop: i64 = json_object_end(data, run_start.usize(), data.count)
            return false if summary_stop < NATIVE_ZERO or run_stop < NATIVE_ZERO
            events: mutable i64 = NATIVE_ZERO
            locations: mutable i64 = NATIVE_ZERO
            statement_events: mutable i64 = NATIVE_ZERO
            value_events: mutable i64 = NATIVE_ZERO
            function_events: mutable i64 = NATIVE_ZERO
            dropped: mutable i64 = NATIVE_ZERO
            thread_count: mutable i64 = NATIVE_ZERO
            exit_code: mutable i64 = NATIVE_ZERO
            outcome: mutable darray[u8] = []
            capture_complete: mutable bool = false
            capture_complete_available: mutable bool = false
            return false if not json_read_number_field(data, "events", summary_start.usize(), summary_stop.usize(), &events)
            return false if not json_read_number_field(data, "locations", summary_start.usize(), summary_stop.usize(), &locations)
            return false if not json_read_number_field(data, "statement_events", summary_start.usize(), summary_stop.usize(), &statement_events)
            return false if not json_read_number_field(data, "value_events", summary_start.usize(), summary_stop.usize(), &value_events)
            return false if not json_read_number_field(data, "function_events", summary_start.usize(), summary_stop.usize(), &function_events)
            return false if not json_read_number_field(data, "dropped", summary_start.usize(), summary_stop.usize(), &dropped)
            return false if not json_read_number_field(data, "thread_count", summary_start.usize(), summary_stop.usize(), &thread_count)
            return false if not json_read_exit_code_field(data, run_start.usize(), run_stop.usize(), &exit_code)
            outcome_start: i64 = json_key_value_start(data, "outcome", run_start.usize(), run_stop.usize())
            if outcome_start >= NATIVE_ZERO:
                return false if json_string_into(data, outcome_start.usize(), run_stop.usize(), &outcome) < NATIVE_ZERO
            if outcome.count == NATIVE_ZERO.usize():
                append_text(outcome, "success" if exit_code == NATIVE_ZERO else "target_exit")
            capture_complete_start: i64 = json_key_value_start(data, "capture_complete", summary_start.usize(), summary_stop.usize())
            if capture_complete_start >= NATIVE_ZERO:
                return false if not json_read_bool_field(data, "capture_complete", summary_start.usize(), summary_stop.usize(), &capture_complete)
                capture_complete_available <- true
            append_text(buffer, "Elisa profiler\nsource: ")
            for index in 0..<source.count |buffer, source|:
                buffer.push(source[index])
            append_text(buffer, "\nstatus: ")
            append_text(buffer, "ok\n" if exit_code == NATIVE_ZERO else "target failed\n")
            append_text(buffer, "outcome: ")
            for index in 0..<outcome.count |buffer, outcome|:
                buffer.push(outcome[index])
            append_text(buffer, "\ncapture completeness: ")
            append_text(buffer, "complete\n" if capture_complete_available and capture_complete else "partial\n" if capture_complete_available else "not recorded\n")
            append_text(buffer, "events: ")
            append_i64(buffer, events)
            append_text(buffer, "\nlocations: ")
            append_i64(buffer, locations)
            append_text(buffer, "\nstatement events: ")
            append_i64(buffer, statement_events)
            append_text(buffer, "\nvalue events: ")
            append_i64(buffer, value_events)
            append_text(buffer, "\nfunction events: ")
            append_i64(buffer, function_events)
            append_text(buffer, "\nthreads: ")
            append_i64(buffer, thread_count)
            append_text(buffer, "\ndropped: ")
            append_i64(buffer, dropped)
            thread_loss_start: i64 = json_key_value_start(data, "thread_loss", NATIVE_ZERO.usize(), data.count)
            append_text(buffer, "\nthread loss records: ")
            append_text(buffer, "present\n" if thread_loss_start >= NATIVE_ZERO else "none\n")
            return true
