# Native report renderers and comparison presentation.
#
# All renderers consume normalized ProfilerNative records. They are private so
# callers cannot bypass validation by reaching into a format-specific writer.
extend ProfilerNative:
    private:
        def append_detail_arrays(buffer: mutable darray[u8]&, summary: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "\"functions\":[")
            buffer.extend(summary.function_records)
            append_text(buffer, "],\"call_edges\":[")
            buffer.extend(summary.call_edge_records)
            append_text(buffer, "],\"stacks\":[")
            buffer.extend(summary.stack_records)
            append_text(buffer, "],\"locations\":[")
            buffer.extend(summary.location_records)
            append_text(buffer, "],\"samples\":[")
            buffer.extend(summary.sample_records)
            append_text(buffer, "]")


        def append_folded_report(buffer: mutable darray[u8]&, summary: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            buffer.extend(summary.folded_records)
            buffer.push(NATIVE_BYTE_NEWLINE) if summary.folded_records.count > NATIVE_ZERO.usize()


        def folded_line_end(records: darray[u8]&, start: usize) -> usize:
            cursor: mutable usize = start
            while cursor < records.count |cursor, records|:
                break if records[cursor] == NATIVE_BYTE_NEWLINE
                cursor <- cursor + NATIVE_ONE.usize()
            return cursor


        def folded_line_weight(records: darray[u8]&, start: usize, stop: usize) -> i64 can[Abort.Panic, Memory.Allocate]:
            separator: mutable usize = start
            cursor: mutable usize = start
            while cursor < stop |cursor, separator, records|:
                separator <- cursor if records[cursor] == NATIVE_BYTE_SPACE
                cursor <- cursor + NATIVE_ONE.usize()
            return NATIVE_ZERO if separator == start or separator + NATIVE_ONE.usize() >= stop
            weight: mutable darray[u8] = []
            for index in separator + NATIVE_ONE.usize()..<stop |weight, records|:
                weight.push(records[index])
            return protocol_number_field(weight)


        def folded_stack_stop(records: darray[u8]&, start: usize, stop: usize) -> usize:
            cursor: mutable usize = stop
            while cursor > start |cursor, records|:
                break if records[cursor - NATIVE_ONE.usize()] == NATIVE_BYTE_SPACE
                cursor <- cursor - NATIVE_ONE.usize()
            return cursor


        def append_speedscope_frames(buffer: mutable darray[u8]&, records: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            first_frame: mutable bool = true
            line_start: mutable usize = NATIVE_ZERO.usize()
            while line_start < records.count |line_start, first_frame, records, buffer|:
                line_end: usize = folded_line_end(records, line_start)
                weight: i64 = folded_line_weight(records, line_start, line_end)
                if weight > NATIVE_ZERO:
                    stack_stop: usize = folded_stack_stop(records, line_start, line_end)
                    frame_start: mutable usize = line_start
                    while frame_start < stack_stop |frame_start, stack_stop, first_frame, records, buffer|:
                        frame_end: mutable usize = frame_start
                        while frame_end < stack_stop |frame_end, stack_stop, records|:
                            break if records[frame_end] == NATIVE_BYTE_SEMICOLON
                            frame_end <- frame_end + NATIVE_ONE.usize()
                        frame: mutable darray[u8] = []
                        for index in frame_start..<frame_end |frame, records|:
                            frame.push(records[index])
                        append_record_separator(buffer) if not first_frame
                        append_text(buffer, "{\"name\":")
                        append_json_string(buffer, frame)
                        append_text(buffer, "}")
                        first_frame <- false
                        frame_start <- frame_end + NATIVE_ONE.usize() if frame_end < stack_stop else stack_stop
                line_start <- line_end + NATIVE_ONE.usize() if line_end < records.count else records.count


        def append_speedscope_samples(buffer: mutable darray[u8]&, records: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            first_sample: mutable bool = true
            frame_index: mutable i64 = NATIVE_ZERO
            line_start: mutable usize = NATIVE_ZERO.usize()
            while line_start < records.count |line_start, first_sample, frame_index, records, buffer|:
                line_end: usize = folded_line_end(records, line_start)
                weight: i64 = folded_line_weight(records, line_start, line_end)
                if weight > NATIVE_ZERO:
                    stack_stop: usize = folded_stack_stop(records, line_start, line_end)
                    frame_start: mutable usize = line_start
                    first_frame: mutable bool = true
                    append_record_separator(buffer) if not first_sample
                    buffer.push(NATIVE_BYTE_LEFT_BRACKET)
                    while frame_start < stack_stop |frame_start, stack_stop, frame_index, first_frame, records, buffer|:
                        frame_end: mutable usize = frame_start
                        while frame_end < stack_stop |frame_end, stack_stop, records|:
                            break if records[frame_end] == NATIVE_BYTE_SEMICOLON
                            frame_end <- frame_end + NATIVE_ONE.usize()
                        append_record_separator(buffer) if not first_frame
                        append_i64(buffer, frame_index)
                        first_frame <- false
                        frame_index <- frame_index + NATIVE_ONE
                        frame_start <- frame_end + NATIVE_ONE.usize() if frame_end < stack_stop else stack_stop
                    buffer.push(NATIVE_BYTE_RIGHT_BRACKET)
                    first_sample <- false
                line_start <- line_end + NATIVE_ONE.usize() if line_end < records.count else records.count


        def append_speedscope_weights(buffer: mutable darray[u8]&, records: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            first_weight: mutable bool = true
            line_start: mutable usize = NATIVE_ZERO.usize()
            while line_start < records.count |line_start, first_weight, records, buffer|:
                line_end: usize = folded_line_end(records, line_start)
                weight: i64 = folded_line_weight(records, line_start, line_end)
                if weight > NATIVE_ZERO:
                    append_record_separator(buffer) if not first_weight
                    append_i64(buffer, weight)
                    first_weight <- false
                line_start <- line_end + NATIVE_ONE.usize() if line_end < records.count else records.count


        def folded_total_weight(records: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate]:
            total: mutable i64 = NATIVE_ZERO
            line_start: mutable usize = NATIVE_ZERO.usize()
            while line_start < records.count |line_start, total, records|:
                line_end: usize = folded_line_end(records, line_start)
                weight: i64 = folded_line_weight(records, line_start, line_end)
                total <- native_saturating_add(total, weight) if weight > NATIVE_ZERO
                line_start <- line_end + NATIVE_ONE.usize() if line_end < records.count else records.count
            return total


        def append_speedscope_report(buffer: mutable darray[u8]&, source: darray[u8]&, records: darray[u8]&, location_timing: bool, sampled: bool) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "{\"$schema\":\"https://www.speedscope.app/file-format-schema.json\",\"name\":")
            append_json_string(buffer, source)
            append_text(buffer, ",\"activeProfileIndex\":0,\"exporter\":\"elisa-profiler-native\",\"shared\":{\"frames\":[")
            append_speedscope_frames(buffer, records)
            append_text(buffer, "]},\"profiles\":[{\"type\":\"sampled\",\"name\":")
            append_json_string(buffer, source)
            append_text(buffer, ",\"unit\":\"")
            append_text(buffer, "samples" if sampled else "nanoseconds" if location_timing else "none")
            append_text(buffer, "\",\"startValue\":0,\"endValue\":")
            append_i64(buffer, folded_total_weight(records))
            append_text(buffer, ",\"samples\":[")
            append_speedscope_samples(buffer, records)
            append_text(buffer, "],\"weights\":[")
            append_speedscope_weights(buffer, records)
            append_text(buffer, "]}]}\n")


        def append_offline_folded_report(buffer: mutable darray[u8]&, profile: NativeOfflineProfile) -> bool can[Abort.Panic, Memory.Allocate]:
            buffer.extend(profile.folded_records)
            buffer.push(NATIVE_BYTE_NEWLINE) if buffer.count > NATIVE_ZERO.usize()
            return true
        def append_offline_speedscope_report(buffer: mutable darray[u8]&, profile: NativeOfflineProfile) -> bool can[Abort.Panic, Memory.Allocate]:
            append_speedscope_report(buffer, profile.source, profile.folded_records, profile.location_timing, profile.sample_count > NATIVE_ZERO)
            return true


        # The browser view keeps metric values as decimal strings until the UI
        # sorts them with BigInt. JSON.parse would round i64 timings above
        # JavaScript's safe-integer range, making a report visually incorrect.
        # The small record scanner therefore extracts only the shallow scalar
        # fields needed by this table and never converts metric text to Number.
        def append_html_function_browser(buffer: mutable darray[u8]&, records: darray[u8]&, folded: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<style>.panel{margin-top:1.25rem}.panel h2{margin-bottom:.5rem}.panel label{display:block;font-weight:650;margin-bottom:.25rem}.panel input{width:100%;box-sizing:border-box;padding:.55rem .7rem;border:1px solid #8c959f;border-radius:6px;font:inherit;background:inherit;color:inherit}.panel input:focus-visible,.panel button:focus-visible,.panel summary:focus-visible{outline:3px solid #0969da;outline-offset:2px}.table-scroll{overflow:auto;margin-top:.75rem}.panel table{width:100%;border-collapse:collapse;min-width:42rem}.panel th,.panel td{padding:.5rem .65rem;border-bottom:1px solid #d8dee4;text-align:left;white-space:nowrap}.panel tbody tr:focus-visible{outline:3px solid #0969da;outline-offset:-2px}.panel th{font-size:.8rem;color:#57606a}.panel td:not(:first-child){font-family:ui-monospace,SFMono-Regular,Menlo,monospace;text-align:right}.panel details{margin-top:.75rem}.empty-state{padding:.75rem;border:1px dashed #8c959f;border-radius:8px;color:#57606a}.panel noscript{display:block;margin-top:.75rem}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:0.01ms!important;animation-duration:0.01ms!important;animation-iteration-count:1!important}}@media print{body{background:#fff!important;color:#000!important}main{box-shadow:none!important;border:0!important;max-width:none!important}.panel input,.panel button,#view-state-status{display:none!important}.panel details[open] > pre{max-height:none!important}.table-scroll{overflow:visible!important}.panel{break-inside:avoid}}@media(prefers-color-scheme:dark){.empty-state{color:#8b949e;border-color:#8b949e}}</style><section class='panel' aria-labelledby='hotspots-title'><h2 id='hotspots-title'>Hotspots</h2><label for='function-filter'>Filter functions</label><input id='function-filter' type='search' autocomplete='off' placeholder='name or percentage'><p id='function-status' role='status' aria-live='polite'>Loading function records…</p><p id='function-empty' class='empty-state' role='status' hidden></p><noscript><p class='empty-state'>Enable JavaScript to inspect hotspots interactively, or use <code>--format text</code> or <code>--format folded</code> for a script-free report.</p></noscript><div class='table-scroll'><table><thead><tr><th scope='col'>Function</th><th scope='col'>Inclusive</th><th scope='col'>Self</th><th scope='col'>Calls</th><th scope='col'>Share</th></tr></thead><tbody id='function-rows'></tbody></table></div><details><summary>Raw function records</summary><pre id='function-records' hidden>")
            append_html_escaped(buffer, records)
            append_text(buffer, "</pre></details><p class='panel-note'>Inclusive share is relative to observed folded root self time. Inclusive callers overlap their callees, so their shares can sum above 100%.</p><pre id='function-root-weights' hidden>")
            append_html_escaped(buffer, folded)
            append_text(buffer, "</pre><script>(function(){'use strict';const raw=document.getElementById('function-records');const root=document.getElementById('function-root-weights');const body=document.getElementById('function-rows');const filter=document.getElementById('function-filter');const status=document.getElementById('function-status');const quote=String.fromCharCode(34);const ZERO=0n;const NEWLINE=String.fromCharCode(10);const SPACE=String.fromCharCode(32);const PERCENT_SCALE=10000n;const PERCENT_DISPLAY_SCALE=100;const MAX_TABLE_ROWS=200;function objects(text){const result=[];let start=-1,depth=0,inString=false,escaped=false;for(let index=0;index<text.length;index+=1){const byte=text.charAt(index);if(inString){if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){inString=false;}continue;}if(byte===quote){inString=true;}else if(byte==='{'){if(depth===0){start=index;}depth+=1;}else if(byte==='}'){depth-=1;if(depth===0&&start>=0){result.push(text.slice(start,index+1));start=-1;}}}return result;}function field(record,name){const marker=quote+name+quote+':';const start=record.indexOf(marker);if(start<0){return '';}let cursor=start+marker.length;while(cursor<record.length&&(record.charAt(cursor)===' '||record.charCodeAt(cursor)===9)){cursor+=1;}if(record.charAt(cursor)===quote){let end=cursor+1,escaped=false;for(;end<record.length;end+=1){const byte=record.charAt(end);if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){break;}}try{return JSON.parse(record.slice(cursor,end+1));}catch(_error){return '';}}let end=cursor;while(end<record.length&&((record.charCodeAt(end)>=48&&record.charCodeAt(end)<=57)||record.charAt(end)==='-')){end+=1;}return record.slice(cursor,end);}function magnitude(value){try{return BigInt(value||'0');}catch(_error){return ZERO;}}function foldedTotal(text){let total=ZERO;(text||'').split(NEWLINE).forEach(function(line){const stop=line.lastIndexOf(SPACE);if(stop<1){return;}const weight=magnitude(line.slice(stop+1).trim());if(weight>ZERO){total+=weight;}});return total;}const total=foldedTotal(root?root.textContent||'':'');function formatShare(value){if(total===ZERO){return 'unavailable';}const scaled=(value*PERCENT_SCALE)/total;return (Number(scaled)/PERCENT_DISPLAY_SCALE).toFixed(2)+'%';}function render(){const query=(filter.value||'').toLowerCase();const rows=objects(raw.textContent||'').map(function(record){const name=field(record,'function'),inclusive=field(record,'inclusive_ns');return{name:name,identity:field(record,'identity_id'),inclusive:inclusive,self:field(record,'self_ns'),calls:field(record,'completed_calls'),search:(field(record,'function')+' '+formatShare(magnitude(inclusive))).toLowerCase()};}).filter(function(row){return row.search.includes(query);}).sort(function(left,right){const a=magnitude(left.inclusive),b=magnitude(right.inclusive);return a===b?left.name.localeCompare(right.name):(a>b?-1:1);});body.replaceChildren();rows.slice(0,MAX_TABLE_ROWS).forEach(function(row){const line=document.createElement('tr');if(row.identity.length>0){line.dataset.identity=row.identity;}[row.name,row.inclusive+' ns',row.self+' ns',row.calls,formatShare(magnitude(row.inclusive))].forEach(function(value){const cell=document.createElement('td');cell.textContent=value;line.appendChild(cell);});body.appendChild(line);});status.textContent=rows.length+' function'+(rows.length===1?'':'s')+' shown'+(rows.length>MAX_TABLE_ROWS?' (first '+MAX_TABLE_ROWS+')':'');}filter.addEventListener('input',render);render();}());</script>")


            append_text(buffer, "</section>")


        def append_html_actionable_summary(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<section class='panel' aria-labelledby='actionable-title'><h2 id='actionable-title'>Where to start</h2><p id='actionable-status' role='status' aria-live='polite'>Ranking self-time starting points…</p><ol id='actionable-rows' class='actionable-list'></ol><p class='panel-note'>These starting points are ranked by recorded self time. Use the function explorer and caller/callee tables to determine whether the cost is local or propagated.</p></section><script>(function(){'use strict';const raw=document.getElementById('function-records');const root=document.getElementById('function-root-weights');const filter=document.getElementById('function-filter');const body=document.getElementById('actionable-rows');const status=document.getElementById('actionable-status');const quote=String.fromCharCode(34);const ZERO=0n;const NEWLINE=String.fromCharCode(10);const SPACE=String.fromCharCode(32);const PERCENT_SCALE=10000n;const PERCENT_DISPLAY_SCALE=100;const MAX_ACTIONABLE_ROWS=5;function objects(text){const result=[];let start=-1,depth=0,inString=false,escaped=false;for(let index=0;index<text.length;index+=1){const byte=text.charAt(index);if(inString){if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){inString=false;}continue;}if(byte===quote){inString=true;}else if(byte==='{'){if(depth===0){start=index;}depth+=1;}else if(byte==='}'){depth-=1;if(depth===0&&start>=0){result.push(text.slice(start,index+1));start=-1;}}}return result;}function field(record,name){const marker=quote+name+quote+':';const start=record.indexOf(marker);if(start<0){return '';}let cursor=start+marker.length;while(cursor<record.length&&(record.charAt(cursor)===' '||record.charCodeAt(cursor)===9)){cursor+=1;}if(record.charAt(cursor)===quote){let end=cursor+1,escaped=false;for(;end<record.length;end+=1){const byte=record.charAt(end);if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){break;}}try{return JSON.parse(record.slice(cursor,end+1));}catch(_error){return '';}}let end=cursor;while(end<record.length&&((record.charCodeAt(end)>=48&&record.charCodeAt(end)<=57)||record.charAt(end)==='-')){end+=1;}return record.slice(cursor,end);}function magnitude(value){try{return BigInt(value||'0');}catch(_error){return ZERO;}}function foldedTotal(text){let total=ZERO;(text||'').split(NEWLINE).forEach(function(line){const stop=line.lastIndexOf(SPACE);if(stop<1){return;}const weight=magnitude(line.slice(stop+1).trim());if(weight>ZERO){total+=weight;}});return total;}const total=foldedTotal(root?root.textContent||'':'');function formatShare(value){if(total===ZERO){return 'unavailable';}const scaled=(value*PERCENT_SCALE)/total;return (Number(scaled)/PERCENT_DISPLAY_SCALE).toFixed(2)+'%';}function render(){const query=(filter.value||'').toLowerCase();const rows=objects(raw.textContent||'').map(function(record){const name=field(record,'function'),inclusive=field(record,'inclusive_ns'),self=field(record,'self_ns'),calls=field(record,'completed_calls');return{name:name,inclusive:inclusive,self:self,calls:calls,search:(name+' '+formatShare(magnitude(inclusive))).toLowerCase()};}).filter(function(row){return row.search.includes(query);}).sort(function(left,right){const leftSelf=magnitude(left.self),rightSelf=magnitude(right.self);if(leftSelf!==rightSelf){return leftSelf>rightSelf?-1:1;}const leftInclusive=magnitude(left.inclusive),rightInclusive=magnitude(right.inclusive);return leftInclusive===rightInclusive?left.name.localeCompare(right.name):(leftInclusive>rightInclusive?-1:1);});body.replaceChildren();if(rows.length===0){status.textContent='No function records match the current filter.';return;}const shown=Math.min(rows.length,MAX_ACTIONABLE_ROWS);status.textContent='Top '+shown+' starting point'+(shown===1?'':'s')+' by self time.';rows.slice(0,MAX_ACTIONABLE_ROWS).forEach(function(row){const item=document.createElement('li');item.textContent=row.name+' — '+row.self+' ns self, '+formatShare(magnitude(row.inclusive))+' inclusive share, '+row.calls+' completed calls';body.appendChild(item);});}filter.addEventListener('input',render);render();}());</script>")


        def append_html_function_explorer(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<section class='panel' aria-labelledby='function-explorer-title'><h2 id='function-explorer-title'>Function explorer</h2><p id='function-selection-status' role='status' aria-live='polite'>Select a hotspot to focus its caller, callee, and source-location records.</p><div id='function-selection-details' hidden><strong id='function-selection-name'></strong><dl><div><dt>Compiler identity</dt><dd id='function-selection-identity'></dd></div><div><dt>Inclusive</dt><dd id='function-selection-inclusive'></dd></div><div><dt>Self</dt><dd id='function-selection-self'></dd></div><div><dt>Completed calls</dt><dd id='function-selection-calls'></dd></div><div><dt>Observed share</dt><dd id='function-selection-share'></dd></div></dl><div class='function-related'><article><h3>Observed callers</h3><p id='function-selection-callers-status' role='status'></p><ul id='function-selection-callers'></ul></article><article><h3>Observed callees</h3><p id='function-selection-callees-status' role='status'></p><ul id='function-selection-callees'></ul></article></div></div><style>.function-link{border:0;padding:0;background:transparent;color:inherit;font:inherit;text-align:left;text-decoration:underline;text-decoration-style:dotted;cursor:pointer}.function-link:focus-visible{outline:3px solid #0969da;outline-offset:2px}.function-related{display:grid;grid-template-columns:repeat(auto-fit,minmax(18rem,1fr));gap:1rem;margin-top:1rem}.function-related article{border:1px solid #d8dee4;border-radius:8px;padding:.75rem}.function-related h3{margin:.1rem 0 .5rem;font-size:1rem}.function-related ul{margin:.5rem 0 0;padding-left:1.25rem}.function-related li{margin:.25rem 0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.function-related p:empty{display:none}@media(prefers-color-scheme:dark){.function-related article{border-color:#30363d}}</style></section>")


        def append_html_detail_browsers(buffer: mutable darray[u8]&, call_edges: darray[u8]&, locations: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<section class='panel' aria-labelledby='edges-title'><h2 id='edges-title'>Caller and callee edges</h2><label for='edge-filter'>Filter caller or callee</label><input id='edge-filter' type='search' autocomplete='off' placeholder='caller or callee'><p id='edge-status' role='status' aria-live='polite'></p><div class='table-scroll'><table><thead><tr><th scope='col'>Caller</th><th scope='col'>Callee</th><th scope='col'>Inclusive</th><th scope='col'>Completed calls</th></tr></thead><tbody id='edge-rows'></tbody></table></div><details><summary>Raw call-edge records</summary><pre id='edge-records' hidden>")
            append_html_escaped(buffer, call_edges)
            append_text(buffer, "</pre></details></section><section class='panel' aria-labelledby='locations-title'><h2 id='locations-title'>Source locations</h2><label for='location-filter'>Filter source, function, or variable</label><input id='location-filter' type='search' autocomplete='off' placeholder='source, function, or variable'><p id='location-status' role='status' aria-live='polite'></p><div class='table-scroll'><table><thead><tr><th scope='col'>Source</th><th scope='col'>Line</th><th scope='col'>Function</th><th scope='col'>Variable</th><th scope='col'>Interval</th><th scope='col'>Count</th></tr></thead><tbody id='location-rows'></tbody></table></div><details><summary>Raw source-location records</summary><pre id='location-records' hidden>")
            append_html_escaped(buffer, locations)
            append_text(buffer, "</pre></details></section><script>(function(){'use strict';const quote=String.fromCharCode(34);const MAX_TABLE_ROWS=200;const edgeRaw=document.getElementById('edge-records');const edgeBody=document.getElementById('edge-rows');const edgeFilter=document.getElementById('edge-filter');const edgeStatus=document.getElementById('edge-status');const locationRaw=document.getElementById('location-records');const locationBody=document.getElementById('location-rows');const locationFilter=document.getElementById('location-filter');const locationStatus=document.getElementById('location-status');function objects(text){const result=[];let start=-1,depth=0,inString=false,escaped=false;for(let index=0;index<text.length;index+=1){const byte=text.charAt(index);if(inString){if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){inString=false;}continue;}if(byte===quote){inString=true;}else if(byte==='{'){if(depth===0){start=index;}depth+=1;}else if(byte==='}'){depth-=1;if(depth===0&&start>=0){result.push(text.slice(start,index+1));start=-1;}}}return result;}function field(record,name){const marker=quote+name+quote+':';const start=record.indexOf(marker);if(start<0){return '';}let cursor=start+marker.length;while(cursor<record.length&&(record.charAt(cursor)===' '||record.charCodeAt(cursor)===9)){cursor+=1;}if(record.charAt(cursor)===quote){let end=cursor+1,escaped=false;for(;end<record.length;end+=1){const byte=record.charAt(end);if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){break;}}try{return JSON.parse(record.slice(cursor,end+1));}catch(_error){return '';}}let end=cursor;while(end<record.length&&((record.charCodeAt(end)>=48&&record.charCodeAt(end)<=57)||record.charAt(end)==='-')){end+=1;}return record.slice(cursor,end);}function magnitude(value){try{return BigInt(value||'0');}catch(_error){return BigInt(0);}}function draw(body,rows){body.replaceChildren();rows.slice(0,MAX_TABLE_ROWS).forEach(function(row){const line=document.createElement('tr');row.values.forEach(function(value){const cell=document.createElement('td');cell.textContent=value;line.appendChild(cell);});body.appendChild(line);});}function renderEdges(){const query=(edgeFilter.value||'').toLowerCase();const rows=objects(edgeRaw.textContent||'').map(function(record){const caller=field(record,'caller'),callee=field(record,'callee');return{search:(caller+' '+callee).toLowerCase(),values:[caller,callee,field(record,'inclusive_ns')+' ns',field(record,'completed_calls')]};}).filter(function(row){return row.search.includes(query);}).sort(function(left,right){const a=magnitude(left.values[2]),b=magnitude(right.values[2]);return a===b?left.values[0].localeCompare(right.values[0]):(a>b?-1:1);});draw(edgeBody,rows);edgeStatus.textContent=rows.length+' edge'+(rows.length===1?'':'s')+' shown'+(rows.length>MAX_TABLE_ROWS?' (first '+MAX_TABLE_ROWS+')':'');}function renderLocations(){const query=(locationFilter.value||'').toLowerCase();const rows=objects(locationRaw.textContent||'').map(function(record){const source=field(record,'source'),line=field(record,'line'),func=field(record,'function'),variable=field(record,'variable');return{search:(source+' '+func+' '+variable).toLowerCase(),values:[source,line,func,variable,field(record,'interval_ns')+' ns',field(record,'count')]};}).filter(function(row){return row.search.includes(query);}).sort(function(left,right){const a=magnitude(left.values[4]),b=magnitude(right.values[4]);return a===b?left.values[0].localeCompare(right.values[0]):(a>b?-1:1);});draw(locationBody,rows);locationStatus.textContent=rows.length+' location'+(rows.length===1?'':'s')+' shown'+(rows.length>MAX_TABLE_ROWS?' (first '+MAX_TABLE_ROWS+')':'');}edgeFilter.addEventListener('input',renderEdges);locationFilter.addEventListener('input',renderLocations);renderEdges();renderLocations();}());</script>")



        # The function table is rebuilt when its filter changes. Keep the
        # explorer behavior delegated from the stable tbody and re-wrap newly
        # rendered rows so filtering never strands the navigation affordance.
        def append_html_function_explorer_rebind(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<script>(function(){'use strict';const rows=document.getElementById('function-rows');const filter=document.getElementById('function-filter');const details=document.getElementById('function-selection-details');const status=document.getElementById('function-selection-status');const FILTER_IDS=['edge-filter','location-filter'];if(rows===null||details===null||status===null){return;}const nodes=['function-selection-name','function-selection-identity','function-selection-inclusive','function-selection-self','function-selection-calls','function-selection-share'].map(function(id){return document.getElementById(id);});function select(row){const cells=row.children;if(cells.length<5){return;}const values=[cells[0].textContent||'',row.dataset.identity||'not available',cells[1].textContent||'',cells[2].textContent||'',cells[3].textContent||'',cells[4].textContent||''];nodes.forEach(function(node,index){if(node!==null){node.textContent=values[index];}});details.hidden=false;status.textContent='Selected '+values[0]+'. Related caller, callee, and source-location views are filtered to this function identity.';FILTER_IDS.forEach(function(id){const input=document.getElementById(id);if(input!==null){input.value=values[0];input.dispatchEvent(new Event('input'));}});rows.querySelectorAll('tr').forEach(function(candidate){candidate.setAttribute('aria-selected',candidate===row?'true':'false');});}function prepare(){rows.querySelectorAll('tr').forEach(function(row){const first=row.firstElementChild;if(first!==null&&first.querySelector('button.function-link')===null){const button=document.createElement('button');button.type='button';button.className='function-link';button.textContent=first.textContent||'';first.replaceChildren(button);}row.tabIndex=0;});}rows.addEventListener('click',function(event){const target=event.target;if(target===null||target.closest===undefined){return;}const row=target.closest('tr');if(row!==null){select(row);}});rows.addEventListener('keydown',function(event){if(event.key!=='Enter'&&event.key!==' '){return;}const target=event.target;if(target===null||target.closest===undefined){return;}const row=target.closest('tr');if(row!==null){event.preventDefault();select(row);}});prepare();if(filter!==null){filter.addEventListener('input',prepare);}}());</script>")


        # Keep hotspot selection coherent with both flame views without making
        # the table renderer own their filters. The observer also handles rows
        # rebuilt after a function search, so selection never depends on a
        # particular DOM lifetime.
        def append_html_function_explorer_flame_navigation(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<script>(function(){'use strict';const selected=document.getElementById('function-selection-name');const FILTER_IDS=['flame-filter','flame-metric-filter'];if(selected===null){return;}function sync(){const name=selected.textContent||'';if(name.length===0){return;}FILTER_IDS.forEach(function(id){const input=document.getElementById(id);if(input!==null&&input.value!==name){input.value=name;input.dispatchEvent(new Event('input'));}});}new MutationObserver(sync).observe(selected,{childList:true,characterData:true,subtree:true});sync();}());</script>")
            append_text(buffer, "<script>(function(){'use strict';const selected=document.getElementById('function-selection-name');const identity=document.getElementById('function-selection-identity');const edgeRaw=document.getElementById('edge-records');const callers=document.getElementById('function-selection-callers');const callees=document.getElementById('function-selection-callees');const callersStatus=document.getElementById('function-selection-callers-status');const calleesStatus=document.getElementById('function-selection-callees-status');const QUOTE=String.fromCharCode(34);const MAX_RELATED_ROWS=20;if(selected===null||identity===null||edgeRaw===null||callers===null||callees===null||callersStatus===null||calleesStatus===null){return;}function objects(text){const result=[];let start=-1,depth=0,inString=false,escaped=false;for(let index=0;index<text.length;index+=1){const byte=text.charAt(index);if(inString){if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===QUOTE){inString=false;}continue;}if(byte===QUOTE){inString=true;}else if(byte==='{'){if(depth===0){start=index;}depth+=1;}else if(byte==='}'){depth-=1;if(depth===0&&start>=0){result.push(text.slice(start,index+1));start=-1;}}}return result;}function field(record,name){const marker=QUOTE+name+QUOTE+':';const start=record.indexOf(marker);if(start<0){return '';}let cursor=start+marker.length;while(cursor<record.length&&(record.charAt(cursor)===' '||record.charCodeAt(cursor)===9)){cursor+=1;}if(record.charAt(cursor)===QUOTE){let end=cursor+1,escaped=false;for(;end<record.length;end+=1){const byte=record.charAt(end);if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===QUOTE){break;}}try{return JSON.parse(record.slice(cursor,end+1));}catch(_error){return '';}}let end=cursor;while(end<record.length&&((record.charCodeAt(end)>=48&&record.charCodeAt(end)<=57)||record.charAt(end)==='-')){end+=1;}return record.slice(cursor,end);}function magnitude(value){try{return BigInt(value||'0');}catch(_error){return 0n;}}function draw(target,notice,kind,items){target.replaceChildren();if(items.length===0){notice.textContent='No observed '+kind+' for this function.';return;}items.sort(function(left,right){const a=magnitude(left.weight),b=magnitude(right.weight);return a===b?left.name.localeCompare(right.name):(a>b?-1:1);});items.slice(0,MAX_RELATED_ROWS).forEach(function(item){const row=document.createElement('li');row.textContent=item.name+' — '+item.weight+' ns, '+item.calls+' completed calls, repetition '+item.repetition;target.appendChild(row);});notice.textContent=items.length+' observed '+kind+(items.length===1?'':'s')+' shown'+(items.length>MAX_RELATED_ROWS?' (first '+MAX_RELATED_ROWS+')':'');}function render(){const name=selected.textContent||'',selectedIdentity=identity.textContent||'';if(name.length===0){return;}const callerItems=[],calleeItems=[];objects(edgeRaw.textContent||'').forEach(function(record){const caller=field(record,'caller'),callee=field(record,'callee'),callerId=field(record,'caller_id'),calleeId=field(record,'callee_id'),item={name:'',weight:field(record,'inclusive_ns'),calls:field(record,'completed_calls'),repetition:field(record,'repetition')||'1'};const callerMatches=selectedIdentity!=='not available'&&selectedIdentity.length>0?calleeId===selectedIdentity:(callee===name&&calleeId.length===0);const calleeMatches=selectedIdentity!=='not available'&&selectedIdentity.length>0?callerId===selectedIdentity:(caller===name&&callerId.length===0);if(callerMatches){item.name=caller;callerItems.push(item);}if(calleeMatches){item.name=callee;calleeItems.push(item);}});draw(callers,callersStatus,'caller',callerItems);draw(callees,calleesStatus,'callee',calleeItems);}new MutationObserver(render).observe(selected,{childList:true,characterData:true,subtree:true});new MutationObserver(render).observe(identity,{childList:true,characterData:true,subtree:true});}());</script>")

        # Keep source navigation in the same selection path as edge and
        # location filtering while allowing the source panel to remain lazy.
        def append_html_function_explorer_source_navigation(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<script>(function(){'use strict';const rows=document.getElementById('function-rows');const SOURCE_FILTER_ID='source-filter';if(rows===null){return;}function focusSource(row){const first=row.firstElementChild;const input=document.getElementById(SOURCE_FILTER_ID);if(first===null||input===null){return;}input.value=first.textContent||'';input.dispatchEvent(new Event('input'));}function targetRow(event){const target=event.target;if(target===null||target.closest===undefined){return null;}return target.closest('tr');}rows.addEventListener('click',function(event){const row=targetRow(event);if(row!==null){focusSource(row);}});rows.addEventListener('keydown',function(event){if(event.key!=='Enter'&&event.key!==' '){return;}const row=targetRow(event);if(row!==null){event.preventDefault();focusSource(row);}}); }());</script>")

        # Keep a real, visible explanation beside an empty function table. The
        # renderer initially emits a loading status, and the mutation observer
        # follows the delegated table renderer without parsing target data.
        def append_html_empty_state_behaviors(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<script>(function(){'use strict';const body=document.getElementById('function-rows');const filter=document.getElementById('function-filter');const empty=document.getElementById('function-empty');if(body===null||empty===null){return;}function refresh(){const hasRows=body.children.length>0;empty.hidden=hasRows;if(!hasRows){empty.textContent=filter!==null&&(filter.value||'').length>0?'No function records match this filter. Clear the filter or inspect the raw records.':'No function records were captured. Check Diagnostics or try a richer collection mode.';}}new MutationObserver(refresh).observe(body,{childList:true});refresh();}());</script>")


        def append_html_flame_graph(buffer: mutable darray[u8]&, folded: darray[u8]&, location_timing: bool, sampled: bool) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<section class='panel' aria-labelledby='flame-title'><h2 id='flame-title'>Flame graph — metric: ")
            append_text(buffer, "samples" if sampled else "nanoseconds" if location_timing else "events")
            append_text(buffer, "</h2><p class='panel-note'>Paths are shown caller → callee by default. Recursive frames are marked when adjacent stack entries repeat.</p><label for='flame-filter'>Search frames</label><input id='flame-filter' type='search' autocomplete='off' placeholder='function or module'><p id='flame-status' role='status' aria-live='polite'></p><button id='flame-reset' type='button'>Reset zoom</button><button id='flame-direction' type='button' aria-pressed='false'>Direction: caller → callee</button><div id='flame-graph' class='flame-graph' role='tree' aria-label='Interactive folded-stack flame graph'></div><details><summary>Raw folded weights</summary><pre id='flame-raw' hidden>")
            append_html_escaped(buffer, folded)
            append_text(buffer, "</pre></details></section><style>.flame-graph{margin-top:.75rem;border:1px solid #d8dee4;border-radius:8px;overflow:auto;padding:.5rem}.flame-row{display:flex;min-width:42rem;height:2.25rem;gap:2px}.flame-frame{box-sizing:border-box;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;border:1px solid #9ecbff;border-radius:4px;background:#ddf4ff;color:inherit;padding:.25rem .4rem;text-align:left;cursor:pointer}.flame-frame:focus-visible{outline:3px solid #0969da;outline-offset:1px}.flame-frame:hover{background:#b6e3ff}.flame-empty{padding:.75rem;color:#57606a}@media(prefers-color-scheme:dark){.flame-graph{border-color:#30363d}.flame-frame{border-color:#388bfd;background:#1f6feb44}.flame-frame:hover{background:#388bfd66}.flame-empty{color:#8b949e}}</style><script>(function(){'use strict';const METRIC_UNIT='")
            append_text(buffer, "samples" if sampled else "nanoseconds" if location_timing else "events")
            append_text(buffer, "';const raw=document.getElementById('flame-raw');const graph=document.getElementById('flame-graph');const filter=document.getElementById('flame-filter');const status=document.getElementById('flame-status');const reset=document.getElementById('flame-reset');const direction=document.getElementById('flame-direction');const PERCENT_SCALE=10000n;const PERCENT_DISPLAY_SCALE=100;const EMPTY_PATH='';let reversed=false;let selected=null;function newRoot(){return{name:'all',value:0n,children:new Map(),recursive:false};}function add(root,path,weight){let node=root;node.value+=weight;let previous=EMPTY_PATH;let frames=path.split(';').filter(function(name){return name.length>0;});if(reversed){frames.reverse();}frames.forEach(function(name){let child=node.children.get(name);if(!child){child={name:name,value:0n,children:new Map(),recursive:false};node.children.set(name,child);}if(name===previous){child.recursive=true;}child.value+=weight;node=child;previous=name;});}function build(){const result=newRoot();(raw.textContent||'').split(String.fromCharCode(10)).forEach(function(line){const trimmed=line.trim();if(!trimmed){return;}const separator=trimmed.lastIndexOf(' ');if(separator<=0){return;}let weight;try{weight=BigInt(trimmed.slice(separator+1));}catch(_error){return;}if(weight<0n){return;}add(result,trimmed.slice(0,separator),weight);});return result;}function label(node){return node.name+(node.recursive?' (recursive)':'');}function hasMatch(node,query){return !query||node.name.toLowerCase().includes(query)||label(node).toLowerCase().includes(query)||[...node.children.values()].some(function(child){return hasMatch(child,query);});}function percent(value,total){if(total===0n){return 0;}const scaled=(value*PERCENT_SCALE)/total;return Number(scaled)/PERCENT_DISPLAY_SCALE;}function render(){if(selected===null){selected=build();}graph.replaceChildren();const query=(filter.value||'').toLowerCase();const total=selected.value;const children=[...selected.children.values()].filter(function(node){return hasMatch(node,query);}).sort(function(left,right){return left.value===right.value?left.name.localeCompare(right.name):(left.value>right.value?-1:1);});if(children.length===0){const empty=document.createElement('p');empty.className='flame-empty';empty.textContent=query?'No matching frames.':'No folded-stack records were captured.';graph.appendChild(empty);status.textContent=empty.textContent;return;}const row=document.createElement('div');row.className='flame-row';row.setAttribute('role','group');children.forEach(function(node){const button=document.createElement('button');button.type='button';button.className='flame-frame';button.style.width=percent(node.value,total)+'%';button.title=label(node)+' — '+node.value.toString()+' '+METRIC_UNIT+' ('+percent(node.value,total).toFixed(2)+'%)';button.setAttribute('aria-label',button.title);button.textContent=label(node)+' ('+node.value.toString()+' '+METRIC_UNIT+')';button.addEventListener('click',function(){selected=node;render();});row.appendChild(button);});graph.appendChild(row);status.textContent=children.length+' frame'+(children.length===1?'':'s')+' shown at '+label(selected)+'; '+(reversed?'callee → caller':'caller → callee')+'; click a frame to zoom';}filter.addEventListener('input',function(){selected=build();render();});reset.addEventListener('click',function(){selected=build();filter.value='';render();});direction.addEventListener('click',function(){reversed=!reversed;selected=build();direction.setAttribute('aria-pressed',reversed?'true':'false');direction.textContent='Direction: '+(reversed?'callee → caller':'caller → callee');render();});render();}());</script>")


        # Keep metric selection on normalized stack records so the report can
        # compare time, completed calls, and event pressure without asking the
        # collector to emit another representation. The raw JSON stays hidden
        # in the document and is bounded by the same native record policy used
        # by the protocol decoder.
        def append_html_flame_metric_explorer(buffer: mutable darray[u8]&, stack_records: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<section class='panel' aria-labelledby='flame-metric-title'><h2 id='flame-metric-title'>Flame graph metric explorer</h2><p class='panel-note'>Select a stack metric to distinguish self time from completed-call and event pressure. Values are exact integer totals from the capture.</p><label for='flame-metric'>Metric</label><select id='flame-metric'><option value='self_ns'>Self time (nanoseconds)</option><option value='completed_calls'>Completed calls</option><option value='call_events'>Call events</option></select><label for='flame-metric-filter'>Search frames</label><input id='flame-metric-filter' type='search' autocomplete='off' placeholder='function or module'><p id='flame-metric-status' role='status' aria-live='polite'></p><button id='flame-metric-reset' type='button'>Reset zoom</button><button id='flame-metric-direction' type='button' aria-pressed='false'>Direction: caller → callee</button><div id='flame-metric-graph' class='flame-metric-graph' role='tree' aria-label='Metric folded-stack flame graph'></div><details><summary>Raw stack metrics</summary><pre id='flame-metric-raw' hidden>")
            append_html_escaped(buffer, stack_records)
            append_text(buffer, "</pre></details></section><style>.flame-metric-graph{margin-top:.75rem;border:1px solid #d8dee4;border-radius:8px;overflow:auto;padding:.5rem}.flame-metric-row{display:flex;min-width:42rem;height:2.25rem;gap:2px}.flame-metric-frame{box-sizing:border-box;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;border:1px solid #8250df;border-radius:4px;background:#fbefff;color:inherit;padding:.25rem .4rem;text-align:left;cursor:pointer}.flame-metric-frame:focus-visible{outline:3px solid #0969da;outline-offset:1px}.flame-metric-frame:hover{background:#e6d7ff}.flame-metric-empty{padding:.75rem;color:#57606a}@media(prefers-color-scheme:dark){.flame-metric-graph{border-color:#30363d}.flame-metric-frame{border-color:#a371f7;background:#8250df44}.flame-metric-frame:hover{background:#a371f766}.flame-metric-empty{color:#8b949e}}</style><script>(function(){'use strict';const raw=document.getElementById('flame-metric-raw');const metric=document.getElementById('flame-metric');const graph=document.getElementById('flame-metric-graph');const filter=document.getElementById('flame-metric-filter');const status=document.getElementById('flame-metric-status');const reset=document.getElementById('flame-metric-reset');const direction=document.getElementById('flame-metric-direction');const METRIC_SELF='self_ns';const METRIC_CALLS='completed_calls';const METRIC_EVENTS='call_events';const ZERO=0n;const PERCENT_SCALE=10000n;const PERCENT_DISPLAY_SCALE=100;const MAX_ROWS=")
            append_i64(buffer, NATIVE_FLAME_METRIC_DETAIL_LIMIT)
            append_text(buffer, ";let reversed=false;let selected=null;function magnitude(value){try{return BigInt(value||'0');}catch(_error){return ZERO;}}function unit(){return metric.value===METRIC_SELF?'ns':metric.value===METRIC_CALLS?'calls':'events';}function metricName(){const option=metric.options[metric.selectedIndex];return option===undefined?'metric':option.textContent||'metric';}function newRoot(){return{name:'all',value:ZERO,children:new Map()};}function add(root,path,weight){if(weight<=ZERO){return;}let node=root;node.value+=weight;let frames=(path||'').split(';').filter(function(name){return name.length>0;});if(reversed){frames.reverse();}frames.forEach(function(name){let child=node.children.get(name);if(!child){child={name:name,value:ZERO,children:new Map()};node.children.set(name,child);}child.value+=weight;node=child;});}function rows(){try{const value=JSON.parse(raw.textContent||'[]');return Array.isArray(value)?value:[];}catch(_error){return [];}}function build(){const result=newRoot();rows().forEach(function(row){add(result,row.stack,magnitude(row[metric.value]));});return result;}function label(node){return node.name;}function hasMatch(node,query){return !query||node.name.toLowerCase().includes(query)||[...node.children.values()].some(function(child){return hasMatch(child,query);});}function percent(value,total){if(total===ZERO){return 0;}const scaled=(value*PERCENT_SCALE)/total;return Number(scaled)/PERCENT_DISPLAY_SCALE;}function render(){if(selected===null){selected=build();}graph.replaceChildren();const query=(filter.value||'').toLowerCase();const total=selected.value;const children=[...selected.children.values()].filter(function(node){return hasMatch(node,query);}).sort(function(left,right){return left.value===right.value?left.name.localeCompare(right.name):(left.value>right.value?-1:1);});if(children.length===0){const empty=document.createElement('p');empty.className='flame-metric-empty';empty.textContent=query?'No matching frames.':'No stack metrics were captured.';graph.appendChild(empty);status.textContent=empty.textContent;return;}const row=document.createElement('div');row.className='flame-metric-row';row.setAttribute('role','group');children.slice(0,MAX_ROWS).forEach(function(node){const button=document.createElement('button');button.type='button';button.className='flame-metric-frame';button.style.width=percent(node.value,total)+'%';button.title=label(node)+' — '+node.value.toString()+' '+unit()+' ('+percent(node.value,total).toFixed(2)+'%)';button.setAttribute('aria-label',button.title);button.textContent=label(node)+' ('+node.value.toString()+' '+unit()+')';button.addEventListener('click',function(){selected=node;render();});row.appendChild(button);});graph.appendChild(row);status.textContent=Math.min(children.length,MAX_ROWS)+' frame'+(children.length===1?'':'s')+' shown at '+label(selected)+' for '+metricName()+'; '+(reversed?'callee → caller':'caller → callee')+(children.length>MAX_ROWS?' (bounded)':'')+'; click a frame to zoom';}function rebuild(){selected=build();render();}metric.addEventListener('change',rebuild);filter.addEventListener('input',rebuild);reset.addEventListener('click',function(){filter.value='';rebuild();});direction.addEventListener('click',function(){reversed=!reversed;direction.setAttribute('aria-pressed',reversed?'true':'false');direction.textContent='Direction: '+(reversed?'callee → caller':'caller → callee');rebuild();});render();}());</script>")


        def append_html_view_state(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            # Persist only navigational controls. Do not put source text, capture
            # records, or other target-controlled data into a URL or storage key.
            append_text(buffer, "<p id='view-state-status' class='panel' role='status' aria-live='polite'>View filters are stored locally on this device. <button id='view-state-clear' type='button'>Clear saved filters</button></p><script>(function(){'use strict';const STORAGE_KEY='elisa-profiler:view-state:v1';const INPUT_IDS=['function-filter','edge-filter','location-filter','source-filter','source-metric','flame-filter','flame-metric-filter','flame-metric','thread-loss-filter'];const EMPTY_QUERY='';const DEFAULT_VALUES=Object.freeze({'source-metric':'interval_ns','flame-metric':'self_ns'});const SELECT_TAG='SELECT';const INPUT_EVENT='input';const CHANGE_EVENT='change';const CLEAR_BUTTON_ID='view-state-clear';function inputs(){return INPUT_IDS.map(function(id){return document.getElementById(id);}).filter(function(input){return input!==null;});}function defaultValue(input){const value=DEFAULT_VALUES[input.id];return value===undefined?EMPTY_QUERY:value;}function eventName(input){return input.tagName===SELECT_TAG?CHANGE_EVENT:INPUT_EVENT;}function notify(input){input.dispatchEvent(new Event(eventName(input)));}function remember(){const state={};inputs().forEach(function(input){state[input.id]=input.value;});try{localStorage.setItem(STORAGE_KEY,JSON.stringify(state));}catch(_error){}}function clearSaved(){try{localStorage.removeItem(STORAGE_KEY);}catch(_error){}inputs().forEach(function(input){input.value=defaultValue(input);notify(input);});}function restore(){let state={};try{const encoded=localStorage.getItem(STORAGE_KEY);if(encoded){const decoded=JSON.parse(encoded);if(decoded&&typeof decoded==='object'){state=decoded;}}}catch(_error){}inputs().forEach(function(input){const saved=state[input.id];input.value=typeof saved==='string'?saved:defaultValue(input);notify(input);input.addEventListener(eventName(input),remember);});const clearButton=document.getElementById(CLEAR_BUTTON_ID);if(clearButton!==null){clearButton.addEventListener('click',clearSaved);}}restore();}());</script>")


        def append_html_host_summary(buffer: mutable darray[u8]&, host: NativeHostMetadata) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<div><dt>Host</dt><dd>")
            if not host.available:
                append_text(buffer, "unavailable")
            else:
                if host.os.count > NATIVE_ZERO.usize():
                    append_html_escaped(buffer, host.os)
                else:
                    append_text(buffer, "unknown OS")
                append_text(buffer, " / ")
                if host.architecture.count > NATIVE_ZERO.usize():
                    append_html_escaped(buffer, host.architecture)
                else:
                    append_text(buffer, "unknown architecture")
            append_text(buffer, "</dd></div><div><dt>Affinity</dt><dd>")
            append_text(buffer, "inherited; unchanged" if host.available else "unavailable")
            append_text(buffer, "</dd></div><div><dt>Power/thermal</dt><dd>")
            append_text(buffer, "not collected" if host.available else "unavailable")
            append_text(buffer, "</dd></div>")


        def append_html_diagnostics(buffer: mutable darray[u8]&, capture_complete: bool, dropped: i64, call_edge_dropped: i64, stack_dropped: i64, frame_dropped: i64, capture_bytes_dropped: i64, stack_overflow_entries: i64, trace_omitted: i64, crash_signal: i64) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<section class='panel' aria-labelledby='diagnostics-title'><h2 id='diagnostics-title'>Diagnostics</h2><ul>")
            has_diagnostics: mutable bool = false
            if not capture_complete:
                append_text(buffer, "<li>Capture is incomplete; termination or final timing evidence may be missing.</li>")
                has_diagnostics <- true
            if dropped > NATIVE_ZERO:
                append_text(buffer, "<li>Aggregate event loss: ")
                append_i64(buffer, dropped)
                append_text(buffer, " event(s) were dropped.</li>")
                has_diagnostics <- true
            if call_edge_dropped > NATIVE_ZERO:
                append_text(buffer, "<li>Caller/callee detail loss: ")
                append_i64(buffer, call_edge_dropped)
                append_text(buffer, " edge record(s) were dropped.</li>")
                has_diagnostics <- true
            if stack_dropped > NATIVE_ZERO:
                append_text(buffer, "<li>Folded-stack detail loss: ")
                append_i64(buffer, stack_dropped)
                append_text(buffer, " stack record(s) were dropped.</li>")
                has_diagnostics <- true
            if frame_dropped > NATIVE_ZERO:
                append_text(buffer, "<li>Transport frame loss: ")
                append_i64(buffer, frame_dropped)
                append_text(buffer, " frame(s) were dropped.</li>")
                has_diagnostics <- true
            if capture_bytes_dropped > NATIVE_ZERO:
                append_text(buffer, "<li>Capture byte budget refused ")
                append_i64(buffer, capture_bytes_dropped)
                append_text(buffer, " byte(s) of detail.</li>")
                has_diagnostics <- true
            if stack_overflow_entries > NATIVE_ZERO:
                append_text(buffer, "<li>Stack depth overflow occurred ")
                append_i64(buffer, stack_overflow_entries)
                append_text(buffer, " time(s); folded paths may be incomplete.</li>")
                has_diagnostics <- true
            if trace_omitted > NATIVE_ZERO:
                append_text(buffer, "<li>Full trace retention omitted ")
                append_i64(buffer, trace_omitted)
                append_text(buffer, " event(s) after the configured limit.</li>")
                has_diagnostics <- true
            if crash_signal > NATIVE_ZERO:
                append_text(buffer, "<li>Target terminated by signal ")
                append_i64(buffer, crash_signal)
                append_text(buffer, ".</li>")
                has_diagnostics <- true
            append_text(buffer, "<li>No recorded capture-quality degradations.</li>" if not has_diagnostics else "")
            append_text(buffer, "</ul></section>")


        def append_html_thread_loss_diagnostics(buffer: mutable darray[u8]&, records: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<section class='panel' aria-labelledby='thread-loss-title'><h2 id='thread-loss-title'>Thread-loss intervals</h2><p class='panel-note'>Intervals are collector event-sequence ranges, not wall-clock timestamps. They identify where bounded detail was lost without inventing cross-thread chronology.</p><label for='thread-loss-filter'>Filter thread or repetition</label><input id='thread-loss-filter' type='search' autocomplete='off' placeholder='thread or repetition'><p id='thread-loss-status' role='status' aria-live='polite'></p><div class='table-scroll'><table><thead><tr><th scope='col'>Repetition</th><th scope='col'>Thread</th><th scope='col'>Event sequence</th><th scope='col'>Events</th><th scope='col'>Locations</th><th scope='col'>Edges</th><th scope='col'>Stacks</th><th scope='col'>Trace</th><th scope='col'>Bytes</th></tr></thead><tbody id='thread-loss-rows'></tbody></table></div><details><summary>Raw thread-loss records</summary><pre id='thread-loss-records' hidden>")
            append_html_escaped(buffer, records)
            append_text(buffer, "</pre></details><style>.thread-loss-note{font-size:.9rem}.panel table .loss-range{white-space:nowrap}@media(prefers-color-scheme:dark){#thread-loss-rows tr[data-loss='true']{background:#f8514933}}</style><script>(function(){'use strict';const raw=document.getElementById('thread-loss-records');const body=document.getElementById('thread-loss-rows');const filter=document.getElementById('thread-loss-filter');const status=document.getElementById('thread-loss-status');const quote=String.fromCharCode(34);const MAX_TABLE_ROWS=200;const NULL_VALUE='null';if(raw===null||body===null||filter===null||status===null){return;}function objects(text){const result=[];let start=-1,depth=0,inString=false,escaped=false;for(let index=0;index<text.length;index+=1){const byte=text.charAt(index);if(inString){if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){inString=false;}continue;}if(byte===quote){inString=true;}else if(byte==='{'){if(depth===0){start=index;}depth+=1;}else if(byte==='}'){depth-=1;if(depth===0&&start>=0){result.push(text.slice(start,index+1));start=-1;}}}return result;}function field(record,name){const marker=quote+name+quote+':';const start=record.indexOf(marker);if(start<0){return ''; }let cursor=start+marker.length;while(cursor<record.length&&(record.charAt(cursor)===' '||record.charCodeAt(cursor)===9)){cursor+=1;}if(record.charAt(cursor)===quote){let end=cursor+1,escaped=false;for(;end<record.length;end+=1){const byte=record.charAt(end);if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){break;}}try{return JSON.parse(record.slice(cursor,end+1));}catch(_error){return '';}}let end=cursor;while(end<record.length&&((record.charCodeAt(end)>=48&&record.charCodeAt(end)<=57)||record.charAt(end)==='-')){end+=1;}return record.slice(cursor,end);}function magnitude(value){try{return BigInt(value||'0');}catch(_error){return 0n;}}function displayRange(start,end){return start.length>0&&end.length>0&&start!==NULL_VALUE&&end!==NULL_VALUE?start+'–'+end:'unavailable';}function render(){const query=(filter.value||'').toLowerCase();const rows=objects(raw.textContent||'').map(function(record){const repetition=field(record,'repetition'),thread=field(record,'thread_id'),start=field(record,'event_start'),end=field(record,'event_end');return{search:(repetition+' '+thread).toLowerCase(),startValue:magnitude(start),values:[repetition,thread,displayRange(start,end),field(record,'events'),field(record,'location_dropped'),field(record,'call_edge_dropped'),field(record,'stack_dropped'),field(record,'trace_dropped'),field(record,'bytes_dropped')]};}).filter(function(row){return row.search.includes(query);}).sort(function(left,right){return left.startValue===right.startValue?left.values[1].localeCompare(right.values[1]):(left.startValue<right.startValue?-1:1);});body.replaceChildren();rows.slice(0,MAX_TABLE_ROWS).forEach(function(row){const line=document.createElement('tr');line.dataset.loss='true';row.values.forEach(function(value,index){const cell=document.createElement('td');cell.textContent=value||'unavailable';if(index===2){cell.className='loss-range';}line.appendChild(cell);});body.appendChild(line);});if(rows.length===0){status.textContent=query?'No thread-loss intervals match this filter.':'No thread-loss intervals were recorded.';}else{status.textContent=rows.length+' thread-loss interval'+(rows.length===1?'':'s')+' shown'+(rows.length>MAX_TABLE_ROWS?' (first '+MAX_TABLE_ROWS+')':'')+'. Sequence ranges are collector order only.';}}filter.addEventListener('input',render);render();}());</script>")


        # Add source heat units without duplicating source text or location
        # records. The base source renderer owns line/filter DOM construction;
        # this controller only recalculates heat and titles from the same raw
        # records when the user changes the selected metric.
        def append_html_source_metric_explorer(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<script>(function(){'use strict';const FILTER_ID='source-filter';const RAW_ID='source-locations';const BODY_ID='source-lines';const METRIC_ID='source-metric';const STATUS_ID='source-metric-status';const METRIC_INTERVAL='interval_ns';const METRIC_COUNT='count';const UNIT_NANOSECONDS='ns';const UNIT_OBSERVATIONS='observations';const HEAT_SCALE=100n;const HEAT_LEVEL_ONE=25n;const HEAT_LEVEL_TWO=60n;const quote=String.fromCharCode(34);const filter=document.getElementById(FILTER_ID);const raw=document.getElementById(RAW_ID);const body=document.getElementById(BODY_ID);if(filter===null||raw===null||body===null||document.getElementById(METRIC_ID)!==null){return;}const label=document.createElement('label');label.htmlFor=METRIC_ID;label.textContent='Heat metric';const metric=document.createElement('select');metric.id=METRIC_ID;metric.innerHTML='<option value=\"interval_ns\">Interval time (nanoseconds)</option><option value=\"count\">Observation count</option>';const status=document.createElement('span');status.id=STATUS_ID;status.setAttribute('role','status');status.setAttribute('aria-live','polite');status.style.marginLeft='.5rem';filter.parentNode.insertBefore(label,filter);filter.parentNode.insertBefore(metric,filter);filter.parentNode.insertBefore(status,filter);function objects(text){const result=[];let start=-1,depth=0,inString=false,escaped=false;for(let index=0;index<text.length;index+=1){const byte=text.charAt(index);if(inString){if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){inString=false;}continue;}if(byte===quote){inString=true;}else if(byte==='{'){if(depth===0){start=index;}depth+=1;}else if(byte==='}'){depth-=1;if(depth===0&&start>=0){result.push(text.slice(start,index+1));start=-1;}}}return result;}function field(record,name){const marker=quote+name+quote+':';const start=record.indexOf(marker);if(start<0){return '';}let cursor=start+marker.length;while(cursor<record.length&&(record.charAt(cursor)===' '||record.charCodeAt(cursor)===9)){cursor+=1;}if(record.charAt(cursor)===quote){let end=cursor+1,escaped=false;for(;end<record.length;end+=1){const byte=record.charAt(end);if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){break;}}try{return JSON.parse(record.slice(cursor,end+1));}catch(_error){return '';}}let end=cursor;while(end<record.length&&((record.charCodeAt(end)>=48&&record.charCodeAt(end)<=57)||record.charAt(end)==='-')){end+=1;}return record.slice(cursor,end);}function magnitude(value){try{return BigInt(value||'0');}catch(_error){return 0n;}}function unit(){return metric.value===METRIC_COUNT?UNIT_OBSERVATIONS:UNIT_NANOSECONDS;}function metricName(){const option=metric.options[metric.selectedIndex];return option===undefined?'metric':option.textContent||'metric';}function render(){const weights=new Map();let maximum=0n;objects(raw.textContent||'').forEach(function(record){const line=Number(field(record,'line'));if(!Number.isSafeInteger(line)||line<1){return;}const weight=magnitude(field(record,metric.value));if(weight<0n){return;}const total=(weights.get(line)||0n)+weight;weights.set(line,total);if(total>maximum){maximum=total;}});body.querySelectorAll('.source-line').forEach(function(row,index){const weight=weights.get(index+1)||0n;row.removeAttribute('data-heat');row.removeAttribute('title');let level=0;if(maximum>0n){const share=(weight*HEAT_SCALE)/maximum;if(share>=HEAT_LEVEL_TWO){level=3;}else if(share>=HEAT_LEVEL_ONE){level=2;}else if(weight>0n){level=1;}}if(level>0){row.dataset.heat=String(level);row.title=weight.toString()+' '+unit()+' observed at this line';}});status.textContent='Heat metric: '+metricName()+' ('+unit()+').';}metric.addEventListener('change',render);filter.addEventListener('input',render);render();}());</script>")


        def append_html_source_view(buffer: mutable darray[u8]&, source: darray[u8]&, source_bytes: darray[u8]&, locations: darray[u8]&, locations_are_array: bool) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<section class='panel' aria-labelledby='source-view-title'><h2 id='source-view-title'>Source view</h2><p><code>")
            append_html_escaped(buffer, source)
            append_text(buffer, "</code>; snapshot SHA-256 <code>")
            append_html_escaped(buffer, sha256_hex(source_bytes))
            append_text(buffer, "</code>. Line heat uses observed location intervals. Values remain exact in the raw records.</p><p class='heat-legend' aria-label='Source heat legend'>Heat legend: <span class='heat-key heat-low'>low</span> <span class='heat-key heat-medium'>medium</span> <span class='heat-key heat-high'>high</span>; color is paired with border patterns for non-color interpretation.</p><label for='source-filter'>Find source text</label><input id='source-filter' type='search' autocomplete='off' placeholder='text or line number'><p id='source-status' role='status' aria-live='polite'></p><div id='source-lines' class='source-lines' role='region' aria-label='Profiled source lines'></div><details><summary>Raw source and location records</summary><pre id='source-content' hidden>")
            append_html_escaped(buffer, source_bytes)
            append_text(buffer, "</pre><pre id='source-locations' hidden>")
            append_text(buffer, "" if locations_are_array else "[")
            append_html_escaped(buffer, locations)
            append_text(buffer, "" if locations_are_array else "]")
            append_text(buffer, "</pre></details></section><style>.source-lines{margin-top:.75rem;border:1px solid #d8dee4;border-radius:8px;overflow:auto;max-height:42rem;font:13px ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre}.source-line{display:flex;min-width:42rem;border-left:4px solid transparent}.source-line[data-heat='1']{border-left-color:#54aeff;border-left-style:dotted;background:#ddf4ff}.source-line[data-heat='2']{border-left-color:#bf8700;border-left-style:dashed;background:#fff8c5}.source-line[data-heat='3']{border-left-color:#cf222e;border-left-style:solid;background:#ffebe9}.heat-legend{font-size:.9rem}.heat-key{display:inline-block;margin-right:.5rem;padding:0 .35rem;border-left:4px solid}.heat-low{border-left-style:dotted;border-left-color:#54aeff}.heat-medium{border-left-style:dashed;border-left-color:#bf8700}.heat-high{border-left-style:solid;border-left-color:#cf222e}.source-number{box-sizing:border-box;flex:0 0 4.5rem;padding:.15rem .75rem;color:#57606a;text-align:right;user-select:none;border-right:1px solid #d8dee4}.source-code{padding:.15rem .75rem;white-space:pre;min-height:1.2em}@media print{.source-lines{max-height:none;overflow:visible}.heat-legend{break-inside:avoid}}@media(prefers-color-scheme:dark){.source-lines{border-color:#30363d}.source-line[data-heat='1']{background:#1f6feb33}.source-line[data-heat='2']{background:#9a670033}.source-line[data-heat='3']{background:#f8514933}.source-number{color:#8b949e;border-color:#30363d}}</style><script>(function(){'use strict';const source=document.getElementById('source-content');const raw=document.getElementById('source-locations');const body=document.getElementById('source-lines');const filter=document.getElementById('source-filter');const status=document.getElementById('source-status');const quote=String.fromCharCode(34);const HEAT_SCALE=100n;const HEAT_LEVEL_ONE=25n;const HEAT_LEVEL_TWO=60n;function objects(text){const result=[];let start=-1,depth=0,inString=false,escaped=false;for(let index=0;index<text.length;index+=1){const byte=text.charAt(index);if(inString){if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){inString=false;}continue;}if(byte===quote){inString=true;}else if(byte==='{'){if(depth===0){start=index;}depth+=1;}else if(byte==='}'){depth-=1;if(depth===0&&start>=0){result.push(text.slice(start,index+1));start=-1;}}}return result;}function field(record,name){const marker=quote+name+quote+':';const start=record.indexOf(marker);if(start<0){return '';}let cursor=start+marker.length;while(cursor<record.length&&(record.charAt(cursor)===' '||record.charCodeAt(cursor)===9)){cursor+=1;}if(record.charAt(cursor)===quote){let end=cursor+1,escaped=false;for(;end<record.length;end+=1){const byte=record.charAt(end);if(escaped){escaped=false;}else if(byte===String.fromCharCode(92)){escaped=true;}else if(byte===quote){break;}}try{return JSON.parse(record.slice(cursor,end+1));}catch(_error){return '';}}let end=cursor;while(end<record.length&&((record.charCodeAt(end)>=48&&record.charCodeAt(end)<=57)||record.charAt(end)==='-')){end+=1;}return record.slice(cursor,end);}function render(){const lines=(source.textContent||'').split(String.fromCharCode(10));const records=objects(raw.textContent||'');const weights=new Map();let maximum=0n;records.forEach(function(record){const line=Number(field(record,'line'));if(!Number.isSafeInteger(line)||line<1){return;}let weight;try{weight=BigInt(field(record,'interval_ns')||'0');}catch(_error){return;}if(weight<0n){return;}const previous=weights.get(line)||0n;const total=previous+weight;weights.set(line,total);if(total>maximum){maximum=total;}});const query=(filter.value||'').toLowerCase();body.replaceChildren();let visible=0;lines.forEach(function(value,index){const line=index+1;const matching=!query||value.toLowerCase().includes(query)||String(line)===query;const row=document.createElement('div');row.className='source-line';row.hidden=!matching;const number=document.createElement('span');number.className='source-number';number.textContent=String(line);const code=document.createElement('span');code.className='source-code';code.textContent=value;const weight=weights.get(line)||0n;let level=0;if(maximum>0n){const share=(weight*HEAT_SCALE)/maximum;if(share>=HEAT_LEVEL_TWO){level=3;}else if(share>=HEAT_LEVEL_ONE){level=2;}else if(weight>0n){level=1;}}if(level>0){row.dataset.heat=String(level);row.title=weight.toString()+' ns observed at this line';}row.appendChild(number);row.appendChild(code);body.appendChild(row);if(matching){visible+=1;}});status.textContent=visible+' source line'+(visible===1?'':'s')+' shown; '+weights.size+' line'+(weights.size===1?'':'s')+' have timing records';}filter.addEventListener('input',render);render();}());</script>\n")


        def append_html_workload_object(buffer: mutable darray[u8]&, workload: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<section class='panel' aria-labelledby='workload-title'><h2 id='workload-title'>Workload reproducibility</h2><p>Arguments, input identity, and environment policy are recorded below; environment values are intentionally redacted.</p><details open><summary>Recorded workload identity</summary><pre>")
            append_html_escaped(buffer, workload)
            append_text(buffer, "</pre></details></section>")


        def append_html_source_unavailable(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<section class='panel' aria-labelledby='source-unavailable-title'><h2 id='source-unavailable-title'>Source view unavailable</h2><p>This capture does not contain an embedded source snapshot, so source navigation and line heat cannot be reconstructed offline. Re-run profiling with <code>--embed-source</code> when the source can be included safely.</p></section>")


        def append_offline_html_profile(buffer: mutable darray[u8]&, profile: NativeOfflineProfile) -> bool can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Elisa profile</title><style>body{font:15px system-ui,sans-serif;line-height:1.45;max-width:1120px;margin:2rem auto;padding:0 1rem;color:#17202a;background:#f6f8fa}main{background:white;border:1px solid #d0d7de;border-radius:12px;padding:1.5rem;box-shadow:0 4px 20px #0001}code,pre{font:13px ui-monospace,SFMono-Regular,Menlo,monospace}dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.75rem}dl div{padding:.8rem;background:#f6f8fa;border-radius:8px}dt{color:#57606a;font-size:.8rem}dd{margin:.2rem 0 0;font-weight:650}details{margin-top:1rem;border:1px solid #d8dee4;border-radius:8px;padding:.75rem}summary{cursor:pointer;font-weight:650}pre{overflow:auto;white-space:pre-wrap;word-break:break-word;margin:.75rem 0 0}@media(prefers-color-scheme:dark){body{color:#e6edf3;background:#0d1117}main{background:#161b22;border-color:#30363d}dl div{background:#21262d}details{border-color:#30363d}dt{color:#8b949e}}</style></head><body><main><h1>Elisa profile</h1><p>Native Elisa offline renderer; records are escaped and shown as inspectable detail.</p><p><strong>Source:</strong> <code>")
            append_html_escaped(buffer, profile.source)
            append_text(buffer, "</code></p><dl><div><dt>Source SHA-256</dt><dd><code>")
            append_html_escaped(buffer, profile.source_digest) if profile.source_digest_available
            append_text(buffer, "unavailable" if not profile.source_digest_available else "")
            append_text(buffer, "</code></dd></div><div><dt>Status</dt><dd>")
            append_text(buffer, "ok" if profile.exit_code == NATIVE_ZERO else "target failed")
            append_text(buffer, "</dd></div><div><dt>Outcome</dt><dd>")
            append_html_escaped(buffer, profile.outcome)
            append_text(buffer, "</dd></div><div><dt>Mean execution</dt><dd>")
            if profile.execution_mean_available:
                append_micros_as_millis(buffer, profile.execution_mean_micros)
                append_text(buffer, " ms")
            else:
                append_text(buffer, "unavailable")
            append_text(buffer, "</dd></div><div><dt>CPU</dt><dd>")
            if profile.cpu_available:
                append_micros_as_millis(buffer, profile.cpu_micros)
                append_text(buffer, " ms")
            else:
                append_text(buffer, "unavailable")
            append_text(buffer, "</dd></div><div><dt>Peak RSS</dt><dd>")
            if profile.peak_rss_available:
                append_i64(buffer, profile.peak_rss_bytes)
                append_text(buffer, " bytes")
            else:
                append_text(buffer, "unavailable")
            append_text(buffer, "</dd></div><div><dt>Measured repetitions</dt><dd>")
            append_i64(buffer, profile.successful_repetitions if profile.successful_repetitions > NATIVE_ZERO else profile.completed_repetitions)
            append_text(buffer, "</dd></div><div><dt>Capture completeness</dt><dd>")
            append_text(buffer, "complete" if profile.capture_complete_available and profile.capture_complete else "partial" if profile.capture_complete_available else "not recorded")
            append_text(buffer, "</dd></div><div><dt>Events</dt><dd>")
            append_i64(buffer, profile.events)
            append_text(buffer, "</dd></div><div><dt>Locations</dt><dd>")
            append_i64(buffer, profile.locations)
            append_text(buffer, "</dd></div><div><dt>Dropped events</dt><dd>")
            append_i64(buffer, profile.dropped)
            append_text(buffer, "</dd></div><div><dt>Threads</dt><dd>")
            append_i64(buffer, profile.thread_count)
            append_text(buffer, "</dd></div>")
            if profile.sample_count > NATIVE_ZERO:
                append_text(buffer, "<div><dt>CPU samples</dt><dd>")
                append_i64(buffer, profile.sample_count)
                append_text(buffer, " captured; ")
                append_i64(buffer, profile.sample_missed)
                append_text(buffer, " missed; ")
                append_i64(buffer, profile.sample_period_microseconds)
                append_text(buffer, " μs period</dd></div>")
            append_html_host_summary(buffer, profile.host)
            append_text(buffer, "</dl>")
            append_html_workload_object(buffer, profile.workload) if profile.workload.count > NATIVE_ZERO.usize()
            append_html_diagnostics(buffer, profile.capture_complete if profile.capture_complete_available else true, profile.dropped, profile.call_edge_dropped, profile.stack_dropped, profile.frame_dropped, profile.capture_bytes_dropped, profile.stack_overflow_entries, profile.trace_omitted, profile.crash_signal if profile.crash_signal_available else NATIVE_NEGATIVE_ONE)
            append_html_thread_loss_diagnostics(buffer, profile.thread_loss)
            if profile.source_snapshot.count > NATIVE_ZERO.usize():
                append_html_source_view(buffer, profile.source, profile.source_snapshot, profile.location_records, true)
                append_html_source_metric_explorer(buffer)
            else:
                append_html_source_unavailable(buffer)
            append_html_function_browser(buffer, profile.functions, profile.folded_records)
            append_html_actionable_summary(buffer)
            append_html_function_explorer(buffer)
            append_html_detail_browsers(buffer, profile.call_edges, profile.location_records)
            append_html_flame_graph(buffer, profile.folded_records, profile.location_timing, profile.sample_count > NATIVE_ZERO)
            append_html_flame_metric_explorer(buffer, profile.stacks)
            append_html_section(buffer, "Thread loss", profile.thread_loss)
            append_html_section(buffer, "CPU samples", profile.sample_records) if profile.sample_records.count > NATIVE_ZERO.usize()
            append_html_section(buffer, "Folded stacks", profile.folded_records)
            append_html_view_state(buffer)
            append_html_function_explorer_rebind(buffer)
            append_html_function_explorer_flame_navigation(buffer)
            append_html_function_explorer_source_navigation(buffer)
            append_html_empty_state_behaviors(buffer)
            append_text(buffer, "</main></body></html>\n")
            return true


        def append_offline_text_profile(buffer: mutable darray[u8]&, profile: NativeOfflineProfile) -> bool can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "Elisa profiler\nsource: ")
            buffer.extend(profile.source)
            append_text(buffer, "\nstatus: ")
            append_text(buffer, "ok\n" if profile.exit_code == NATIVE_ZERO else "target failed\n")
            append_text(buffer, "outcome: ")
            buffer.extend(profile.outcome)
            append_text(buffer, "\ncapture completeness: ")
            append_text(buffer, "complete\n" if profile.capture_complete_available and profile.capture_complete else "partial\n" if profile.capture_complete_available else "not recorded\n")
            append_text(buffer, "events: ")
            append_i64(buffer, profile.events)
            append_text(buffer, "\nlocations: ")
            append_i64(buffer, profile.locations)
            append_text(buffer, "\nstatement events: ")
            append_i64(buffer, profile.statement_events)
            append_text(buffer, "\nvalue events: ")
            append_i64(buffer, profile.value_events)
            append_text(buffer, "\nfunction events: ")
            append_i64(buffer, profile.function_events)
            if profile.sample_count > NATIVE_ZERO:
                append_text(buffer, "\nsamples: ")
                append_i64(buffer, profile.sample_count)
                append_text(buffer, " captured, ")
                append_i64(buffer, profile.sample_missed)
                append_text(buffer, " missed at ")
                append_i64(buffer, profile.sample_period_microseconds)
                append_text(buffer, " microseconds\n")
            append_text(buffer, "\nthreads: ")
            append_i64(buffer, profile.thread_count)
            append_text(buffer, "\ndropped: ")
            append_i64(buffer, profile.dropped)
            append_text(buffer, "\nthread loss records: ")
            append_text(buffer, "present\n" if profile.thread_loss.count > NATIVE_ZERO.usize() else "none\n")
            return true
