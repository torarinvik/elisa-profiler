# Elisa-native profiler front door.
#
# This is the first migration slice away from the Python implementation. It owns the
# compile -> instrument -> run -> protocol decode -> JSON report path. The low-level C
# collector remains an ABI/runtime component; all orchestration and report policy lives here.
#
# The native implementation owns the profiler CLI, execution boundary, protocol decoder,
# aggregation model, and report writers. The low-level C collector remains an explicit ABI
# component; it is not a second profiler front door.
include "../../../elisa-compiler-worktrees/profiler/elisacore_std/collections.elisa"

struct ProfilerNativeTimespec:
    seconds: i64
    nanoseconds: i64

# `wait4` writes the POSIX `struct rusage` returned for the reaped child. The
# profiler targets the 64-bit hosts supported by the native compiler, where
# `time_t`, `suseconds_t`, and `long` occupy one 64-bit slot. Keep the complete
# layout here: passing a truncated struct would let libc overwrite adjacent
# Elisa state even though only four fields are consumed below.
struct ProfilerNativeRusage:
    user_seconds: i64
    user_microseconds: i64
    system_seconds: i64
    system_microseconds: i64
    maximum_resident_set_bytes: i64
    integral_shared_memory: i64
    integral_unshared_data: i64
    integral_unshared_stack: i64
    page_reclaims: i64
    page_faults: i64
    swaps: i64
    block_input_operations: i64
    block_output_operations: i64
    messages_sent: i64
    messages_received: i64
    signals_received: i64
    voluntary_context_switches: i64
    involuntary_context_switches: i64

@link_name("read")
extern profiler_ffi_read(fd: i64, buf: u8&, count: usize) -> i64 can[Console]
@link_name("write")
extern profiler_ffi_write(fd: i64, buf: u8&, count: usize) -> i64 can[Console]
@link_name("open")
extern profiler_ffi_open(path: cstr, flags: i64, ...) -> i64
@link_name("close")
extern profiler_ffi_close(fd: i64) -> i64
@link_name("getenv")
extern profiler_ffi_getenv(name: cstr) -> u8&?
@link_name("mkdir")
extern profiler_ffi_mkdir(path: cstr, mode: u16) -> i64
@link_name("unlink")
extern profiler_ffi_unlink(path: cstr) -> i64
