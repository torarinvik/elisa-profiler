# Elisa-native profiler front door.
#
# This is the first migration slice away from the Python implementation. It owns the
# compile -> instrument -> run -> protocol decode -> JSON report path. The low-level C
# collector remains an ABI/runtime component; all orchestration and report policy lives here.
#
# The native implementation owns the profiler CLI, execution boundary, protocol decoder,
# aggregation model, and report writers. The low-level C collector remains an explicit ABI
# component; it is not a second profiler front door.
include "../../../elisa-compiler-worktrees/profiler/elisacore_std/collections.elisa"

struct ProfilerNativeTimespec:
    seconds: i64
    nanoseconds: i64

@link_name("read")
extern profiler_ffi_read(fd: i64, buf: u8&, count: usize) -> i64 can[Console]
@link_name("write")
extern profiler_ffi_write(fd: i64, buf: u8&, count: usize) -> i64 can[Console]
@link_name("open")
extern profiler_ffi_open(path: cstr, flags: i64, ...) -> i64
@link_name("close")
extern profiler_ffi_close(fd: i64) -> i64
@link_name("getenv")
extern profiler_ffi_getenv(name: cstr) -> u8&?
@link_name("mkdir")
extern profiler_ffi_mkdir(path: cstr, mode: u16) -> i64
@link_name("unlink")
extern profiler_ffi_unlink(path: cstr) -> i64
@link_name("rename")
extern profiler_ffi_rename(old_path: cstr, new_path: cstr) -> i64
@link_name("rmdir")
extern profiler_ffi_rmdir(path: cstr) -> i64
@link_name("strcmp")
extern profiler_ffi_strcmp(left: cstr, right: cstr) -> i64
@link_name("getpid")
extern profiler_ffi_getpid() -> i64
@link_name("access")
extern profiler_ffi_access(path: cstr, mode: i64) -> i64
@link_name("setenv")
extern profiler_ffi_setenv(name: cstr, value: cstr, overwrite: i64) -> i64
@link_name("unsetenv")
extern profiler_ffi_unsetenv(name: cstr) -> i64
@link_name("fork")
extern profiler_ffi_fork() -> i64
@link_name("execv")
extern profiler_ffi_execv(path: cstr, argv: mutable cstr&&) -> i64
@link_name("execvp")
extern profiler_ffi_execvp(path: cstr, argv: mutable cstr&&) -> i64
@link_name("waitpid")
extern profiler_ffi_waitpid(pid: i64, status: mutable i64&, options: i64) -> i64
@link_name("dup2")
extern profiler_ffi_dup2(old_fd: i64, new_fd: i64) -> i64
@link_name("chdir")
extern profiler_ffi_chdir(path: cstr) -> i64
@link_name("_exit")
extern profiler_ffi_process_exit(status: i64) -> void
@link_name("clock_gettime")
extern profiler_ffi_clock_gettime(clock_id: i64, timestamp: mutable ProfilerNativeTimespec&) -> i64
@link_name("sview_len")
extern profiler_ffi_sview_len(view: sview) -> usize
@link_name("sview_at")
extern profiler_ffi_sview_at(view: sview, index: usize) -> u8

include "./profiler_model.elisa"

extend ProfilerNative:
    private:
        def append_text(buffer: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
            for index in 0..<profiler_ffi_sview_len(text) |buffer, text|:
                buffer.push(profiler_ffi_sview_at(text, index))


        def append_html_escaped(buffer: mutable darray[u8]&, value: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            for index in 0..<value.count |buffer, value|:
                byte: u8 = value[index]
                if byte == NATIVE_BYTE_AMPERSAND:
                    append_text(buffer, "&amp;")
                elif byte == NATIVE_BYTE_LESS_THAN:
                    append_text(buffer, "&lt;")
                elif byte == NATIVE_BYTE_GREATER_THAN:
                    append_text(buffer, "&gt;")
                elif byte == NATIVE_BYTE_DOUBLE_QUOTE:
                    append_text(buffer, "&quot;")
                else:
                    buffer.push(byte)
        
        
        def append_i64(buffer: mutable darray[u8]&, value: i64) -> void can[Abort.Panic, Memory.Allocate]:
            if value == NATIVE_I64_MIN:
                append_text(buffer, "-9223372036854775808")
                return
            if value == NATIVE_ZERO:
                buffer.push(NATIVE_BYTE_ASCII_ZERO)
                return
            negative: bool = value < NATIVE_ZERO
            magnitude: mutable i64 = -value if negative else value
            buffer.push(NATIVE_BYTE_MINUS) if negative
            digits: mutable darray[u8] = []
            while magnitude > NATIVE_ZERO |digits, magnitude|:
                digits.push((NATIVE_BYTE_ASCII_ZERO.i64() + (magnitude % NATIVE_DECIMAL_BASE)).u8())
                magnitude <- magnitude / NATIVE_DECIMAL_BASE
            for index in 0..<digits.count |buffer, digits|:
                buffer.push(digits[digits.count - 1.usize() - index])


        def append_millis(buffer: mutable darray[u8]&, nanoseconds: i64) -> void can[Abort.Panic, Memory.Allocate]:
            whole: i64 = nanoseconds / NATIVE_NANOS_PER_MILLISECOND
            fraction: i64 = (nanoseconds % NATIVE_NANOS_PER_MILLISECOND) / NATIVE_NANOS_PER_MICROSECOND
            append_i64(buffer, whole)
            buffer.push(NATIVE_BYTE_PERIOD)
            buffer.push((NATIVE_BYTE_ASCII_ZERO.i64() + (fraction / NATIVE_MILLIS_HUNDREDS_DIVISOR)).u8())
            buffer.push((NATIVE_BYTE_ASCII_ZERO.i64() + ((fraction / NATIVE_DECIMAL_TENS_DIVISOR) % NATIVE_DECIMAL_BASE)).u8())
            buffer.push((NATIVE_BYTE_ASCII_ZERO.i64() + (fraction % NATIVE_DECIMAL_BASE)).u8())


        def append_micros_as_millis(buffer: mutable darray[u8]&, microseconds: i64) -> void can[Abort.Panic, Memory.Allocate]:
            append_millis(buffer, microseconds * NATIVE_NANOS_PER_MICROSECOND)


        def read_monotonic() -> ProfilerNativeTimespec:
            timestamp: mutable ProfilerNativeTimespec = ProfilerNativeTimespec{seconds: NATIVE_ZERO, nanoseconds: NATIVE_ZERO}
            _ = profiler_ffi_clock_gettime(NATIVE_MONOTONIC_CLOCK, &timestamp)
            return timestamp


        def elapsed_nanoseconds(start: ProfilerNativeTimespec, finish: ProfilerNativeTimespec) -> i64:
            return (finish.seconds - start.seconds) * NATIVE_NANOS_PER_SECOND + finish.nanoseconds - start.nanoseconds
        
        
        def append_cstr(buffer: mutable darray[u8]&, value: cstr) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            value_bytes: u8& = value.cast[u8&] can Unsafe.PointerCast
            cursor: mutable i64 = NATIVE_ZERO
            while true |buffer, cursor, value_bytes|:
                byte_ref: u8& = value_bytes + cursor
                byte: u8 = byte_ref
                break if byte == NATIVE_BYTE_NUL
                buffer.push(byte)
                cursor <- cursor + NATIVE_ONE
        
        
        def append_json_string(buffer: mutable darray[u8]&, value: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            buffer.push(NATIVE_BYTE_DOUBLE_QUOTE)
            for index in 0..<value.count |buffer, value|:
                byte: u8 = value[index]
                if byte == NATIVE_BYTE_DOUBLE_QUOTE:
                    append_text(buffer, "\\\"")
                elif byte == NATIVE_BYTE_BACKSLASH:
                    append_text(buffer, "\\\\")
                elif byte == NATIVE_BYTE_NEWLINE:
                    append_text(buffer, "\\n")
                elif byte == NATIVE_BYTE_CARRIAGE_RETURN:
                    append_text(buffer, "\\r")
                elif byte == NATIVE_BYTE_TAB:
                    append_text(buffer, "\\t")
                elif byte < NATIVE_BYTE_CONTROL_LIMIT:
                    append_text(buffer, "\\u00")
                    high: u8 = (byte / NATIVE_HEX_BASE.u8()).u8()
                    low: u8 = (byte % NATIVE_HEX_BASE.u8()).u8()
                    buffer.push(NATIVE_BYTE_ASCII_ZERO + high if high < NATIVE_DECIMAL_BASE.u8() else NATIVE_HEX_LETTER_OFFSET + high)
                    buffer.push(NATIVE_BYTE_ASCII_ZERO + low if low < NATIVE_DECIMAL_BASE.u8() else NATIVE_HEX_LETTER_OFFSET + low)
                else:
                    buffer.push(byte)
            buffer.push(NATIVE_BYTE_DOUBLE_QUOTE)
        
        
        def append_json_key(buffer: mutable darray[u8]&, key: sview) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "\"")
            append_text(buffer, key)
            append_text(buffer, "\":")
        
        
        def append_command_argument[@r](arguments: mutable darray[darray[u8]]& @r, value: sview) -> void can[Abort.Panic, Memory.Allocate]:
            argument: mutable darray[u8] @r = []
            append_text(argument, value)
            argument.push(NATIVE_BYTE_NUL)
            arguments.push(argument)


        def append_command_path_argument[@r](arguments: mutable darray[darray[u8]]& @r, value: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            argument: mutable darray[u8] @r = []
            argument.extend(value)
            argument.push(NATIVE_BYTE_NUL)
            arguments.push(argument)


        def append_command_i64_argument[@r](arguments: mutable darray[darray[u8]]& @r, prefix: sview, value: i64) -> void can[Abort.Panic, Memory.Allocate]:
            argument: mutable darray[u8] @r = []
            append_text(argument, prefix)
            append_i64(argument, value)
            argument.push(NATIVE_BYTE_NUL)
            arguments.push(argument)
        
        
        def copy_cstr(destination: mutable darray[u8]&, value: cstr) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            destination <- []
            append_cstr(destination, value)


        def parse_nonnegative_cstr(value: cstr) -> i64 can[Unsafe.PointerCast]:
            bytes: u8& = value.cast[u8&] can Unsafe.PointerCast
            cursor: mutable i64 = NATIVE_ZERO
            result: mutable i64 = NATIVE_ZERO
            digits: mutable i64 = NATIVE_ZERO
            while true |bytes, cursor, result, digits|:
                byte_ref: u8& = bytes + cursor
                byte: u8 = byte_ref
                break if byte == NATIVE_BYTE_NUL
                return NATIVE_NEGATIVE_ONE if byte < NATIVE_BYTE_ASCII_ZERO or byte > NATIVE_BYTE_ASCII_NINE
                digit: i64 = (byte - NATIVE_BYTE_ASCII_ZERO).i64()
                return NATIVE_NEGATIVE_ONE if result > (NATIVE_I64_MAX - digit) / NATIVE_DECIMAL_BASE
                result <- result * NATIVE_DECIMAL_BASE + digit
                digits <- digits + NATIVE_ONE
                cursor <- cursor + NATIVE_ONE
            return NATIVE_NEGATIVE_ONE if digits == NATIVE_ZERO
            return result


        def copy_environment(name: sview, destination: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            name_storage: mutable darray[u8] = []
            append_text(name_storage, name)
            name_storage.push(NATIVE_BYTE_NUL)
            if profiler_ffi_getenv((&name_storage[0]).cast[cstr] can Unsafe.PointerCast) is value:
                cursor: mutable i64 = NATIVE_ZERO
                while true |destination, cursor, value|:
                    byte_ref: u8& = value + cursor
                    byte: u8 = byte_ref
                    break if byte == NATIVE_BYTE_NUL
                    destination.push(byte)
                    cursor <- cursor + NATIVE_ONE
                return true
            return false
        
        
        def environment_or(name: sview, fallback: sview, destination: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if copy_environment(name, destination)
            append_text(destination, fallback)


        def trim_line_endings(value: mutable darray[u8]&) -> void:
            while value.count > NATIVE_ZERO.usize() |value|:
                last: u8 = value[value.count - NATIVE_ONE.usize()]
                break if last != NATIVE_BYTE_NEWLINE and last != NATIVE_BYTE_CARRIAGE_RETURN
                value.count <- value.count - NATIVE_ONE.usize()


        def read_git_metadata(compiler_root: darray[u8]&, operation: sview, output_path: darray[u8]&, error_path: darray[u8]&, git_tool: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            command_arguments: mutable darray[darray[u8]] = []
            append_command_argument(command_arguments, "-C")
            append_command_path_argument(command_arguments, compiler_root)
            if operation == "branch":
                append_command_argument(command_arguments, "rev-parse")
                append_command_argument(command_arguments, "--abbrev-ref")
                append_command_argument(command_arguments, "HEAD")
            elif operation == "commit":
                append_command_argument(command_arguments, "rev-parse")
                append_command_argument(command_arguments, "HEAD")
            elif operation == "dirty":
                append_command_argument(command_arguments, "status")
                append_command_argument(command_arguments, "--porcelain")
                append_command_argument(command_arguments, "--untracked-files=all")
            else:
                return []
            return [] if run_tool_direct(git_tool, command_arguments, output_path, error_path) != NATIVE_ZERO
            result: mutable darray[u8] = read_file(output_path)
            trim_line_endings(&result)
            return result
        
        
        def path_with_suffix(path: darray[u8]&, suffix: sview) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
            result: mutable darray[u8] = []
            result.extend(path)
            append_text(result, suffix)
            return result
        
        
        def remove_temp_file(directory: darray[u8]&, suffix: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path: mutable darray[u8] = path_with_suffix(directory, suffix)
            path.push(NATIVE_BYTE_NUL)
            _ = profiler_ffi_unlink((&path[0]).cast[cstr] can Unsafe.PointerCast)


        def cleanup_temp(directory: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            remove_temp_file(directory, "/target.o")
            remove_temp_file(directory, "/target-renamed.o")
            remove_temp_file(directory, "/runtime-collector.o")
            remove_temp_file(directory, "/profiler-runtime.o")
            remove_temp_file(directory, "/profiled-program")
            remove_temp_file(directory, "/capture.txt")
            remove_temp_file(directory, "/compile.err")
            remove_temp_file(directory, "/compile.out")
            remove_temp_file(directory, "/link.err")
            remove_temp_file(directory, "/program.out")
            remove_temp_file(directory, "/program.err")
            remove_temp_file(directory, "/compiler-branch")
            remove_temp_file(directory, "/compiler-commit")
            remove_temp_file(directory, "/compiler-dirty")
            remove_temp_file(directory, "/compiler-metadata.err")
            directory_copy: mutable darray[u8] = []
            directory_copy.extend(directory)
            directory_copy.push(NATIVE_BYTE_NUL)
            _ = profiler_ffi_rmdir((&directory_copy[0]).cast[cstr] can Unsafe.PointerCast)


        def write_stderr(buffer: darray[u8]&) -> void can[Abort.Panic, Console]:
            return if buffer.count == NATIVE_ZERO.usize()
            _ = profiler_ffi_write(NATIVE_STANDARD_ERROR, &buffer[0], buffer.count) can Console
        
        
        def report_error(message: sview) -> i64 can[Abort.Panic, Memory.Allocate, Console]:
            buffer: mutable darray[u8] = []
            append_text(buffer, "elisa-profiler: ")
            append_text(buffer, message)
            buffer.push(NATIVE_BYTE_NEWLINE)
            write_stderr(buffer)
            return NATIVE_TWO


        def report_protocol_error(summary: CaptureSummary) -> i64 can[Abort.Panic, Memory.Allocate, Console]:
            buffer: mutable darray[u8] = []
            append_text(buffer, "elisa-profiler: malformed native protocol code=")
            append_i64(buffer, summary.malformed_code)
            buffer.push(NATIVE_BYTE_NEWLINE)
            write_stderr(buffer)
            return NATIVE_TWO


        def write_file(path: darray[u8]&, data: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            temporary_path: mutable darray[u8] = []
            temporary_path.extend(path)
            append_text(temporary_path, ".elisa-profiler.tmp.")
            append_i64(temporary_path, profiler_ffi_getpid())
            temporary_path.push(NATIVE_BYTE_NUL)
            temporary_cstr: cstr = (&temporary_path[0]).cast[cstr] can Unsafe.PointerCast
            fd: i64 = profiler_ffi_open(temporary_cstr, NATIVE_O_WRONLY + NATIVE_O_CREAT + NATIVE_O_TRUNC, NATIVE_FILE_MODE)
            false return if fd < NATIVE_ZERO
            written: mutable usize = NATIVE_ZERO.usize()
            while written < data.count |written, data, fd|:
                amount: i64 = profiler_ffi_write(fd, &data[written], data.count - written) can Console
                if amount <= NATIVE_ZERO:
                    _ = profiler_ffi_close(fd)
                    _ = profiler_ffi_unlink(temporary_cstr)
                    return false
                written <- written + amount.usize()
            _ = profiler_ffi_close(fd)
            path_copy: mutable darray[u8] = []
            path_copy.extend(path)
            path_copy.push(NATIVE_BYTE_NUL)
            path_cstr: cstr = (&path_copy[0]).cast[cstr] can Unsafe.PointerCast
            if profiler_ffi_rename(temporary_cstr, path_cstr) != NATIVE_ZERO:
                _ = profiler_ffi_unlink(temporary_cstr)
                return false
            return true


        def append_profile_artifact(buffer: mutable darray[u8]&, capture: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "{\"artifact_version\":")
            append_i64(buffer, NATIVE_ARTIFACT_VERSION)
            append_text(buffer, ",\"kind\":\"elisa-profile\",\"manifest\":{\"capture_format\":\"profile-json-v1\",\"compression\":\"none\",\"capture_bytes\":")
            append_i64(buffer, capture.count.i64())
            append_text(buffer, "},\"capture\":")
            buffer.extend(capture)
            append_text(buffer, "}\n")


        def unwrap_profile_artifact(data: darray[u8]&, capture: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            artifact_start: i64 = json_key_value_start(data, "artifact_version", NATIVE_ZERO.usize(), data.count)
            if artifact_start < NATIVE_ZERO:
                capture.extend(data)
                return true
            version: i64 = json_number_at(data, artifact_start.usize(), data.count)
            return false if version != NATIVE_ARTIFACT_VERSION
            kind_start: i64 = json_key_value_start(data, "kind", NATIVE_ZERO.usize(), data.count)
            return false if kind_start < NATIVE_ZERO
            kind: mutable darray[u8] = []
            return false if json_string_into(data, kind_start.usize(), data.count, &kind) < NATIVE_ZERO
            return false if not protocol_field_is(kind, "elisa-profile")
            capture_start: i64 = json_key_value_start(data, "capture", NATIVE_ZERO.usize(), data.count)
            return false if capture_start < NATIVE_ZERO
            capture_stop: i64 = json_object_end(data, capture_start.usize(), data.count)
            return false if capture_stop < NATIVE_ZERO
            for index in capture_start.usize()..<capture_stop.usize() |capture, data|:
                capture.push(data[index])
            capture.push(NATIVE_BYTE_NEWLINE)
            return true


        def open_output_file(path: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path_copy: mutable darray[u8] = []
            path_copy.extend(path)
            path_copy.push(NATIVE_BYTE_NUL)
            path_cstr: cstr = (&path_copy[0]).cast[cstr] can Unsafe.PointerCast
            return profiler_ffi_open(path_cstr, NATIVE_O_WRONLY + NATIVE_O_CREAT + NATIVE_O_TRUNC, NATIVE_FILE_MODE)


        def open_input_file(path: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path_copy: mutable darray[u8] = []
            path_copy.extend(path)
            path_copy.push(NATIVE_BYTE_NUL)
            path_cstr: cstr = (&path_copy[0]).cast[cstr] can Unsafe.PointerCast
            return profiler_ffi_open(path_cstr, NATIVE_O_RDONLY, NATIVE_ZERO)


        def run_tool_direct(tool: darray[u8]&, arguments: darray[darray[u8]], stdout_path: darray[u8]&, stderr_path: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            # Build stable C-string storage before creating the child. The child receives a
            # direct argv vector; no shell parser can reinterpret a path or an option.
            tool_storage: mutable darray[u8] = []
            tool_storage.extend(tool)
            tool_storage.push(NATIVE_BYTE_NUL)
            tool_cstr: cstr = (&tool_storage[0]).cast[cstr] can Unsafe.PointerCast
            argument_storage: mutable darray[darray[u8]] = []
            for index in 0..<arguments.count |argument_storage, arguments|:
                argument_storage.push(arguments[index])
            command_argv: mutable darray[cstr] = []
            command_argv.push(tool_cstr)
            for index in 0..<argument_storage.count |command_argv, argument_storage|:
                argument_cstr: cstr = (&argument_storage[index][0]).cast[cstr] can Unsafe.PointerCast
                command_argv.push(argument_cstr)
            command_argv.push(null)
            stdout_fd: i64 = open_output_file(stdout_path)
            return NATIVE_NEGATIVE_ONE if stdout_fd < NATIVE_ZERO
            stderr_fd: i64 = open_output_file(stderr_path)
            if stderr_fd < NATIVE_ZERO:
                _ = profiler_ffi_close(stdout_fd)
                return NATIVE_NEGATIVE_ONE
            process: i64 = profiler_ffi_fork()
            if process == NATIVE_ZERO:
                if profiler_ffi_dup2(stdout_fd, NATIVE_STANDARD_OUTPUT) < NATIVE_ZERO or profiler_ffi_dup2(stderr_fd, NATIVE_STANDARD_ERROR) < NATIVE_ZERO:
                    profiler_ffi_process_exit(NATIVE_CHILD_FAILURE_STATUS)
                _ = profiler_ffi_close(stdout_fd)
                _ = profiler_ffi_close(stderr_fd)
                _ = profiler_ffi_execvp(tool_cstr, (&command_argv[0]).cast[mutable cstr&&] can Unsafe.PointerCast)
                profiler_ffi_process_exit(NATIVE_CHILD_FAILURE_STATUS)
            if process < NATIVE_ZERO:
                _ = profiler_ffi_close(stdout_fd)
                _ = profiler_ffi_close(stderr_fd)
                return NATIVE_NEGATIVE_ONE
            status: mutable i64 = NATIVE_ZERO
            waited: i64 = profiler_ffi_waitpid(process, &status, NATIVE_WAIT_NO_OPTIONS)
            _ = profiler_ffi_close(stdout_fd)
            _ = profiler_ffi_close(stderr_fd)
            return NATIVE_NEGATIVE_ONE if waited != process
            return status


        def clear_target_environment() -> void:
            _ = profiler_ffi_unsetenv("ELISA_PROFILE_FD")
            _ = profiler_ffi_unsetenv("ELISA_PROFILE_EVENT_TRACE")
            _ = profiler_ffi_unsetenv("ELISA_PROFILE_EVENT_TRACE_LIMIT")
            _ = profiler_ffi_unsetenv("ELISA_PROFILE_MAX_CAPTURE_BYTES")
            _ = profiler_ffi_unsetenv("ELISA_PROFILE_RECENT_PATH")


        def environment_assignment_valid(value: darray[u8]&) -> bool:
            false return if value.count == NATIVE_ZERO.usize()
            equals: mutable usize = value.count
            for index in 0..<value.count |value, equals|:
                if value[index] == NATIVE_BYTE_EQUALS:
                    equals <- index
                    break
            return equals > NATIVE_ZERO.usize() and equals < value.count


        def apply_environment_overrides(environment: darray[u8]) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            assignment_start: mutable usize = NATIVE_ZERO.usize()
            while assignment_start < environment.count |environment, assignment_start|:
                assignment_stop: mutable usize = assignment_start
                while assignment_stop < environment.count and environment[assignment_stop] != NATIVE_BYTE_NUL |environment, assignment_stop|:
                    assignment_stop <- assignment_stop + NATIVE_ONE.usize()
                assignment: mutable darray[u8] = []
                for assignment_index in assignment_start..<assignment_stop |assignment, environment|:
                    assignment.push(environment[assignment_index])
                equals: mutable usize = assignment.count
                for assignment_index in 0..<assignment.count |assignment, equals|:
                    if assignment[assignment_index] == NATIVE_BYTE_EQUALS:
                        equals <- assignment_index
                        break
                return false if equals == NATIVE_ZERO.usize() or equals == assignment.count
                name: mutable darray[u8] = []
                value: mutable darray[u8] = []
                for assignment_index in 0..<equals |assignment, name|:
                    name.push(assignment[assignment_index])
                for assignment_index in equals + NATIVE_ONE.usize()..<assignment.count |assignment, value|:
                    value.push(assignment[assignment_index])
                name.push(NATIVE_BYTE_NUL)
                value.push(NATIVE_BYTE_NUL)
                name_cstr: cstr = (&name[0]).cast[cstr] can Unsafe.PointerCast
                value_cstr: cstr = (&value[0]).cast[cstr] can Unsafe.PointerCast
                if profiler_ffi_setenv(name_cstr, value_cstr, NATIVE_ENV_OVERWRITE) != NATIVE_ZERO:
                    return false
                assignment_start <- assignment_stop + NATIVE_ONE.usize()
            return true
        def executable_available(path: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path_copy: mutable darray[u8] = []
            path_copy.extend(path)
            path_copy.push(NATIVE_BYTE_NUL)
            path_cstr: cstr = (&path_copy[0]).cast[cstr] can Unsafe.PointerCast
            return profiler_ffi_access(path_cstr, NATIVE_ACCESS_EXECUTE) == NATIVE_ZERO


        def readable_file(path: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path_copy: mutable darray[u8] = []
            path_copy.extend(path)
            path_copy.push(NATIVE_BYTE_NUL)
            path_cstr: cstr = (&path_copy[0]).cast[cstr] can Unsafe.PointerCast
            fd: i64 = profiler_ffi_open(path_cstr, NATIVE_O_RDONLY, NATIVE_ZERO)
            return false if fd < NATIVE_ZERO
            _ = profiler_ffi_close(fd)
            return true


        def run_target_direct(executable: darray[u8]&, stdout_path: darray[u8]&, stderr_path: darray[u8]&, working_directory: darray[u8]&, stdin_path: darray[u8]&, environment: darray[u8], capture_fd: i64, event_trace: bool, recent_path: bool, trace_limit: i64, capture_byte_limit: i64) -> TargetRunResult can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            stdout_fd: i64 = open_output_file(stdout_path)
            return TargetRunResult{status: NATIVE_NEGATIVE_ONE, elapsed_ns: NATIVE_ZERO} if stdout_fd < NATIVE_ZERO
            stderr_fd: i64 = open_output_file(stderr_path)
            if stderr_fd < NATIVE_ZERO:
                _ = profiler_ffi_close(stdout_fd)
                return TargetRunResult{status: NATIVE_NEGATIVE_ONE, elapsed_ns: NATIVE_ZERO}
            executable_arg: mutable darray[u8] = []
            executable_arg.extend(executable)
            executable_arg.push(NATIVE_BYTE_NUL)
            executable_cstr: cstr = (&executable_arg[0]).cast[cstr] can Unsafe.PointerCast
            fd_text: mutable darray[u8] = []
            append_i64(fd_text, capture_fd)
            fd_text.push(NATIVE_BYTE_NUL)
            fd_cstr: cstr = (&fd_text[0]).cast[cstr] can Unsafe.PointerCast
            if profiler_ffi_setenv("ELISA_PROFILE_FD", fd_cstr, NATIVE_ENV_OVERWRITE) != NATIVE_ZERO:
                _ = profiler_ffi_close(stdout_fd)
                _ = profiler_ffi_close(stderr_fd)
                clear_target_environment()
                return TargetRunResult{status: NATIVE_NEGATIVE_ONE, elapsed_ns: NATIVE_ZERO}
            trace_flag: mutable cstr = "0"
            trace_flag <- "1" if event_trace
            if profiler_ffi_setenv("ELISA_PROFILE_EVENT_TRACE", trace_flag, NATIVE_ENV_OVERWRITE) != NATIVE_ZERO:
                _ = profiler_ffi_close(stdout_fd)
                _ = profiler_ffi_close(stderr_fd)
                clear_target_environment()
                return TargetRunResult{status: NATIVE_NEGATIVE_ONE, elapsed_ns: NATIVE_ZERO}
            limit_text: mutable darray[u8] = []
            append_i64(limit_text, trace_limit if event_trace else NATIVE_ZERO)
            limit_text.push(NATIVE_BYTE_NUL)
            limit_cstr: cstr = (&limit_text[0]).cast[cstr] can Unsafe.PointerCast
            if profiler_ffi_setenv("ELISA_PROFILE_EVENT_TRACE_LIMIT", limit_cstr, NATIVE_ENV_OVERWRITE) != NATIVE_ZERO:
                _ = profiler_ffi_close(stdout_fd)
                _ = profiler_ffi_close(stderr_fd)
                clear_target_environment()
                return TargetRunResult{status: NATIVE_NEGATIVE_ONE, elapsed_ns: NATIVE_ZERO}
            capture_byte_limit_text: mutable darray[u8] = []
            append_i64(capture_byte_limit_text, capture_byte_limit)
            capture_byte_limit_text.push(NATIVE_BYTE_NUL)
            capture_byte_limit_cstr: cstr = (&capture_byte_limit_text[0]).cast[cstr] can Unsafe.PointerCast
            if profiler_ffi_setenv("ELISA_PROFILE_MAX_CAPTURE_BYTES", capture_byte_limit_cstr, NATIVE_ENV_OVERWRITE) != NATIVE_ZERO:
                _ = profiler_ffi_close(stdout_fd)
                _ = profiler_ffi_close(stderr_fd)
                clear_target_environment()
                return TargetRunResult{status: NATIVE_NEGATIVE_ONE, elapsed_ns: NATIVE_ZERO}
            recent_flag: mutable cstr = "0"
            recent_flag <- "1" if recent_path and not event_trace
            if profiler_ffi_setenv("ELISA_PROFILE_RECENT_PATH", recent_flag, NATIVE_ENV_OVERWRITE) != NATIVE_ZERO:
                _ = profiler_ffi_close(stdout_fd)
                _ = profiler_ffi_close(stderr_fd)
                clear_target_environment()
                return TargetRunResult{status: NATIVE_NEGATIVE_ONE, elapsed_ns: NATIVE_ZERO}
            stdin_fd: mutable i64 = NATIVE_NEGATIVE_ONE
            if stdin_path.count > NATIVE_ZERO.usize():
                stdin_fd <- open_input_file(stdin_path)
                if stdin_fd < NATIVE_ZERO:
                    _ = profiler_ffi_close(stdout_fd)
                    _ = profiler_ffi_close(stderr_fd)
                    clear_target_environment()
                    return TargetRunResult{status: NATIVE_NEGATIVE_ONE, elapsed_ns: NATIVE_ZERO}
            start_time: ProfilerNativeTimespec = read_monotonic()
            process: i64 = profiler_ffi_fork()
            if process == NATIVE_ZERO:
                if profiler_ffi_dup2(stdout_fd, NATIVE_STANDARD_OUTPUT) < NATIVE_ZERO or profiler_ffi_dup2(stderr_fd, NATIVE_STANDARD_ERROR) < NATIVE_ZERO:
                    profiler_ffi_process_exit(NATIVE_CHILD_FAILURE_STATUS)
                if stdin_fd >= NATIVE_ZERO and profiler_ffi_dup2(stdin_fd, NATIVE_STANDARD_INPUT) < NATIVE_ZERO:
                    profiler_ffi_process_exit(NATIVE_CHILD_FAILURE_STATUS)
                if working_directory.count > NATIVE_ZERO.usize():
                    working_directory_cstr: mutable darray[u8] = []
                    working_directory_cstr.extend(working_directory)
                    working_directory_cstr.push(NATIVE_BYTE_NUL)
                    if profiler_ffi_chdir((&working_directory_cstr[0]).cast[cstr] can Unsafe.PointerCast) != NATIVE_ZERO:
                        profiler_ffi_process_exit(NATIVE_CHILD_FAILURE_STATUS)
                if not apply_environment_overrides(environment):
                    profiler_ffi_process_exit(NATIVE_CHILD_FAILURE_STATUS)
                _ = profiler_ffi_close(stdout_fd)
                _ = profiler_ffi_close(stderr_fd)
                if stdin_fd >= NATIVE_ZERO:
                    _ = profiler_ffi_close(stdin_fd)
                target_argv: mutable darray[cstr] = []
                target_argv.push(executable_cstr)
                target_argv.push(null)
                _ = profiler_ffi_execv(executable_cstr, (&target_argv[0]).cast[mutable cstr&&] can Unsafe.PointerCast)
                profiler_ffi_process_exit(NATIVE_CHILD_FAILURE_STATUS)
            if process < NATIVE_ZERO:
                _ = profiler_ffi_close(stdout_fd)
                _ = profiler_ffi_close(stderr_fd)
                if stdin_fd >= NATIVE_ZERO:
                    _ = profiler_ffi_close(stdin_fd)
                clear_target_environment()
                return TargetRunResult{status: NATIVE_NEGATIVE_ONE, elapsed_ns: NATIVE_ZERO}
            status: mutable i64 = NATIVE_ZERO
            waited: i64 = profiler_ffi_waitpid(process, &status, NATIVE_WAIT_NO_OPTIONS)
            finish_time: ProfilerNativeTimespec = read_monotonic()
            _ = profiler_ffi_close(stdout_fd)
            _ = profiler_ffi_close(stderr_fd)
            if stdin_fd >= NATIVE_ZERO:
                _ = profiler_ffi_close(stdin_fd)
            clear_target_environment()
            return TargetRunResult{status: NATIVE_NEGATIVE_ONE, elapsed_ns: NATIVE_ZERO} if waited != process
            return TargetRunResult{status: status, elapsed_ns: elapsed_nanoseconds(start_time, finish_time)}


        def read_file(path: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path_copy: mutable darray[u8] = []
            path_copy.extend(path)
            path_copy.push(NATIVE_BYTE_NUL)
            path_cstr: cstr = (&path_copy[0]).cast[cstr] can Unsafe.PointerCast
            fd: i64 = profiler_ffi_open(path_cstr, NATIVE_O_RDONLY, NATIVE_ZERO)
            result: mutable darray[u8] = []
            return result if fd < NATIVE_ZERO
            chunk: mutable darray[u8] = [NATIVE_BYTE_NUL for _ in 0..<NATIVE_READ_CHUNK_BYTES]
            while true |result, chunk, fd|:
                amount: i64 = profiler_ffi_read(fd, &chunk[0], chunk.count) can Console
                if amount < NATIVE_ZERO:
                    _ = profiler_ffi_close(fd)
                    return []
                break if amount == NATIVE_ZERO
                if amount.usize() > NATIVE_MAX_FILE_BYTES - result.count:
                    _ = profiler_ffi_close(fd)
                    return []
                for index in 0..<amount.usize() |result, chunk|:
                    result.push(chunk[index])
            _ = profiler_ffi_close(fd)
            return result
        
        
        def line_prefix(data: darray[u8]&, start: usize, stop: usize, prefix: sview) -> bool can[Abort.Panic]:
            prefix_length: usize = profiler_ffi_sview_len(prefix)
            false return if start + prefix_length > stop
            for index in 0..<prefix_length |data, prefix|:
                false return if data[start + index] != profiler_ffi_sview_at(prefix, index)
            return true


        def protocol_field_into(data: darray[u8]&, start: usize, stop: usize, destination: mutable darray[u8]&) -> usize can[Abort.Panic, Memory.Allocate]:
            field_end: mutable usize = start
            while field_end < stop |field_end, data|:
                break if data[field_end] == NATIVE_BYTE_TAB
                field_end <- field_end + NATIVE_ONE.usize()
            for index in start..<field_end |destination, data|:
                destination.push(data[index])
            return field_end + NATIVE_ONE.usize() if field_end < stop and data[field_end] == NATIVE_BYTE_TAB else field_end


        def protocol_field_is(value: darray[u8]&, expected: sview) -> bool can[Abort.Panic]:
            false return if value.count != profiler_ffi_sview_len(expected)
            for index in 0..<value.count |value, expected|:
                false return if value[index] != profiler_ffi_sview_at(expected, index)
            return true


        def protocol_unsigned(value: darray[u8]&) -> bool can[Abort.Panic]:
            false return if value.count == NATIVE_ZERO.usize()
            parsed: mutable i64 = NATIVE_ZERO
            for index in 0..<value.count |value, parsed|:
                false return if value[index] < NATIVE_BYTE_ASCII_ZERO or value[index] > NATIVE_BYTE_ASCII_NINE
                digit: i64 = (value[index] - NATIVE_BYTE_ASCII_ZERO).i64()
                false return if parsed > (NATIVE_I64_MAX - digit) / NATIVE_DECIMAL_BASE
                parsed <- parsed * NATIVE_DECIMAL_BASE + digit
            return true


        def protocol_signed(value: darray[u8]&, allow_overflow: bool) -> bool can[Abort.Panic]:
            return true if allow_overflow and protocol_field_is(value, "overflow")
            false return if value.count == NATIVE_ZERO.usize()
            start: mutable usize = NATIVE_ZERO.usize()
            negative: mutable bool = false
            if value[NATIVE_ZERO.usize()] == NATIVE_BYTE_MINUS:
                negative <- true
                start <- NATIVE_ONE.usize()
            false return if start == value.count
            parsed: mutable i64 = NATIVE_ZERO
            for index in start..<value.count |value, parsed, negative|:
                false return if value[index] < NATIVE_BYTE_ASCII_ZERO or value[index] > NATIVE_BYTE_ASCII_NINE
                digit: i64 = (value[index] - NATIVE_BYTE_ASCII_ZERO).i64()
                permits_signed_minimum: bool = negative and index + NATIVE_ONE.usize() == value.count and parsed == NATIVE_I64_MAX / NATIVE_DECIMAL_BASE and digit == NATIVE_ONE + NATIVE_I64_MAX % NATIVE_DECIMAL_BASE
                false return if parsed > (NATIVE_I64_MAX - digit) / NATIVE_DECIMAL_BASE and not permits_signed_minimum
                parsed <- parsed * NATIVE_DECIMAL_BASE + digit if not permits_signed_minimum
            return true


        def append_record_separator(records: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            records.push(NATIVE_BYTE_COMMA) if records.count > NATIVE_ZERO.usize()


        def append_folded_separator(records: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            records.push(NATIVE_BYTE_NEWLINE) if records.count > NATIVE_ZERO.usize()


        def append_protocol_number(records: mutable darray[u8]&, value: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            records.extend(value)


        def protocol_number_field(value: darray[u8]&) -> i64 can[Abort.Panic]:
            return NATIVE_NEGATIVE_ONE if not protocol_unsigned(value)
            result: mutable i64 = NATIVE_ZERO
            for index in 0..<value.count |result, value|:
                result <- result * NATIVE_DECIMAL_BASE + (value[index] - NATIVE_BYTE_ASCII_ZERO).i64()
            return result


        def append_location_record(summary: mutable CaptureSummary&, location_records: mutable darray[u8]&, function_records: mutable darray[u8]&, data: darray[u8]&, cursor: mutable usize&, stop: usize, source: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            kind_field: mutable darray[u8] = []
            function_field: mutable darray[u8] = []
            line_field: mutable darray[u8] = []
            count_field: mutable darray[u8] = []
            variable_field: mutable darray[u8] = []
            signed_field: mutable darray[u8] = []
            field_min: mutable darray[u8] = []
            field_max: mutable darray[u8] = []
            field_sum: mutable darray[u8] = []
            field_last: mutable darray[u8] = []
            field_interval: mutable darray[u8] = []
            field_max_interval: mutable darray[u8] = []
            cursor <- protocol_field_into(data, cursor, stop, &kind_field)
            cursor <- protocol_field_into(data, cursor, stop, &function_field)
            cursor <- protocol_field_into(data, cursor, stop, &line_field)
            cursor <- protocol_field_into(data, cursor, stop, &count_field)
            cursor <- protocol_field_into(data, cursor, stop, &variable_field)
            cursor <- protocol_field_into(data, cursor, stop, &signed_field)
            cursor <- protocol_field_into(data, cursor, stop, &field_min)
            cursor <- protocol_field_into(data, cursor, stop, &field_max)
            cursor <- protocol_field_into(data, cursor, stop, &field_sum)
            cursor <- protocol_field_into(data, cursor, stop, &field_last)
            cursor <- protocol_field_into(data, cursor, stop, &field_interval)
            cursor <- protocol_field_into(data, cursor, stop, &field_max_interval)
            kind_name: mutable sview = ""
            if protocol_number_field(kind_field) == NATIVE_PROTOCOL_KIND_STATEMENT:
                kind_name <- "statement"
            elif protocol_number_field(kind_field) == NATIVE_PROTOCOL_KIND_VALUE:
                kind_name <- "value"
            elif protocol_number_field(kind_field) == NATIVE_PROTOCOL_KIND_FUNCTION:
                kind_name <- "function"
            else:
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_LOCATION
                return
            valid: mutable bool = function_field.count > NATIVE_ZERO.usize() and protocol_unsigned(line_field) and protocol_unsigned(count_field)
            valid <- valid and (protocol_number_field(signed_field) == NATIVE_PROTOCOL_SIGNED_FALSE or protocol_number_field(signed_field) == NATIVE_PROTOCOL_SIGNED_TRUE)
            valid <- valid and protocol_unsigned(field_interval) and protocol_unsigned(field_max_interval)
            if kind_name == "function":
                valid <- valid and protocol_unsigned(field_min) and protocol_unsigned(field_max) and protocol_unsigned(field_sum) and protocol_unsigned(field_last)
            elif kind_name == "value":
                signed_value: bool = protocol_number_field(signed_field) == NATIVE_PROTOCOL_SIGNED_TRUE
                valid <- valid and protocol_signed(field_min, false) and protocol_signed(field_max, false)
                valid <- valid and protocol_signed(field_sum, true) and protocol_signed(field_last, false)
                valid <- valid and (protocol_field_is(variable_field, "-") or variable_field.count > NATIVE_ZERO.usize())
                if not signed_value:
                    valid <- valid and protocol_unsigned(field_min) and protocol_unsigned(field_max) and protocol_unsigned(field_last)
            else:
                valid <- valid and protocol_unsigned(field_min) and protocol_unsigned(field_max) and protocol_unsigned(field_sum) and protocol_unsigned(field_last)
            if not valid:
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_LOCATION
                return

            append_record_separator(location_records)
            append_text(location_records, "{\"kind\":\"")
            append_text(location_records, kind_name)
            append_text(location_records, "\",\"function\":")
            append_json_string(location_records, function_field)
            append_text(location_records, ",\"line\":")
            append_protocol_number(location_records, line_field)
            append_text(location_records, ",\"count\":")
            append_protocol_number(location_records, count_field)
            count_number: i64 = protocol_number_field(count_field)
            if kind_name == "statement":
                summary.statement_events <- summary.statement_events + count_number
            elif kind_name == "value":
                summary.value_events <- summary.value_events + count_number
            else:
                summary.function_events <- summary.function_events + count_number
            if kind_name == "value":
                append_text(location_records, ",\"variable\":")
                if protocol_field_is(variable_field, "-"):
                    append_text(location_records, "null")
                else:
                    append_json_string(location_records, variable_field)
                append_text(location_records, ",\"signed\":")
                append_text(location_records, "true" if protocol_number_field(signed_field) == NATIVE_PROTOCOL_SIGNED_TRUE else "false")
                append_text(location_records, ",\"minimum\":")
                append_protocol_number(location_records, field_min)
                append_text(location_records, ",\"maximum\":")
                append_protocol_number(location_records, field_max)
                append_text(location_records, ",\"sum\":")
                if protocol_field_is(field_sum, "overflow"):
                    append_text(location_records, "null,\"sum_overflow\":true")
                else:
                    append_protocol_number(location_records, field_sum)
                append_text(location_records, ",\"last\":")
                append_protocol_number(location_records, field_last)
            elif kind_name == "function":
                append_text(location_records, ",\"inclusive_ns\":")
                append_protocol_number(location_records, field_min)
                append_text(location_records, ",\"self_ns\":")
                append_protocol_number(location_records, field_max)
                append_text(location_records, ",\"completed_calls\":")
                append_protocol_number(location_records, field_sum)
            append_text(location_records, ",\"interval_ns\":")
            append_protocol_number(location_records, field_interval)
            append_text(location_records, ",\"max_interval_ns\":")
            append_protocol_number(location_records, field_max_interval)
            append_text(location_records, ",\"compiler_line\":")
            append_protocol_number(location_records, line_field)
            append_text(location_records, ",\"source\":")
            append_json_string(location_records, source)
            append_text(location_records, ",\"source_text\":null")
            append_text(location_records, "}")
            if kind_name == "function":
                append_record_separator(function_records)
                append_text(function_records, "{\"function\":")
                append_json_string(function_records, function_field)
                append_text(function_records, ",\"events\":")
                append_protocol_number(function_records, count_field)
                append_text(function_records, ",\"statement_events\":")
                append_i64(function_records, NATIVE_ZERO)
                append_text(function_records, ",\"value_events\":")
                append_i64(function_records, NATIVE_ZERO)
                append_text(function_records, ",\"call_events\":")
                append_protocol_number(function_records, count_field)
                append_text(function_records, ",\"locations\":")
                append_i64(function_records, NATIVE_ONE)
                append_text(function_records, ",\"interval_ns\":")
                append_protocol_number(function_records, field_interval)
                append_text(function_records, ",\"max_interval_ns\":")
                append_protocol_number(function_records, field_max_interval)
                append_text(function_records, ",\"inclusive_ns\":")
                append_protocol_number(function_records, field_min)
                append_text(function_records, ",\"self_ns\":")
                append_protocol_number(function_records, field_max)
                append_text(function_records, ",\"completed_calls\":")
                append_protocol_number(function_records, field_sum)
                append_text(function_records, ",\"definitions\":[],\"mean_inclusive_ns\":")
                append_i64(function_records, NATIVE_ZERO)
                append_text(function_records, ",\"mean_self_ns\":")
                append_i64(function_records, NATIVE_ZERO)
                append_text(function_records, ",\"inclusive_percent\":")
                append_text(function_records, "0.0")
                append_text(function_records, ",\"self_percent\":")
                append_text(function_records, "0.0")
                append_text(function_records, "}")


        def append_call_record(summary: mutable CaptureSummary&, call_edge_records: mutable darray[u8]&, data: darray[u8]&, cursor: mutable usize&, stop: usize) -> void can[Abort.Panic, Memory.Allocate]:
            caller_field: mutable darray[u8] = []
            callee_field: mutable darray[u8] = []
            calls_field: mutable darray[u8] = []
            completed_field: mutable darray[u8] = []
            inclusive_field: mutable darray[u8] = []
            cursor <- protocol_field_into(data, cursor, stop, &caller_field)
            cursor <- protocol_field_into(data, cursor, stop, &callee_field)
            cursor <- protocol_field_into(data, cursor, stop, &calls_field)
            cursor <- protocol_field_into(data, cursor, stop, &completed_field)
            cursor <- protocol_field_into(data, cursor, stop, &inclusive_field)
            if caller_field.count == NATIVE_ZERO.usize() or callee_field.count == NATIVE_ZERO.usize() or not protocol_unsigned(calls_field) or not protocol_unsigned(completed_field) or not protocol_unsigned(inclusive_field):
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_CALL
                return
            append_record_separator(call_edge_records)
            append_text(call_edge_records, "{\"caller\":")
            append_json_string(call_edge_records, caller_field)
            append_text(call_edge_records, ",\"callee\":")
            append_json_string(call_edge_records, callee_field)
            append_text(call_edge_records, ",\"call_events\":")
            append_protocol_number(call_edge_records, calls_field)
            append_text(call_edge_records, ",\"completed_calls\":")
            append_protocol_number(call_edge_records, completed_field)
            append_text(call_edge_records, ",\"inclusive_ns\":")
            append_protocol_number(call_edge_records, inclusive_field)
            append_text(call_edge_records, "}")


        def append_stack_record(summary: mutable CaptureSummary&, stack_records: mutable darray[u8]&, folded_records: mutable darray[u8]&, data: darray[u8]&, cursor: mutable usize&, stop: usize) -> void can[Abort.Panic, Memory.Allocate]:
            stack_field: mutable darray[u8] = []
            calls_field: mutable darray[u8] = []
            completed_field: mutable darray[u8] = []
            self_field: mutable darray[u8] = []
            cursor <- protocol_field_into(data, cursor, stop, &stack_field)
            cursor <- protocol_field_into(data, cursor, stop, &calls_field)
            cursor <- protocol_field_into(data, cursor, stop, &completed_field)
            cursor <- protocol_field_into(data, cursor, stop, &self_field)
            if stack_field.count == NATIVE_ZERO.usize() or not protocol_unsigned(calls_field) or not protocol_unsigned(completed_field) or not protocol_unsigned(self_field):
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_STACK
                return
            append_record_separator(stack_records)
            append_text(stack_records, "{\"stack\":")
            append_json_string(stack_records, stack_field)
            append_text(stack_records, ",\"call_events\":")
            append_protocol_number(stack_records, calls_field)
            append_text(stack_records, ",\"completed_calls\":")
            append_protocol_number(stack_records, completed_field)
            append_text(stack_records, ",\"self_ns\":")
            append_protocol_number(stack_records, self_field)
            append_text(stack_records, "}")
            append_folded_separator(folded_records)
            for index in 0..<stack_field.count |folded_records, stack_field|:
                folded_records.push(stack_field[index])
            folded_records.push(NATIVE_BYTE_SPACE)
            if protocol_number_field(self_field) > NATIVE_ZERO:
                append_protocol_number(folded_records, self_field)
            else:
                append_protocol_number(folded_records, calls_field)


        def append_event_record(summary: mutable CaptureSummary&, event_records: mutable darray[u8]&, data: darray[u8]&, cursor: mutable usize&, stop: usize, source: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            sequence_field: mutable darray[u8] = []
            kind_field: mutable darray[u8] = []
            function_field: mutable darray[u8] = []
            line_field: mutable darray[u8] = []
            variable_field: mutable darray[u8] = []
            signed_field: mutable darray[u8] = []
            value_field: mutable darray[u8] = []
            cursor <- protocol_field_into(data, cursor, stop, &sequence_field)
            cursor <- protocol_field_into(data, cursor, stop, &kind_field)
            cursor <- protocol_field_into(data, cursor, stop, &function_field)
            cursor <- protocol_field_into(data, cursor, stop, &line_field)
            cursor <- protocol_field_into(data, cursor, stop, &variable_field)
            cursor <- protocol_field_into(data, cursor, stop, &signed_field)
            cursor <- protocol_field_into(data, cursor, stop, &value_field)
            kind_name: mutable sview = ""
            if protocol_number_field(kind_field) == NATIVE_PROTOCOL_KIND_STATEMENT:
                kind_name <- "statement"
            elif protocol_number_field(kind_field) == NATIVE_PROTOCOL_KIND_VALUE:
                kind_name <- "value"
            elif protocol_number_field(kind_field) == NATIVE_PROTOCOL_KIND_FUNCTION:
                kind_name <- "function"
            else:
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_EVENT
                return
            signed_value: bool = protocol_number_field(signed_field) == NATIVE_PROTOCOL_SIGNED_TRUE
            valid: mutable bool = protocol_unsigned(sequence_field) and function_field.count > NATIVE_ZERO.usize() and protocol_unsigned(line_field)
            valid <- valid and (protocol_number_field(signed_field) == NATIVE_PROTOCOL_SIGNED_FALSE or signed_value)
            valid <- valid and protocol_signed(value_field, false)
            if not signed_value:
                valid <- valid and protocol_unsigned(value_field)
            if not valid:
                summary.malformed <- true
                summary.malformed_code <- NATIVE_PROTOCOL_ERROR_EVENT
                return
            append_record_separator(event_records)
            append_text(event_records, "{\"sequence\":")
            append_protocol_number(event_records, sequence_field)
            append_text(event_records, ",\"kind\":\"")
            append_text(event_records, kind_name)
            append_text(event_records, "\",\"function\":")
            append_json_string(event_records, function_field)
            append_text(event_records, ",\"line\":")
            append_protocol_number(event_records, line_field)
            append_text(event_records, ",\"variable\":")
            if protocol_field_is(variable_field, "-"):
                append_text(event_records, "null")
            else:
                append_json_string(event_records, variable_field)
            append_text(event_records, ",\"signed\":")
            append_text(event_records, "true" if signed_value else "false")
            append_text(event_records, ",\"value\":")
            append_protocol_number(event_records, value_field)
            append_text(event_records, ",\"compiler_line\":")
            append_protocol_number(event_records, line_field)
            append_text(event_records, ",\"source\":")
            append_json_string(event_records, source)
            append_text(event_records, ",\"source_text\":null")
            append_text(event_records, "}")


        def parse_protocol_number(data: darray[u8]&, cursor: mutable usize&, stop: usize) -> i64:
            value: mutable i64 = NATIVE_ZERO
            valid: mutable bool = true
            digits: mutable usize = NATIVE_ZERO.usize()
            position: mutable usize = cursor
            while position < stop and data[position] != NATIVE_BYTE_TAB |position, value, valid, digits, data|:
                if data[position] < NATIVE_BYTE_ASCII_ZERO or data[position] > NATIVE_BYTE_ASCII_NINE:
                    valid <- false
                elif valid:
                    digit: i64 = (data[position] - NATIVE_BYTE_ASCII_ZERO).i64()
                    valid <- false if value > (NATIVE_I64_MAX - digit) / NATIVE_DECIMAL_BASE
                    value <- value * NATIVE_DECIMAL_BASE + digit if valid
                digits <- digits + NATIVE_ONE.usize()
                position <- position + NATIVE_ONE.usize()
            position <- position + NATIVE_ONE.usize() if position < stop and data[position] == NATIVE_BYTE_TAB
            cursor <- position
            return NATIVE_NEGATIVE_ONE if not valid or digits == NATIVE_ZERO.usize()
            return value
        
        
        def parse_capture(data: darray[u8]&, source: darray[u8]&) -> CaptureSummary:
            summary: mutable CaptureSummary = CaptureSummary{
                events: NATIVE_ZERO,
                locations: NATIVE_ZERO,
                statement_events: NATIVE_ZERO,
                value_events: NATIVE_ZERO,
                function_events: NATIVE_ZERO,
                dropped: NATIVE_ZERO,
                max_stack_depth: NATIVE_ZERO,
                stack_overflow_entries: NATIVE_ZERO,
                thread_count: NATIVE_ZERO,
                trace_enabled: NATIVE_ZERO,
                trace_captured: NATIVE_ZERO,
                trace_omitted: NATIVE_ZERO,
                trace_limit: NATIVE_ZERO,
                location_limit: NATIVE_ZERO,
                call_edge_limit: NATIVE_ZERO,
                stack_limit: NATIVE_ZERO,
                capture_byte_limit: NATIVE_ZERO,
                capture_bytes_used: NATIVE_ZERO,
                capture_bytes_dropped: NATIVE_ZERO,
                budget_exceeded: NATIVE_ZERO,
                call_edge_dropped: NATIVE_ZERO,
                stack_dropped: NATIVE_ZERO,
                crash_signal: NATIVE_ZERO,
                location_records: [],
                function_records: [],
                call_edge_records: [],
                stack_records: [],
                folded_records: [],
                event_records: [],
                malformed: false,
                malformed_code: NATIVE_ZERO,
            }
            location_records: mutable darray[u8] = []
            function_records: mutable darray[u8] = []
            call_edge_records: mutable darray[u8] = []
            stack_records: mutable darray[u8] = []
            event_records: mutable darray[u8] = []
            folded_records: mutable darray[u8] = []
            meta_prefix: sview = "ELISA_PROFILE\t1\tmeta\t"
            trace_prefix: sview = "ELISA_PROFILE\t1\ttrace\t"
            crash_prefix: sview = "ELISA_PROFILE\t1\tcrash\t"
            line_start: mutable usize = NATIVE_ZERO.usize()
            while line_start < data.count |line_start, data, summary|:
                line_stop: mutable usize = line_start
                while line_stop < data.count and data[line_stop] != NATIVE_BYTE_NEWLINE |line_stop, data|:
                    line_stop <- line_stop + NATIVE_ONE.usize()
                if line_prefix(data, line_start, line_stop, meta_prefix):
                    cursor: mutable usize = line_start + profiler_ffi_sview_len(meta_prefix)
                    summary.events <- parse_protocol_number(data, &cursor, line_stop)
                    summary.locations <- parse_protocol_number(data, &cursor, line_stop)
                    summary.dropped <- parse_protocol_number(data, &cursor, line_stop)
                    summary.max_stack_depth <- parse_protocol_number(data, &cursor, line_stop)
                    summary.stack_overflow_entries <- parse_protocol_number(data, &cursor, line_stop)
                    summary.thread_count <- parse_protocol_number(data, &cursor, line_stop)
                    summary.location_limit <- parse_protocol_number(data, &cursor, line_stop)
                    summary.call_edge_limit <- parse_protocol_number(data, &cursor, line_stop)
                    summary.stack_limit <- parse_protocol_number(data, &cursor, line_stop)
                    summary.budget_exceeded <- parse_protocol_number(data, &cursor, line_stop)
                    summary.call_edge_dropped <- parse_protocol_number(data, &cursor, line_stop)
                    summary.stack_dropped <- parse_protocol_number(data, &cursor, line_stop)
                    if cursor < line_stop:
                        summary.capture_byte_limit <- parse_protocol_number(data, &cursor, line_stop)
                        summary.capture_bytes_used <- parse_protocol_number(data, &cursor, line_stop)
                        summary.capture_bytes_dropped <- parse_protocol_number(data, &cursor, line_stop)
                    if summary.events < NATIVE_ZERO or summary.locations < NATIVE_ZERO or summary.dropped < NATIVE_ZERO or summary.max_stack_depth < NATIVE_ZERO or summary.stack_overflow_entries < NATIVE_ZERO or summary.thread_count < NATIVE_ZERO or summary.location_limit < NATIVE_ZERO or summary.call_edge_limit < NATIVE_ZERO or summary.stack_limit < NATIVE_ZERO or summary.budget_exceeded < NATIVE_ZERO or summary.call_edge_dropped < NATIVE_ZERO or summary.stack_dropped < NATIVE_ZERO or summary.capture_byte_limit < NATIVE_ZERO or summary.capture_bytes_used < NATIVE_ZERO or summary.capture_bytes_dropped < NATIVE_ZERO:
                        summary.malformed <- true
                        summary.malformed_code <- NATIVE_PROTOCOL_ERROR_META
                elif line_prefix(data, line_start, line_stop, trace_prefix):
                    cursor: mutable usize = line_start + profiler_ffi_sview_len(trace_prefix)
                    summary.trace_enabled <- parse_protocol_number(data, &cursor, line_stop)
                    summary.trace_captured <- parse_protocol_number(data, &cursor, line_stop)
                    summary.trace_omitted <- parse_protocol_number(data, &cursor, line_stop)
                    summary.trace_limit <- parse_protocol_number(data, &cursor, line_stop)
                    if summary.trace_enabled < NATIVE_ZERO or summary.trace_captured < NATIVE_ZERO or summary.trace_omitted < NATIVE_ZERO or summary.trace_limit < NATIVE_ZERO:
                        summary.malformed <- true
                        summary.malformed_code <- NATIVE_PROTOCOL_ERROR_META
                elif line_prefix(data, line_start, line_stop, crash_prefix):
                    cursor: mutable usize = line_start + profiler_ffi_sview_len(crash_prefix)
                    summary.crash_signal <- parse_protocol_number(data, &cursor, line_stop)
                    if summary.crash_signal < NATIVE_ZERO:
                        summary.malformed <- true
                        summary.malformed_code <- NATIVE_PROTOCOL_ERROR_META
                elif line_prefix(data, line_start, line_stop, "ELISA_PROFILE\t1\tlocation\t"):
                    cursor: mutable usize = line_start + profiler_ffi_sview_len("ELISA_PROFILE\t1\tlocation\t")
                    append_location_record(&summary, &location_records, &function_records, data, &cursor, line_stop, source)
                elif line_prefix(data, line_start, line_stop, "ELISA_PROFILE\t1\tcall\t"):
                    cursor: mutable usize = line_start + profiler_ffi_sview_len("ELISA_PROFILE\t1\tcall\t")
                    append_call_record(&summary, &call_edge_records, data, &cursor, line_stop)
                elif line_prefix(data, line_start, line_stop, "ELISA_PROFILE\t1\tstack\t"):
                    cursor: mutable usize = line_start + profiler_ffi_sview_len("ELISA_PROFILE\t1\tstack\t")
                    append_stack_record(&summary, &stack_records, &folded_records, data, &cursor, line_stop)
                elif line_prefix(data, line_start, line_stop, "ELISA_PROFILE\t1\tpath\t"):
                    cursor: mutable usize = line_start + profiler_ffi_sview_len("ELISA_PROFILE\t1\tpath\t")
                    append_event_record(&summary, &event_records, data, &cursor, line_stop, source)
                elif line_prefix(data, line_start, line_stop, "ELISA_PROFILE\t1\t"):
                    summary.malformed <- true
                line_start <- line_stop + NATIVE_ONE.usize()
            summary.location_records <- location_records
            summary.function_records <- function_records
            summary.call_edge_records <- call_edge_records
            summary.stack_records <- stack_records
            summary.folded_records <- folded_records
            summary.event_records <- event_records
            return summary


        def empty_capture_summary() -> CaptureSummary:
            return CaptureSummary{
                events: NATIVE_ZERO,
                locations: NATIVE_ZERO,
                statement_events: NATIVE_ZERO,
                value_events: NATIVE_ZERO,
                function_events: NATIVE_ZERO,
                dropped: NATIVE_ZERO,
                max_stack_depth: NATIVE_ZERO,
                stack_overflow_entries: NATIVE_ZERO,
                thread_count: NATIVE_ZERO,
                trace_enabled: NATIVE_ZERO,
                trace_captured: NATIVE_ZERO,
                trace_omitted: NATIVE_ZERO,
                trace_limit: NATIVE_ZERO,
                location_limit: NATIVE_ZERO,
                call_edge_limit: NATIVE_ZERO,
                stack_limit: NATIVE_ZERO,
                capture_byte_limit: NATIVE_ZERO,
                capture_bytes_used: NATIVE_ZERO,
                capture_bytes_dropped: NATIVE_ZERO,
                budget_exceeded: NATIVE_ZERO,
                call_edge_dropped: NATIVE_ZERO,
                stack_dropped: NATIVE_ZERO,
                crash_signal: NATIVE_ZERO,
                location_records: [],
                function_records: [],
                call_edge_records: [],
                stack_records: [],
                folded_records: [],
                event_records: [],
                malformed: false,
                malformed_code: NATIVE_ZERO,
            }


        def merge_capture_summary(destination: mutable CaptureSummary&, incoming: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            destination.events <- destination.events + incoming.events
            destination.locations <- destination.locations + incoming.locations
            destination.statement_events <- destination.statement_events + incoming.statement_events
            destination.value_events <- destination.value_events + incoming.value_events
            destination.function_events <- destination.function_events + incoming.function_events
            destination.dropped <- destination.dropped + incoming.dropped
            destination.max_stack_depth <- incoming.max_stack_depth if incoming.max_stack_depth > destination.max_stack_depth
            destination.stack_overflow_entries <- destination.stack_overflow_entries + incoming.stack_overflow_entries
            destination.thread_count <- incoming.thread_count if incoming.thread_count > destination.thread_count
            destination.trace_enabled <- incoming.trace_enabled
            destination.trace_captured <- destination.trace_captured + incoming.trace_captured
            destination.trace_omitted <- destination.trace_omitted + incoming.trace_omitted
            destination.trace_limit <- incoming.trace_limit
            destination.location_limit <- incoming.location_limit
            destination.call_edge_limit <- incoming.call_edge_limit
            destination.stack_limit <- incoming.stack_limit
            destination.capture_byte_limit <- incoming.capture_byte_limit
            destination.capture_bytes_used <- destination.capture_bytes_used + incoming.capture_bytes_used
            destination.capture_bytes_dropped <- destination.capture_bytes_dropped + incoming.capture_bytes_dropped
            destination.budget_exceeded <- incoming.budget_exceeded if incoming.budget_exceeded != NATIVE_ZERO
            destination.call_edge_dropped <- destination.call_edge_dropped + incoming.call_edge_dropped
            destination.stack_dropped <- destination.stack_dropped + incoming.stack_dropped
            destination.crash_signal <- incoming.crash_signal if incoming.crash_signal > NATIVE_ZERO
            append_record_separator(destination.location_records)
            destination.location_records.extend(incoming.location_records)
            append_record_separator(destination.function_records)
            destination.function_records.extend(incoming.function_records)
            append_record_separator(destination.call_edge_records)
            destination.call_edge_records.extend(incoming.call_edge_records)
            append_record_separator(destination.stack_records)
            destination.stack_records.extend(incoming.stack_records)
            append_folded_separator(destination.folded_records)
            destination.folded_records.extend(incoming.folded_records)
            append_record_separator(destination.event_records)
            destination.event_records.extend(incoming.event_records)
            if incoming.malformed:
                destination.malformed <- true
                destination.malformed_code <- incoming.malformed_code


        def integer_sqrt(value: i64) -> i64:
            return NATIVE_ZERO if value <= NATIVE_ZERO
            guess: mutable i64 = value
            while guess > value / guess |guess, value|:
                guess <- (guess + value / guess) / NATIVE_TWO
            return guess


        def sort_i64(values: mutable darray[i64]&) -> void:
            for outer in 0..<values.count |outer, values|:
                smallest: mutable usize = outer
                for inner in outer + 1.usize()..<values.count |inner, smallest, values|:
                    smallest <- inner if values[inner] < values[smallest]
                temporary: i64 = values[outer]
                values[outer] <- values[smallest]
                values[smallest] <- temporary


        def append_repetition_record(buffer: mutable darray[u8]&, repetition: i64, requested: i64, result: TargetRunResult, summary: CaptureSummary, event_trace: bool, recent_path: bool) -> void can[Abort.Panic, Memory.Allocate]:
            append_record_separator(buffer)
            append_text(buffer, "{\"repetition\":")
            append_i64(buffer, repetition)
            append_text(buffer, ",\"requested_repetitions\":")
            append_i64(buffer, requested)
            append_text(buffer, ",\"exit_code\":")
            append_i64(buffer, system_exit_code(result.status))
            append_text(buffer, ",\"signal\":")
            append_observed_signal(buffer, result.status, summary)
            append_text(buffer, ",\"execution_ms\":")
            append_millis(buffer, result.elapsed_ns)
            append_text(buffer, ",\"timed_out\":false,\"cpu_user_ms\":null,\"cpu_system_ms\":null,\"cpu_ms\":null,\"peak_rss_bytes\":null,\"trace_events\":")
            append_i64(buffer, summary.events)
            append_text(buffer, ",\"trace_locations\":")
            append_i64(buffer, summary.locations)
            append_text(buffer, ",\"trace_dropped\":")
            append_i64(buffer, summary.dropped)
            append_text(buffer, ",\"trace_threads\":")
            append_i64(buffer, summary.thread_count)
            append_text(buffer, ",\"trace_max_stack_depth\":")
            append_i64(buffer, summary.max_stack_depth)
            append_text(buffer, ",\"trace_stack_overflow_entries\":")
            append_i64(buffer, summary.stack_overflow_entries)
            append_text(buffer, ",\"location_limit\":")
            append_i64(buffer, summary.location_limit)
            append_text(buffer, ",\"call_edge_limit\":")
            append_i64(buffer, summary.call_edge_limit)
            append_text(buffer, ",\"stack_limit\":")
            append_i64(buffer, summary.stack_limit)
            append_text(buffer, ",\"capture_byte_limit\":")
            append_i64(buffer, summary.capture_byte_limit)
            append_text(buffer, ",\"capture_bytes_used\":")
            append_i64(buffer, summary.capture_bytes_used)
            append_text(buffer, ",\"capture_bytes_dropped\":")
            append_i64(buffer, summary.capture_bytes_dropped)
            append_text(buffer, ",\"detail_budget_exceeded\":")
            append_text(buffer, "true" if summary.budget_exceeded != NATIVE_ZERO else "false")
            append_text(buffer, ",\"dropped_call_edges\":")
            append_i64(buffer, summary.call_edge_dropped)
            append_text(buffer, ",\"dropped_stacks\":")
            append_i64(buffer, summary.stack_dropped)
            append_text(buffer, ",\"crash_signal\":")
            if summary.crash_signal > NATIVE_ZERO:
                append_i64(buffer, summary.crash_signal)
            else:
                append_text(buffer, "null")
            append_text(buffer, ",\"trace_events_captured\":")
            append_i64(buffer, summary.trace_captured)
            append_text(buffer, ",\"trace_events_omitted\":")
            append_i64(buffer, summary.trace_omitted)
            append_text(buffer, ",\"trace_event_limit\":")
            if event_trace:
                append_i64(buffer, summary.trace_limit)
            else:
                append_text(buffer, "null")
            append_text(buffer, ",\"trace_complete\":")
            if event_trace:
                append_text(buffer, "true" if summary.trace_omitted == NATIVE_ZERO and summary.trace_captured == summary.events else "false")
            else:
                append_text(buffer, "null")
            if event_trace:
                append_text(buffer, ",\"event_trace\":[")
                buffer.extend(summary.event_records)
                append_text(buffer, "]")
            elif recent_path:
                append_text(buffer, ",\"recent_events\":[")
                buffer.extend(summary.event_records)
                append_text(buffer, "]")
            append_text(buffer, "}")
        
        
        def system_exit_code(status: i64) -> i64:
            return NATIVE_CHILD_FAILURE_STATUS if status < NATIVE_ZERO
            return status / NATIVE_EXIT_STATUS_BASE if status % NATIVE_EXIT_STATUS_BASE == NATIVE_ZERO else NATIVE_SIGNAL_EXIT_BASE + (status % NATIVE_SIGNAL_STATUS_BASE)


        def system_signal(status: i64) -> i64:
            return NATIVE_NEGATIVE_ONE if status < NATIVE_ZERO or status % NATIVE_EXIT_STATUS_BASE == NATIVE_ZERO else status % NATIVE_SIGNAL_STATUS_BASE


        def append_optional_signal(buffer: mutable darray[u8]&, status: i64) -> void can[Abort.Panic, Memory.Allocate]:
            signal: i64 = system_signal(status)
            append_text(buffer, "null") if signal < NATIVE_ZERO
            append_i64(buffer, signal) if signal >= NATIVE_ZERO


        def observed_signal(status: i64, summary: CaptureSummary) -> i64:
            signal: i64 = system_signal(status)
            return summary.crash_signal if signal < NATIVE_ZERO and summary.crash_signal > NATIVE_ZERO
            return signal


        def append_observed_signal(buffer: mutable darray[u8]&, status: i64, summary: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            signal: i64 = observed_signal(status, summary)
            append_text(buffer, "null") if signal < NATIVE_ZERO
            append_i64(buffer, signal) if signal >= NATIVE_ZERO


        def append_quality(buffer: mutable darray[u8]&, summary: CaptureSummary, status: i64, event_trace: bool) -> void can[Abort.Panic, Memory.Allocate]:
            target_exit: i64 = system_exit_code(status)
            signal: i64 = observed_signal(status, summary)
            detail_degraded: bool = summary.dropped > NATIVE_ZERO or summary.call_edge_dropped > NATIVE_ZERO or summary.stack_dropped > NATIVE_ZERO or summary.capture_bytes_dropped > NATIVE_ZERO or summary.stack_overflow_entries > NATIVE_ZERO or (event_trace and summary.trace_omitted > NATIVE_ZERO)
            append_text(buffer, "\"quality\":{\"capture\":\"")
            if status < NATIVE_ZERO:
                append_text(buffer, "profiler_failure")
            elif signal >= NATIVE_ZERO:
                append_text(buffer, "target_signal")
            elif target_exit != NATIVE_ZERO:
                append_text(buffer, "target_exit")
            else:
                append_text(buffer, "complete")
            append_text(buffer, "\",\"detail\":\"")
            append_text(buffer, "degraded" if detail_degraded else "complete")
            append_text(buffer, "\",\"event_counts\":\"")
            append_text(buffer, "partial" if summary.dropped > NATIVE_ZERO else "exact")
            append_text(buffer, "\",\"reasons\":[")
            first_reason: mutable bool = true
            if status < NATIVE_ZERO:
                append_text(buffer, "\"wait_failure\"")
                first_reason <- false
            if signal >= NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"signal_termination\"")
                first_reason <- false
            if target_exit != NATIVE_ZERO and signal < NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"target_exit\"")
                first_reason <- false
            if summary.dropped > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"dropped_locations\"")
                first_reason <- false
            if summary.call_edge_dropped > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"dropped_call_edges\"")
                first_reason <- false
            if summary.stack_dropped > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"dropped_stacks\"")
                first_reason <- false
            if summary.capture_bytes_dropped > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"capture_byte_budget\"")
                first_reason <- false
            if summary.stack_overflow_entries > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"stack_overflow\"")
                first_reason <- false
            if summary.crash_signal > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"crash_marker\"")
                first_reason <- false
            if event_trace and summary.trace_omitted > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"event_trace_omitted\"")
            append_text(buffer, "]}")
        
        
        def append_detail_arrays(buffer: mutable darray[u8]&, summary: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "\"functions\":[")
            buffer.extend(summary.function_records)
            append_text(buffer, "],\"call_edges\":[")
            buffer.extend(summary.call_edge_records)
            append_text(buffer, "],\"stacks\":[")
            buffer.extend(summary.stack_records)
            append_text(buffer, "],\"locations\":[")
            buffer.extend(summary.location_records)
            append_text(buffer, "]")


        def append_folded_report(buffer: mutable darray[u8]&, summary: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            buffer.extend(summary.folded_records)
            buffer.push(NATIVE_BYTE_NEWLINE) if summary.folded_records.count > NATIVE_ZERO.usize()


        def folded_line_end(records: darray[u8]&, start: usize) -> usize:
            cursor: mutable usize = start
            while cursor < records.count |cursor, records|:
                break if records[cursor] == NATIVE_BYTE_NEWLINE
                cursor <- cursor + NATIVE_ONE.usize()
            return cursor


        def folded_line_weight(records: darray[u8]&, start: usize, stop: usize) -> i64 can[Abort.Panic, Memory.Allocate]:
            separator: mutable usize = start
            cursor: mutable usize = start
            while cursor < stop |cursor, separator, records|:
                separator <- cursor if records[cursor] == NATIVE_BYTE_SPACE
                cursor <- cursor + NATIVE_ONE.usize()
            return NATIVE_ZERO if separator == start or separator + NATIVE_ONE.usize() >= stop
            weight: mutable darray[u8] = []
            for index in separator + NATIVE_ONE.usize()..<stop |weight, records|:
                weight.push(records[index])
            return protocol_number_field(weight)


        def folded_stack_stop(records: darray[u8]&, start: usize, stop: usize) -> usize:
            cursor: mutable usize = stop
            while cursor > start |cursor, records|:
                break if records[cursor - NATIVE_ONE.usize()] == NATIVE_BYTE_SPACE
                cursor <- cursor - NATIVE_ONE.usize()
            return cursor


        def append_speedscope_frames(buffer: mutable darray[u8]&, records: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            first_frame: mutable bool = true
            line_start: mutable usize = NATIVE_ZERO.usize()
            while line_start < records.count |line_start, first_frame, records, buffer|:
                line_end: usize = folded_line_end(records, line_start)
                weight: i64 = folded_line_weight(records, line_start, line_end)
                if weight > NATIVE_ZERO:
                    stack_stop: usize = folded_stack_stop(records, line_start, line_end)
                    frame_start: mutable usize = line_start
                    while frame_start < stack_stop |frame_start, stack_stop, first_frame, records, buffer|:
                        frame_end: mutable usize = frame_start
                        while frame_end < stack_stop |frame_end, stack_stop, records|:
                            break if records[frame_end] == NATIVE_BYTE_SEMICOLON
                            frame_end <- frame_end + NATIVE_ONE.usize()
                        frame: mutable darray[u8] = []
                        for index in frame_start..<frame_end |frame, records|:
                            frame.push(records[index])
                        append_record_separator(buffer) if not first_frame
                        append_text(buffer, "{\"name\":")
                        append_json_string(buffer, frame)
                        append_text(buffer, "}")
                        first_frame <- false
                        frame_start <- frame_end + NATIVE_ONE.usize() if frame_end < stack_stop else stack_stop
                line_start <- line_end + NATIVE_ONE.usize() if line_end < records.count else records.count


        def append_speedscope_samples(buffer: mutable darray[u8]&, records: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            first_sample: mutable bool = true
            frame_index: mutable i64 = NATIVE_ZERO
            line_start: mutable usize = NATIVE_ZERO.usize()
            while line_start < records.count |line_start, first_sample, frame_index, records, buffer|:
                line_end: usize = folded_line_end(records, line_start)
                weight: i64 = folded_line_weight(records, line_start, line_end)
                if weight > NATIVE_ZERO:
                    stack_stop: usize = folded_stack_stop(records, line_start, line_end)
                    frame_start: mutable usize = line_start
                    first_frame: mutable bool = true
                    append_record_separator(buffer) if not first_sample
                    buffer.push(NATIVE_BYTE_LEFT_BRACKET)
                    while frame_start < stack_stop |frame_start, stack_stop, frame_index, first_frame, records, buffer|:
                        frame_end: mutable usize = frame_start
                        while frame_end < stack_stop |frame_end, stack_stop, records|:
                            break if records[frame_end] == NATIVE_BYTE_SEMICOLON
                            frame_end <- frame_end + NATIVE_ONE.usize()
                        append_record_separator(buffer) if not first_frame
                        append_i64(buffer, frame_index)
                        first_frame <- false
                        frame_index <- frame_index + NATIVE_ONE
                        frame_start <- frame_end + NATIVE_ONE.usize() if frame_end < stack_stop else stack_stop
                    buffer.push(NATIVE_BYTE_RIGHT_BRACKET)
                    first_sample <- false
                line_start <- line_end + NATIVE_ONE.usize() if line_end < records.count else records.count


        def append_speedscope_weights(buffer: mutable darray[u8]&, records: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            first_weight: mutable bool = true
            line_start: mutable usize = NATIVE_ZERO.usize()
            while line_start < records.count |line_start, first_weight, records, buffer|:
                line_end: usize = folded_line_end(records, line_start)
                weight: i64 = folded_line_weight(records, line_start, line_end)
                if weight > NATIVE_ZERO:
                    append_record_separator(buffer) if not first_weight
                    append_i64(buffer, weight)
                    first_weight <- false
                line_start <- line_end + NATIVE_ONE.usize() if line_end < records.count else records.count


        def folded_total_weight(records: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate]:
            total: mutable i64 = NATIVE_ZERO
            line_start: mutable usize = NATIVE_ZERO.usize()
            while line_start < records.count |line_start, total, records|:
                line_end: usize = folded_line_end(records, line_start)
                weight: i64 = folded_line_weight(records, line_start, line_end)
                total <- total + weight if weight > NATIVE_ZERO
                line_start <- line_end + NATIVE_ONE.usize() if line_end < records.count else records.count
            return total


        def append_speedscope_report(buffer: mutable darray[u8]&, source: darray[u8]&, records: darray[u8]&, location_timing: bool) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "{\"$schema\":\"https://www.speedscope.app/file-format-schema.json\",\"name\":")
            append_json_string(buffer, source)
            append_text(buffer, ",\"activeProfileIndex\":0,\"exporter\":\"elisa-profiler-native\",\"shared\":{\"frames\":[")
            append_speedscope_frames(buffer, records)
            append_text(buffer, "]},\"profiles\":[{\"type\":\"sampled\",\"name\":")
            append_json_string(buffer, source)
            append_text(buffer, ",\"unit\":\"")
            append_text(buffer, "nanoseconds" if location_timing else "none")
            append_text(buffer, "\",\"startValue\":0,\"endValue\":")
            append_i64(buffer, folded_total_weight(records))
            append_text(buffer, ",\"samples\":[")
            append_speedscope_samples(buffer, records)
            append_text(buffer, "],\"weights\":[")
            append_speedscope_weights(buffer, records)
            append_text(buffer, "]}]}\n")


        def json_skip_whitespace(data: darray[u8]&, cursor: usize, stop: usize) -> usize:
            next: mutable usize = cursor
            while next < stop |next, data|:
                byte: u8 = data[next]
                break if byte != NATIVE_BYTE_SPACE and byte != NATIVE_BYTE_TAB and byte != NATIVE_BYTE_NEWLINE and byte != NATIVE_BYTE_CARRIAGE_RETURN
                next <- next + NATIVE_ONE.usize()
            return next


        def json_string_end(data: darray[u8]&, start: usize, stop: usize) -> i64:
            return NATIVE_NEGATIVE_ONE if start >= stop or data[start] != NATIVE_BYTE_DOUBLE_QUOTE
            escaped: mutable bool = false
            cursor: mutable usize = start + NATIVE_ONE.usize()
            while cursor < stop |cursor, escaped, data|:
                byte: u8 = data[cursor]
                if escaped:
                    escaped <- false
                elif byte == NATIVE_BYTE_BACKSLASH:
                    escaped <- true
                elif byte == NATIVE_BYTE_DOUBLE_QUOTE:
                    return (cursor + NATIVE_ONE.usize()).i64()
                cursor <- cursor + NATIVE_ONE.usize()
            return NATIVE_NEGATIVE_ONE


        def json_key_value_start(data: darray[u8]&, key: sview, start: usize, stop: usize) -> i64 can[Abort.Panic]:
            key_length: usize = profiler_ffi_sview_len(key)
            cursor: mutable usize = start
            while cursor < stop |cursor, key_length, key, data|:
                if data[cursor] == NATIVE_BYTE_DOUBLE_QUOTE:
                    key_cursor: usize = cursor + NATIVE_ONE.usize()
                    matches: mutable bool = key_cursor + key_length < stop
                    if matches:
                        for index in 0..<key_length |index, key_cursor, key, data, matches|:
                            matches <- false if data[key_cursor + index] != profiler_ffi_sview_at(key, index)
                    matches <- false if matches and data[key_cursor + key_length] != NATIVE_BYTE_DOUBLE_QUOTE
                    if matches:
                        value_cursor: usize = json_skip_whitespace(data, key_cursor + key_length + NATIVE_ONE.usize(), stop)
                        if value_cursor < stop and data[value_cursor] == NATIVE_BYTE_COLON:
                            return json_skip_whitespace(data, value_cursor + NATIVE_ONE.usize(), stop).i64()
                    string_end: i64 = json_string_end(data, cursor, stop)
                    cursor <- string_end.usize() if string_end >= NATIVE_ZERO else cursor + NATIVE_ONE.usize()
                    continue
                cursor <- cursor + NATIVE_ONE.usize()
            return NATIVE_NEGATIVE_ONE


        def json_object_end(data: darray[u8]&, start: usize, stop: usize) -> i64:
            return NATIVE_NEGATIVE_ONE if start >= stop or data[start] != NATIVE_BYTE_LEFT_BRACE
            depth: mutable i64 = NATIVE_ZERO
            in_string: mutable bool = false
            escaped: mutable bool = false
            cursor: mutable usize = start
            while cursor < stop |cursor, depth, in_string, escaped, data|:
                byte: u8 = data[cursor]
                if in_string:
                    if escaped:
                        escaped <- false
                    elif byte == NATIVE_BYTE_BACKSLASH:
                        escaped <- true
                    elif byte == NATIVE_BYTE_DOUBLE_QUOTE:
                        in_string <- false
                elif byte == NATIVE_BYTE_DOUBLE_QUOTE:
                    in_string <- true
                elif byte == NATIVE_BYTE_LEFT_BRACE:
                    depth <- depth + NATIVE_ONE
                elif byte == NATIVE_BYTE_RIGHT_BRACE:
                    depth <- depth - NATIVE_ONE
                    return (cursor + NATIVE_ONE.usize()).i64() if depth == NATIVE_ZERO
                cursor <- cursor + NATIVE_ONE.usize()
            return NATIVE_NEGATIVE_ONE


        def json_array_end(data: darray[u8]&, start: usize, stop: usize) -> i64:
            return NATIVE_NEGATIVE_ONE if start >= stop or data[start] != NATIVE_BYTE_LEFT_BRACKET
            depth: mutable i64 = NATIVE_ZERO
            in_string: mutable bool = false
            escaped: mutable bool = false
            cursor: mutable usize = start
            while cursor < stop |cursor, depth, in_string, escaped, data|:
                byte: u8 = data[cursor]
                if in_string:
                    if escaped:
                        escaped <- false
                    elif byte == NATIVE_BYTE_BACKSLASH:
                        escaped <- true
                    elif byte == NATIVE_BYTE_DOUBLE_QUOTE:
                        in_string <- false
                elif byte == NATIVE_BYTE_DOUBLE_QUOTE:
                    in_string <- true
                elif byte == NATIVE_BYTE_LEFT_BRACKET:
                    depth <- depth + NATIVE_ONE
                elif byte == NATIVE_BYTE_RIGHT_BRACKET:
                    depth <- depth - NATIVE_ONE
                    return (cursor + NATIVE_ONE.usize()).i64() if depth == NATIVE_ZERO
                cursor <- cursor + NATIVE_ONE.usize()
            return NATIVE_NEGATIVE_ONE


        def json_hex_digit(byte: u8) -> i64:
            return (byte - NATIVE_BYTE_ASCII_ZERO).i64() if byte >= NATIVE_BYTE_ASCII_ZERO and byte <= NATIVE_BYTE_ASCII_NINE
            return (byte - NATIVE_BYTE_ASCII_UPPER_A).i64() + NATIVE_HEX_DIGIT_ALPHA_VALUE if byte >= NATIVE_BYTE_ASCII_UPPER_A and byte <= NATIVE_BYTE_ASCII_UPPER_F
            return (byte - NATIVE_BYTE_ASCII_LOWER_A).i64() + NATIVE_HEX_DIGIT_ALPHA_VALUE if byte >= NATIVE_BYTE_ASCII_LOWER_A and byte <= NATIVE_BYTE_ASCII_LOWER_F
            return NATIVE_NEGATIVE_ONE


        def json_hex_quad(data: darray[u8]&, start: usize, stop: usize) -> i64:
            return NATIVE_NEGATIVE_ONE if start + NATIVE_JSON_UNICODE_DIGITS > stop
            first: i64 = json_hex_digit(data[start])
            second: i64 = json_hex_digit(data[start + NATIVE_ONE.usize()])
            third: i64 = json_hex_digit(data[start + NATIVE_TWO.usize()])
            fourth: i64 = json_hex_digit(data[start + NATIVE_THREE.usize()])
            return NATIVE_NEGATIVE_ONE if first < NATIVE_ZERO or second < NATIVE_ZERO or third < NATIVE_ZERO or fourth < NATIVE_ZERO
            return (((first * NATIVE_HEX_BASE) + second) * NATIVE_HEX_BASE + third) * NATIVE_HEX_BASE + fourth


        def json_string_into(data: darray[u8]&, start: usize, stop: usize, destination: mutable darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate]:
            return NATIVE_NEGATIVE_ONE if start >= stop or data[start] != NATIVE_BYTE_DOUBLE_QUOTE
            cursor: mutable usize = start + NATIVE_ONE.usize()
            while cursor < stop |cursor, destination, data|:
                byte: u8 = data[cursor]
                if byte == NATIVE_BYTE_DOUBLE_QUOTE:
                    return (cursor + NATIVE_ONE.usize()).i64()
                if byte != NATIVE_BYTE_BACKSLASH:
                    destination.push(byte)
                    cursor <- cursor + NATIVE_ONE.usize()
                    continue
                cursor <- cursor + NATIVE_ONE.usize()
                return NATIVE_NEGATIVE_ONE if cursor >= stop
                escaped: u8 = data[cursor]
                if escaped == NATIVE_BYTE_DOUBLE_QUOTE or escaped == NATIVE_BYTE_BACKSLASH or escaped == NATIVE_BYTE_SLASH:
                    destination.push(escaped)
                elif escaped == NATIVE_BYTE_ESCAPE_BACKSPACE:
                    destination.push(NATIVE_BYTE_JSON_BACKSPACE)
                elif escaped == NATIVE_BYTE_ESCAPE_FORMFEED:
                    destination.push(NATIVE_BYTE_JSON_FORMFEED)
                elif escaped == NATIVE_BYTE_ESCAPE_NEWLINE:
                    destination.push(NATIVE_BYTE_NEWLINE)
                elif escaped == NATIVE_BYTE_ESCAPE_CARRIAGE_RETURN:
                    destination.push(NATIVE_BYTE_CARRIAGE_RETURN)
                elif escaped == NATIVE_BYTE_ESCAPE_TAB:
                    destination.push(NATIVE_BYTE_TAB)
                elif escaped == NATIVE_BYTE_ESCAPE_UNICODE:
                    codepoint: i64 = json_hex_quad(data, cursor + NATIVE_ONE.usize(), stop)
                    return NATIVE_NEGATIVE_ONE if codepoint < NATIVE_ZERO
                    if codepoint >= NATIVE_UNICODE_HIGH_SURROGATE_MIN and codepoint <= NATIVE_UNICODE_HIGH_SURROGATE_MAX:
                        low_start: usize = cursor + NATIVE_JSON_UNICODE_DIGITS + NATIVE_THREE.usize()
                        return NATIVE_NEGATIVE_ONE if cursor + NATIVE_JSON_UNICODE_DIGITS + NATIVE_THREE.usize() + NATIVE_JSON_UNICODE_DIGITS > stop
                        return NATIVE_NEGATIVE_ONE if data[cursor + NATIVE_JSON_UNICODE_DIGITS + NATIVE_ONE.usize()] != NATIVE_BYTE_BACKSLASH or data[cursor + NATIVE_JSON_UNICODE_DIGITS + NATIVE_TWO.usize()] != NATIVE_BYTE_ESCAPE_UNICODE
                        low: i64 = json_hex_quad(data, low_start, stop)
                        return NATIVE_NEGATIVE_ONE if low < NATIVE_UNICODE_LOW_SURROGATE_MIN or low > NATIVE_UNICODE_LOW_SURROGATE_MAX
                        codepoint <- NATIVE_UNICODE_SURROGATE_BASE + (codepoint - NATIVE_UNICODE_HIGH_SURROGATE_MIN) * NATIVE_UNICODE_SURROGATE_SHIFT + low - NATIVE_UNICODE_LOW_SURROGATE_MIN
                        cursor <- cursor + NATIVE_JSON_UNICODE_DIGITS + NATIVE_TWO.usize() + NATIVE_JSON_UNICODE_DIGITS
                    else:
                        return NATIVE_NEGATIVE_ONE if codepoint >= NATIVE_UNICODE_LOW_SURROGATE_MIN and codepoint <= NATIVE_UNICODE_LOW_SURROGATE_MAX
                        return NATIVE_NEGATIVE_ONE if codepoint > NATIVE_UNICODE_MAX
                        cursor <- cursor + NATIVE_JSON_UNICODE_DIGITS
                    if codepoint <= NATIVE_ASCII_MAX:
                        destination.push(codepoint.u8())
                    elif codepoint <= NATIVE_UTF8_TWO_BYTE_LIMIT:
                        destination.push((NATIVE_UTF8_TWO_BYTE_BASE + codepoint / NATIVE_UTF8_TWO_BYTE_DIVISOR).u8())
                        destination.push((NATIVE_UTF8_CONTINUATION_BASE + codepoint % NATIVE_UTF8_CONTINUATION_MODULUS).u8())
                    elif codepoint <= NATIVE_UTF8_THREE_BYTE_LIMIT:
                        destination.push((NATIVE_UTF8_THREE_BYTE_BASE + codepoint / NATIVE_UTF8_THREE_BYTE_DIVISOR).u8())
                        destination.push((NATIVE_UTF8_CONTINUATION_BASE + (codepoint / NATIVE_UTF8_TWO_BYTE_DIVISOR) % NATIVE_UTF8_CONTINUATION_MODULUS).u8())
                        destination.push((NATIVE_UTF8_CONTINUATION_BASE + codepoint % NATIVE_UTF8_CONTINUATION_MODULUS).u8())
                    else:
                        destination.push((NATIVE_UTF8_FOUR_BYTE_BASE + codepoint / NATIVE_UTF8_FOUR_BYTE_DIVISOR).u8())
                        destination.push((NATIVE_UTF8_CONTINUATION_BASE + (codepoint / NATIVE_UTF8_THREE_BYTE_DIVISOR) % NATIVE_UTF8_CONTINUATION_MODULUS).u8())
                        destination.push((NATIVE_UTF8_CONTINUATION_BASE + (codepoint / NATIVE_UTF8_TWO_BYTE_DIVISOR) % NATIVE_UTF8_CONTINUATION_MODULUS).u8())
                        destination.push((NATIVE_UTF8_CONTINUATION_BASE + codepoint % NATIVE_UTF8_CONTINUATION_MODULUS).u8())
                else:
                    return NATIVE_NEGATIVE_ONE
                cursor <- cursor + NATIVE_ONE.usize()
            return NATIVE_NEGATIVE_ONE


        def json_number_at(data: darray[u8]&, start: usize, stop: usize) -> i64:
            return NATIVE_NEGATIVE_ONE if start >= stop
            cursor: mutable usize = start
            return NATIVE_NEGATIVE_ONE if data[cursor] == NATIVE_BYTE_MINUS
            return NATIVE_NEGATIVE_ONE if data[cursor] < NATIVE_BYTE_ASCII_ZERO or data[cursor] > NATIVE_BYTE_ASCII_NINE
            value: mutable i64 = NATIVE_ZERO
            digits: mutable i64 = NATIVE_ZERO
            while cursor < stop |cursor, value, digits, data|:
                byte: u8 = data[cursor]
                break if byte < NATIVE_BYTE_ASCII_ZERO or byte > NATIVE_BYTE_ASCII_NINE
                digit: i64 = (byte - NATIVE_BYTE_ASCII_ZERO).i64()
                return NATIVE_NEGATIVE_ONE if value > (NATIVE_I64_MAX - digit) / NATIVE_DECIMAL_BASE
                value <- value * NATIVE_DECIMAL_BASE + digit
                digits <- digits + NATIVE_ONE
                cursor <- cursor + NATIVE_ONE.usize()
            return NATIVE_NEGATIVE_ONE if digits == NATIVE_ZERO
            return value if cursor >= stop
            if data[cursor] != NATIVE_BYTE_SPACE and data[cursor] != NATIVE_BYTE_TAB and data[cursor] != NATIVE_BYTE_NEWLINE and data[cursor] != NATIVE_BYTE_CARRIAGE_RETURN and data[cursor] != NATIVE_BYTE_COMMA and data[cursor] != NATIVE_BYTE_RIGHT_BRACE and data[cursor] != NATIVE_BYTE_RIGHT_BRACKET:
                return NATIVE_NEGATIVE_ONE
            return NATIVE_NEGATIVE_ONE if digits > NATIVE_ONE and data[start] == NATIVE_BYTE_ASCII_ZERO
            return value


        def json_millis_micros_at(data: darray[u8]&, start: usize, stop: usize) -> i64:
            return NATIVE_NEGATIVE_ONE if start >= stop
            cursor: mutable usize = start
            whole: mutable i64 = NATIVE_ZERO
            fraction: mutable i64 = NATIVE_ZERO
            fraction_digits: mutable i64 = NATIVE_ZERO
            in_fraction: mutable bool = false
            seen_digit: mutable bool = false
            while cursor < stop |cursor, whole, fraction, fraction_digits, in_fraction, seen_digit, data|:
                byte: u8 = data[cursor]
                if byte >= NATIVE_BYTE_ASCII_ZERO and byte <= NATIVE_BYTE_ASCII_NINE:
                    seen_digit <- true
                    if in_fraction:
                        if fraction_digits < NATIVE_THREE:
                            fraction <- fraction * NATIVE_DECIMAL_BASE + (byte - NATIVE_BYTE_ASCII_ZERO).i64()
                            fraction_digits <- fraction_digits + NATIVE_ONE
                    else:
                        whole <- whole * NATIVE_DECIMAL_BASE + (byte - NATIVE_BYTE_ASCII_ZERO).i64()
                elif byte == NATIVE_BYTE_PERIOD and not in_fraction:
                    in_fraction <- true
                else:
                    break
                cursor <- cursor + NATIVE_ONE.usize()
            return NATIVE_NEGATIVE_ONE if not seen_digit
            while fraction_digits < NATIVE_THREE |fraction, fraction_digits|:
                fraction <- fraction * NATIVE_DECIMAL_BASE
                fraction_digits <- fraction_digits + NATIVE_ONE
            return whole * NATIVE_MICROSECONDS_PER_MILLISECOND + fraction


        def json_bool_into(data: darray[u8]&, start: usize, stop: usize, result: mutable bool&) -> bool:
            return false if start >= stop
            if start + NATIVE_JSON_TRUE_LENGTH <= stop and data[start] == NATIVE_BYTE_ASCII_TRUE_T and data[start + NATIVE_ONE.usize()] == NATIVE_BYTE_ASCII_TRUE_R and data[start + NATIVE_TWO.usize()] == NATIVE_BYTE_ASCII_TRUE_U and data[start + NATIVE_THREE.usize()] == NATIVE_BYTE_ASCII_TRUE_E:
                result <- true
                return true
            if start + NATIVE_JSON_FALSE_LENGTH <= stop and data[start] == NATIVE_BYTE_ASCII_FALSE_F and data[start + NATIVE_ONE.usize()] == NATIVE_BYTE_ASCII_FALSE_A and data[start + NATIVE_TWO.usize()] == NATIVE_BYTE_ASCII_FALSE_L and data[start + NATIVE_THREE.usize()] == NATIVE_BYTE_ASCII_FALSE_S and data[start + NATIVE_JSON_TRUE_LENGTH] == NATIVE_BYTE_ASCII_FALSE_E:
                result <- false
                return true
            return false


        def json_source_value_start(data: darray[u8]&) -> i64 can[Abort.Panic]:
            compiler_start: i64 = json_key_value_start(data, "compiler", NATIVE_ZERO.usize(), data.count)
            return NATIVE_NEGATIVE_ONE if compiler_start < NATIVE_ZERO
            compiler_stop: i64 = json_object_end(data, compiler_start.usize(), data.count)
            return NATIVE_NEGATIVE_ONE if compiler_stop < NATIVE_ZERO
            return json_key_value_start(data, "source", compiler_stop.usize(), data.count)


        def json_read_location_timing(data: darray[u8]&, timing: mutable bool&) -> bool can[Abort.Panic]:
            run_start: i64 = json_key_value_start(data, "run", NATIVE_ZERO.usize(), data.count)
            return false if run_start < NATIVE_ZERO
            run_stop: i64 = json_object_end(data, run_start.usize(), data.count)
            return false if run_stop < NATIVE_ZERO
            value_start: i64 = json_key_value_start(data, "location_timing", run_start.usize(), run_stop.usize())
            return false if value_start < NATIVE_ZERO
            return false if data[value_start.usize()] != NATIVE_BYTE_ASCII_TRUE_T and data[value_start.usize()] != NATIVE_BYTE_ASCII_FALSE_F
            timing <- data[value_start.usize()] == NATIVE_BYTE_ASCII_TRUE_T
            return true


        def json_read_number_field(data: darray[u8]&, key: sview, start: usize, stop: usize, result: mutable i64&) -> bool can[Abort.Panic]:
            value_start: i64 = json_key_value_start(data, key, start, stop)
            return false if value_start < NATIVE_ZERO
            value: i64 = json_number_at(data, value_start.usize(), stop)
            return false if value < NATIVE_ZERO
            result <- value
            return true


        def json_read_optional_number_field(data: darray[u8]&, key: sview, start: usize, stop: usize, result: mutable i64&) -> bool can[Abort.Panic]:
            value_start: i64 = json_key_value_start(data, key, start, stop)
            return true if value_start < NATIVE_ZERO
            value: i64 = json_number_at(data, value_start.usize(), stop)
            return false if value < NATIVE_ZERO
            result <- value
            return true


        def json_read_string_field(data: darray[u8]&, key: sview, start: usize, stop: usize, result: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            value_start: i64 = json_key_value_start(data, key, start, stop)
            return false if value_start < NATIVE_ZERO
            return json_string_into(data, value_start.usize(), stop, result) >= NATIVE_ZERO


        def json_read_millis_field(data: darray[u8]&, key: sview, start: usize, stop: usize, result: mutable i64&) -> bool can[Abort.Panic]:
            value_start: i64 = json_key_value_start(data, key, start, stop)
            return false if value_start < NATIVE_ZERO
            value: i64 = json_millis_micros_at(data, value_start.usize(), stop)
            return false if value < NATIVE_ZERO
            result <- value
            return true


        def json_read_bool_field(data: darray[u8]&, key: sview, start: usize, stop: usize, result: mutable bool&) -> bool can[Abort.Panic]:
            value_start: i64 = json_key_value_start(data, key, start, stop)
            return false if value_start < NATIVE_ZERO
            return json_bool_into(data, value_start.usize(), stop, result)


        def byte_arrays_equal(left: darray[u8]&, right: darray[u8]&) -> bool can[Abort.Panic]:
            return false if left.count != right.count
            for index in 0..<left.count |left, right|:
                return false if left[index] != right[index]
            return true


        def read_comparison_capture(data: darray[u8]&, capture: mutable ComparisonCapture&) -> bool can[Abort.Panic, Memory.Allocate]:
            schema_version: mutable i64 = NATIVE_ZERO
            return false if not json_read_number_field(data, "schema_version", NATIVE_ZERO.usize(), data.count, &schema_version)
            return false if schema_version != NATIVE_REPORT_SCHEMA_VERSION
            compiler_start: i64 = json_key_value_start(data, "compiler", NATIVE_ZERO.usize(), data.count)
            summary_start: i64 = json_key_value_start(data, "summary", NATIVE_ZERO.usize(), data.count)
            run_start: i64 = json_key_value_start(data, "run", NATIVE_ZERO.usize(), data.count)
            return false if compiler_start < NATIVE_ZERO or summary_start < NATIVE_ZERO or run_start < NATIVE_ZERO
            compiler_stop: i64 = json_object_end(data, compiler_start.usize(), data.count)
            summary_stop: i64 = json_object_end(data, summary_start.usize(), data.count)
            run_stop: i64 = json_object_end(data, run_start.usize(), data.count)
            return false if compiler_stop < NATIVE_ZERO or summary_stop < NATIVE_ZERO or run_stop < NATIVE_ZERO
            source_start: i64 = json_key_value_start(data, "source", compiler_stop.usize(), data.count)
            return false if source_start < NATIVE_ZERO
            return false if json_string_into(data, source_start.usize(), data.count, &capture.source) < NATIVE_ZERO
            return false if not json_read_string_field(data, "branch", compiler_start.usize(), compiler_stop.usize(), &capture.compiler_branch)
            return false if not json_read_string_field(data, "commit", compiler_start.usize(), compiler_stop.usize(), &capture.compiler_commit)
            return false if not json_read_string_field(data, "opt_level", run_start.usize(), run_stop.usize(), &capture.opt_level)
            return false if not json_read_number_field(data, "events", summary_start.usize(), summary_stop.usize(), &capture.events)
            return false if not json_read_number_field(data, "locations", summary_start.usize(), summary_stop.usize(), &capture.locations)
            return false if not json_read_number_field(data, "dropped", summary_start.usize(), summary_stop.usize(), &capture.dropped)
            return false if not json_read_optional_number_field(data, "dropped_call_edges", summary_start.usize(), summary_stop.usize(), &capture.dropped_call_edges)
            return false if not json_read_optional_number_field(data, "dropped_stacks", summary_start.usize(), summary_stop.usize(), &capture.dropped_stacks)
            return false if not json_read_number_field(data, "stack_overflow_entries", summary_start.usize(), summary_stop.usize(), &capture.stack_overflow_entries)
            return false if not json_read_number_field(data, "thread_count", summary_start.usize(), summary_stop.usize(), &capture.thread_count)
            return false if not json_read_number_field(data, "trace_events_omitted", summary_start.usize(), summary_stop.usize(), &capture.trace_events_omitted)
            return false if not json_read_bool_field(data, "detail_budget_exceeded", summary_start.usize(), summary_stop.usize(), &capture.detail_budget_exceeded)
            return false if not json_read_millis_field(data, "execution_ms_mean", run_start.usize(), run_stop.usize(), &capture.execution_mean_micros)
            return false if not json_read_millis_field(data, "compile_ms", run_start.usize(), run_stop.usize(), &capture.compile_micros)
            return false if not json_read_number_field(data, "exit_code", run_start.usize(), run_stop.usize(), &capture.exit_code)
            return true


        def json_read_stacks_to_folded(data: darray[u8]&, folded: mutable darray[u8]&, location_timing: bool) -> bool can[Abort.Panic, Memory.Allocate]:
            array_start: i64 = json_key_value_start(data, "stacks", NATIVE_ZERO.usize(), data.count)
            return false if array_start < NATIVE_ZERO or data[array_start.usize()] != NATIVE_BYTE_LEFT_BRACKET
            array_stop: i64 = json_array_end(data, array_start.usize(), data.count)
            return false if array_stop < NATIVE_ZERO
            cursor: mutable usize = array_start.usize() + NATIVE_ONE.usize()
            stop: usize = array_stop.usize() - NATIVE_ONE.usize()
            while cursor < stop |cursor, stop, data, folded, location_timing|:
                cursor <- json_skip_whitespace(data, cursor, stop)
                break if cursor >= stop or data[cursor] == NATIVE_BYTE_RIGHT_BRACKET
                return false if data[cursor] != NATIVE_BYTE_LEFT_BRACE
                object_stop: i64 = json_object_end(data, cursor, stop)
                return false if object_stop < NATIVE_ZERO
                stack_start: i64 = json_key_value_start(data, "stack", cursor, object_stop.usize())
                calls_start: i64 = json_key_value_start(data, "call_events", cursor, object_stop.usize())
                self_start: i64 = json_key_value_start(data, "self_ns", cursor, object_stop.usize())
                return false if stack_start < NATIVE_ZERO or calls_start < NATIVE_ZERO or self_start < NATIVE_ZERO
                stack_value: mutable darray[u8] = []
                return false if json_string_into(data, stack_start.usize(), object_stop.usize(), &stack_value) < NATIVE_ZERO
                calls: i64 = json_number_at(data, calls_start.usize(), object_stop.usize())
                self_ns: i64 = json_number_at(data, self_start.usize(), object_stop.usize())
                return false if calls < NATIVE_ZERO or self_ns < NATIVE_ZERO
                weight: i64 = self_ns if location_timing else calls
                if weight > NATIVE_ZERO:
                    append_folded_separator(folded)
                    folded.extend(stack_value)
                    folded.push(NATIVE_BYTE_SPACE)
                    append_i64(folded, weight)
                cursor <- object_stop.usize()
                cursor <- cursor + NATIVE_ONE.usize() if cursor < stop and data[cursor] == NATIVE_BYTE_COMMA
            return true


        def append_offline_folded_report(buffer: mutable darray[u8]&, data: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            timing: mutable bool = false
            return false if not json_read_location_timing(data, &timing)
            return false if not json_read_stacks_to_folded(data, buffer, timing)
            buffer.push(NATIVE_BYTE_NEWLINE) if buffer.count > NATIVE_ZERO.usize()
            return true


        def append_offline_speedscope_report(buffer: mutable darray[u8]&, data: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            source: mutable darray[u8] = []
            timing: mutable bool = false
            source_start: i64 = json_source_value_start(data)
            return false if source_start < NATIVE_ZERO
            return false if json_string_into(data, source_start.usize(), data.count, &source) < NATIVE_ZERO
            return false if not json_read_location_timing(data, &timing)
            folded: mutable darray[u8] = []
            return false if not json_read_stacks_to_folded(data, &folded, timing)
            append_speedscope_report(buffer, source, folded, timing)
            return true


        def append_offline_html_report(buffer: mutable darray[u8]&, data: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            source: mutable darray[u8] = []
            source_start: i64 = json_source_value_start(data)
            return false if source_start < NATIVE_ZERO
            return false if json_string_into(data, source_start.usize(), data.count, &source) < NATIVE_ZERO
            summary_start: i64 = json_key_value_start(data, "summary", NATIVE_ZERO.usize(), data.count)
            run_start: i64 = json_key_value_start(data, "run", NATIVE_ZERO.usize(), data.count)
            return false if summary_start < NATIVE_ZERO or run_start < NATIVE_ZERO
            summary_stop: i64 = json_object_end(data, summary_start.usize(), data.count)
            run_stop: i64 = json_object_end(data, run_start.usize(), data.count)
            return false if summary_stop < NATIVE_ZERO or run_stop < NATIVE_ZERO
            events: mutable i64 = NATIVE_ZERO
            locations: mutable i64 = NATIVE_ZERO
            dropped: mutable i64 = NATIVE_ZERO
            thread_count: mutable i64 = NATIVE_ZERO
            exit_code: mutable i64 = NATIVE_ZERO
            return false if not json_read_number_field(data, "events", summary_start.usize(), summary_stop.usize(), &events)
            return false if not json_read_number_field(data, "locations", summary_start.usize(), summary_stop.usize(), &locations)
            return false if not json_read_number_field(data, "dropped", summary_start.usize(), summary_stop.usize(), &dropped)
            return false if not json_read_number_field(data, "thread_count", summary_start.usize(), summary_stop.usize(), &thread_count)
            return false if not json_read_number_field(data, "exit_code", run_start.usize(), run_stop.usize(), &exit_code)
            timing: mutable bool = false
            return false if not json_read_location_timing(data, &timing)
            folded: mutable darray[u8] = []
            return false if not json_read_stacks_to_folded(data, &folded, timing)
            append_text(buffer, "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Elisa profile</title><style>body{font:15px system-ui,sans-serif;line-height:1.45;max-width:1120px;margin:2rem auto;padding:0 1rem;color:#17202a;background:#f6f8fa}main{background:white;border:1px solid #d0d7de;border-radius:12px;padding:1.5rem;box-shadow:0 4px 20px #0001}code,pre{font:13px ui-monospace,SFMono-Regular,Menlo,monospace}dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.75rem}dl div{padding:.8rem;background:#f6f8fa;border-radius:8px}dt{color:#57606a;font-size:.8rem}dd{margin:.2rem 0 0;font-weight:650}details{margin-top:1rem;border:1px solid #d8dee4;border-radius:8px;padding:.75rem}summary{cursor:pointer;font-weight:650}pre{overflow:auto;white-space:pre-wrap;word-break:break-word;margin:.75rem 0 0}@media(prefers-color-scheme:dark){body{color:#e6edf3;background:#0d1117}main{background:#161b22;border-color:#30363d}dl div{background:#21262d}details{border-color:#30363d}dt{color:#8b949e}}</style></head><body><main><h1>Elisa profile</h1><p>Native Elisa offline renderer; records are escaped and shown as inspectable detail.</p><p><strong>Source:</strong> <code>")
            append_html_escaped(buffer, source)
            append_text(buffer, "</code></p><dl><div><dt>Status</dt><dd>")
            append_text(buffer, "ok" if exit_code == NATIVE_ZERO else "target failed")
            append_text(buffer, "</dd></div><div><dt>Events</dt><dd>")
            append_i64(buffer, events)
            append_text(buffer, "</dd></div><div><dt>Locations</dt><dd>")
            append_i64(buffer, locations)
            append_text(buffer, "</dd></div><div><dt>Dropped events</dt><dd>")
            append_i64(buffer, dropped)
            append_text(buffer, "</dd></div><div><dt>Threads</dt><dd>")
            append_i64(buffer, thread_count)
            append_text(buffer, "</dd></div></dl>")
            append_html_section(buffer, "Folded stacks", folded)
            append_text(buffer, "</main></body></html>\n")
            return true


        def append_offline_text_report(buffer: mutable darray[u8]&, data: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            source: mutable darray[u8] = []
            source_start: i64 = json_source_value_start(data)
            return false if source_start < NATIVE_ZERO
            return false if json_string_into(data, source_start.usize(), data.count, &source) < NATIVE_ZERO
            summary_start: i64 = json_key_value_start(data, "summary", NATIVE_ZERO.usize(), data.count)
            run_start: i64 = json_key_value_start(data, "run", NATIVE_ZERO.usize(), data.count)
            return false if summary_start < NATIVE_ZERO or run_start < NATIVE_ZERO
            summary_stop: i64 = json_object_end(data, summary_start.usize(), data.count)
            run_stop: i64 = json_object_end(data, run_start.usize(), data.count)
            return false if summary_stop < NATIVE_ZERO or run_stop < NATIVE_ZERO
            events: mutable i64 = NATIVE_ZERO
            locations: mutable i64 = NATIVE_ZERO
            statement_events: mutable i64 = NATIVE_ZERO
            value_events: mutable i64 = NATIVE_ZERO
            function_events: mutable i64 = NATIVE_ZERO
            dropped: mutable i64 = NATIVE_ZERO
            thread_count: mutable i64 = NATIVE_ZERO
            exit_code: mutable i64 = NATIVE_ZERO
            return false if not json_read_number_field(data, "events", summary_start.usize(), summary_stop.usize(), &events)
            return false if not json_read_number_field(data, "locations", summary_start.usize(), summary_stop.usize(), &locations)
            return false if not json_read_number_field(data, "statement_events", summary_start.usize(), summary_stop.usize(), &statement_events)
            return false if not json_read_number_field(data, "value_events", summary_start.usize(), summary_stop.usize(), &value_events)
            return false if not json_read_number_field(data, "function_events", summary_start.usize(), summary_stop.usize(), &function_events)
            return false if not json_read_number_field(data, "dropped", summary_start.usize(), summary_stop.usize(), &dropped)
            return false if not json_read_number_field(data, "thread_count", summary_start.usize(), summary_stop.usize(), &thread_count)
            return false if not json_read_number_field(data, "exit_code", run_start.usize(), run_stop.usize(), &exit_code)
            append_text(buffer, "Elisa profiler\nsource: ")
            for index in 0..<source.count |buffer, source|:
                buffer.push(source[index])
            append_text(buffer, "\nstatus: ")
            append_text(buffer, "ok\n" if exit_code == NATIVE_ZERO else "target failed\n")
            append_text(buffer, "events: ")
            append_i64(buffer, events)
            append_text(buffer, "\nlocations: ")
            append_i64(buffer, locations)
            append_text(buffer, "\nstatement events: ")
            append_i64(buffer, statement_events)
            append_text(buffer, "\nvalue events: ")
            append_i64(buffer, value_events)
            append_text(buffer, "\nfunction events: ")
            append_i64(buffer, function_events)
            append_text(buffer, "\nthreads: ")
            append_i64(buffer, thread_count)
            append_text(buffer, "\ndropped: ")
            append_i64(buffer, dropped)
            append_text(buffer, "\n")
            return true


        def append_comparison_warning_json(buffer: mutable darray[u8]&, warning: sview, include: bool, first: mutable bool&) -> i64 can[Abort.Panic, Memory.Allocate]:
            return NATIVE_ZERO if not include
            buffer.push(NATIVE_BYTE_COMMA) if not first
            warning_value: mutable darray[u8] = []
            append_text(warning_value, warning)
            append_json_string(buffer, warning_value)
            first <- false
            return NATIVE_ONE


        def append_comparison_warning_text(buffer: mutable darray[u8]&, warning: sview, include: bool) -> void can[Abort.Panic, Memory.Allocate]:
            return if not include
            append_text(buffer, "  - ")
            append_text(buffer, warning)
            append_text(buffer, "\n")


        def append_comparison_report(
            buffer: mutable darray[u8]&, baseline_path: darray[u8]&, candidate_path: darray[u8]&, baseline: ComparisonCapture, candidate: ComparisonCapture, format_json: bool
        ) -> void can[Abort.Panic, Memory.Allocate]:
            source_mismatch: bool = not byte_arrays_equal(baseline.source, candidate.source)
            compiler_mismatch: bool = not byte_arrays_equal(baseline.compiler_commit, candidate.compiler_commit)
            optimization_mismatch: bool = not byte_arrays_equal(baseline.opt_level, candidate.opt_level)
            target_failure: bool = baseline.exit_code != NATIVE_ZERO or candidate.exit_code != NATIVE_ZERO
            evidence_loss: bool = baseline.dropped > NATIVE_ZERO or candidate.dropped > NATIVE_ZERO or baseline.dropped_call_edges > NATIVE_ZERO or candidate.dropped_call_edges > NATIVE_ZERO or baseline.dropped_stacks > NATIVE_ZERO or candidate.dropped_stacks > NATIVE_ZERO or baseline.stack_overflow_entries > NATIVE_ZERO or candidate.stack_overflow_entries > NATIVE_ZERO or baseline.trace_events_omitted > NATIVE_ZERO or candidate.trace_events_omitted > NATIVE_ZERO or baseline.detail_budget_exceeded or candidate.detail_budget_exceeded
            if not format_json:
                append_text(buffer, "Elisa profile comparison\n")
                append_text(buffer, "baseline: ")
                for index in 0..<baseline_path.count |buffer, baseline_path|:
                    buffer.push(baseline_path[index])
                append_text(buffer, "\ncandidate: ")
                for index in 0..<candidate_path.count |buffer, candidate_path|:
                    buffer.push(candidate_path[index])
                append_text(buffer, "\nsource: ")
                append_text(buffer, "same\n" if not source_mismatch else "different\n")
                append_text(buffer, "compiler commit: ")
                append_text(buffer, "same\n" if not compiler_mismatch else "different\n")
                append_text(buffer, "optimization: ")
                append_text(buffer, "same\n" if not optimization_mismatch else "different\n")
                append_text(buffer, "wall mean: baseline=")
                append_micros_as_millis(buffer, baseline.execution_mean_micros)
                append_text(buffer, " ms candidate=")
                append_micros_as_millis(buffer, candidate.execution_mean_micros)
                append_text(buffer, " ms\ncompile: baseline=")
                append_micros_as_millis(buffer, baseline.compile_micros)
                append_text(buffer, " ms candidate=")
                append_micros_as_millis(buffer, candidate.compile_micros)
                append_text(buffer, " ms\nevents: baseline=")
                append_i64(buffer, baseline.events)
                append_text(buffer, " candidate=")
                append_i64(buffer, candidate.events)
                append_text(buffer, " delta=")
                append_i64(buffer, candidate.events - baseline.events)
                append_text(buffer, "\nlocations: baseline=")
                append_i64(buffer, baseline.locations)
                append_text(buffer, " candidate=")
                append_i64(buffer, candidate.locations)
                append_text(buffer, "\nthreads: baseline=")
                append_i64(buffer, baseline.thread_count)
                append_text(buffer, " candidate=")
                append_i64(buffer, candidate.thread_count)
                append_text(buffer, "\ndropped events: baseline=")
                append_i64(buffer, baseline.dropped)
                append_text(buffer, " candidate=")
                append_i64(buffer, candidate.dropped)
                append_text(buffer, "\nstack overflow entries: baseline=")
                append_i64(buffer, baseline.stack_overflow_entries)
                append_text(buffer, " candidate=")
                append_i64(buffer, candidate.stack_overflow_entries)
                append_text(buffer, "\n")
                if source_mismatch or compiler_mismatch or optimization_mismatch or target_failure or evidence_loss:
                    append_text(buffer, "warnings:\n")
                    append_comparison_warning_text(buffer, "baseline and candidate use different source paths or contents", source_mismatch)
                    append_comparison_warning_text(buffer, "baseline and candidate use different compiler commits", compiler_mismatch)
                    append_comparison_warning_text(buffer, "baseline and candidate use different optimization levels", optimization_mismatch)
                    append_comparison_warning_text(buffer, "baseline or candidate target execution failed", target_failure)
                    append_comparison_warning_text(buffer, "one or both captures contain incomplete or bounded evidence", evidence_loss)
                return
            append_text(buffer, "{\"kind\":\"profile_comparison\",\"schema_version\":")
            append_i64(buffer, NATIVE_REPORT_SCHEMA_VERSION)
            append_text(buffer, ",\"baseline\":{\"path\":")
            append_json_string(buffer, baseline_path)
            append_text(buffer, ",\"source\":")
            append_json_string(buffer, baseline.source)
            append_text(buffer, ",\"compiler_commit\":")
            append_json_string(buffer, baseline.compiler_commit)
            append_text(buffer, ",\"opt_level\":")
            append_json_string(buffer, baseline.opt_level)
            append_text(buffer, ",\"exit_code\":")
            append_i64(buffer, baseline.exit_code)
            append_text(buffer, "},\"candidate\":{\"path\":")
            append_json_string(buffer, candidate_path)
            append_text(buffer, ",\"source\":")
            append_json_string(buffer, candidate.source)
            append_text(buffer, ",\"compiler_commit\":")
            append_json_string(buffer, candidate.compiler_commit)
            append_text(buffer, ",\"opt_level\":")
            append_json_string(buffer, candidate.opt_level)
            append_text(buffer, ",\"exit_code\":")
            append_i64(buffer, candidate.exit_code)
            append_text(buffer, "},\"metrics\":{\"execution_ms_mean\":{\"baseline\":")
            append_micros_as_millis(buffer, baseline.execution_mean_micros)
            append_text(buffer, ",\"candidate\":")
            append_micros_as_millis(buffer, candidate.execution_mean_micros)
            append_text(buffer, ",\"delta_micros\":")
            append_i64(buffer, candidate.execution_mean_micros - baseline.execution_mean_micros)
            append_text(buffer, "},\"compile_ms\":{\"baseline\":")
            append_micros_as_millis(buffer, baseline.compile_micros)
            append_text(buffer, ",\"candidate\":")
            append_micros_as_millis(buffer, candidate.compile_micros)
            append_text(buffer, ",\"delta_micros\":")
            append_i64(buffer, candidate.compile_micros - baseline.compile_micros)
            append_text(buffer, "},\"events\":{\"baseline\":")
            append_i64(buffer, baseline.events)
            append_text(buffer, ",\"candidate\":")
            append_i64(buffer, candidate.events)
            append_text(buffer, ",\"delta\":")
            append_i64(buffer, candidate.events - baseline.events)
            append_text(buffer, "},\"locations\":{\"baseline\":")
            append_i64(buffer, baseline.locations)
            append_text(buffer, ",\"candidate\":")
            append_i64(buffer, candidate.locations)
            append_text(buffer, ",\"delta\":")
            append_i64(buffer, candidate.locations - baseline.locations)
            append_text(buffer, "},\"dropped_events\":{\"baseline\":")
            append_i64(buffer, baseline.dropped)
            append_text(buffer, ",\"candidate\":")
            append_i64(buffer, candidate.dropped)
            append_text(buffer, ",\"delta\":")
            append_i64(buffer, candidate.dropped - baseline.dropped)
            append_text(buffer, "},\"thread_count\":{\"baseline\":")
            append_i64(buffer, baseline.thread_count)
            append_text(buffer, ",\"candidate\":")
            append_i64(buffer, candidate.thread_count)
            append_text(buffer, ",\"delta\":")
            append_i64(buffer, candidate.thread_count - baseline.thread_count)
            append_text(buffer, "},\"stack_overflow_entries\":{\"baseline\":")
            append_i64(buffer, baseline.stack_overflow_entries)
            append_text(buffer, ",\"candidate\":")
            append_i64(buffer, candidate.stack_overflow_entries)
            append_text(buffer, ",\"delta\":")
            append_i64(buffer, candidate.stack_overflow_entries - baseline.stack_overflow_entries)
            append_text(buffer, "},\"trace_events_omitted\":{\"baseline\":")
            append_i64(buffer, baseline.trace_events_omitted)
            append_text(buffer, ",\"candidate\":")
            append_i64(buffer, candidate.trace_events_omitted)
            append_text(buffer, ",\"delta\":")
            append_i64(buffer, candidate.trace_events_omitted - baseline.trace_events_omitted)
            append_text(buffer, "}},\"warnings\":[")
            warning_first: mutable bool = true
            warning_count: mutable i64 = NATIVE_ZERO
            warning_count <- warning_count + append_comparison_warning_json(buffer, "baseline and candidate use different source paths or contents", source_mismatch, &warning_first)
            warning_count <- warning_count + append_comparison_warning_json(buffer, "baseline and candidate use different compiler commits", compiler_mismatch, &warning_first)
            warning_count <- warning_count + append_comparison_warning_json(buffer, "baseline and candidate use different optimization levels", optimization_mismatch, &warning_first)
            warning_count <- warning_count + append_comparison_warning_json(buffer, "baseline or candidate target execution failed", target_failure, &warning_first)
            warning_count <- warning_count + append_comparison_warning_json(buffer, "one or both captures contain incomplete or bounded evidence", evidence_loss, &warning_first)
            append_text(buffer, "],\"status\":\"")
            append_text(buffer, "warning" if warning_count > NATIVE_ZERO else "ok")
            append_text(buffer, "\"}\n")


        def compare_offline(argc: i64, slots: mutable cstr&&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            return report_error("usage: elisa-profiler compare BASELINE CANDIDATE [--format text|json] [--output PATH]") if argc < NATIVE_MIN_COMPARE_ARGUMENTS
            baseline_path: mutable darray[u8] = []
            candidate_path: mutable darray[u8] = []
            output_path: mutable darray[u8] = []
            copy_cstr(baseline_path, slots[NATIVE_COMPARE_BASELINE_INDEX].cast[cstr])
            copy_cstr(candidate_path, slots[NATIVE_COMPARE_CANDIDATE_INDEX].cast[cstr])
            format_json: mutable bool = false
            index: mutable i64 = NATIVE_COMPARE_FIRST_OPTION_INDEX
            while index < argc |index, slots, output_path, format_json|:
                argument: cstr = slots[index].cast[cstr]
                if profiler_ffi_strcmp(argument, "--format") == NATIVE_ZERO:
                    return report_error("--format requires text or json") if index + NATIVE_ONE >= argc
                    if profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "json") == NATIVE_ZERO:
                        format_json <- true
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "text") == NATIVE_ZERO:
                        format_json <- false
                    else:
                        return report_error("--format requires text or json")
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--output") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "-o") == NATIVE_ZERO:
                    return report_error("--output requires a path") if index + NATIVE_ONE >= argc
                    copy_cstr(output_path, slots[index + NATIVE_ONE].cast[cstr])
                    index <- index + NATIVE_TWO
                    continue
                return report_error("unknown compare option")
            baseline_data: darray[u8] = read_file(baseline_path)
            candidate_data: darray[u8] = read_file(candidate_path)
            return report_error("baseline capture could not be read") if baseline_data.count == NATIVE_ZERO.usize()
            return report_error("candidate capture could not be read") if candidate_data.count == NATIVE_ZERO.usize()
            baseline_capture: mutable darray[u8] = []
            candidate_capture: mutable darray[u8] = []
            return report_error("baseline artifact is malformed or unsupported") if not unwrap_profile_artifact(baseline_data, &baseline_capture)
            return report_error("candidate artifact is malformed or unsupported") if not unwrap_profile_artifact(candidate_data, &candidate_capture)
            baseline: mutable ComparisonCapture = ComparisonCapture{
                source: [], compiler_branch: [], compiler_commit: [], opt_level: [], events: NATIVE_ZERO, locations: NATIVE_ZERO,
                dropped: NATIVE_ZERO, dropped_call_edges: NATIVE_ZERO, dropped_stacks: NATIVE_ZERO, stack_overflow_entries: NATIVE_ZERO, thread_count: NATIVE_ZERO, trace_events_omitted: NATIVE_ZERO,
                execution_mean_micros: NATIVE_ZERO, compile_micros: NATIVE_ZERO, exit_code: NATIVE_ZERO, detail_budget_exceeded: false
            }
            candidate: mutable ComparisonCapture = ComparisonCapture{
                source: [], compiler_branch: [], compiler_commit: [], opt_level: [], events: NATIVE_ZERO, locations: NATIVE_ZERO,
                dropped: NATIVE_ZERO, dropped_call_edges: NATIVE_ZERO, dropped_stacks: NATIVE_ZERO, stack_overflow_entries: NATIVE_ZERO, thread_count: NATIVE_ZERO, trace_events_omitted: NATIVE_ZERO,
                execution_mean_micros: NATIVE_ZERO, compile_micros: NATIVE_ZERO, exit_code: NATIVE_ZERO, detail_budget_exceeded: false
            }
            return report_error("baseline capture is not a supported native JSON profile") if not read_comparison_capture(baseline_capture, &baseline)
            return report_error("candidate capture is not a supported native JSON profile") if not read_comparison_capture(candidate_capture, &candidate)
            rendered: mutable darray[u8] = []
            append_comparison_report(&rendered, baseline_path, candidate_path, baseline, candidate, format_json)
            if output_path.count > NATIVE_ZERO.usize():
                return NATIVE_ZERO if write_file(output_path, rendered)
                return report_error("could not write native comparison report")
            _ = profiler_ffi_write(NATIVE_STANDARD_OUTPUT, &rendered[0], rendered.count) can Console
            return NATIVE_ZERO


        def append_html_section(buffer: mutable darray[u8]&, title: sview, records: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<details open><summary>")
            append_text(buffer, title)
            append_text(buffer, "</summary><pre>")
            append_html_escaped(buffer, records)
            append_text(buffer, "</pre></details>")


        def append_html_report(buffer: mutable darray[u8]&, source: darray[u8]&, summary: CaptureSummary, exit_code: i64, execution_ns: i64, compile_ns: i64) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Elisa profile</title><style>body{font:15px system-ui,sans-serif;line-height:1.45;max-width:1120px;margin:2rem auto;padding:0 1rem;color:#17202a;background:#f6f8fa}main{background:white;border:1px solid #d0d7de;border-radius:12px;padding:1.5rem;box-shadow:0 4px 20px #0001}h1{margin-top:0}code,pre{font:13px ui-monospace,SFMono-Regular,Menlo,monospace}dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.75rem}dl div{padding:.8rem;background:#f6f8fa;border-radius:8px}dt{color:#57606a;font-size:.8rem}dd{margin:.2rem 0 0;font-weight:650}details{margin-top:1rem;border:1px solid #d8dee4;border-radius:8px;padding:.75rem}summary{cursor:pointer;font-weight:650}pre{overflow:auto;white-space:pre-wrap;word-break:break-word;margin:.75rem 0 0}@media(prefers-color-scheme:dark){body{color:#e6edf3;background:#0d1117}main{background:#161b22;border-color:#30363d}dl div{background:#21262d}details{border-color:#30363d}dt{color:#8b949e}}</style></head><body><main><h1>Elisa profile</h1><p>Native Elisa renderer; records are escaped and shown as inspectable detail.</p><p><strong>Source:</strong> <code>")
            append_html_escaped(buffer, source)
            append_text(buffer, "</code></p><dl><div><dt>Status</dt><dd>")
            append_text(buffer, "ok" if exit_code == NATIVE_ZERO else "target failed")
            append_text(buffer, "</dd></div><div><dt>Execution</dt><dd>")
            append_millis(buffer, execution_ns)
            append_text(buffer, " ms</dd></div><div><dt>Compilation</dt><dd>")
            append_millis(buffer, compile_ns)
            append_text(buffer, " ms</dd></div><div><dt>Events</dt><dd>")
            append_i64(buffer, summary.events)
            append_text(buffer, "</dd></div><div><dt>Locations</dt><dd>")
            append_i64(buffer, summary.locations)
            append_text(buffer, "</dd></div><div><dt>Dropped events</dt><dd>")
            append_i64(buffer, summary.dropped)
            append_text(buffer, "</dd></div><div><dt>Detail budget</dt><dd>")
            append_text(buffer, "exceeded" if summary.budget_exceeded != NATIVE_ZERO else "not exceeded")
            append_text(buffer, "</dd></div><div><dt>Threads</dt><dd>")
            append_i64(buffer, summary.thread_count)
            append_text(buffer, "</dd></div></dl>")
            append_html_section(buffer, "Functions", summary.function_records)
            append_html_section(buffer, "Call edges", summary.call_edge_records)
            append_html_section(buffer, "Folded stacks", summary.stack_records)
            append_html_section(buffer, "Locations", summary.location_records)
            append_text(buffer, "</main></body></html>\n")


        def append_report(
            buffer: mutable darray[u8]&, source: darray[u8]&, compiler_root: darray[u8]&, compiler_branch: darray[u8]&, compiler_commit: darray[u8]&, compiler_dirty: bool, runtime_object: darray[u8]&, summary: CaptureSummary,
            exit_code: i64, status: i64, opt_level: i64, event_trace: bool, recent_path: bool, program_stderr: darray[u8]&, execution_ns: i64, compile_ns: i64,
            repetition_records: darray[u8]&, requested_repetitions: i64, completed_repetitions: i64, successful_repetitions: i64, failed_repetitions: i64,
            warmup_repetitions: i64, warmup_ns: i64, execution_min_ns: i64, execution_mean_ns: i64, execution_max_ns: i64, execution_median_ns: i64, execution_stdev_ns: i64
        ) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "{\"schema_version\":")
            append_i64(buffer, NATIVE_REPORT_SCHEMA_VERSION)
            append_text(buffer, ",\"source\":")
            append_json_string(buffer, source)
            append_text(buffer, ",\"compiler\":{\"root\":")
            append_json_string(buffer, compiler_root)
            append_text(buffer, ",\"branch\":")
            append_json_string(buffer, compiler_branch)
            append_text(buffer, ",\"commit\":")
            append_json_string(buffer, compiler_commit)
            append_text(buffer, ",\"dirty\":")
            append_text(buffer, "true" if compiler_dirty else "false")
            append_text(buffer, ",\"runtime_object\":")
            append_json_string(buffer, runtime_object)
            append_text(buffer, "},\"summary\":{\"events\":")
            append_i64(buffer, summary.events)
            append_text(buffer, ",\"locations\":")
            append_i64(buffer, summary.locations)
            append_text(buffer, ",\"dropped\":")
            append_i64(buffer, summary.dropped)
            append_text(buffer, ",\"statement_events\":")
            append_i64(buffer, summary.statement_events)
            append_text(buffer, ",\"value_events\":")
            append_i64(buffer, summary.value_events)
            append_text(buffer, ",\"function_events\":")
            append_i64(buffer, summary.function_events)
            append_text(buffer, ",\"max_stack_depth\":")
            append_i64(buffer, summary.max_stack_depth)
            append_text(buffer, ",\"stack_overflow_entries\":")
            append_i64(buffer, summary.stack_overflow_entries)
            append_text(buffer, ",\"location_limit\":")
            append_i64(buffer, summary.location_limit)
            append_text(buffer, ",\"call_edge_limit\":")
            append_i64(buffer, summary.call_edge_limit)
            append_text(buffer, ",\"stack_limit\":")
            append_i64(buffer, summary.stack_limit)
            append_text(buffer, ",\"capture_byte_limit\":")
            append_i64(buffer, summary.capture_byte_limit)
            append_text(buffer, ",\"capture_bytes_used\":")
            append_i64(buffer, summary.capture_bytes_used)
            append_text(buffer, ",\"capture_bytes_dropped\":")
            append_i64(buffer, summary.capture_bytes_dropped)
            append_text(buffer, ",\"detail_budget_exceeded\":")
            append_text(buffer, "true" if summary.budget_exceeded != NATIVE_ZERO else "false")
            append_text(buffer, ",\"dropped_call_edges\":")
            append_i64(buffer, summary.call_edge_dropped)
            append_text(buffer, ",\"dropped_stacks\":")
            append_i64(buffer, summary.stack_dropped)
            append_text(buffer, ",\"crash_signal\":")
            if summary.crash_signal > NATIVE_ZERO:
                append_i64(buffer, summary.crash_signal)
            else:
                append_text(buffer, "null")
            append_text(buffer, ",\"thread_count\":")
            append_i64(buffer, summary.thread_count)
            append_text(buffer, ",\"trace_events_captured\":")
            append_i64(buffer, summary.trace_captured)
            append_text(buffer, ",\"trace_events_omitted\":")
            append_i64(buffer, summary.trace_omitted)
            append_text(buffer, ",\"trace_event_limit\":")
            if not event_trace:
                append_text(buffer, "null")
            else:
                append_i64(buffer, summary.trace_limit)
            append_text(buffer, ",\"trace_complete\":")
            if not event_trace:
                append_text(buffer, "null")
            else:
                append_text(buffer, "true" if summary.trace_omitted == NATIVE_ZERO and summary.trace_captured == summary.events else "false")
            append_text(buffer, "},")
            append_quality(buffer, summary, status, event_trace)
            append_text(buffer, ",\"source_mapping\":{\"mode\":\"native-summary\",\"mapped_locations\":")
            append_i64(buffer, NATIVE_ZERO)
            append_text(buffer, ",\"unmapped_locations\":")
            append_i64(buffer, summary.locations)
            append_text(buffer, "},\"run\":{\"exit_code\":")
            append_i64(buffer, exit_code)
            append_text(buffer, ",\"signal\":")
            append_observed_signal(buffer, status, summary)
            append_text(buffer, ",\"location_timing\":true,\"timing_clock\":\"wall\",\"event_trace_enabled\":")
            append_text(buffer, "true" if event_trace else "false")
            append_text(buffer, ",\"trace_events_captured\":")
            append_i64(buffer, summary.trace_captured)
            append_text(buffer, ",\"trace_events_omitted\":")
            append_i64(buffer, summary.trace_omitted)
            append_text(buffer, ",\"trace_event_limit\":")
            if not event_trace:
                append_text(buffer, "null")
            else:
                append_i64(buffer, summary.trace_limit)
            append_text(buffer, ",\"trace_complete\":")
            if not event_trace:
                append_text(buffer, "null")
            else:
                append_text(buffer, "true" if summary.trace_omitted == NATIVE_ZERO and summary.trace_captured == summary.events else "false")
            append_text(buffer, ",\"opt_level\":\"-O")
            append_i64(buffer, opt_level)
            append_text(buffer, "\",\"execution_ms\":")
            append_millis(buffer, execution_ns)
            append_text(buffer, ",\"timeout_s\":null,\"execution_ms_min\":")
            append_millis(buffer, execution_min_ns)
            append_text(buffer, ",\"execution_ms_mean\":")
            append_millis(buffer, execution_mean_ns)
            append_text(buffer, ",\"execution_ms_max\":")
            append_millis(buffer, execution_max_ns)
            append_text(buffer, ",\"execution_ms_median\":")
            append_millis(buffer, execution_median_ns)
            append_text(buffer, ",\"execution_ms_stdev\":")
            append_millis(buffer, execution_stdev_ns)
            append_text(buffer, ",\"cpu_user_ms\":null,\"cpu_system_ms\":null,\"cpu_ms\":null,\"peak_rss_bytes\":null,\"warmup_ms\":")
            append_millis(buffer, warmup_ns)
            append_text(buffer, ",\"warmup_repetitions\":")
            append_i64(buffer, warmup_repetitions)
            append_text(buffer, ",\"requested_repetitions\":")
            append_i64(buffer, requested_repetitions)
            append_text(buffer, ",\"completed_repetitions\":")
            append_i64(buffer, completed_repetitions)
            append_text(buffer, ",\"successful_repetitions\":")
            append_i64(buffer, successful_repetitions)
            append_text(buffer, ",\"failed_repetitions\":")
            append_i64(buffer, failed_repetitions)
            append_text(buffer, ",\"measurement_repetitions\":")
            append_i64(buffer, successful_repetitions if successful_repetitions > NATIVE_ZERO else completed_repetitions)
            append_text(buffer, ",\"measurement_basis\":\"")
            append_text(buffer, "successful" if successful_repetitions > NATIVE_ZERO else "all_completed")
            append_text(buffer, "\",\"repetitions\":[")
            buffer.extend(repetition_records)
            append_text(buffer, "],\"compile_ms\":")
            append_millis(buffer, compile_ns)
            append_text(buffer, "},")
            append_detail_arrays(buffer, summary)
            if program_stderr.count > NATIVE_ZERO.usize():
                append_text(buffer, ",\"program_stderr\":")
                append_json_string(buffer, program_stderr)
            append_text(buffer, "}\n")


        def append_text_report(buffer: mutable darray[u8]&, source: darray[u8]&, summary: CaptureSummary, exit_code: i64, event_trace: bool, recent_path: bool, execution_ns: i64, compile_ns: i64) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "Elisa profiler\nsource: ")
            for index in 0..<source.count |buffer, source|:
                buffer.push(source[index])
            append_text(buffer, "\nstatus: ")
            append_text(buffer, "ok\n" if exit_code == NATIVE_ZERO else "target failed\n")
            append_text(buffer, "events: ")
            append_i64(buffer, summary.events)
            append_text(buffer, "\nlocations: ")
            append_i64(buffer, summary.locations)
            append_text(buffer, "\nstatement events: ")
            append_i64(buffer, summary.statement_events)
            append_text(buffer, "\nvalue events: ")
            append_i64(buffer, summary.value_events)
            append_text(buffer, "\nfunction events: ")
            append_i64(buffer, summary.function_events)
            append_text(buffer, "\nthreads: ")
            append_i64(buffer, summary.thread_count)
            append_text(buffer, "\ndropped: ")
            append_i64(buffer, summary.dropped)
            append_text(buffer, "\ndetail budgets: ")
            append_text(buffer, "exceeded" if summary.budget_exceeded != NATIVE_ZERO else "not exceeded")
            append_text(buffer, " (locations ")
            append_i64(buffer, summary.location_limit)
            append_text(buffer, ", call edges ")
            append_i64(buffer, summary.call_edge_limit)
            append_text(buffer, ", stacks ")
            append_i64(buffer, summary.stack_limit)
            append_text(buffer, "; dropped call edges ")
            append_i64(buffer, summary.call_edge_dropped)
            append_text(buffer, ", stacks ")
            append_i64(buffer, summary.stack_dropped)
            append_text(buffer, ")\n")
            append_text(buffer, "\nexecution: ")
            append_millis(buffer, execution_ns)
            append_text(buffer, " ms\ncompile: ")
            append_millis(buffer, compile_ns)
            append_text(buffer, " ms\n")
            if event_trace:
                append_text(buffer, "event trace: ")
                append_i64(buffer, summary.trace_captured)
                append_text(buffer, " captured, ")
                append_i64(buffer, summary.trace_omitted)
                append_text(buffer, " omitted\n")
            elif recent_path:
                append_text(buffer, "recent path events: ")
                append_i64(buffer, summary.event_records.count)
                append_text(buffer, "\n")


        def doctor(argc: i64, slots: mutable cstr&&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            output_path: mutable darray[u8] = []
            index: mutable i64 = NATIVE_FIRST_OPTION_INDEX
            while index < argc |index, slots, output_path|:
                argument: cstr = slots[index].cast[cstr]
                if profiler_ffi_strcmp(argument, "--format") == NATIVE_ZERO:
                    return report_error("doctor supports only --format json") if index + NATIVE_ONE >= argc or profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "json") != NATIVE_ZERO
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--output") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "-o") == NATIVE_ZERO:
                    return report_error("--output requires a path") if index + NATIVE_ONE >= argc
                    copy_cstr(output_path, slots[index + NATIVE_ONE].cast[cstr])
                    index <- index + NATIVE_TWO
                    continue
                return report_error("unknown doctor option")
            compiler_root: mutable darray[u8] = []
            environment_or("ELISA_COMPILER_ROOT", "../elisa-compiler-worktrees/profiler", compiler_root)
            stage1: mutable darray[u8] = []
            environment_or("ELISA_STAGE1_BIN", "../elisa-compiler-worktrees/profiler/bin/elisac-stage1", stage1)
            runtime: mutable darray[u8] = []
            environment_or("ELISA_RUNTIME_OBJ", "../elisa-compiler-worktrees/profiler/build/runtime/elisacore_runtime.o", runtime)
            collector: mutable darray[u8] = []
            environment_or("ELISA_PROFILER_RUNTIME_C", "scripts/profiler_runtime.c", collector)
            compiler_ok: bool = readable_file(compiler_root)
            stage1_ok: bool = executable_available(stage1)
            runtime_ok: bool = readable_file(runtime)
            collector_ok: bool = readable_file(collector)
            all_ok: bool = compiler_ok and stage1_ok and runtime_ok and collector_ok
            report: mutable darray[u8] = []
            append_text(report, "{\"ok\":")
            append_text(report, "true" if all_ok else "false")
            append_text(report, ",\"compiler_root\":")
            append_json_string(report, compiler_root)
            append_text(report, ",\"checks\":{\"compiler_root\":")
            append_text(report, "true" if compiler_ok else "false")
            append_text(report, ",\"stage1_binary\":")
            append_text(report, "true" if stage1_ok else "false")
            append_text(report, ",\"runtime_object\":")
            append_text(report, "true" if runtime_ok else "false")
            append_text(report, ",\"collector_source\":")
            append_text(report, "true" if collector_ok else "false")
            append_text(report, "},\"paths\":{\"stage1_binary\":")
            append_json_string(report, stage1)
            append_text(report, ",\"runtime_object\":")
            append_json_string(report, runtime)
            append_text(report, ",\"collector_source\":")
            append_json_string(report, collector)
            append_text(report, "}}\n")
            if output_path.count > NATIVE_ZERO.usize():
                return NATIVE_ZERO if write_file(output_path, report)
                return report_error("could not write doctor report")
            _ = profiler_ffi_write(NATIVE_STANDARD_OUTPUT, &report[0], report.count) can Console
            return NATIVE_ZERO if all_ok else NATIVE_TWO


        def report_offline(argc: i64, slots: mutable cstr&&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            return report_error("usage: elisa-profiler report CAPTURE [--format json|text|folded|speedscope|html] [--output PATH]") if argc < NATIVE_MIN_PATH_ARGUMENTS
            capture_path: mutable darray[u8] = []
            output_path: mutable darray[u8] = []
            format_json: mutable bool = false
            format_text: mutable bool = false
            format_folded: mutable bool = false
            format_speedscope: mutable bool = false
            format_html: mutable bool = false
            capture_seen: mutable bool = false
            index: mutable i64 = NATIVE_FIRST_OPTION_INDEX
            while index < argc |index, slots, capture_path, output_path, format_json, format_text, format_folded, format_speedscope, format_html, capture_seen|:
                argument: cstr = slots[index].cast[cstr]
                if profiler_ffi_strcmp(argument, "--format") == NATIVE_ZERO:
                    return report_error("--format requires json, text, folded, speedscope, or html") if index + NATIVE_ONE >= argc
                    if profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "json") == NATIVE_ZERO:
                        format_json <- true
                        format_text <- false
                        format_folded <- false
                        format_speedscope <- false
                        format_html <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "text") == NATIVE_ZERO:
                        format_json <- false
                        format_text <- true
                        format_folded <- false
                        format_speedscope <- false
                        format_html <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "folded") == NATIVE_ZERO:
                        format_json <- false
                        format_text <- false
                        format_folded <- true
                        format_speedscope <- false
                        format_html <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "speedscope") == NATIVE_ZERO:
                        format_json <- false
                        format_text <- false
                        format_folded <- false
                        format_speedscope <- true
                        format_html <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "html") == NATIVE_ZERO:
                        format_json <- false
                        format_text <- false
                        format_folded <- false
                        format_speedscope <- false
                        format_html <- true
                    else:
                        return report_error("--format requires json, text, folded, speedscope, or html")
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--output") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "-o") == NATIVE_ZERO:
