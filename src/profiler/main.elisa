extend ProfilerNative:
    private:
        def append_text(buffer: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
            for index in 0..<profiler_ffi_sview_len(text) |buffer, text|:
                buffer.push(profiler_ffi_sview_at(text, index))


        def append_html_escaped(buffer: mutable darray[u8]&, value: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            for index in 0..<value.count |buffer, value|:
                byte: u8 = value[index]
                if byte == NATIVE_BYTE_AMPERSAND:
                    append_text(buffer, "&amp;")
                elif byte == NATIVE_BYTE_LESS_THAN:
                    append_text(buffer, "&lt;")
                elif byte == NATIVE_BYTE_GREATER_THAN:
                    append_text(buffer, "&gt;")
                elif byte == NATIVE_BYTE_DOUBLE_QUOTE:
                    append_text(buffer, "&quot;")
                elif byte == NATIVE_BYTE_SINGLE_QUOTE:
                    append_text(buffer, "&#39;")
                else:
                    buffer.push(byte)
        
        
        def append_i64(buffer: mutable darray[u8]&, value: i64) -> void can[Abort.Panic, Memory.Allocate]:
            if value == NATIVE_I64_MIN:
                append_text(buffer, NATIVE_I64_MIN_TEXT)
                return
            if value == NATIVE_ZERO:
                buffer.push(NATIVE_BYTE_ASCII_ZERO)
                return
            negative: bool = value < NATIVE_ZERO
            magnitude: mutable i64 = -value if negative else value
            buffer.push(NATIVE_BYTE_MINUS) if negative
            digits: mutable darray[u8] = []
            while magnitude > NATIVE_ZERO |digits, magnitude|:
                digits.push((NATIVE_BYTE_ASCII_ZERO.i64() + (magnitude % NATIVE_DECIMAL_BASE)).u8())
                magnitude <- magnitude / NATIVE_DECIMAL_BASE
            for index in 0..<digits.count |buffer, digits|:
                buffer.push(digits[digits.count - 1.usize() - index])
        def append_millis(buffer: mutable darray[u8]&, nanoseconds: i64) -> void can[Abort.Panic, Memory.Allocate]:
            whole: i64 = nanoseconds / NATIVE_NANOS_PER_MILLISECOND
            fraction: i64 = (nanoseconds % NATIVE_NANOS_PER_MILLISECOND) / NATIVE_NANOS_PER_MICROSECOND
            append_i64(buffer, whole)
            buffer.push(NATIVE_BYTE_PERIOD)
            buffer.push((NATIVE_BYTE_ASCII_ZERO.i64() + (fraction / NATIVE_MILLIS_HUNDREDS_DIVISOR)).u8())
            buffer.push((NATIVE_BYTE_ASCII_ZERO.i64() + ((fraction / NATIVE_DECIMAL_TENS_DIVISOR) % NATIVE_DECIMAL_BASE)).u8())
            buffer.push((NATIVE_BYTE_ASCII_ZERO.i64() + (fraction % NATIVE_DECIMAL_BASE)).u8())


        def append_micros_as_millis(buffer: mutable darray[u8]&, microseconds: i64) -> void can[Abort.Panic, Memory.Allocate]:
            whole: i64 = microseconds / NATIVE_MICROSECONDS_PER_MILLISECOND
            fraction: i64 = microseconds % NATIVE_MICROSECONDS_PER_MILLISECOND
            append_i64(buffer, whole)
            buffer.push(NATIVE_BYTE_PERIOD)
            buffer.push((NATIVE_BYTE_ASCII_ZERO.i64() + fraction / NATIVE_MILLIS_HUNDREDS_DIVISOR).u8())
            buffer.push((NATIVE_BYTE_ASCII_ZERO.i64() + ((fraction / NATIVE_DECIMAL_TENS_DIVISOR) % NATIVE_DECIMAL_BASE)).u8())
            buffer.push((NATIVE_BYTE_ASCII_ZERO.i64() + (fraction % NATIVE_DECIMAL_BASE)).u8())


        def append_timeout_seconds(buffer: mutable darray[u8]&, timeout_ns: i64) -> void can[Abort.Panic, Memory.Allocate]:
            whole_seconds: i64 = timeout_ns / NATIVE_NANOS_PER_SECOND
            fraction: mutable i64 = timeout_ns % NATIVE_NANOS_PER_SECOND
            append_i64(buffer, whole_seconds)
            if fraction > NATIVE_ZERO:
                buffer.push(NATIVE_BYTE_PERIOD)
                divisor: mutable i64 = NATIVE_TIMEOUT_FRACTION_FIRST_DIVISOR
                while divisor > NATIVE_ZERO |buffer, fraction, divisor|:
                    buffer.push((NATIVE_BYTE_ASCII_ZERO.i64() + fraction / divisor).u8())
                    fraction <- fraction % divisor
                    divisor <- divisor / NATIVE_DECIMAL_BASE


        def parse_positive_timeout_ns(value: cstr) -> i64 can[Unsafe.PointerCast]:
            bytes: u8& = value.cast[u8&] can Unsafe.PointerCast
            cursor: mutable i64 = NATIVE_ZERO
            whole: mutable i64 = NATIVE_ZERO
            fraction: mutable i64 = NATIVE_ZERO
            fractional_digits: mutable i64 = NATIVE_ZERO
            saw_digit: mutable bool = false
            saw_fraction_digit: mutable bool = false
            saw_period: mutable bool = false
            while true |bytes, cursor, whole, fraction, fractional_digits, saw_digit, saw_fraction_digit, saw_period|:
                byte_ref: u8& = bytes + cursor
                byte: u8 = byte_ref
                break if byte == NATIVE_BYTE_NUL
                if byte == NATIVE_BYTE_PERIOD:
                    return NATIVE_NEGATIVE_ONE if saw_period
                    saw_period <- true
                    cursor <- cursor + NATIVE_ONE
                    continue
                return NATIVE_NEGATIVE_ONE if byte < NATIVE_BYTE_ASCII_ZERO or byte > NATIVE_BYTE_ASCII_NINE
                digit: i64 = (byte - NATIVE_BYTE_ASCII_ZERO).i64()
                saw_digit <- true
                if saw_period:
                    return NATIVE_NEGATIVE_ONE if fractional_digits >= NATIVE_TIMEOUT_FRACTION_DIGITS
                    fraction <- fraction * NATIVE_DECIMAL_BASE + digit
                    fractional_digits <- fractional_digits + NATIVE_ONE
                    saw_fraction_digit <- true
                else:
                    return NATIVE_NEGATIVE_ONE if whole > (NATIVE_I64_MAX - digit) / NATIVE_DECIMAL_BASE
                    whole <- whole * NATIVE_DECIMAL_BASE + digit
                cursor <- cursor + NATIVE_ONE
            return NATIVE_NEGATIVE_ONE if not saw_digit or (saw_period and not saw_fraction_digit)
            while fractional_digits < NATIVE_TIMEOUT_FRACTION_DIGITS |fraction, fractional_digits|:
                fraction <- fraction * NATIVE_DECIMAL_BASE
                fractional_digits <- fractional_digits + NATIVE_ONE
            return NATIVE_NEGATIVE_ONE if whole > (NATIVE_I64_MAX - fraction) / NATIVE_NANOS_PER_SECOND
            result: i64 = whole * NATIVE_NANOS_PER_SECOND + fraction
            return NATIVE_NEGATIVE_ONE if result <= NATIVE_ZERO
            return result


        def read_monotonic() -> ProfilerNativeTimespec:
            timestamp: mutable ProfilerNativeTimespec = ProfilerNativeTimespec{seconds: NATIVE_NEGATIVE_ONE, nanoseconds: NATIVE_NEGATIVE_ONE}
            return timestamp if profiler_ffi_clock_gettime(NATIVE_MONOTONIC_CLOCK, &timestamp) != NATIVE_ZERO
            return timestamp


        def monotonic_timestamp_valid(timestamp: ProfilerNativeTimespec) -> bool:
            return timestamp.seconds >= NATIVE_ZERO and timestamp.nanoseconds >= NATIVE_ZERO and timestamp.nanoseconds < NATIVE_NANOS_PER_SECOND


        def elapsed_nanoseconds(start: ProfilerNativeTimespec, finish: ProfilerNativeTimespec) -> i64:
            return NATIVE_ZERO if not monotonic_timestamp_valid(start) or not monotonic_timestamp_valid(finish) or finish.seconds < start.seconds
            seconds: mutable i64 = finish.seconds - start.seconds
            nanoseconds: mutable i64 = finish.nanoseconds - start.nanoseconds
            if nanoseconds < NATIVE_ZERO:
                return NATIVE_ZERO if seconds == NATIVE_ZERO
                seconds <- seconds - NATIVE_ONE
                nanoseconds <- NATIVE_NANOS_PER_SECOND + nanoseconds
            return native_saturating_add(native_saturating_mul_nonnegative(seconds, NATIVE_NANOS_PER_SECOND), nanoseconds)
        
        
        def append_cstr(buffer: mutable darray[u8]&, value: cstr) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            value_bytes: u8& = value.cast[u8&] can Unsafe.PointerCast
            cursor: mutable i64 = NATIVE_ZERO
            while true |buffer, cursor, value_bytes|:
                byte_ref: u8& = value_bytes + cursor
                byte: u8 = byte_ref
                break if byte == NATIVE_BYTE_NUL
                buffer.push(byte)
                cursor <- cursor + NATIVE_ONE
        
        
        def append_json_string(buffer: mutable darray[u8]&, value: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            buffer.push(NATIVE_BYTE_DOUBLE_QUOTE)
            for index in 0..<value.count |buffer, value|:
                byte: u8 = value[index]
                if byte == NATIVE_BYTE_DOUBLE_QUOTE:
                    append_text(buffer, "\\\"")
                elif byte == NATIVE_BYTE_BACKSLASH:
                    append_text(buffer, "\\\\")
                elif byte == NATIVE_BYTE_NEWLINE:
                    append_text(buffer, "\\n")
                elif byte == NATIVE_BYTE_CARRIAGE_RETURN:
                    append_text(buffer, "\\r")
                elif byte == NATIVE_BYTE_TAB:
                    append_text(buffer, "\\t")
                elif byte < NATIVE_BYTE_CONTROL_LIMIT:
                    append_text(buffer, "\\u00")
                    high: u8 = (byte / NATIVE_HEX_BASE.u8()).u8()
                    low: u8 = (byte % NATIVE_HEX_BASE.u8()).u8()
                    buffer.push(NATIVE_BYTE_ASCII_ZERO + high if high < NATIVE_DECIMAL_BASE.u8() else NATIVE_HEX_LETTER_OFFSET + high)
                    buffer.push(NATIVE_BYTE_ASCII_ZERO + low if low < NATIVE_DECIMAL_BASE.u8() else NATIVE_HEX_LETTER_OFFSET + low)
                else:
                    buffer.push(byte)
            buffer.push(NATIVE_BYTE_DOUBLE_QUOTE)
        
        
        def append_json_key(buffer: mutable darray[u8]&, key: sview) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "\"")
            append_text(buffer, key)
            append_text(buffer, "\":")


        def append_json_optional_sha256(buffer: mutable darray[u8]&, digest: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "null") if digest.count != NATIVE_SHA256_HEX_LENGTH
            append_json_string(buffer, digest) if digest.count == NATIVE_SHA256_HEX_LENGTH


        def append_active_stack(buffer: mutable darray[u8]&, summary: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            return if not summary.active_stack_available
            append_text(buffer, ",\"active_stack\":{\"tracked_depth\":")
            append_i64(buffer, summary.active_stack_tracked_depth)
            append_text(buffer, ",\"overflow_depth\":")
            append_i64(buffer, summary.active_stack_overflow_depth)
            append_text(buffer, ",\"stack\":[")
            first: mutable bool = true
            segment: mutable darray[u8] = []
            for index in 0..<summary.active_stack_path.count |buffer, summary, first, segment|:
                byte: u8 = summary.active_stack_path[index]
                if byte == NATIVE_BYTE_SEMICOLON:
                    if segment.count > NATIVE_ZERO.usize():
                        append_text(buffer, "," if not first else "")
                        append_json_string(buffer, segment)
                        first <- false
                    segment <- []
                else:
                    segment.push(byte)
            if segment.count > NATIVE_ZERO.usize() and not (segment.count == NATIVE_ONE.usize() and segment[NATIVE_ZERO.usize()] == NATIVE_BYTE_MINUS):
                append_text(buffer, "," if not first else "")
                append_json_string(buffer, segment)
            append_text(buffer, "]}")


        def append_capture_contract(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, ",\"capture\":{\"process\":{\"scope\":\"single_profiled_child\",\"lifetime\":\"launch_to_wait\"},\"threads\":{\"scope\":\"registered_collector_threads\",\"lifetime\":\"capture_only\",\"identity\":\"local_capture_thread_generation\"},\"tasks\":{\"status\":\"not_recorded\"},\"repetition\":{\"scope\":\"run.repetitions\",\"warmups_excluded\":true},\"clock\":{\"domain\":\"wall\",\"unit\":\"ns\",\"source\":\"CLOCK_MONOTONIC\"}}")


        def append_numeric_encoding_contract(buffer: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, ",\"numeric_encoding\":{\"integer\":\"decimal_json_integer\",\"large_integer_policy\":\"preserve_decimal_text\",\"viewer_metric_parser\":\"raw_json_to_BigInt\",\"javascript_safe_integer\":\"2^53_minus_1\"}")


        def append_json_f64(buffer: mutable darray[u8]&, value: f64) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            scratch: mutable darray[u8] = [NATIVE_BYTE_NUL for _ in 0..<NATIVE_HOST_FLOAT_BUFFER_BYTES]
            written: i64 = profiler_ffi_snprintf(&scratch[0], scratch.count, NATIVE_HOST_LOAD_FORMAT, value)
            return false if written <= NATIVE_ZERO or written >= scratch.count.i64()
            for index in 0..<written.usize() |buffer, scratch|:
                buffer.push(scratch[index])
            return true


        def append_json_host(buffer: mutable darray[u8]&, host: NativeHostMetadata) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            append_text(buffer, ",\"host\":")
            if not host.available:
                append_text(buffer, "null")
                return
            append_text(buffer, "{\"os\":")
            if host.os.count > NATIVE_ZERO.usize():
                append_json_string(buffer, host.os)
            else:
                append_text(buffer, "null")
            append_text(buffer, ",\"architecture\":")
            if host.architecture.count > NATIVE_ZERO.usize():
                append_json_string(buffer, host.architecture)
            else:
                append_text(buffer, "null")
            append_text(buffer, ",\"load_average_1m\":")
            if host.load_average_available and not append_json_f64(buffer, host.load_average_1m):
                append_text(buffer, "null")
            elif not host.load_average_available:
                append_text(buffer, "null")
            append_text(buffer, ",\"load_average_source\":")
            append_text(buffer, "\"getloadavg\"" if host.load_average_available else "null")
            append_text(buffer, ",\"affinity\":{\"policy\":\"inherited\",\"changed\":false}")
            append_text(buffer, ",\"power_thermal\":null}")
        
        
        def append_command_argument[@r](arguments: mutable darray[darray[u8]]& @r, value: sview) -> void can[Abort.Panic, Memory.Allocate]:
            argument: mutable darray[u8] @r = []
            append_text(argument, value)
            argument.push(NATIVE_BYTE_NUL)
            arguments.push(argument)


        def append_command_path_argument[@r](arguments: mutable darray[darray[u8]]& @r, value: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            argument: mutable darray[u8] @r = []
            argument.extend(value)
            argument.push(NATIVE_BYTE_NUL)
            arguments.push(argument)


        def append_command_i64_argument[@r](arguments: mutable darray[darray[u8]]& @r, prefix: sview, value: i64) -> void can[Abort.Panic, Memory.Allocate]:
            argument: mutable darray[u8] @r = []
            append_text(argument, prefix)
            append_i64(argument, value)
            argument.push(NATIVE_BYTE_NUL)
            arguments.push(argument)
        
        
        def copy_cstr(destination: mutable darray[u8]&, value: cstr) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            destination <- []
            append_cstr(destination, value)


        def parse_nonnegative_cstr(value: cstr) -> i64 can[Unsafe.PointerCast]:
            bytes: u8& = value.cast[u8&] can Unsafe.PointerCast
            cursor: mutable i64 = NATIVE_ZERO
            result: mutable i64 = NATIVE_ZERO
            digits: mutable i64 = NATIVE_ZERO
            while true |bytes, cursor, result, digits|:
                byte_ref: u8& = bytes + cursor
                byte: u8 = byte_ref
                break if byte == NATIVE_BYTE_NUL
                return NATIVE_NEGATIVE_ONE if byte < NATIVE_BYTE_ASCII_ZERO or byte > NATIVE_BYTE_ASCII_NINE
                digit: i64 = (byte - NATIVE_BYTE_ASCII_ZERO).i64()
                return NATIVE_NEGATIVE_ONE if result > (NATIVE_I64_MAX - digit) / NATIVE_DECIMAL_BASE
                result <- result * NATIVE_DECIMAL_BASE + digit
                digits <- digits + NATIVE_ONE
                cursor <- cursor + NATIVE_ONE
            return NATIVE_NEGATIVE_ONE if digits == NATIVE_ZERO
            return result


        def copy_environment(name: sview, destination: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            name_storage: mutable darray[u8] = []
            append_text(name_storage, name)
            name_storage.push(NATIVE_BYTE_NUL)
            if profiler_ffi_getenv((&name_storage[0]).cast[cstr] can Unsafe.PointerCast) is value:
                cursor: mutable i64 = NATIVE_ZERO
                while true |destination, cursor, value|:
                    byte_ref: u8& = value + cursor
                    byte: u8 = byte_ref
                    break if byte == NATIVE_BYTE_NUL
                    destination.push(byte)
                    cursor <- cursor + NATIVE_ONE
                return true
            return false


        def append_random_seed_environment(environment: mutable darray[u8]&, random_seed: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(environment, "ELISA_RANDOM_SEED=")
            environment.extend(random_seed)
            environment.push(NATIVE_BYTE_NUL)
        
        
        def environment_or(name: sview, fallback: sview, destination: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if copy_environment(name, destination)
            append_text(destination, fallback)


        def path_from_executable(argv_zero: cstr, suffix: sview, destination: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            executable: mutable darray[u8] = []
            copy_cstr(executable, argv_zero)
            separator: mutable usize = executable.count
            while separator > NATIVE_ZERO.usize() |separator, executable|:
                separator <- separator - NATIVE_ONE.usize()
                break if executable[separator] == NATIVE_BYTE_SLASH
            return false if separator == NATIVE_ZERO.usize()
            destination <- []
            for index in 0..<separator |destination, executable|:
                destination.push(executable[index])
            append_text(destination, suffix)
            return true


        def environment_or_executable(name: sview, fallback: sview, argv_zero: cstr, suffix: sview, destination: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            destination <- []
            return if copy_environment(name, destination)
            return if path_from_executable(argv_zero, suffix, destination)
            append_text(destination, fallback)


        def read_manifest_digest(manifest_path: darray[u8]&, object_name: sview) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
            manifest: darray[u8] = read_file(manifest_path)
            return [] if manifest.count == NATIVE_ZERO.usize()
            object_start: i64 = json_key_value_start(manifest, object_name, NATIVE_ZERO.usize(), manifest.count)
            return [] if object_start < NATIVE_ZERO
            object_stop: i64 = json_object_end(manifest, object_start.usize(), manifest.count)
            return [] if object_stop < NATIVE_ZERO
            result: mutable darray[u8] = []
            return [] if not json_read_string_field(manifest, "sha256", object_start.usize(), object_stop.usize(), &result)
            return [] if result.count != NATIVE_SHA256_HEX_LENGTH
            return result


        def trim_line_endings(value: mutable darray[u8]&) -> void:
            while value.count > NATIVE_ZERO.usize() |value|:
                last: u8 = value[value.count - NATIVE_ONE.usize()]
                break if last != NATIVE_BYTE_NEWLINE and last != NATIVE_BYTE_CARRIAGE_RETURN
                value.count <- value.count - NATIVE_ONE.usize()


        def write_all_fd(fd: i64, data: darray[u8]&) -> bool can[Abort.Panic, Console]:
            written: mutable usize = NATIVE_ZERO.usize()
            while written < data.count |written, data, fd|:
                amount: i64 = profiler_ffi_write(fd, &data[written], data.count - written) can Console
                return false if amount <= NATIVE_ZERO
                written <- written + amount.usize()
            return true


        def read_git_metadata(compiler_root: darray[u8]&, operation: sview, output_path: darray[u8]&, error_path: darray[u8]&, git_tool: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            command_arguments: mutable darray[darray[u8]] = []
            append_command_argument(command_arguments, "-C")
            append_command_path_argument(command_arguments, compiler_root)
            if operation == "branch":
                append_command_argument(command_arguments, "rev-parse")
                append_command_argument(command_arguments, "--abbrev-ref")
                append_command_argument(command_arguments, "HEAD")
            elif operation == "commit":
                append_command_argument(command_arguments, "rev-parse")
                append_command_argument(command_arguments, "HEAD")
            elif operation == "dirty":
                append_command_argument(command_arguments, "status")
                append_command_argument(command_arguments, "--porcelain")
                append_command_argument(command_arguments, "--untracked-files=all")
            else:
                return []
            return [] if run_tool_direct(git_tool, command_arguments, output_path, error_path) != NATIVE_ZERO
            result: mutable darray[u8] = read_file(output_path)
            trim_line_endings(&result)
            return result


        # The compiler's dependency listing is newline-delimited absolute paths. Hash the
        # contents in that deterministic order, rather than the paths, so two checkouts at
        # different roots still compare by source content while an included-file edit is
        # distinguishable from an unchanged top-level source file.
        def dependency_tree_digest(dependency_listing: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            material: mutable darray[u8] = []
            line_start: mutable usize = NATIVE_ZERO.usize()
            dependency_count: mutable i64 = NATIVE_ZERO
            while line_start < dependency_listing.count |line_start, dependency_listing, material, dependency_count|:
                line_stop: mutable usize = line_start
                while line_stop < dependency_listing.count and dependency_listing[line_stop] != NATIVE_BYTE_NEWLINE |line_stop, dependency_listing|:
                    line_stop <- line_stop + NATIVE_ONE.usize()
                line_end: mutable usize = line_stop
                line_end <- line_end - NATIVE_ONE.usize() if line_end > line_start and dependency_listing[line_end - NATIVE_ONE.usize()] == NATIVE_BYTE_CARRIAGE_RETURN
                return [] if line_end == line_start
                return [] if dependency_count >= NATIVE_MAX_DEPENDENCY_FILES
                dependency_path: mutable darray[u8] = []
                for index in line_start..<line_end |index, dependency_listing, dependency_path|:
                    dependency_path.push(dependency_listing[index])
                return [] if not readable_file(dependency_path)
                dependency_bytes: darray[u8] = read_file(dependency_path)
                dependency_digest: darray[u8] = sha256_hex(dependency_bytes)
                return [] if dependency_digest.count == NATIVE_ZERO.usize()
                material.extend(dependency_digest)
                material.push(NATIVE_BYTE_NUL)
                dependency_count <- dependency_count + NATIVE_ONE
                line_start <- line_stop + NATIVE_ONE.usize()
            return [] if dependency_count == NATIVE_ZERO
            return sha256_hex(material)


        def collect_dependency_digest(compiler: darray[u8]&, source: darray[u8]&, dependency_path: darray[u8]&, output_path: darray[u8]&, error_path: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            command_arguments: mutable darray[darray[u8]] = []
            append_command_argument(command_arguments, "-emit")
            append_command_argument(command_arguments, "deps")
            append_command_argument(command_arguments, "-o")
            append_command_path_argument(command_arguments, dependency_path)
            append_command_path_argument(command_arguments, source)
            return [] if run_tool_direct(compiler, command_arguments, output_path, error_path) != NATIVE_ZERO
            return dependency_tree_digest(read_file(dependency_path))
        
        
        def path_with_suffix(path: darray[u8]&, suffix: sview) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
            result: mutable darray[u8] = []
            result.extend(path)
            append_text(result, suffix)
            return result
        
        
        def remove_temp_file(directory: darray[u8]&, suffix: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path: mutable darray[u8] = path_with_suffix(directory, suffix)
            path.push(NATIVE_BYTE_NUL)
            _ = profiler_ffi_unlink((&path[0]).cast[cstr] can Unsafe.PointerCast)


        def cleanup_temp(directory: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            remove_temp_file(directory, "/target.o")
            remove_temp_file(directory, "/source-map.txt")
            remove_temp_file(directory, "/target-renamed.o")
            remove_temp_file(directory, "/runtime-collector.o")
            remove_temp_file(directory, "/profiler-runtime.o")
            remove_temp_file(directory, "/profiled-program")
            remove_temp_file(directory, "/capture.txt")
            remove_temp_file(directory, "/dependencies.txt")
            remove_temp_file(directory, "/compile.err")
            remove_temp_file(directory, "/compile.out")
            remove_temp_file(directory, "/link.err")
            remove_temp_file(directory, "/program.out")
            remove_temp_file(directory, "/program.err")
            remove_temp_file(directory, "/compiler-branch")
            remove_temp_file(directory, "/compiler-commit")
            remove_temp_file(directory, "/compiler-dirty")
            remove_temp_file(directory, "/compiler-metadata.err")
            directory_copy: mutable darray[u8] = []
            directory_copy.extend(directory)
            directory_copy.push(NATIVE_BYTE_NUL)
            _ = profiler_ffi_rmdir((&directory_copy[0]).cast[cstr] can Unsafe.PointerCast)


        def write_stderr(buffer: darray[u8]&) -> void can[Abort.Panic, Console]:
            return if buffer.count == NATIVE_ZERO.usize()
            _ = write_all_fd(NATIVE_STANDARD_ERROR, buffer) can Console


        def append_program_output(buffer: mutable darray[u8]&, chunk: darray[u8]&, truncated: mutable bool&) -> void can[Abort.Panic, Memory.Allocate]:
            return if chunk.count == NATIVE_ZERO.usize()
            if buffer.count > NATIVE_ZERO.usize() and buffer.count < NATIVE_MAX_PROGRAM_OUTPUT_BYTES:
                buffer.push(NATIVE_BYTE_NEWLINE)
            for index in 0..<chunk.count |buffer, chunk, index, truncated|:
                if buffer.count >= NATIVE_MAX_PROGRAM_OUTPUT_BYTES:
                    truncated <- true
                    break
                buffer.push(chunk[index])
        
        
        def report_error_bytes(message: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Console]:
            buffer: mutable darray[u8] = []
            append_text(buffer, "elisa-profiler: ")
            buffer.extend(message)
            buffer.push(NATIVE_BYTE_NEWLINE)
            write_stderr(buffer)
            return NATIVE_TWO


        def report_error(message: sview) -> i64 can[Abort.Panic, Memory.Allocate, Console]:
            message_bytes: mutable darray[u8] = []
            append_text(message_bytes, message)
            return report_error_bytes(message_bytes)


        def report_json_error_bytes(code: sview, message_bytes: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Console]:
            code_bytes: mutable darray[u8] = []
            append_text(code_bytes, code)
            report: mutable darray[u8] = []
            append_text(report, "{\"schema_version\":")
            append_i64(report, NATIVE_ERROR_SCHEMA_VERSION)
            append_text(report, ",\"envelope\":{\"major\":")
            append_i64(report, NATIVE_ERROR_ENVELOPE_MAJOR)
            append_text(report, ",\"minor\":")
            append_i64(report, NATIVE_ERROR_ENVELOPE_MINOR)
            append_text(report, ",\"kind\":\"error\",\"compatibility\":\"stable-v1\"},\"error\":{\"code\":")
            append_json_string(report, code_bytes)
            append_text(report, ",\"message\":")
            append_json_string(report, message_bytes)
            append_text(report, "}}\n")
            _ = write_all_fd(NATIVE_STANDARD_OUTPUT, report) can Console
            return report_error_bytes(message_bytes)


        def report_json_error(code: sview, message: sview) -> i64 can[Abort.Panic, Memory.Allocate, Console]:
            message_bytes: mutable darray[u8] = []
            append_text(message_bytes, message)
            return report_json_error_bytes(code, message_bytes)


        def report_protocol_error(summary: CaptureSummary) -> i64 can[Abort.Panic, Memory.Allocate, Console]:
            buffer: mutable darray[u8] = []
            append_text(buffer, "elisa-profiler: malformed native protocol code=")
            append_i64(buffer, summary.malformed_code)
            buffer.push(NATIVE_BYTE_NEWLINE)
            write_stderr(buffer)
            return NATIVE_TWO


        def report_protocol_json_error(summary: CaptureSummary) -> i64 can[Abort.Panic, Memory.Allocate, Console]:
            detail: mutable darray[u8] = []
            append_text(detail, "malformed native protocol code=")
            append_i64(detail, summary.malformed_code)
            return report_json_error_bytes("malformed_native_protocol", detail)


        def write_file(path: darray[u8]&, data: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            temporary_path: mutable darray[u8] = []
            temporary_path.extend(path)
            append_text(temporary_path, ".elisa-profiler.tmp.")
            append_i64(temporary_path, profiler_ffi_getpid())
            temporary_path.push(NATIVE_BYTE_NUL)
            temporary_cstr: cstr = (&temporary_path[0]).cast[cstr] can Unsafe.PointerCast
            fd: i64 = profiler_ffi_open(temporary_cstr, NATIVE_O_WRONLY + NATIVE_O_CREAT + NATIVE_O_TRUNC, NATIVE_FILE_MODE)
            false return if fd < NATIVE_ZERO
            if not write_all_fd(fd, data) can Console:
                _ = profiler_ffi_close(fd)
                _ = profiler_ffi_unlink(temporary_cstr)
                return false
            _ = profiler_ffi_close(fd)
            path_copy: mutable darray[u8] = []
            path_copy.extend(path)
            path_copy.push(NATIVE_BYTE_NUL)
            path_cstr: cstr = (&path_copy[0]).cast[cstr] can Unsafe.PointerCast
            if profiler_ffi_rename(temporary_cstr, path_cstr) != NATIVE_ZERO:
                _ = profiler_ffi_unlink(temporary_cstr)
                return false
            return true


        def append_profile_artifact(buffer: mutable darray[u8]&, capture: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "{\"artifact_version\":")
            append_i64(buffer, NATIVE_ARTIFACT_VERSION)
            append_text(buffer, ",\"kind\":\"elisa-profile\",\"manifest\":{\"capture_format\":\"profile-json-v2\",\"compression\":\"none\",\"capture_bytes\":")
            append_i64(buffer, capture.count.i64())
            append_text(buffer, "},\"capture\":")
            buffer.extend(capture)
            append_text(buffer, "}\n")


        def write_capture_manifest(path: darray[u8]&, source: darray[u8]&, source_bytes: darray[u8]&, mode: darray[u8]&, capture_path: darray[u8]&, state: sview, requested: i64, completed: i64, successful: i64, failed: i64, summary: CaptureSummary, capture_bytes: i64, valid_frames: i64, valid_capture_bytes: i64) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return true if path.count == NATIVE_ZERO.usize()
            manifest: mutable darray[u8] = []
            source_digest: darray[u8] = sha256_hex(source_bytes)
            state_value: mutable darray[u8] = []
            append_text(state_value, state)
            append_text(manifest, "{\"kind\":\"elisa_profile_capture_manifest\",\"schema_version\":")
            append_i64(manifest, NATIVE_CAPTURE_MANIFEST_VERSION)
            append_text(manifest, ",\"state\":")
            append_json_string(manifest, state_value)
            append_text(manifest, ",\"source\":")
            append_json_string(manifest, source)
            append_text(manifest, ",\"source_sha256\":")
            append_json_string(manifest, source_digest)
            append_text(manifest, ",\"collection_mode\":")
            append_json_string(manifest, mode)
            append_text(manifest, ",\"capture_path\":")
            append_json_string(manifest, capture_path)
            append_text(manifest, ",\"requested_repetitions\":")
            append_i64(manifest, requested)
            append_text(manifest, ",\"completed_repetitions\":")
            append_i64(manifest, completed)
            append_text(manifest, ",\"successful_repetitions\":")
            append_i64(manifest, successful)
            append_text(manifest, ",\"failed_repetitions\":")
            append_i64(manifest, failed)
            append_text(manifest, ",\"events\":")
            append_i64(manifest, summary.events)
            append_text(manifest, ",\"capture_started\":")
            append_text(manifest, "true" if summary.capture_started else "false")
            append_text(manifest, ",\"capture_complete\":")
            append_text(manifest, "true" if summary.capture_started and summary.capture_complete else "false")
            append_text(manifest, ",\"frame_dropped\":")
            append_i64(manifest, summary.frame_dropped)
            append_text(manifest, ",\"sample_count\":")
            append_i64(manifest, summary.sample_count)
            append_text(manifest, ",\"sample_missed\":")
            append_i64(manifest, summary.sample_missed)
            append_text(manifest, ",\"sample_period_microseconds\":")
            append_i64(manifest, summary.sample_period_microseconds)
            append_text(manifest, ",\"sampling_setup_failed\":")
            append_i64(manifest, summary.sampling_setup_failed)
            append_text(manifest, ",\"collector_status\":")
            append_i64(manifest, summary.collector_status)
            append_text(manifest, ",\"capture_index\":{\"format\":\"record-framed-v1\",\"bytes\":")
            append_i64(manifest, capture_bytes)
            append_text(manifest, ",\"valid_frames\":")
            append_i64(manifest, valid_frames)
            append_text(manifest, ",\"valid_bytes\":")
            append_i64(manifest, valid_capture_bytes)
            append_text(manifest, "}")
            append_text(manifest, "}\n")
            return write_file(path, manifest)


        def write_progress(path: darray[u8]&, state: sview, repetition: i64, requested: i64, elapsed_ns: i64, summary: CaptureSummary) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return true if path.count == NATIVE_ZERO.usize()
            progress: mutable darray[u8] = []
            state_value: mutable darray[u8] = []
            append_text(state_value, state)
            append_text(progress, "{\"kind\":\"elisa_profile_progress\",\"schema_version\":")
            append_i64(progress, NATIVE_PROGRESS_SCHEMA_VERSION)
            append_text(progress, ",\"state\":")
            append_json_string(progress, state_value)
            append_text(progress, ",\"repetition\":")
            append_i64(progress, repetition)
            append_text(progress, ",\"requested_repetitions\":")
            append_i64(progress, requested)
            append_text(progress, ",\"elapsed_ns\":")
            append_i64(progress, elapsed_ns)
            append_text(progress, ",\"events\":")
            append_i64(progress, summary.events)
            append_text(progress, ",\"capture_bytes\":")
            append_i64(progress, summary.capture_bytes_used)
            append_text(progress, ",\"valid_frames\":")
            append_i64(progress, summary.valid_frames)
            append_text(progress, ",\"capture_started\":")
            append_text(progress, "true" if summary.capture_started else "false")
            append_text(progress, ",\"capture_complete\":")
            append_text(progress, "true" if summary.capture_complete else "false")
            append_text(progress, ",\"sample_count\":")
            append_i64(progress, summary.sample_count)
            append_text(progress, ",\"sample_missed\":")
            append_i64(progress, summary.sample_missed)
            append_text(progress, ",\"sample_period_microseconds\":")
            append_i64(progress, summary.sample_period_microseconds)
            append_text(progress, ",\"sampling_setup_failed\":")
            append_i64(progress, summary.sampling_setup_failed)
            append_text(progress, ",\"collector_status\":")
            append_i64(progress, summary.collector_status)
            append_text(progress, "}\n")
            return write_file(path, progress)


        def unwrap_profile_artifact(data: darray[u8]&, capture: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate]:
            return false if not json_document_is_object(data)
            artifact_start: i64 = json_key_value_start(data, "artifact_version", NATIVE_ZERO.usize(), data.count)
            if artifact_start < NATIVE_ZERO:
                capture.extend(data)
                return true
            version: i64 = json_number_at(data, artifact_start.usize(), data.count)
            return false if version != NATIVE_ARTIFACT_VERSION
            kind_start: i64 = json_key_value_start(data, "kind", NATIVE_ZERO.usize(), data.count)
            return false if kind_start < NATIVE_ZERO
            kind: mutable darray[u8] = []
            return false if json_string_into(data, kind_start.usize(), data.count, &kind) < NATIVE_ZERO
            return false if not protocol_field_is(kind, "elisa-profile")
            capture_start: i64 = json_key_value_start(data, "capture", NATIVE_ZERO.usize(), data.count)
            return false if capture_start < NATIVE_ZERO
            capture_stop: i64 = json_object_end(data, capture_start.usize(), data.count)
            return false if capture_stop < NATIVE_ZERO
            for index in capture_start.usize()..<capture_stop.usize() |capture, data|:
                capture.push(data[index])
            capture.push(NATIVE_BYTE_NEWLINE)
            return true


        def system_exit_code(status: i64) -> i64:
            return NATIVE_CHILD_FAILURE_STATUS if status < NATIVE_ZERO
            return status / NATIVE_EXIT_STATUS_BASE if status % NATIVE_EXIT_STATUS_BASE == NATIVE_ZERO else NATIVE_SIGNAL_EXIT_BASE + (status % NATIVE_SIGNAL_STATUS_BASE)


        def system_signal(status: i64) -> i64:
            return NATIVE_NEGATIVE_ONE if status < NATIVE_ZERO or status % NATIVE_EXIT_STATUS_BASE == NATIVE_ZERO else status % NATIVE_SIGNAL_STATUS_BASE


        def observed_signal(status: i64, summary: CaptureSummary) -> i64:
            signal: i64 = system_signal(status)
            return summary.crash_signal if signal < NATIVE_ZERO and summary.crash_signal > NATIVE_ZERO
            return signal


        def append_observed_signal(buffer: mutable darray[u8]&, status: i64, summary: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            signal: i64 = observed_signal(status, summary)
            append_text(buffer, "null") if signal < NATIVE_ZERO
            append_i64(buffer, signal) if signal >= NATIVE_ZERO


        def append_observed_exit_code(buffer: mutable darray[u8]&, status: i64, summary: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            signal: i64 = observed_signal(status, summary)
            append_text(buffer, "null") if summary.collector_status >= NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE or status < NATIVE_ZERO or signal >= NATIVE_ZERO
            append_i64(buffer, system_exit_code(status)) if summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and signal < NATIVE_ZERO


        def append_run_outcome(buffer: mutable darray[u8]&, summary: CaptureSummary, status: i64, timed_out: bool, recovered: bool) -> void can[Abort.Panic, Memory.Allocate]:
            signal: i64 = observed_signal(status, summary)
            target_exit: i64 = system_exit_code(status)
            append_text(buffer, "\"incomplete_artifact\"") if recovered
            append_text(buffer, "\"collector_failure\"") if not recovered and summary.collector_status >= NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE
            append_text(buffer, "\"profiler_failure\"") if not recovered and summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status < NATIVE_ZERO
            append_text(buffer, "\"timeout\"") if not recovered and summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and timed_out
            append_text(buffer, "\"target_crash\"") if not recovered and summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and not timed_out and signal >= NATIVE_ZERO and summary.crash_signal > NATIVE_ZERO
            append_text(buffer, "\"target_signal\"") if not recovered and summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and not timed_out and signal >= NATIVE_ZERO and summary.crash_signal <= NATIVE_ZERO
            append_text(buffer, "\"target_exit\"") if not recovered and summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and not timed_out and signal < NATIVE_ZERO and target_exit != NATIVE_ZERO
            append_text(buffer, "\"success\"") if not recovered and summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and not timed_out and signal < NATIVE_ZERO and target_exit == NATIVE_ZERO and summary.capture_complete
            append_text(buffer, "\"incomplete_capture\"") if not recovered and summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and not timed_out and signal < NATIVE_ZERO and target_exit == NATIVE_ZERO and not summary.capture_complete


        def append_html_outcome(buffer: mutable darray[u8]&, summary: CaptureSummary, status: i64, timed_out: bool) -> void can[Abort.Panic, Memory.Allocate]:
            signal: i64 = observed_signal(status, summary)
            append_text(buffer, "collector failure") if summary.collector_status >= NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE
            append_text(buffer, "profiler failure") if summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status < NATIVE_ZERO
            append_text(buffer, "timeout") if summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and timed_out
            append_text(buffer, "target crash") if summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and not timed_out and signal >= NATIVE_ZERO and summary.crash_signal > NATIVE_ZERO
            append_text(buffer, "target signal") if summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and not timed_out and signal >= NATIVE_ZERO and summary.crash_signal <= NATIVE_ZERO
            append_text(buffer, "target exit") if summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and not timed_out and signal < NATIVE_ZERO and system_exit_code(status) != NATIVE_ZERO
            append_text(buffer, "success") if summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and not timed_out and signal < NATIVE_ZERO and system_exit_code(status) == NATIVE_ZERO and summary.capture_complete
            append_text(buffer, "incomplete capture") if summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and not timed_out and signal < NATIVE_ZERO and system_exit_code(status) == NATIVE_ZERO and not summary.capture_complete


        def append_text_outcome(buffer: mutable darray[u8]&, summary: CaptureSummary, status: i64, timed_out: bool) -> void can[Abort.Panic, Memory.Allocate]:
            signal: i64 = observed_signal(status, summary)
            append_text(buffer, "collector_failure") if summary.collector_status >= NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE
            append_text(buffer, "profiler_failure") if summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status < NATIVE_ZERO
            append_text(buffer, "timeout") if summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and timed_out
            append_text(buffer, "target_crash") if summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and not timed_out and signal >= NATIVE_ZERO and summary.crash_signal > NATIVE_ZERO
            append_text(buffer, "target_signal") if summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and not timed_out and signal >= NATIVE_ZERO and summary.crash_signal <= NATIVE_ZERO
            append_text(buffer, "target_exit") if summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and not timed_out and signal < NATIVE_ZERO and system_exit_code(status) != NATIVE_ZERO
            append_text(buffer, "success") if summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and not timed_out and signal < NATIVE_ZERO and system_exit_code(status) == NATIVE_ZERO and summary.capture_complete
            append_text(buffer, "incomplete_capture") if summary.collector_status < NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and status >= NATIVE_ZERO and not timed_out and signal < NATIVE_ZERO and system_exit_code(status) == NATIVE_ZERO and not summary.capture_complete


        def append_quality(buffer: mutable darray[u8]&, summary: CaptureSummary, status: i64, event_trace: bool, timed_out: bool, recovered: bool) -> void can[Abort.Panic, Memory.Allocate]:
            target_exit: i64 = system_exit_code(status)
            signal: i64 = observed_signal(status, summary)
            capture_incomplete: bool = recovered or status < NATIVE_ZERO or signal >= NATIVE_ZERO or timed_out or summary.collector_status >= NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE
            detail_degraded: bool = capture_incomplete or summary.dropped > NATIVE_ZERO or summary.call_edge_dropped > NATIVE_ZERO or summary.stack_dropped > NATIVE_ZERO or summary.capture_bytes_dropped > NATIVE_ZERO or summary.frame_dropped > NATIVE_ZERO or summary.stack_overflow_entries > NATIVE_ZERO or summary.sample_missed > NATIVE_ZERO or (event_trace and summary.trace_omitted > NATIVE_ZERO)
            append_text(buffer, "\"quality\":{\"capture\":\"")
            if recovered:
                append_text(buffer, "recovered")
            elif summary.collector_status >= NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE:
                append_text(buffer, "collector_failure")
            elif status < NATIVE_ZERO:
                append_text(buffer, "profiler_failure")
            elif timed_out:
                append_text(buffer, "timeout")
            elif signal >= NATIVE_ZERO and summary.crash_signal > NATIVE_ZERO:
                append_text(buffer, "target_crash")
            elif signal >= NATIVE_ZERO:
                append_text(buffer, "target_signal")
            elif target_exit != NATIVE_ZERO:
                append_text(buffer, "target_exit")
            else:
                append_text(buffer, "complete")
            append_text(buffer, "\",\"detail\":\"")
            append_text(buffer, "degraded" if detail_degraded else "complete")
            append_text(buffer, "\",\"event_counts\":\"")
            append_text(buffer, "partial" if summary.dropped > NATIVE_ZERO else "exact")
            append_text(buffer, "\",\"completeness\":{\"events\":\"")
            append_text(buffer, "partial" if summary.dropped > NATIVE_ZERO or capture_incomplete else "exact")
            append_text(buffer, "\",\"locations\":\"")
            append_text(buffer, "partial" if summary.dropped > NATIVE_ZERO or capture_incomplete else "exact")
            append_text(buffer, "\",\"functions\":\"")
            append_text(buffer, "partial" if summary.dropped > NATIVE_ZERO or capture_incomplete else "exact")
            append_text(buffer, "\",\"call_edges\":\"")
            append_text(buffer, "partial" if summary.call_edge_dropped > NATIVE_ZERO or capture_incomplete else "exact")
            append_text(buffer, "\",\"stacks\":\"")
            append_text(buffer, "partial" if summary.stack_dropped > NATIVE_ZERO or summary.stack_overflow_entries > NATIVE_ZERO or capture_incomplete else "exact")
            append_text(buffer, "\",\"timings\":\"")
            append_text(buffer, "partial" if capture_incomplete else "exact")
            append_text(buffer, "\"},\"reasons\":[")
            first_reason: mutable bool = true
            if recovered:
                append_text(buffer, "\"recovered_partial\"")
                first_reason <- false
            elif status < NATIVE_ZERO:
                append_text(buffer, "\"wait_failure\"")
                first_reason <- false
            if signal >= NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"signal_termination\"")
                first_reason <- false
            if timed_out:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"timeout\"")
                first_reason <- false
            if not recovered and target_exit != NATIVE_ZERO and signal < NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"target_exit\"")
                first_reason <- false
            if summary.dropped > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"dropped_locations\"")
                first_reason <- false
            if summary.call_edge_dropped > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"dropped_call_edges\"")
                first_reason <- false
            if summary.stack_dropped > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"dropped_stacks\"")
                first_reason <- false
            if summary.capture_bytes_dropped > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"capture_byte_budget\"")
                first_reason <- false
            if summary.frame_dropped > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"framed_transport_loss\"")
                first_reason <- false
            if summary.sample_missed > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"sampling_signal_loss\"")
                first_reason <- false
            if summary.stack_overflow_entries > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"stack_overflow\"")
                first_reason <- false
            if summary.crash_signal > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"crash_marker\"")
                first_reason <- false
            if event_trace and summary.trace_omitted > NATIVE_ZERO:
                append_text(buffer, "," if not first_reason else "")
                append_text(buffer, "\"event_trace_omitted\"")
            append_text(buffer, "]}")
        
        
        def append_html_section(buffer: mutable darray[u8]&, title: sview, records: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<details open><summary>")
            append_text(buffer, title)
            append_text(buffer, "</summary><pre>")
            append_html_escaped(buffer, records)
            append_text(buffer, "</pre></details>")


        def append_html_workload_summary(buffer: mutable darray[u8]&, working_directory: darray[u8]&, stdin_path: darray[u8]&, environment: darray[u8], target_arguments: darray[darray[u8]], random_seed: darray[u8]&, random_seed_source: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            append_text(buffer, "<section class='panel' aria-labelledby='workload-title'><h2 id='workload-title'>Workload reproducibility</h2><dl class='workload-grid'><div><dt>Working directory</dt><dd><code>")
            if working_directory.count == NATIVE_ZERO.usize():
                append_text(buffer, ".")
            else:
                append_html_escaped(buffer, working_directory)
            append_text(buffer, "</code></dd></div><div><dt>Standard input</dt><dd>")
            if stdin_path.count == NATIVE_ZERO.usize():
                append_text(buffer, "not configured")
            else:
                append_html_escaped(buffer, stdin_path)
                if readable_file(stdin_path):
                    stdin_digest: darray[u8] = sha256_hex(read_file(stdin_path))
                    append_text(buffer, "<br><small>SHA-256 <code>")
                    append_html_escaped(buffer, stdin_digest)
                    append_text(buffer, "</code></small>")
                else:
                    append_text(buffer, "<br><small>unavailable</small>")
            append_text(buffer, "</dd></div><div><dt>Environment overrides</dt><dd>")
            environment_index: mutable usize = NATIVE_ZERO.usize()
            environment_first: mutable bool = true
            while environment_index < environment.count |environment_index, environment, environment_first, buffer|:
                environment_stop: mutable usize = environment_index
                while environment_stop < environment.count and environment[environment_stop] != NATIVE_BYTE_NUL |environment_stop, environment|:
                    environment_stop <- environment_stop + NATIVE_ONE.usize()
                environment_equals: mutable usize = environment_stop
                for assignment_index in environment_index..<environment_stop |environment_equals, environment|:
                    if environment[assignment_index] == NATIVE_BYTE_EQUALS:
                        environment_equals <- assignment_index
                        break
                if environment_equals > environment_index:
                    append_text(buffer, ", " if not environment_first else "")
                    environment_name: mutable darray[u8] = []
                    for assignment_index in environment_index..<environment_equals |environment_name, environment|:
                        environment_name.push(environment[assignment_index])
                    append_html_escaped(buffer, environment_name)
                    environment_first <- false
                environment_index <- environment_stop + NATIVE_ONE.usize()
            append_text(buffer, "none" if environment_first else "")
            append_text(buffer, "</dd></div><div><dt>Target arguments</dt><dd><code>")
            if target_arguments.count == NATIVE_ZERO.usize():
                append_text(buffer, "none")
            else:
                for argument_index in 0..<target_arguments.count |argument_index, target_arguments, buffer|:
                    append_text(buffer, " " if argument_index > NATIVE_ZERO.usize() else "")
                    append_html_escaped(buffer, target_arguments[argument_index])
            append_text(buffer, "</code></dd></div><div><dt>Random seed</dt><dd>")
            if random_seed.count == NATIVE_ZERO.usize():
                append_text(buffer, "not controlled")
            else:
                append_html_escaped(buffer, random_seed)
                append_text(buffer, " (")
                append_html_escaped(buffer, random_seed_source)
                append_text(buffer, ")")
            append_text(buffer, "</dd></div><div><dt>Reproducibility policy</dt><dd>environment values redacted; inputs hashed; seed control is opt-in</dd></div></dl></section>")


        def append_html_program_output(buffer: mutable darray[u8]&, program_stdout: darray[u8]&, program_stdout_truncated: bool, program_stderr: darray[u8]&, program_stderr_truncated: bool) -> void can[Abort.Panic, Memory.Allocate]:
            return if program_stdout.count == NATIVE_ZERO.usize() and program_stderr.count == NATIVE_ZERO.usize() and not program_stdout_truncated and not program_stderr_truncated
            append_text(buffer, "<section class='panel' aria-labelledby='target-output-title'><h2 id='target-output-title'>Target output</h2>")
            append_text(buffer, "<details open><summary>stdout")
            append_text(buffer, " (truncated)" if program_stdout_truncated else "")
            append_text(buffer, "</summary><pre>")
            append_html_escaped(buffer, program_stdout)
            append_text(buffer, "</pre></details><details><summary>stderr")
            append_text(buffer, " (truncated)" if program_stderr_truncated else "")
            append_text(buffer, "</summary><pre>")
            append_html_escaped(buffer, program_stderr)
            append_text(buffer, "</pre></details></section>")


        def append_html_report(buffer: mutable darray[u8]&, source: darray[u8]&, source_bytes: darray[u8]&, dependency_digest: darray[u8]&, mode: darray[u8]&, host: NativeHostMetadata, summary: CaptureSummary, exit_code: i64, status: i64, timed_out: bool, timeout_ns: i64, execution_ns: i64, execution_mean_ns: i64, compile_ns: i64, cpu_user_ns: i64, cpu_system_ns: i64, peak_rss_bytes: i64, resource_metrics_available: bool, completed_repetitions: i64, successful_repetitions: i64, program_stdout: darray[u8]&, program_stdout_truncated: bool, program_stderr: darray[u8]&, program_stderr_truncated: bool, working_directory: darray[u8]&, stdin_path: darray[u8]&, environment: darray[u8], target_arguments: darray[darray[u8]], random_seed: darray[u8]&, random_seed_source: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            append_text(buffer, "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Elisa profile</title><style>body{font:15px system-ui,sans-serif;line-height:1.45;max-width:1120px;margin:2rem auto;padding:0 1rem;color:#17202a;background:#f6f8fa}main{background:white;border:1px solid #d0d7de;border-radius:12px;padding:1.5rem;box-shadow:0 4px 20px #0001}h1{margin-top:0}code,pre{font:13px ui-monospace,SFMono-Regular,Menlo,monospace}dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.75rem}dl div{padding:.8rem;background:#f6f8fa;border-radius:8px}dt{color:#57606a;font-size:.8rem}dd{margin:.2rem 0 0;font-weight:650}details{margin-top:1rem;border:1px solid #d8dee4;border-radius:8px;padding:.75rem}summary{cursor:pointer;font-weight:650}pre{overflow:auto;white-space:pre-wrap;word-break:break-word;margin:.75rem 0 0}@media(prefers-color-scheme:dark){body{color:#e6edf3;background:#0d1117}main{background:#161b22;border-color:#30363d}dl div{background:#21262d}details{border-color:#30363d}dt{color:#8b949e}}</style></head><body><main><h1>Elisa profile</h1><p>Native Elisa renderer; records are escaped and shown as inspectable detail.</p><p><strong>Source:</strong> <code>")
            append_html_escaped(buffer, source)
            append_text(buffer, "</code></p><dl><div><dt>Source SHA-256</dt><dd><code>")
            source_digest: darray[u8] = sha256_hex(source_bytes)
            append_html_escaped(buffer, source_digest)
            append_text(buffer, "</code></dd></div><div><dt>Source tree SHA-256</dt><dd><code>")
            if dependency_digest.count > NATIVE_ZERO.usize():
                append_html_escaped(buffer, dependency_digest)
            else:
                append_text(buffer, "unavailable")
            append_text(buffer, "</code></dd></div><div><dt>Status</dt><dd>")
            append_text(buffer, "ok" if exit_code == NATIVE_ZERO else "target failed")
            append_text(buffer, "</dd></div><div><dt>Outcome</dt><dd>")
            append_html_outcome(buffer, summary, status, timed_out)
            append_text(buffer, "</dd></div><div><dt>Signal</dt><dd>")
            append_observed_signal(buffer, status, summary)
            append_text(buffer, "</dd></div><div><dt>Execution</dt><dd>")
            append_millis(buffer, execution_ns)
            append_text(buffer, " ms</dd></div><div><dt>Timeout</dt><dd>")
            if timeout_ns <= NATIVE_ZERO:
                append_text(buffer, "none")
            else:
                append_timeout_seconds(buffer, timeout_ns)
                append_text(buffer, " s")
                append_text(buffer, " (triggered)" if timed_out else "")
            append_text(buffer, "</dd></div><div><dt>Mean execution</dt><dd>")
            append_millis(buffer, execution_mean_ns)
            append_text(buffer, " ms</dd></div><div><dt>CPU</dt><dd>")
            if resource_metrics_available:
                append_millis(buffer, native_saturating_add(cpu_user_ns, cpu_system_ns))
                append_text(buffer, " ms")
            else:
                append_text(buffer, "unavailable")
            append_text(buffer, "</dd></div><div><dt>Peak RSS</dt><dd>")
            if resource_metrics_available:
                append_i64(buffer, peak_rss_bytes)
                append_text(buffer, " bytes")
            else:
                append_text(buffer, "unavailable")
            append_text(buffer, "</dd></div><div><dt>Measured repetitions</dt><dd>")
            append_i64(buffer, successful_repetitions if successful_repetitions > NATIVE_ZERO else completed_repetitions)
            append_text(buffer, "</dd></div><div><dt>Capture completeness</dt><dd>")
            append_text(buffer, "complete" if summary.capture_complete else "partial")
            append_text(buffer, "</dd></div><div><dt>Compilation</dt><dd>")
            append_millis(buffer, compile_ns)
            append_text(buffer, " ms</dd></div><div><dt>Events</dt><dd>")
            append_i64(buffer, summary.events)
            append_text(buffer, "</dd></div><div><dt>Locations</dt><dd>")
            append_i64(buffer, summary.locations)
            append_text(buffer, "</dd></div><div><dt>Dropped events</dt><dd>")
            append_i64(buffer, summary.dropped)
            append_text(buffer, "</dd></div><div><dt>Detail budget</dt><dd>")
            append_text(buffer, "exceeded" if summary.budget_exceeded != NATIVE_ZERO else "not exceeded")
            append_text(buffer, "</dd></div><div><dt>Threads</dt><dd>")
            append_i64(buffer, summary.thread_count)
            append_text(buffer, "</dd></div><div><dt>Collection mode</dt><dd>")
            append_html_escaped(buffer, mode)
            append_text(buffer, "</dd></div>")
            if protocol_field_is(mode, "sample"):
                append_text(buffer, "<div><dt>CPU samples</dt><dd>")
                append_i64(buffer, summary.sample_count)
                append_text(buffer, " captured; ")
                append_i64(buffer, summary.sample_missed)
                append_text(buffer, " missed; ")
                append_i64(buffer, summary.sample_period_microseconds)
                append_text(buffer, " μs period</dd></div>")
            append_capability_html_summary(buffer, mode, summary)
            append_html_host_summary(buffer, host)
            append_text(buffer, "</dl>")
            append_html_workload_summary(buffer, working_directory, stdin_path, environment, target_arguments, random_seed, random_seed_source)
            append_html_program_output(buffer, program_stdout, program_stdout_truncated, program_stderr, program_stderr_truncated)
            append_html_diagnostics(buffer, summary.capture_complete, summary.dropped, summary.call_edge_dropped, summary.stack_dropped, summary.frame_dropped, summary.capture_bytes_dropped, summary.stack_overflow_entries, summary.trace_omitted, summary.crash_signal)
            append_html_thread_loss_diagnostics(buffer, summary.thread_loss_records)
            if summary.active_stack_available:
                append_text(buffer, "<section class='panel' aria-labelledby='active-stack-title'><h2 id='active-stack-title'>Interrupted active stack</h2><p>Tracked depth ")
                append_i64(buffer, summary.active_stack_tracked_depth)
                append_text(buffer, "; overflow depth ")
                append_i64(buffer, summary.active_stack_overflow_depth)
                append_text(buffer, ". This is diagnostic evidence, not completed-call evidence.</p><pre>")
                append_html_escaped(buffer, summary.active_stack_path)
                append_text(buffer, "</pre></section>")
            append_html_source_view(buffer, source, source_bytes, summary.location_records, false)
            append_html_source_metric_explorer(buffer)
            append_html_function_browser(buffer, summary.function_records, summary.folded_records)
            append_html_actionable_summary(buffer)
            append_html_function_explorer(buffer)
            append_html_detail_browsers(buffer, summary.call_edge_records, summary.location_records)
            append_html_flame_graph(buffer, summary.folded_records, not protocol_field_is(mode, "sample"), protocol_field_is(mode, "sample"))
            append_html_flame_metric_explorer(buffer, summary.stack_records)
            append_html_section(buffer, "Folded stacks", summary.stack_records)
            append_html_section(buffer, "CPU samples", summary.sample_records) if protocol_field_is(mode, "sample")
            append_html_section(buffer, "Thread loss", summary.thread_loss_records)
            append_html_view_state(buffer)
            append_html_function_explorer_rebind(buffer)
            append_html_function_explorer_flame_navigation(buffer)
            append_html_function_explorer_source_navigation(buffer)
            append_html_empty_state_behaviors(buffer)
            append_text(buffer, "</main></body></html>\n")


        def append_json_workload(buffer: mutable darray[u8]&, source_bytes: darray[u8]&, dependency_digest: darray[u8]&, working_directory: darray[u8]&, stdin_path: darray[u8]&, environment: darray[u8], target_arguments: darray[darray[u8]], random_seed: darray[u8]&, random_seed_source: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            append_text(buffer, ",\"workload\":{\"source_sha256\":")
            source_digest: darray[u8] = sha256_hex(source_bytes)
            append_json_string(buffer, source_digest)
            append_text(buffer, ",\"source_tree_sha256\":")
            if dependency_digest.count > NATIVE_ZERO.usize():
                append_json_string(buffer, dependency_digest)
            else:
                append_text(buffer, "null")
            append_text(buffer, ",\"source_size_bytes\":")
            append_i64(buffer, source_bytes.count.i64())
            append_text(buffer, ",\"working_directory\":")
            if working_directory.count == NATIVE_ZERO.usize():
                append_text(buffer, "\".\"")
            else:
                append_json_string(buffer, working_directory)
            append_text(buffer, ",\"stdin\":")
            if stdin_path.count == NATIVE_ZERO.usize():
                append_text(buffer, "null")
            else:
                append_text(buffer, "{\"path\":")
                append_json_string(buffer, stdin_path)
                append_text(buffer, ",\"sha256\":")
                stdin_readable: bool = readable_file(stdin_path)
                stdin_data: darray[u8] = read_file(stdin_path) if stdin_readable else []
                stdin_digest: darray[u8] = sha256_hex(stdin_data) if stdin_readable else []
                if stdin_digest.count > NATIVE_ZERO.usize():
                    append_json_string(buffer, stdin_digest)
                else:
                    append_text(buffer, "null")
                append_text(buffer, "}")
            append_text(buffer, ",\"environment_override_keys\":[")
            environment_index: mutable usize = NATIVE_ZERO.usize()
            environment_first: mutable bool = true
            while environment_index < environment.count |environment_index, environment, environment_first|:
                environment_stop: mutable usize = environment_index
                while environment_stop < environment.count and environment[environment_stop] != NATIVE_BYTE_NUL |environment_stop, environment|:
                    environment_stop <- environment_stop + NATIVE_ONE.usize()
                environment_name: mutable darray[u8] = []
                environment_equals: mutable usize = environment_stop
                for assignment_index in environment_index..<environment_stop |environment_name, environment, environment_equals|:
                    if environment[assignment_index] == NATIVE_BYTE_EQUALS:
                        environment_equals <- assignment_index
                        break
                for assignment_index in environment_index..<environment_equals |environment_name, environment|:
                    environment_name.push(environment[assignment_index])
                if environment_name.count > NATIVE_ZERO.usize():
                    append_text(buffer, "," if not environment_first else "")
                    append_json_string(buffer, environment_name)
                    environment_first <- false
                environment_index <- environment_stop + NATIVE_ONE.usize()
            append_text(buffer, "],\"arguments\":[")
            for argument_index in 0..<target_arguments.count |buffer, target_arguments|:
                append_text(buffer, "," if argument_index > NATIVE_ZERO.usize() else "")
                append_json_string(buffer, target_arguments[argument_index])
            append_text(buffer, "],\"reproducibility\":{\"random_seed\":")
            if random_seed.count == NATIVE_ZERO.usize():
                append_text(buffer, "null")
            else:
                append_json_string(buffer, random_seed)
            append_text(buffer, ",\"random_seed_source\":")
            append_json_string(buffer, random_seed_source)
            append_text(buffer, ",\"environment_values\":\"redacted\",\"inputs_hashed\":true}}")


        def append_build_cache(buffer: mutable darray[u8]&, cache: NativeBuildCache) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, ",\"build_cache\":{\"enabled\":")
            append_text(buffer, "true" if cache.enabled else "false")
            append_text(buffer, ",\"status\":")
            append_json_string(buffer, cache.status)
            append_text(buffer, ",\"key\":")
            if cache.key.count == NATIVE_ZERO.usize():
                append_text(buffer, "null")
            else:
                append_json_string(buffer, cache.key)
            append_text(buffer, ",\"explanation\":")
            append_json_string(buffer, cache.explanation)
            append_text(buffer, "}")


        def append_target_build(buffer: mutable darray[u8]&, build_kind: darray[u8]&, executable: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, ",\"target\":{\"build_kind\":")
            append_json_string(buffer, build_kind)
            append_text(buffer, ",\"executable\":")
            if executable.count == NATIVE_ZERO.usize():
                append_text(buffer, "null")
            else:
                append_json_string(buffer, executable)
            append_text(buffer, "}")


        def append_report(
            buffer: mutable darray[u8]&, source: darray[u8]&, source_bytes: darray[u8]&, embed_source: bool, mode: darray[u8]&, compiler_root: darray[u8]&, compiler_branch: darray[u8]&, compiler_commit: darray[u8]&, compiler_dirty: bool, compiler_manifest: darray[u8]&, compiler_stage1: darray[u8]&, stage1_digest: darray[u8]&, runtime_object: darray[u8]&, runtime_digest: darray[u8]&, build_cache: NativeBuildCache, build_kind: darray[u8]&, prebuilt_executable: darray[u8]&, host: NativeHostMetadata, summary: CaptureSummary,
            status: i64, opt_level: i64, event_trace: bool, recent_path: bool, timed_out: bool, recovered: bool, timeout_ns: i64, program_stdout: darray[u8]&, program_stdout_truncated: bool, program_stderr: darray[u8]&, program_stderr_truncated: bool, execution_ns: i64, compile_ns: i64,
            repetition_records: darray[u8]&, requested_repetitions: i64, completed_repetitions: i64, successful_repetitions: i64, failed_repetitions: i64,
            warmup_repetitions: i64, warmup_ns: i64, execution_min_ns: i64, execution_mean_ns: i64, execution_max_ns: i64, execution_median_ns: i64, execution_stdev_ns: i64, execution_ci95_low_ns: i64, execution_ci95_high_ns: i64, execution_ci95_available: bool,
            cpu_user_ns: i64, cpu_system_ns: i64, peak_rss_bytes: i64, resource_metrics_available: bool,
            dependency_digest: darray[u8]&, working_directory: darray[u8]&, stdin_path: darray[u8]&, environment: darray[u8], target_arguments: darray[darray[u8]], random_seed: darray[u8]&, random_seed_source: darray[u8]&
        ) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            append_text(buffer, "{\"schema_version\":")
            append_i64(buffer, NATIVE_REPORT_SCHEMA_VERSION)
            append_text(buffer, ",\"envelope\":{\"major\":")
            append_i64(buffer, NATIVE_REPORT_ENVELOPE_MAJOR)
            append_text(buffer, ",\"minor\":")
            append_i64(buffer, NATIVE_REPORT_ENVELOPE_MINOR)
            append_text(buffer, ",\"kind\":\"profile\",\"compatibility\":\"backward-compatible-v1\"},\"source\":")
            append_json_string(buffer, source)
            append_text(buffer, ",\"compiler\":{\"root\":")
            append_json_string(buffer, compiler_root)
            append_text(buffer, ",\"branch\":")
            append_json_string(buffer, compiler_branch)
            append_text(buffer, ",\"commit\":")
            append_json_string(buffer, compiler_commit)
            append_text(buffer, ",\"dirty\":")
            append_text(buffer, "true" if compiler_dirty else "false")
            append_text(buffer, ",\"manifest\":")
            append_json_string(buffer, compiler_manifest)
            append_text(buffer, ",\"stage1_binary\":")
            append_json_string(buffer, compiler_stage1)
            append_text(buffer, ",\"stage1_sha256\":")
            append_json_optional_sha256(buffer, stage1_digest)
            append_text(buffer, ",\"runtime_object\":")
            append_json_string(buffer, runtime_object)
            append_text(buffer, ",\"runtime_object_sha256\":")
            append_json_optional_sha256(buffer, runtime_digest)
            append_text(buffer, "}")
            append_build_cache(buffer, build_cache)
            append_target_build(buffer, build_kind, prebuilt_executable)
            append_json_host(buffer, host)
            append_json_workload(buffer, source_bytes, dependency_digest, working_directory, stdin_path, environment, target_arguments, random_seed, random_seed_source)
            if embed_source:
                source_digest: darray[u8] = sha256_hex(source_bytes)
                append_text(buffer, ",\"source_snapshot\":{\"sha256\":")
                append_json_string(buffer, source_digest)
                append_text(buffer, ",\"content\":")
                append_json_string(buffer, source_bytes)
                append_text(buffer, "}")
            append_text(buffer, ",\"summary\":{\"events\":")
            append_i64(buffer, summary.events)
            append_text(buffer, ",\"locations\":")
            append_i64(buffer, summary.locations)
            append_text(buffer, ",\"dropped\":")
            append_i64(buffer, summary.dropped)
            append_text(buffer, ",\"statement_events\":")
            append_i64(buffer, summary.statement_events)
            append_text(buffer, ",\"value_events\":")
            append_i64(buffer, summary.value_events)
            append_text(buffer, ",\"function_events\":")
            append_i64(buffer, summary.function_events)
            append_text(buffer, ",\"max_stack_depth\":")
            append_i64(buffer, summary.max_stack_depth)
            append_text(buffer, ",\"stack_overflow_entries\":")
            append_i64(buffer, summary.stack_overflow_entries)
            append_text(buffer, ",\"location_limit\":")
            append_i64(buffer, summary.location_limit)
            append_text(buffer, ",\"call_edge_limit\":")
            append_i64(buffer, summary.call_edge_limit)
            append_text(buffer, ",\"stack_limit\":")
            append_i64(buffer, summary.stack_limit)
            append_text(buffer, ",\"capture_byte_limit\":")
            append_i64(buffer, summary.capture_byte_limit)
            append_text(buffer, ",\"capture_bytes_used\":")
            append_i64(buffer, summary.capture_bytes_used)
            append_text(buffer, ",\"capture_bytes_dropped\":")
            append_i64(buffer, summary.capture_bytes_dropped)
            append_text(buffer, ",\"frame_dropped\":")
            append_i64(buffer, summary.frame_dropped)
            append_text(buffer, ",\"valid_frames\":")
            append_i64(buffer, summary.valid_frames)
            append_text(buffer, ",\"valid_capture_bytes\":")
            append_i64(buffer, summary.valid_capture_bytes)
            append_text(buffer, ",\"detail_budget_exceeded\":")
            append_text(buffer, "true" if summary.budget_exceeded != NATIVE_ZERO else "false")
            append_text(buffer, ",\"dropped_call_edges\":")
            append_i64(buffer, summary.call_edge_dropped)
            append_text(buffer, ",\"dropped_stacks\":")
            append_i64(buffer, summary.stack_dropped)
            append_text(buffer, ",\"crash_signal\":")
            if summary.crash_signal > NATIVE_ZERO:
                append_i64(buffer, summary.crash_signal)
            else:
                append_text(buffer, "null")
            append_text(buffer, ",\"capture_started\":")
            append_text(buffer, "true" if summary.capture_started else "false")
            append_text(buffer, ",\"capture_complete\":")
            append_text(buffer, "true" if summary.capture_started and summary.capture_complete else "false")
            append_text(buffer, ",\"thread_count\":")
            append_i64(buffer, summary.thread_count)
            append_text(buffer, ",\"trace_events_captured\":")
            append_i64(buffer, summary.trace_captured)
            append_text(buffer, ",\"trace_events_omitted\":")
            append_i64(buffer, summary.trace_omitted)
            append_text(buffer, ",\"sample_count\":")
            append_i64(buffer, summary.sample_count)
            append_text(buffer, ",\"sample_missed\":")
            append_i64(buffer, summary.sample_missed)
            append_text(buffer, ",\"sample_period_microseconds\":")
            append_i64(buffer, summary.sample_period_microseconds)
            append_text(buffer, ",\"sampling_setup_failed\":")
            append_i64(buffer, summary.sampling_setup_failed)
            append_text(buffer, ",\"collector_status\":")
            append_i64(buffer, summary.collector_status)
            append_text(buffer, ",\"trace_event_limit\":")
            if not event_trace:
                append_text(buffer, "null")
            else:
                append_i64(buffer, summary.trace_limit)
            append_text(buffer, ",\"trace_complete\":")
            if not event_trace:
                append_text(buffer, "null")
            else:
                append_text(buffer, "true" if summary.trace_omitted == NATIVE_ZERO and summary.trace_captured == summary.events else "false")
            append_text(buffer, "}")
            append_capture_contract(buffer)
            append_numeric_encoding_contract(buffer)
            append_active_stack(buffer, summary)
            append_text(buffer, ",")
            append_quality(buffer, summary, status, event_trace, timed_out, recovered)
            append_text(buffer, ",\"source_mapping\":{\"mode\":\"")
            append_text(buffer, "compiler-line-map" if summary.source_mapping_available else "native-summary")
            append_text(buffer, "\",\"mapped_locations\":")
            append_i64(buffer, summary.source_mapping_mapped)
            append_text(buffer, ",\"unmapped_locations\":")
            append_i64(buffer, summary.source_mapping_unmapped)
            append_text(buffer, "},\"run\":{\"collection_mode\":")
            append_json_string(buffer, mode)
            append_text(buffer, ",\"outcome\":")
            append_run_outcome(buffer, summary, status, timed_out, recovered)
            append_collection_capabilities(buffer, mode, event_trace, recent_path, summary)
            append_text(buffer, ",\"exit_code\":")
            append_observed_exit_code(buffer, status, summary)
            append_text(buffer, ",\"signal\":")
            append_observed_signal(buffer, status, summary)
            append_text(buffer, ",\"location_timing\":")
            append_text(buffer, "false" if protocol_field_is(mode, "sample") else "true")
            append_text(buffer, ",\"timing_clock\":\"cpu\"" if protocol_field_is(mode, "sample") else ",\"timing_clock\":\"wall\"")
            append_text(buffer, ",\"event_trace_enabled\":")
            append_text(buffer, "true" if event_trace else "false")
            append_text(buffer, ",\"trace_events_captured\":")
            append_i64(buffer, summary.trace_captured)
            append_text(buffer, ",\"trace_events_omitted\":")
            append_i64(buffer, summary.trace_omitted)
            append_text(buffer, ",\"trace_event_limit\":")
            if not event_trace:
                append_text(buffer, "null")
            else:
                append_i64(buffer, summary.trace_limit)
            append_text(buffer, ",\"trace_complete\":")
            if not event_trace:
                append_text(buffer, "null")
            else:
                append_text(buffer, "true" if summary.trace_omitted == NATIVE_ZERO and summary.trace_captured == summary.events else "false")
            append_text(buffer, ",\"opt_level\":\"-O")
            append_i64(buffer, opt_level)
            append_text(buffer, "\",\"execution_ms\":")
            append_millis(buffer, execution_ns)
            append_text(buffer, ",\"timeout_s\":")
            if timeout_ns <= NATIVE_ZERO:
                append_text(buffer, "null")
            else:
                append_timeout_seconds(buffer, timeout_ns)
            append_text(buffer, ",\"execution_ms_min\":")
            append_millis(buffer, execution_min_ns)
            append_text(buffer, ",\"execution_ms_mean\":")
            append_millis(buffer, execution_mean_ns)
            append_text(buffer, ",\"execution_ms_max\":")
            append_millis(buffer, execution_max_ns)
            append_text(buffer, ",\"execution_ms_median\":")
            append_millis(buffer, execution_median_ns)
            append_text(buffer, ",\"execution_ms_stdev\":")
            append_millis(buffer, execution_stdev_ns)
            append_text(buffer, ",\"execution_ms_ci95_low\":")
            append_millis(buffer, execution_ci95_low_ns)
            append_text(buffer, ",\"execution_ms_ci95_high\":")
            append_millis(buffer, execution_ci95_high_ns)
            append_text(buffer, ",\"execution_ci95_available\":")
            append_text(buffer, "true" if execution_ci95_available else "false")
            append_text(buffer, ",\"cpu_user_ms\":")
            if resource_metrics_available:
                append_millis(buffer, cpu_user_ns)
            else:
                append_text(buffer, "null")
            append_text(buffer, ",\"cpu_system_ms\":")
            if resource_metrics_available:
                append_millis(buffer, cpu_system_ns)
            else:
                append_text(buffer, "null")
            append_text(buffer, ",\"cpu_ms\":")
            if resource_metrics_available:
                append_millis(buffer, native_saturating_add(cpu_user_ns, cpu_system_ns))
            else:
                append_text(buffer, "null")
            append_text(buffer, ",\"peak_rss_bytes\":")
            if resource_metrics_available:
                append_i64(buffer, peak_rss_bytes)
            else:
                append_text(buffer, "null")
            append_text(buffer, ",\"warmup_ms\":")
            append_millis(buffer, warmup_ns)
            append_text(buffer, ",\"warmup_repetitions\":")
            append_i64(buffer, warmup_repetitions)
            append_text(buffer, ",\"requested_repetitions\":")
            append_i64(buffer, requested_repetitions)
            append_text(buffer, ",\"completed_repetitions\":")
            append_i64(buffer, completed_repetitions)
            append_text(buffer, ",\"successful_repetitions\":")
            append_i64(buffer, successful_repetitions)
            append_text(buffer, ",\"failed_repetitions\":")
            append_i64(buffer, failed_repetitions)
            append_text(buffer, ",\"measurement_repetitions\":")
            append_i64(buffer, successful_repetitions if successful_repetitions > NATIVE_ZERO else completed_repetitions)
            append_text(buffer, ",\"measurement_basis\":\"")
            append_text(buffer, "successful" if successful_repetitions > NATIVE_ZERO else "all_completed")
            append_text(buffer, "\",\"repetitions\":[")
            buffer.extend(repetition_records)
            append_text(buffer, "],\"compile_ms\":")
            append_millis(buffer, compile_ns)
            append_text(buffer, "},")
            append_detail_arrays(buffer, summary)
            append_text(buffer, ",\"thread_loss\":[")
            buffer.extend(summary.thread_loss_records)
            append_text(buffer, "]")
            if program_stderr.count > NATIVE_ZERO.usize():
                append_text(buffer, ",\"program_stderr\":")
                append_json_string(buffer, program_stderr)
            append_text(buffer, ",\"program_stderr_truncated\":")
            append_text(buffer, "true" if program_stderr_truncated else "false")
            if program_stdout.count > NATIVE_ZERO.usize():
                append_text(buffer, ",\"program_stdout\":")
                append_json_string(buffer, program_stdout)
            append_text(buffer, ",\"program_stdout_truncated\":")
            append_text(buffer, "true" if program_stdout_truncated else "false")
            append_text(buffer, "}\n")


        def append_text_report(buffer: mutable darray[u8]&, source: darray[u8]&, mode: darray[u8]&, summary: CaptureSummary, exit_code: i64, status: i64, timed_out: bool, timeout_ns: i64, event_trace: bool, recent_path: bool, execution_ns: i64, compile_ns: i64, program_stdout: darray[u8]&, program_stdout_truncated: bool, program_stderr: darray[u8]&, program_stderr_truncated: bool) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "Elisa profiler\nsource: ")
            for index in 0..<source.count |buffer, source|:
                buffer.push(source[index])
            append_text(buffer, "\nstatus: ")
            append_text(buffer, "ok\n" if exit_code == NATIVE_ZERO else "target failed\n")
            append_text(buffer, "outcome: ")
            append_text_outcome(buffer, summary, status, timed_out)
            append_text(buffer, "\ncapture completeness: ")
            append_text(buffer, "complete\n" if summary.capture_complete else "partial\n")
            append_text(buffer, "collection mode: ")
            for index in 0..<mode.count |buffer, mode|:
                buffer.push(mode[index])
            append_text(buffer, "\n")
            append_capability_text_summary(buffer, mode, summary)
            append_text(buffer, "signal: ")
            append_observed_signal(buffer, status, summary)
            append_text(buffer, "\ntimeout: ")
            if timeout_ns <= NATIVE_ZERO:
                append_text(buffer, "none\n")
            else:
                append_timeout_seconds(buffer, timeout_ns)
                append_text(buffer, " s (triggered)\n" if timed_out else " s\n")
            if summary.active_stack_available:
                append_text(buffer, "active stack (tracked depth ")
                append_i64(buffer, summary.active_stack_tracked_depth)
                append_text(buffer, ", overflow depth ")
                append_i64(buffer, summary.active_stack_overflow_depth)
                append_text(buffer, "): ")
                buffer.extend(summary.active_stack_path)
                append_text(buffer, "\n")
            append_text(buffer, "events: ")
            append_i64(buffer, summary.events)
            append_text(buffer, "\nlocations: ")
            append_i64(buffer, summary.locations)
            append_text(buffer, "\nstatement events: ")
            append_i64(buffer, summary.statement_events)
            append_text(buffer, "\nvalue events: ")
            append_i64(buffer, summary.value_events)
            append_text(buffer, "\nfunction events: ")
            append_i64(buffer, summary.function_events)
            if protocol_field_is(mode, "sample"):
                append_text(buffer, "\nsamples: ")
                append_i64(buffer, summary.sample_count)
                append_text(buffer, " captured, ")
                append_i64(buffer, summary.sample_missed)
                append_text(buffer, " missed at ")
                append_i64(buffer, summary.sample_period_microseconds)
                append_text(buffer, " microseconds\n")
            append_text(buffer, "\nthreads: ")
            append_i64(buffer, summary.thread_count)
            append_text(buffer, "\ndropped: ")
            append_i64(buffer, summary.dropped)
            append_text(buffer, "\ndetail budgets: ")
            append_text(buffer, "exceeded" if summary.budget_exceeded != NATIVE_ZERO else "not exceeded")
            append_text(buffer, " (locations ")
            append_i64(buffer, summary.location_limit)
            append_text(buffer, ", call edges ")
            append_i64(buffer, summary.call_edge_limit)
            append_text(buffer, ", stacks ")
            append_i64(buffer, summary.stack_limit)
            append_text(buffer, "; dropped call edges ")
            append_i64(buffer, summary.call_edge_dropped)
            append_text(buffer, ", stacks ")
            append_i64(buffer, summary.stack_dropped)
            append_text(buffer, ")\n")
            append_text(buffer, "thread loss records: ")
            append_i64(buffer, summary.thread_loss_record_count)
            append_text(buffer, "\n")
            append_text(buffer, "\nexecution: ")
            append_millis(buffer, execution_ns)
            append_text(buffer, " ms\ncompile: ")
            append_millis(buffer, compile_ns)
            append_text(buffer, " ms\n")
            if event_trace:
                append_text(buffer, "event trace: ")
                append_i64(buffer, summary.trace_captured)
                append_text(buffer, " captured, ")
                append_i64(buffer, summary.trace_omitted)
                append_text(buffer, " omitted\n")
            elif recent_path:
                append_text(buffer, "recent path events: ")
                append_i64(buffer, summary.event_records.count)
                append_text(buffer, "\n")
            if program_stdout.count > NATIVE_ZERO.usize() or program_stdout_truncated:
                append_text(buffer, "\nprogram stdout")
                append_text(buffer, " (truncated)" if program_stdout_truncated else "")
                append_text(buffer, ":\n")
                buffer.extend(program_stdout)
                append_text(buffer, "\n")
            if program_stderr.count > NATIVE_ZERO.usize() or program_stderr_truncated:
                append_text(buffer, "\nprogram stderr")
                append_text(buffer, " (truncated)" if program_stderr_truncated else "")
                append_text(buffer, ":\n")
                buffer.extend(program_stderr)
                append_text(buffer, "\n")


        def doctor(argc: i64, slots: mutable cstr&&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            output_path: mutable darray[u8] = []
            index: mutable i64 = NATIVE_FIRST_OPTION_INDEX
            while index < argc |index, slots, output_path|:
                argument: cstr = slots[index].cast[cstr]
                if profiler_ffi_strcmp(argument, "--format") == NATIVE_ZERO:
                    return report_error("doctor supports only --format json") if index + NATIVE_ONE >= argc or profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "json") != NATIVE_ZERO
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--output") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "-o") == NATIVE_ZERO:
                    return report_error("--output requires a path") if index + NATIVE_ONE >= argc
                    copy_cstr(output_path, slots[index + NATIVE_ONE].cast[cstr])
                    index <- index + NATIVE_TWO
                    continue
                return report_error("unknown doctor option")
            compiler_root: mutable darray[u8] = []
            argv_zero: cstr = slots[NATIVE_ZERO].cast[cstr]
            environment_or_executable("ELISA_COMPILER_ROOT", "../elisa-compiler-worktrees/profiler", argv_zero, "/../../elisa-compiler-worktrees/profiler", compiler_root)
            stage1: mutable darray[u8] = []
            environment_or_executable("ELISA_STAGE1_BIN", "../elisa-compiler-worktrees/profiler/bin/elisac-stage1", argv_zero, "/../../elisa-compiler-worktrees/profiler/bin/elisac-stage1", stage1)
            runtime: mutable darray[u8] = []
            environment_or_executable("ELISA_RUNTIME_OBJ", "../elisa-compiler-worktrees/profiler/build/runtime/elisacore_runtime.o", argv_zero, "/../../elisa-compiler-worktrees/profiler/build/runtime/elisacore_runtime.o", runtime)
            collector: mutable darray[u8] = []
            environment_or_executable("ELISA_PROFILER_RUNTIME_C", "scripts/profiler_runtime.c", argv_zero, "/../scripts/profiler_runtime.c", collector)
            manifest_path: darray[u8] = path_with_suffix(compiler_root, "/build/compiler-build-manifest.json")
            integration_ledger: mutable darray[u8] = []
            environment_or_executable("ELISA_COMPILER_INTEGRATION_LEDGER", "build/compiler-integration-ledger.json", argv_zero, "/../build/compiler-integration-ledger.json", integration_ledger)
            compiler_ok: bool = readable_file(compiler_root)
            stage1_ok: bool = executable_available(stage1)
            runtime_ok: bool = readable_file(runtime)
            collector_ok: bool = readable_file(collector)
            manifest_data: darray[u8] = read_file(manifest_path)
            ledger_data: darray[u8] = read_file(integration_ledger)
            manifest_ok: mutable bool = false
            if manifest_data.count > NATIVE_ZERO.usize():
                freshness_start: i64 = json_key_value_start(manifest_data, "freshness", NATIVE_ZERO.usize(), manifest_data.count)
                if freshness_start >= NATIVE_ZERO:
                    freshness_stop: i64 = json_object_end(manifest_data, freshness_start.usize(), manifest_data.count)
                    manifest_usable: mutable bool = false
                    manifest_ok <- freshness_stop >= NATIVE_ZERO and json_read_bool_field(manifest_data, "usable", freshness_start.usize(), freshness_stop.usize(), &manifest_usable) and manifest_usable
            ledger_ok: mutable bool = false
            if ledger_data.count > NATIVE_ZERO.usize() and json_document_is_object(ledger_data):
                ledger_summary: i64 = json_key_value_start(ledger_data, "summary", NATIVE_ZERO.usize(), ledger_data.count)
                if ledger_summary >= NATIVE_ZERO:
                    ledger_summary_stop: i64 = json_object_end(ledger_data, ledger_summary.usize(), ledger_data.count)
                    ancestry_complete: mutable bool = false
                    ledger_ok <- ledger_summary_stop >= NATIVE_ZERO and json_read_bool_field(ledger_data, "ancestry_complete", ledger_summary.usize(), ledger_summary_stop.usize(), &ancestry_complete) and ancestry_complete
            all_ok: bool = compiler_ok and stage1_ok and runtime_ok and collector_ok and manifest_ok and ledger_ok
            host: NativeHostMetadata = native_host_metadata()
            report: mutable darray[u8] = []
            append_text(report, "{\"ok\":")
            append_text(report, "true" if all_ok else "false")
            append_text(report, ",\"compiler_root\":")
            append_json_string(report, compiler_root)
            append_text(report, ",\"checks\":{\"compiler_root\":")
            append_text(report, "true" if compiler_ok else "false")
            append_text(report, ",\"stage1_binary\":")
            append_text(report, "true" if stage1_ok else "false")
            append_text(report, ",\"runtime_object\":")
            append_text(report, "true" if runtime_ok else "false")
            append_text(report, ",\"collector_source\":")
            append_text(report, "true" if collector_ok else "false")
            append_text(report, ",\"compiler_manifest\":")
            append_text(report, "true" if manifest_ok else "false")
            append_text(report, ",\"branch_coverage\":")
            append_text(report, "true" if ledger_ok else "false")
            append_text(report, "},\"paths\":{\"stage1_binary\":")
            append_json_string(report, stage1)
            append_text(report, ",\"runtime_object\":")
            append_json_string(report, runtime)
            append_text(report, ",\"collector_source\":")
            append_json_string(report, collector)
            append_text(report, ",\"compiler_manifest\":")
            append_json_string(report, manifest_path)
            append_text(report, ",\"integration_ledger\":")
            append_json_string(report, integration_ledger)
            append_text(report, "},\"host\":")
            if host.available:
                append_text(report, "{\"os\":")
                append_json_string(report, host.os) if host.os.count > NATIVE_ZERO.usize()
                append_text(report, "null") if host.os.count == NATIVE_ZERO.usize()
                append_text(report, ",\"architecture\":")
                append_json_string(report, host.architecture) if host.architecture.count > NATIVE_ZERO.usize()
                append_text(report, "null") if host.architecture.count == NATIVE_ZERO.usize()
                append_text(report, "}")
            else:
                append_text(report, "null")
            append_text(report, ",\"capabilities\":{\"launch\":{\"status\":\"supported\",\"mode\":\"direct_execv\"},\"wall_timing\":{\"status\":\"supported\",\"clock\":\"CLOCK_MONOTONIC\"},\"cpu_sampling\":{\"status\":\"experimental\",\"backend\":\"SIGPROF_ITIMER_PROF\",\"scope\":\"instrumented_call_stack\"},\"attach\":{\"status\":\"unsupported\",\"reason\":\"launch_mode_only\"},\"allocation\":{\"status\":\"unsupported\",\"reason\":\"allocator_lifecycle_hooks_unavailable\"},\"tasks\":{\"status\":\"unsupported\",\"reason\":\"task_lifecycle_hooks_unavailable\"},\"unwinding\":{\"status\":\"unsupported\",\"reason\":\"raw_native_unwind_not_emitted\"}}}\n")
            if output_path.count > NATIVE_ZERO.usize():
                return NATIVE_ZERO if write_file(output_path, report)
                return report_error("could not write doctor report")
            _ = write_all_fd(NATIVE_STANDARD_OUTPUT, report) can Console
            return NATIVE_ZERO if all_ok else NATIVE_TWO


        def append_recovery_metadata(buffer: mutable darray[u8]&, manifest_path: darray[u8]&, capture_path: darray[u8]&, state: darray[u8]&, source_digest: darray[u8]&, capture_bytes: i64, summary: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            return if buffer.count < NATIVE_TWO.usize()
            buffer.count <- buffer.count - NATIVE_TWO.usize()
            append_text(buffer, ",\"recovery\":{\"kind\":\"partial-capture\",\"state\":")
            append_json_string(buffer, state)
            append_text(buffer, ",\"manifest\":")
            append_json_string(buffer, manifest_path)
            append_text(buffer, ",\"capture_path\":")
            append_json_string(buffer, capture_path)
            append_text(buffer, ",\"source_sha256\":")
            append_json_string(buffer, source_digest)
            append_text(buffer, ",\"capture_bytes\":")
            append_i64(buffer, capture_bytes)
            append_text(buffer, ",\"valid_frames\":")
            append_i64(buffer, summary.valid_frames)
            append_text(buffer, ",\"valid_bytes\":")
            append_i64(buffer, summary.valid_capture_bytes)
            append_text(buffer, ",\"tail_truncated\":")
            append_text(buffer, "true" if summary.valid_capture_bytes < capture_bytes else "false")
            append_text(buffer, "}}\n")


        def append_recovered_report(buffer: mutable darray[u8]&, source: darray[u8]&, source_bytes: darray[u8]&, mode: darray[u8]&, summary: CaptureSummary, manifest_path: darray[u8]&, capture_path: darray[u8]&, state: darray[u8]&, source_digest: darray[u8]&, capture_bytes: i64) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            compiler_root: mutable darray[u8] = []
            compiler_branch: mutable darray[u8] = []
            compiler_commit: mutable darray[u8] = []
            compiler_manifest: mutable darray[u8] = []
            compiler_stage1: mutable darray[u8] = []
            stage1_digest: mutable darray[u8] = []
            runtime_object: mutable darray[u8] = []
            runtime_digest: mutable darray[u8] = []
            empty_build_cache: NativeBuildCache = empty_native_build_cache()
            recovered_build_kind: mutable darray[u8] = []
            append_text(recovered_build_kind, "recovered")
            empty_prebuilt_executable: mutable darray[u8] = []
            append_text(compiler_root, "unavailable-recovery")
            append_text(compiler_branch, "unavailable-recovery")
            append_text(compiler_commit, "unavailable-recovery")
            append_text(compiler_manifest, "unavailable-recovery")
            append_text(compiler_stage1, "unavailable-recovery")
            append_text(runtime_object, "unavailable-recovery")
            repetition_records: mutable darray[u8] = []
            empty_program_stdout: mutable darray[u8] = []
            empty_program_stderr: mutable darray[u8] = []
            empty_dependency_digest: mutable darray[u8] = []
            empty_working_directory: mutable darray[u8] = []
            empty_stdin_path: mutable darray[u8] = []
            empty_environment: mutable darray[u8] = []
            empty_target_arguments: mutable darray[darray[u8]] = []
            empty_random_seed: mutable darray[u8] = []
            empty_random_seed_source: mutable darray[u8] = []
            append_text(empty_random_seed_source, "not_controlled")
            empty_host: NativeHostMetadata = empty_native_host_metadata()
            recovery_result: TargetRunResult = TargetRunResult{
                status: NATIVE_NEGATIVE_ONE,
                collector_status: NATIVE_COLLECTOR_STATUS_UNKNOWN,
                elapsed_ns: NATIVE_ZERO,
                timed_out: false,
                resource_available: false,
                cpu_user_ns: NATIVE_ZERO,
                cpu_system_ns: NATIVE_ZERO,
                peak_rss_bytes: NATIVE_ZERO,
            }
            append_repetition_record(&repetition_records, NATIVE_ONE, NATIVE_ONE, recovery_result, summary, false, false)
            append_report(
                buffer, source, source_bytes, false, mode, compiler_root, compiler_branch, compiler_commit,
                true, compiler_manifest, compiler_stage1, stage1_digest, runtime_object, runtime_digest, empty_build_cache, recovered_build_kind, empty_prebuilt_executable, empty_host, summary, NATIVE_NEGATIVE_ONE, NATIVE_ZERO, false, false, false, true,
                NATIVE_ZERO, empty_program_stdout, false, empty_program_stderr, false, NATIVE_ZERO, NATIVE_ZERO, repetition_records,
                NATIVE_ONE, NATIVE_ONE, NATIVE_ZERO, NATIVE_ONE, NATIVE_ZERO, NATIVE_ZERO,
                NATIVE_ZERO, NATIVE_ZERO, NATIVE_ZERO, NATIVE_ZERO, NATIVE_ZERO, NATIVE_ZERO, NATIVE_ZERO,
                false, NATIVE_ZERO, NATIVE_ZERO, NATIVE_ZERO, false,
                empty_dependency_digest, empty_working_directory, empty_stdin_path, empty_environment, empty_target_arguments, empty_random_seed, empty_random_seed_source)
            append_recovery_metadata(buffer, manifest_path, capture_path, state, source_digest, capture_bytes, summary)


        def recover_offline(argc: i64, slots: mutable cstr&&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            return report_error("usage: elisa-profiler recover MANIFEST [--format json|text|folded|speedscope|html] [--output PATH]") if argc < NATIVE_MIN_PATH_ARGUMENTS
            manifest_path: mutable darray[u8] = []
            output_path: mutable darray[u8] = []
            format_json: mutable bool = false
            format_text: mutable bool = false
            format_folded: mutable bool = false
            format_speedscope: mutable bool = false
            format_html: mutable bool = false
            manifest_seen: mutable bool = false
            index: mutable i64 = NATIVE_FIRST_OPTION_INDEX
            while index < argc |index, slots, manifest_path, output_path, format_json, format_text, format_folded, format_speedscope, format_html, manifest_seen|:
                argument: cstr = slots[index].cast[cstr]
                if profiler_ffi_strcmp(argument, "--format") == NATIVE_ZERO:
                    return report_error("--format requires json, text, folded, speedscope, or html") if index + NATIVE_ONE >= argc
                    if profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "json") == NATIVE_ZERO:
                        format_json <- true
                        format_text <- false
                        format_folded <- false
                        format_speedscope <- false
                        format_html <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "text") == NATIVE_ZERO:
                        format_json <- false
                        format_text <- true
                        format_folded <- false
                        format_speedscope <- false
                        format_html <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "folded") == NATIVE_ZERO:
                        format_json <- false
                        format_text <- false
                        format_folded <- true
                        format_speedscope <- false
                        format_html <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "speedscope") == NATIVE_ZERO:
                        format_json <- false
                        format_text <- false
                        format_folded <- false
                        format_speedscope <- true
                        format_html <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "html") == NATIVE_ZERO:
                        format_json <- false
                        format_text <- false
                        format_folded <- false
                        format_speedscope <- false
                        format_html <- true
                    else:
                        return report_error("--format requires json, text, folded, speedscope, or html")
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--output") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "-o") == NATIVE_ZERO:
                    return report_error("--output requires a path") if index + NATIVE_ONE >= argc
                    copy_cstr(output_path, slots[index + NATIVE_ONE].cast[cstr])
                    index <- index + NATIVE_TWO
                    continue
                if argument[NATIVE_ZERO.usize()] == NATIVE_BYTE_MINUS:
                    return report_error("unknown recover option")
                return report_error("recover accepts exactly one manifest path") if manifest_seen
                copy_cstr(manifest_path, argument)
                manifest_seen <- true
                index <- index + NATIVE_ONE
            return report_error("recover requires a manifest path") if not manifest_seen
            return report_error("recover requires --format json, text, folded, speedscope, or html") if not format_json and not format_text and not format_folded and not format_speedscope and not format_html
            manifest: darray[u8] = read_file(manifest_path)
            return report_error("capture manifest could not be read") if manifest.count == NATIVE_ZERO.usize()
            manifest_state: mutable darray[u8] = []
            source: mutable darray[u8] = []
            source_digest: mutable darray[u8] = []
            mode: mutable darray[u8] = []
            capture_path: mutable darray[u8] = []
            return report_error("capture manifest is malformed or unsupported") if not json_read_string_field(manifest, "state", NATIVE_ZERO.usize(), manifest.count, &manifest_state)
            return report_error("capture manifest is malformed or unsupported") if not json_read_string_field(manifest, "source", NATIVE_ZERO.usize(), manifest.count, &source)
            return report_error("capture manifest is malformed or unsupported") if not json_read_string_field(manifest, "source_sha256", NATIVE_ZERO.usize(), manifest.count, &source_digest)
            if not json_read_string_field(manifest, "collection_mode", NATIVE_ZERO.usize(), manifest.count, &mode):
                append_text(mode, "full")
            return report_error("capture manifest is malformed or unsupported") if not json_read_string_field(manifest, "capture_path", NATIVE_ZERO.usize(), manifest.count, &capture_path)
            capture: darray[u8] = read_file(capture_path)
            return report_error("indexed capture file could not be read") if capture.count == NATIVE_ZERO.usize()
            source_bytes: darray[u8] = read_file(source)
            return report_error("source file could not be read for recovery") if source_bytes.count == NATIVE_ZERO.usize()
            return report_error("source changed since capture; recovery would misattribute locations") if not byte_arrays_equal(source_digest, sha256_hex(source_bytes))
            recovery_source_map_flat_lines: mutable darray[i64] = []
            recovery_source_map_source_lines: mutable darray[i64] = []
            recovery_source_map_data: mutable darray[u8] = []
            recovery_path_maps: mutable darray[NativePathMap] = []
            summary: CaptureSummary = parse_capture(capture, source, recovery_path_maps, recovery_source_map_data, recovery_source_map_flat_lines, recovery_source_map_source_lines, true, NATIVE_ONE, not protocol_field_is(mode, "sample"))
            if summary.malformed:
                return report_protocol_json_error(summary) if format_json else report_protocol_error(summary)
            if summary.valid_frames == NATIVE_ZERO:
                return report_json_error("empty_capture", "capture contains no complete framed records") if format_json else report_error("capture contains no complete framed records")
            recovered: mutable darray[u8] = []
            append_recovered_report(&recovered, source, source_bytes, mode, summary, manifest_path, capture_path, manifest_state, source_digest, capture.count.i64())
            rendered: mutable darray[u8] = []
            if format_json:
                rendered.extend(recovered)
            else:
                recovered_profile: mutable NativeOfflineProfile = empty_native_offline_profile()
                return report_error("recovered capture is malformed or unsupported") if not read_offline_profile(recovered, &recovered_profile)
                if format_text:
                    return report_error("recovered capture is not a native JSON profile") if not append_offline_text_profile(&rendered, recovered_profile)
                elif format_folded:
                    return report_error("recovered capture is not a native JSON profile") if not append_offline_folded_report(&rendered, recovered_profile)
                elif format_speedscope:
                    return report_error("recovered capture is not a native JSON profile") if not append_offline_speedscope_report(&rendered, recovered_profile)
                elif format_html:
                    return report_error("recovered capture is not a native JSON profile") if not append_offline_html_profile(&rendered, recovered_profile)
            if output_path.count > NATIVE_ZERO.usize():
                return NATIVE_ZERO if write_file(output_path, rendered)
                return report_error("could not write recovered profile")
            _ = write_all_fd(NATIVE_STANDARD_OUTPUT, rendered) can Console
            return NATIVE_ZERO


        def report_offline(argc: i64, slots: mutable cstr&&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            return report_error("usage: elisa-profiler report CAPTURE [--format json|text|folded|speedscope|html] [--source PATH] [--output PATH]") if argc < NATIVE_MIN_PATH_ARGUMENTS
            capture_path: mutable darray[u8] = []
            source_override: mutable darray[u8] = []
            output_path: mutable darray[u8] = []
            format_json: mutable bool = false
            format_text: mutable bool = false
            format_folded: mutable bool = false
            format_speedscope: mutable bool = false
            format_html: mutable bool = false
            capture_seen: mutable bool = false
            source_override_seen: mutable bool = false
            index: mutable i64 = NATIVE_FIRST_OPTION_INDEX
            while index < argc |index, slots, capture_path, source_override, output_path, format_json, format_text, format_folded, format_speedscope, format_html, capture_seen, source_override_seen|:
                argument: cstr = slots[index].cast[cstr]
                if profiler_ffi_strcmp(argument, "--format") == NATIVE_ZERO:
                    return report_error("--format requires json, text, folded, speedscope, or html") if index + NATIVE_ONE >= argc
                    if profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "json") == NATIVE_ZERO:
                        format_json <- true
                        format_text <- false
                        format_folded <- false
                        format_speedscope <- false
                        format_html <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "text") == NATIVE_ZERO:
                        format_json <- false
                        format_text <- true
                        format_folded <- false
                        format_speedscope <- false
                        format_html <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "folded") == NATIVE_ZERO:
                        format_json <- false
                        format_text <- false
                        format_folded <- true
                        format_speedscope <- false
                        format_html <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "speedscope") == NATIVE_ZERO:
                        format_json <- false
                        format_text <- false
                        format_folded <- false
                        format_speedscope <- true
                        format_html <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "html") == NATIVE_ZERO:
                        format_json <- false
                        format_text <- false
                        format_folded <- false
                        format_speedscope <- false
                        format_html <- true
                    else:
                        return report_error("--format requires json, text, folded, speedscope, or html")
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--source") == NATIVE_ZERO:
                    return report_error("--source requires a path") if index + NATIVE_ONE >= argc
                    return report_error("report accepts --source only once") if source_override_seen
                    copy_cstr(source_override, slots[index + NATIVE_ONE].cast[cstr])
                    source_override_seen <- true
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--output") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "-o") == NATIVE_ZERO:
                    return report_error("--output requires a path") if index + NATIVE_ONE >= argc
                    copy_cstr(output_path, slots[index + NATIVE_ONE].cast[cstr])
                    index <- index + NATIVE_TWO
                    continue
                if argument[NATIVE_ZERO.usize()] == NATIVE_BYTE_MINUS:
                    return report_error("unknown report option")
                return report_error("report accepts exactly one capture path") if capture_seen
                copy_cstr(capture_path, argument)
                capture_seen <- true
                index <- index + NATIVE_ONE
            return report_error("report requires a capture path") if not capture_seen
            return report_error("report requires --format json, text, folded, speedscope, or html") if not format_json and not format_text and not format_folded and not format_speedscope and not format_html
            report: darray[u8] = read_file(capture_path)
            return report_error("capture could not be read") if report.count == NATIVE_ZERO.usize()
            capture: mutable darray[u8] = []
            if not unwrap_profile_artifact(report, &capture):
                return report_json_error("malformed_profile_artifact", "capture artifact is malformed or unsupported") if format_json else report_error("capture artifact is malformed or unsupported")
            offline_profile: mutable NativeOfflineProfile = empty_native_offline_profile()
            if not read_offline_profile(capture, &offline_profile):
                return report_json_error("malformed_profile", "capture report is malformed or unsupported") if format_json else report_error("capture report is malformed or unsupported")
            if source_override_seen:
                return report_error("capture does not contain workload identity") if offline_profile.workload.count == NATIVE_ZERO.usize()
                return report_error("capture does not contain a source SHA-256 identity") if not offline_profile.source_digest_available
                source_bytes: darray[u8] = read_file(source_override)
                return report_error("source file could not be read for report verification") if source_bytes.count == NATIVE_ZERO.usize()
                return report_error("source changed since capture; report locations would be misattributed") if not byte_arrays_equal(offline_profile.source_digest, sha256_hex(source_bytes))
                offline_profile.source_snapshot <- []
                offline_profile.source_snapshot.extend(source_bytes)
            rendered: mutable darray[u8] = []
            if format_text:
                return report_error("offline capture is not a native JSON profile") if not append_offline_text_profile(&rendered, offline_profile)
            elif format_folded:
                return report_error("offline capture is not a native JSON profile") if not append_offline_folded_report(&rendered, offline_profile)
            elif format_speedscope:
                return report_error("offline capture is not a native JSON profile") if not append_offline_speedscope_report(&rendered, offline_profile)
            elif format_html:
                return report_error("offline capture is not a native JSON profile") if not append_offline_html_profile(&rendered, offline_profile)
            else:
                rendered.extend(capture)
            if output_path.count > NATIVE_ZERO.usize():
                return NATIVE_ZERO if write_file(output_path, rendered)
                return report_error("could not write offline report")
            _ = write_all_fd(NATIVE_STANDARD_OUTPUT, rendered) can Console
            return NATIVE_ZERO
        
        
    public:
        def run(argc: i64, argv: mutable void&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            return report_error("usage: elisa-profiler profile|record SOURCE [options including --path-map FROM=TO, --cache-dir PATH, --no-cache, or --prebuilt EXECUTABLE] [-- TARGET_ARGS...] or report CAPTURE [--format json|text|folded|speedscope|html] [--source PATH] [--output PATH] or recover MANIFEST [--format json|text|folded|speedscope|html] [--output PATH]") if argc < NATIVE_MIN_COMMAND_ARGUMENTS
            slots: mutable cstr&& = argv.cast[mutable cstr&&]
            first: cstr = slots[NATIVE_COMMAND_ARGUMENT_INDEX].cast[cstr]
            return report_offline(argc, slots) if profiler_ffi_strcmp(first, "report") == NATIVE_ZERO
            return recover_offline(argc, slots) if profiler_ffi_strcmp(first, "recover") == NATIVE_ZERO
            return compare_offline(argc, slots) if profiler_ffi_strcmp(first, "compare") == NATIVE_ZERO
            return doctor(argc, slots) if profiler_ffi_strcmp(first, "doctor") == NATIVE_ZERO
            return benchmark(argc, slots) if profiler_ffi_strcmp(first, "benchmark") == NATIVE_ZERO
            return baseline(argc, slots) if profiler_ffi_strcmp(first, "baseline") == NATIVE_ZERO
            return report_error("unknown command; use profile, record, report, recover, compare, benchmark, baseline, or doctor") if profiler_ffi_strcmp(first, "profile") != NATIVE_ZERO and profiler_ffi_strcmp(first, "record") != NATIVE_ZERO and profiler_ffi_strcmp(first, "recover") != NATIVE_ZERO
            return report_error("usage: elisa-profiler profile|record SOURCE [--format json] [--mode sample] [--sample-period-us MICROSECONDS] [--output PATH] [--progress PATH] [--path-map FROM=TO] [--cache-dir PATH|--no-cache] [--prebuilt EXECUTABLE] [--artifact-output PATH] [--embed-source] [--cwd PATH] [--stdin PATH] [--env KEY=VALUE] [--random-seed SEED] [--timeout SECONDS] [-- TARGET_ARGS...]") if argc < NATIVE_MIN_PATH_ARGUMENTS
        
            source: mutable darray[u8] = []
            output: mutable darray[u8] = []
            progress_path: mutable darray[u8] = []
            path_maps: mutable darray[NativePathMap] = []
            artifact_output: mutable darray[u8] = []
            embed_source: mutable bool = false
            opt_level: mutable i64 = NATIVE_ZERO
            event_trace: mutable bool = false
            recent_path: mutable bool = false
            format_text: mutable bool = false
            format_folded: mutable bool = false
            format_html: mutable bool = false
            format_speedscope: mutable bool = false
            mode: mutable darray[u8] = []
            append_text(mode, "full")
            mode_seen: mutable bool = false
            diagnostic_mode: mutable bool = false
            requested_repetitions: mutable i64 = NATIVE_ONE
            warmup_repetitions: mutable i64 = NATIVE_ZERO
            trace_limit: mutable i64 = NATIVE_DEFAULT_TRACE_LIMIT
            sample_period_microseconds: mutable i64 = NATIVE_DEFAULT_SAMPLE_PERIOD_MICROSECONDS
            capture_byte_limit: mutable i64 = NATIVE_DEFAULT_CAPTURE_BYTES
            timeout_ns: mutable i64 = NATIVE_ZERO
            working_directory: mutable darray[u8] = []
            stdin_path: mutable darray[u8] = []
            environment: mutable darray[u8] = []
            target_arguments: mutable darray[darray[u8]] = []
            random_seed: mutable darray[u8] = []
            random_seed_source: mutable darray[u8] = []
            if copy_environment("ELISA_RANDOM_SEED", random_seed):
                append_text(random_seed_source, "environment")
            else:
                append_text(random_seed_source, "not_controlled")
            cache_directory: mutable darray[u8] = []
            cache_requested: mutable bool = false
            cache_disabled: mutable bool = false
            prebuilt_executable: mutable darray[u8] = []
            prebuilt_requested: mutable bool = false
            source_seen: mutable bool = false
            index: mutable i64 = NATIVE_FIRST_OPTION_INDEX
            while index < argc |index, slots, source, output, progress_path, path_maps, artifact_output, embed_source, opt_level, event_trace, recent_path, format_text, format_folded, format_html, format_speedscope, mode, mode_seen, diagnostic_mode, requested_repetitions, warmup_repetitions, trace_limit, sample_period_microseconds, capture_byte_limit, timeout_ns, working_directory, stdin_path, environment, target_arguments, random_seed, random_seed_source, cache_directory, cache_requested, cache_disabled, prebuilt_executable, prebuilt_requested, source_seen|:
                argument: cstr = slots[index].cast[cstr]
                if profiler_ffi_strcmp(argument, "--") == NATIVE_ZERO:
                    index <- index + NATIVE_ONE
                    while index < argc |index, slots, target_arguments|:
                        target_argument: mutable darray[u8] = []
                        copy_cstr(target_argument, slots[index].cast[cstr])
                        target_arguments.push(target_argument)
                        index <- index + NATIVE_ONE
                    continue
                if profiler_ffi_strcmp(argument, "--format") == NATIVE_ZERO:
                    return report_error("--format requires json, text, folded, speedscope, or html") if index + NATIVE_ONE >= argc
                    if profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "json") == NATIVE_ZERO:
                        format_text <- false
                        format_folded <- false
                        format_html <- false
                        format_speedscope <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "text") == NATIVE_ZERO:
                        format_text <- true
                        format_folded <- false
                        format_html <- false
                        format_speedscope <- false
                    elif profiler_ffi_strcmp(slots[index + NATIVE_ONE].cast[cstr], "folded") == NATIVE_ZERO:
