                    copy_cstr(artifact_output, slots[index + NATIVE_ONE].cast[cstr])
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--mode") == NATIVE_ZERO:
                    return report_error("--mode requires full, functions, statements, values, or diagnostic") if index + NATIVE_ONE >= argc or mode_seen
                    selected_mode: cstr = slots[index + NATIVE_ONE].cast[cstr]
                    return report_error("sampling mode is not available in this build; use functions, statements, values, full, or diagnostic") if profiler_ffi_strcmp(selected_mode, "sample") == NATIVE_ZERO or profiler_ffi_strcmp(selected_mode, "sampling") == NATIVE_ZERO
                    return report_error("--mode requires full, functions, statements, values, or diagnostic") if profiler_ffi_strcmp(selected_mode, "full") != NATIVE_ZERO and profiler_ffi_strcmp(selected_mode, "functions") != NATIVE_ZERO and profiler_ffi_strcmp(selected_mode, "statements") != NATIVE_ZERO and profiler_ffi_strcmp(selected_mode, "values") != NATIVE_ZERO and profiler_ffi_strcmp(selected_mode, "diagnostic") != NATIVE_ZERO
                    mode <- []
                    copy_cstr(mode, selected_mode)
                    mode_seen <- true
                    diagnostic_mode <- profiler_ffi_strcmp(selected_mode, "diagnostic") == NATIVE_ZERO
                    index <- index + NATIVE_TWO
