# Elisa-native profiler front door.
#
# This is the first migration slice away from the Python implementation. It owns the
# compile -> instrument -> run -> protocol decode -> JSON report path. The low-level C
# collector remains an ABI/runtime component; all orchestration and report policy lives here.
#
# The initial native slice intentionally emits summary-only v1 reports. Detail records and
# offline renderers are being ported behind the same model, with the existing implementation
# serving as a golden-output oracle during the transition.
include "../../../elisa-compiler-worktrees/profiler/elisacore_std/collections.elisa"

struct ProfilerNativeTimespec:
    seconds: i64
    nanoseconds: i64

@link_name("read")
extern profiler_ffi_read(fd: i64, buf: u8&, count: usize) -> i64 can[Console]
@link_name("write")
extern profiler_ffi_write(fd: i64, buf: u8&, count: usize) -> i64 can[Console]
@link_name("open")
extern profiler_ffi_open(path: cstr, flags: i64, ...) -> i64
@link_name("close")
extern profiler_ffi_close(fd: i64) -> i64
@link_name("system")
extern profiler_ffi_system(command: cstr) -> i64
@link_name("getenv")
extern profiler_ffi_getenv(name: cstr) -> u8&?
@link_name("mkdir")
extern profiler_ffi_mkdir(path: cstr, mode: u16) -> i64
@link_name("unlink")
extern profiler_ffi_unlink(path: cstr) -> i64
@link_name("rmdir")
extern profiler_ffi_rmdir(path: cstr) -> i64
@link_name("strcmp")
extern profiler_ffi_strcmp(left: cstr, right: cstr) -> i64
@link_name("getpid")
extern profiler_ffi_getpid() -> i64
@link_name("access")
extern profiler_ffi_access(path: cstr, mode: i64) -> i64
@link_name("setenv")
extern profiler_ffi_setenv(name: cstr, value: cstr, overwrite: i64) -> i64
@link_name("unsetenv")
extern profiler_ffi_unsetenv(name: cstr) -> i64
@link_name("fork")
extern profiler_ffi_fork() -> i64
@link_name("execv")
extern profiler_ffi_execv(path: cstr, argv: mutable cstr&&) -> i64
@link_name("waitpid")
extern profiler_ffi_waitpid(pid: i64, status: mutable i64&, options: i64) -> i64
@link_name("dup2")
extern profiler_ffi_dup2(old_fd: i64, new_fd: i64) -> i64
@link_name("_exit")
extern profiler_ffi_process_exit(status: i64) -> void
@link_name("clock_gettime")
extern profiler_ffi_clock_gettime(clock_id: i64, timestamp: mutable ProfilerNativeTimespec&) -> i64
@link_name("sview_len")
extern profiler_ffi_sview_len(view: sview) -> usize
@link_name("sview_at")
extern profiler_ffi_sview_at(view: sview, index: usize) -> u8

module ProfilerNative:
    private:
        # All implementation details stay private to the profiler facade. The only
        # source-level API exported by this module is `run`; libc symbols above are
        # deliberately aliased to keep the global FFI namespace collision-free.
        const NATIVE_O_RDONLY: i64 = 0
        const NATIVE_O_WRONLY: i64 = 1
        const NATIVE_O_CREAT: i64 = 64
        const NATIVE_O_TRUNC: i64 = 512
        const NATIVE_FILE_MODE: i64 = 420
        const NATIVE_MONOTONIC_CLOCK: i64 = 6

        struct TargetRunResult:
            status: i64
            elapsed_ns: i64

        struct CaptureSummary:
            events: mutable i64
            locations: mutable i64
            statement_events: mutable i64
            value_events: mutable i64
            function_events: mutable i64
            dropped: mutable i64
            max_stack_depth: mutable i64
            stack_overflow_entries: mutable i64
            thread_count: mutable i64
            trace_enabled: mutable i64
            trace_captured: mutable i64
            trace_omitted: mutable i64
            trace_limit: mutable i64
            location_records: mutable darray[u8]
            function_records: mutable darray[u8]
            call_edge_records: mutable darray[u8]
            stack_records: mutable darray[u8]
            event_records: mutable darray[u8]
            malformed: mutable bool
            malformed_code: mutable i64
        
        
        def append_text(buffer: mutable darray[u8]&, text: sview) -> void can[Abort.Panic, Memory.Allocate]:
            for index in 0..<profiler_ffi_sview_len(text) |buffer, text|:
                buffer.push(profiler_ffi_sview_at(text, index))
        
        
        def append_i64(buffer: mutable darray[u8]&, value: i64) -> void can[Abort.Panic, Memory.Allocate]:
            if value == 0:
                buffer.push(48)
                return
            negative: bool = value < 0
            magnitude: mutable i64 = -value if negative else value
            buffer.push(45) if negative
            digits: mutable darray[u8] = []
            while magnitude > 0 |digits, magnitude|:
                digits.push((48 + (magnitude % 10)).u8())
                magnitude <- magnitude / 10
            for index in 0..<digits.count |buffer, digits|:
                buffer.push(digits[digits.count - 1.usize() - index])


        def append_millis(buffer: mutable darray[u8]&, nanoseconds: i64) -> void can[Abort.Panic, Memory.Allocate]:
            whole: i64 = nanoseconds / 1000000
            fraction: i64 = (nanoseconds % 1000000) / 1000
            append_i64(buffer, whole)
            buffer.push(46)
            buffer.push(48 + (fraction / 100).u8())
            buffer.push(48 + ((fraction / 10) % 10).u8())
            buffer.push(48 + (fraction % 10).u8())


        def read_monotonic() -> ProfilerNativeTimespec:
            timestamp: mutable ProfilerNativeTimespec = ProfilerNativeTimespec{seconds: 0, nanoseconds: 0}
            _ = profiler_ffi_clock_gettime(NATIVE_MONOTONIC_CLOCK, &timestamp)
            return timestamp


        def elapsed_nanoseconds(start: ProfilerNativeTimespec, finish: ProfilerNativeTimespec) -> i64:
            return (finish.seconds - start.seconds) * 1000000000 + finish.nanoseconds - start.nanoseconds
        
        
        def append_cstr(buffer: mutable darray[u8]&, value: cstr) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            value_bytes: u8& = value.cast[u8&] can Unsafe.PointerCast
            cursor: mutable i64 = 0
            while true |buffer, cursor, value_bytes|:
                byte_ref: u8& = value_bytes + cursor
                byte: u8 = byte_ref
                break if byte == 0
                buffer.push(byte)
                cursor <- cursor + 1
        
        
        def append_json_string(buffer: mutable darray[u8]&, value: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            buffer.push(34)
            for index in 0..<value.count |buffer, value|:
                byte: u8 = value[index]
                if byte == 34:
                    append_text(buffer, "\\\"")
                elif byte == 92:
                    append_text(buffer, "\\\\")
                elif byte == 10:
                    append_text(buffer, "\\n")
                elif byte == 13:
                    append_text(buffer, "\\r")
                elif byte == 9:
                    append_text(buffer, "\\t")
                elif byte < 32:
                    append_text(buffer, "\\u00")
                    high: u8 = (byte / 16).u8()
                    low: u8 = (byte % 16).u8()
                    buffer.push(48 + high if high < 10 else 87 + high)
                    buffer.push(48 + low if low < 10 else 87 + low)
                else:
                    buffer.push(byte)
            buffer.push(34)
        
        
        def append_json_key(buffer: mutable darray[u8]&, key: sview) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "\"")
            append_text(buffer, key)
            append_text(buffer, "\":")
        
        
        def append_shell_quoted(buffer: mutable darray[u8]&, value: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            # Single-quote every path/command argument. A literal single quote is represented
            # as the shell-safe close-quote/backslash/open-quote sequence.
            buffer.push(39)
            for index in 0..<value.count |buffer, value|:
                byte: u8 = value[index]
                if byte == 39:
                    append_text(buffer, "'\\''")
                else:
                    buffer.push(byte)
            buffer.push(39)
        
        
        def copy_cstr(destination: mutable darray[u8]&, value: cstr) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            append_cstr(destination, value)
        
        
        def copy_environment(name: sview, destination: mutable darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            name_storage: mutable darray[u8] = []
            append_text(name_storage, name)
            name_storage.push(0)
            if profiler_ffi_getenv((&name_storage[0]).cast[cstr] can Unsafe.PointerCast) is value:
                cursor: mutable i64 = 0
                while true |destination, cursor, value|:
                    byte_ref: u8& = value + cursor
                    byte: u8 = byte_ref
                    break if byte == 0
                    destination.push(byte)
                    cursor <- cursor + 1
                return true
            return false
        
        
        def environment_or(name: sview, fallback: sview, destination: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            return if copy_environment(name, destination)
            append_text(destination, fallback)
        
        
        def path_with_suffix(path: darray[u8]&, suffix: sview) -> darray[u8] can[Abort.Panic, Memory.Allocate]:
            result: mutable darray[u8] = []
            result.extend(path)
            append_text(result, suffix)
            return result
        
        
        def make_cstr(path: mutable darray[u8]&) -> cstr can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path.push(0)
            return (&path[0]).cast[cstr] can Unsafe.PointerCast


        def remove_temp_file(directory: darray[u8]&, suffix: sview) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path: mutable darray[u8] = path_with_suffix(directory, suffix)
            path.push(0)
            _ = profiler_ffi_unlink((&path[0]).cast[cstr] can Unsafe.PointerCast)


        def cleanup_temp(directory: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            remove_temp_file(directory, "/target.o")
            remove_temp_file(directory, "/target-renamed.o")
            remove_temp_file(directory, "/runtime-collector.o")
            remove_temp_file(directory, "/profiler-runtime.o")
            remove_temp_file(directory, "/profiled-program")
            remove_temp_file(directory, "/capture.txt")
            remove_temp_file(directory, "/compile.err")
            remove_temp_file(directory, "/compile.out")
            remove_temp_file(directory, "/link.err")
            remove_temp_file(directory, "/program.out")
            remove_temp_file(directory, "/program.err")
            directory_copy: mutable darray[u8] = []
            directory_copy.extend(directory)
            directory_copy.push(0)
            _ = profiler_ffi_rmdir((&directory_copy[0]).cast[cstr] can Unsafe.PointerCast)


        def write_stderr(buffer: darray[u8]&) -> void can[Abort.Panic, Console]:
            return if buffer.count == 0
            _ = profiler_ffi_write(2, &buffer[0], buffer.count) can Console
        
        
        def report_error(message: sview) -> i64 can[Abort.Panic, Memory.Allocate, Console]:
            buffer: mutable darray[u8] = []
            append_text(buffer, "elisa-profiler: ")
            append_text(buffer, message)
            buffer.push(10)
            write_stderr(buffer)
            return 2


        def report_protocol_error(summary: CaptureSummary) -> i64 can[Abort.Panic, Memory.Allocate, Console]:
            buffer: mutable darray[u8] = []
            append_text(buffer, "elisa-profiler: malformed native protocol code=")
            append_i64(buffer, summary.malformed_code)
            buffer.push(10)
            write_stderr(buffer)
            return 2


        def write_file(path: darray[u8]&, data: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path_copy: mutable darray[u8] = []
            path_copy.extend(path)
            path_copy.push(0)
            path_cstr: cstr = (&path_copy[0]).cast[cstr] can Unsafe.PointerCast
            fd: i64 = profiler_ffi_open(path_cstr, NATIVE_O_WRONLY + NATIVE_O_CREAT + NATIVE_O_TRUNC, NATIVE_FILE_MODE)
            false return if fd < 0
            written: mutable usize = 0.usize()
            while written < data.count |written, data, fd|:
                amount: i64 = profiler_ffi_write(fd, &data[written], data.count - written) can Console
                if amount <= 0:
                    _ = profiler_ffi_close(fd)
                    return false
                written <- written + amount.usize()
            _ = profiler_ffi_close(fd)
            return true


        def open_output_file(path: darray[u8]&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path_copy: mutable darray[u8] = []
            path_copy.extend(path)
            path_copy.push(0)
            path_cstr: cstr = (&path_copy[0]).cast[cstr] can Unsafe.PointerCast
            return profiler_ffi_open(path_cstr, NATIVE_O_WRONLY + NATIVE_O_CREAT + NATIVE_O_TRUNC, NATIVE_FILE_MODE)


        def clear_target_environment() -> void:
            _ = profiler_ffi_unsetenv("ELISA_PROFILE_FD")
            _ = profiler_ffi_unsetenv("ELISA_PROFILE_EVENT_TRACE")
            _ = profiler_ffi_unsetenv("ELISA_PROFILE_EVENT_TRACE_LIMIT")
            _ = profiler_ffi_unsetenv("ELISA_PROFILE_RECENT_PATH")


        def executable_available(path: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path_copy: mutable darray[u8] = []
            path_copy.extend(path)
            path_copy.push(0)
            path_cstr: cstr = (&path_copy[0]).cast[cstr] can Unsafe.PointerCast
            return profiler_ffi_access(path_cstr, 1) == 0


        def readable_file(path: darray[u8]&) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path_copy: mutable darray[u8] = []
            path_copy.extend(path)
            path_copy.push(0)
            path_cstr: cstr = (&path_copy[0]).cast[cstr] can Unsafe.PointerCast
            fd: i64 = profiler_ffi_open(path_cstr, NATIVE_O_RDONLY, 0)
            return false if fd < 0
            _ = profiler_ffi_close(fd)
            return true


        def run_target_direct(executable: darray[u8]&, stdout_path: darray[u8]&, stderr_path: darray[u8]&, capture_fd: i64, event_trace: bool, recent_path: bool, trace_limit: i64) -> TargetRunResult can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            stdout_fd: i64 = open_output_file(stdout_path)
            return TargetRunResult{status: -1, elapsed_ns: 0} if stdout_fd < 0
            stderr_fd: i64 = open_output_file(stderr_path)
            if stderr_fd < 0:
                _ = profiler_ffi_close(stdout_fd)
                return TargetRunResult{status: -1, elapsed_ns: 0}
            executable_arg: mutable darray[u8] = []
            executable_arg.extend(executable)
            executable_arg.push(0)
            executable_cstr: cstr = (&executable_arg[0]).cast[cstr] can Unsafe.PointerCast
            fd_text: mutable darray[u8] = []
            append_i64(fd_text, capture_fd)
            fd_text.push(0)
            fd_cstr: cstr = (&fd_text[0]).cast[cstr] can Unsafe.PointerCast
            if profiler_ffi_setenv("ELISA_PROFILE_FD", fd_cstr, 1) != 0:
                _ = profiler_ffi_close(stdout_fd)
                _ = profiler_ffi_close(stderr_fd)
                return TargetRunResult{status: -1, elapsed_ns: 0}
            trace_flag: mutable cstr = "0"
            trace_flag <- "1" if event_trace
            if profiler_ffi_setenv("ELISA_PROFILE_EVENT_TRACE", trace_flag, 1) != 0:
                _ = profiler_ffi_close(stdout_fd)
                _ = profiler_ffi_close(stderr_fd)
                clear_target_environment()
                return TargetRunResult{status: -1, elapsed_ns: 0}
            limit_text: mutable darray[u8] = []
            append_i64(limit_text, trace_limit if event_trace else 0)
            limit_text.push(0)
            limit_cstr: cstr = (&limit_text[0]).cast[cstr] can Unsafe.PointerCast
            if profiler_ffi_setenv("ELISA_PROFILE_EVENT_TRACE_LIMIT", limit_cstr, 1) != 0:
                _ = profiler_ffi_close(stdout_fd)
                _ = profiler_ffi_close(stderr_fd)
                clear_target_environment()
                return TargetRunResult{status: -1, elapsed_ns: 0}
            recent_flag: mutable cstr = "0"
            recent_flag <- "1" if recent_path and not event_trace
            if profiler_ffi_setenv("ELISA_PROFILE_RECENT_PATH", recent_flag, 1) != 0:
                _ = profiler_ffi_close(stdout_fd)
                _ = profiler_ffi_close(stderr_fd)
                clear_target_environment()
                return TargetRunResult{status: -1, elapsed_ns: 0}
            start_time: ProfilerNativeTimespec = read_monotonic()
            process: i64 = profiler_ffi_fork()
            if process == 0:
                if profiler_ffi_dup2(stdout_fd, 1) < 0 or profiler_ffi_dup2(stderr_fd, 2) < 0:
                    profiler_ffi_process_exit(127)
                _ = profiler_ffi_close(stdout_fd)
                _ = profiler_ffi_close(stderr_fd)
                target_argv: mutable darray[cstr] = []
                target_argv.push(executable_cstr)
                target_argv.push(null)
                _ = profiler_ffi_execv(executable_cstr, (&target_argv[0]).cast[mutable cstr&&] can Unsafe.PointerCast)
                profiler_ffi_process_exit(127)
            if process < 0:
                _ = profiler_ffi_close(stdout_fd)
                _ = profiler_ffi_close(stderr_fd)
                clear_target_environment()
                return TargetRunResult{status: -1, elapsed_ns: 0}
            status: mutable i64 = 0
            waited: i64 = profiler_ffi_waitpid(process, &status, 0)
            finish_time: ProfilerNativeTimespec = read_monotonic()
            _ = profiler_ffi_close(stdout_fd)
            _ = profiler_ffi_close(stderr_fd)
            clear_target_environment()
            return TargetRunResult{status: -1, elapsed_ns: 0} if waited != process
            return TargetRunResult{status: status, elapsed_ns: elapsed_nanoseconds(start_time, finish_time)}


        def read_file(path: darray[u8]&) -> darray[u8] can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            path_copy: mutable darray[u8] = []
            path_copy.extend(path)
            path_copy.push(0)
            path_cstr: cstr = (&path_copy[0]).cast[cstr] can Unsafe.PointerCast
            fd: i64 = profiler_ffi_open(path_cstr, NATIVE_O_RDONLY, 0)
            result: mutable darray[u8] = []
            return result if fd < 0
            chunk: mutable darray[u8] = [0 for _ in 0..<8192]
            while true |result, chunk, fd|:
                amount: i64 = profiler_ffi_read(fd, &chunk[0], chunk.count) can Console
                break if amount <= 0
                for index in 0..<amount.usize() |result, chunk|:
                    result.push(chunk[index])
            _ = profiler_ffi_close(fd)
            return result
        
        
        def line_prefix(data: darray[u8]&, start: usize, stop: usize, prefix: sview) -> bool can[Abort.Panic]:
            prefix_length: usize = profiler_ffi_sview_len(prefix)
            false return if start + prefix_length > stop
            for index in 0..<prefix_length |data, prefix|:
                false return if data[start + index] != profiler_ffi_sview_at(prefix, index)
            return true


        def protocol_field_into(data: darray[u8]&, start: usize, stop: usize, destination: mutable darray[u8]&) -> usize can[Abort.Panic, Memory.Allocate]:
            field_end: mutable usize = start
            while field_end < stop |field_end, data|:
                break if data[field_end] == 9
                field_end <- field_end + 1.usize()
            for index in start..<field_end |destination, data|:
                destination.push(data[index])
            return field_end + 1.usize() if field_end < stop and data[field_end] == 9 else field_end


        def protocol_field_is(value: darray[u8]&, expected: sview) -> bool can[Abort.Panic]:
            false return if value.count != profiler_ffi_sview_len(expected)
            for index in 0..<value.count |value, expected|:
                false return if value[index] != profiler_ffi_sview_at(expected, index)
            return true


        def protocol_unsigned(value: darray[u8]&) -> bool can[Abort.Panic]:
            false return if value.count == 0
            for index in 0..<value.count |value|:
                false return if value[index] < 48 or value[index] > 57
            return true


        def protocol_signed(value: darray[u8]&, allow_overflow: bool) -> bool can[Abort.Panic]:
            return true if allow_overflow and protocol_field_is(value, "overflow")
            false return if value.count == 0
            start: mutable usize = 0.usize()
            if value[0] == 45:
                start <- 1.usize()
            false return if start == value.count
            for index in start..<value.count |value|:
                false return if value[index] < 48 or value[index] > 57
            return true


        def append_record_separator(records: mutable darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            records.push(44) if records.count > 0


        def append_protocol_number(records: mutable darray[u8]&, value: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            records.extend(value)


        def protocol_number_field(value: darray[u8]&) -> i64:
            result: mutable i64 = 0
            for index in 0..<value.count |result, value|:
                result <- result * 10 + (value[index] - 48).i64()
            return result


        def append_location_record(summary: mutable CaptureSummary&, data: darray[u8]&, cursor: mutable usize&, stop: usize, source: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            kind_field: mutable darray[u8] = []
            function_field: mutable darray[u8] = []
            line_field: mutable darray[u8] = []
            count_field: mutable darray[u8] = []
            variable_field: mutable darray[u8] = []
            signed_field: mutable darray[u8] = []
            field_min: mutable darray[u8] = []
            field_max: mutable darray[u8] = []
            field_sum: mutable darray[u8] = []
            field_last: mutable darray[u8] = []
            field_interval: mutable darray[u8] = []
            field_max_interval: mutable darray[u8] = []
            cursor <- protocol_field_into(data, cursor, stop, &kind_field)
            cursor <- protocol_field_into(data, cursor, stop, &function_field)
            cursor <- protocol_field_into(data, cursor, stop, &line_field)
            cursor <- protocol_field_into(data, cursor, stop, &count_field)
            cursor <- protocol_field_into(data, cursor, stop, &variable_field)
            cursor <- protocol_field_into(data, cursor, stop, &signed_field)
            cursor <- protocol_field_into(data, cursor, stop, &field_min)
            cursor <- protocol_field_into(data, cursor, stop, &field_max)
            cursor <- protocol_field_into(data, cursor, stop, &field_sum)
            cursor <- protocol_field_into(data, cursor, stop, &field_last)
            cursor <- protocol_field_into(data, cursor, stop, &field_interval)
            cursor <- protocol_field_into(data, cursor, stop, &field_max_interval)
            kind_name: mutable sview = ""
            if protocol_field_is(kind_field, "1"):
                kind_name <- "statement"
            elif protocol_field_is(kind_field, "2"):
                kind_name <- "value"
            elif protocol_field_is(kind_field, "3"):
                kind_name <- "function"
            else:
                summary.malformed <- true
                summary.malformed_code <- 1
                return
            valid: mutable bool = function_field.count > 0 and protocol_unsigned(line_field) and protocol_unsigned(count_field)
            valid <- valid and (protocol_field_is(signed_field, "0") or protocol_field_is(signed_field, "1"))
            valid <- valid and protocol_unsigned(field_interval) and protocol_unsigned(field_max_interval)
            if kind_name == "function":
                valid <- valid and protocol_unsigned(field_min) and protocol_unsigned(field_max) and protocol_unsigned(field_sum) and protocol_unsigned(field_last)
            elif kind_name == "value":
                signed_value: bool = protocol_field_is(signed_field, "1")
                valid <- valid and protocol_signed(field_min, false) and protocol_signed(field_max, false)
                valid <- valid and protocol_signed(field_sum, true) and protocol_signed(field_last, false)
                valid <- valid and (protocol_field_is(variable_field, "-") or variable_field.count > 0)
                if not signed_value:
                    valid <- valid and protocol_unsigned(field_min) and protocol_unsigned(field_max) and protocol_unsigned(field_last)
            else:
                valid <- valid and protocol_unsigned(field_min) and protocol_unsigned(field_max) and protocol_unsigned(field_sum) and protocol_unsigned(field_last)
            if not valid:
                summary.malformed <- true
                summary.malformed_code <- 1
                return

            append_record_separator(summary.location_records)
            append_text(summary.location_records, "{\"kind\":\"")
            append_text(summary.location_records, kind_name)
            append_text(summary.location_records, "\",\"function\":")
            append_json_string(summary.location_records, function_field)
            append_text(summary.location_records, ",\"line\":")
            append_protocol_number(summary.location_records, line_field)
            append_text(summary.location_records, ",\"count\":")
            append_protocol_number(summary.location_records, count_field)
            count_number: i64 = protocol_number_field(count_field)
            if kind_name == "statement":
                summary.statement_events <- summary.statement_events + count_number
            elif kind_name == "value":
                summary.value_events <- summary.value_events + count_number
            else:
                summary.function_events <- summary.function_events + count_number
            if kind_name == "value":
                append_text(summary.location_records, ",\"variable\":")
                if protocol_field_is(variable_field, "-"):
                    append_text(summary.location_records, "null")
                else:
                    append_json_string(summary.location_records, variable_field)
                append_text(summary.location_records, ",\"signed\":")
                append_text(summary.location_records, "true" if protocol_field_is(signed_field, "1") else "false")
                append_text(summary.location_records, ",\"minimum\":")
                append_protocol_number(summary.location_records, field_min)
                append_text(summary.location_records, ",\"maximum\":")
                append_protocol_number(summary.location_records, field_max)
                append_text(summary.location_records, ",\"sum\":")
                if protocol_field_is(field_sum, "overflow"):
                    append_text(summary.location_records, "null,\"sum_overflow\":true")
                else:
                    append_protocol_number(summary.location_records, field_sum)
                append_text(summary.location_records, ",\"last\":")
                append_protocol_number(summary.location_records, field_last)
            elif kind_name == "function":
                append_text(summary.location_records, ",\"inclusive_ns\":")
                append_protocol_number(summary.location_records, field_min)
                append_text(summary.location_records, ",\"self_ns\":")
                append_protocol_number(summary.location_records, field_max)
                append_text(summary.location_records, ",\"completed_calls\":")
                append_protocol_number(summary.location_records, field_sum)
            append_text(summary.location_records, ",\"interval_ns\":")
            append_protocol_number(summary.location_records, field_interval)
            append_text(summary.location_records, ",\"max_interval_ns\":")
            append_protocol_number(summary.location_records, field_max_interval)
            append_text(summary.location_records, ",\"compiler_line\":")
            append_protocol_number(summary.location_records, line_field)
            append_text(summary.location_records, ",\"source\":")
            append_json_string(summary.location_records, source)
            append_text(summary.location_records, ",\"source_text\":null")
            append_text(summary.location_records, "}")
            if kind_name == "function":
                append_record_separator(summary.function_records)
                append_text(summary.function_records, "{\"function\":")
                append_json_string(summary.function_records, function_field)
                append_text(summary.function_records, ",\"events\":")
                append_protocol_number(summary.function_records, count_field)
                append_text(summary.function_records, ",\"statement_events\":0,\"value_events\":0,\"call_events\":")
                append_protocol_number(summary.function_records, count_field)
                append_text(summary.function_records, ",\"locations\":1,\"interval_ns\":")
                append_protocol_number(summary.function_records, field_interval)
                append_text(summary.function_records, ",\"max_interval_ns\":")
                append_protocol_number(summary.function_records, field_max_interval)
                append_text(summary.function_records, ",\"inclusive_ns\":")
                append_protocol_number(summary.function_records, field_min)
                append_text(summary.function_records, ",\"self_ns\":")
                append_protocol_number(summary.function_records, field_max)
                append_text(summary.function_records, ",\"completed_calls\":")
                append_protocol_number(summary.function_records, field_sum)
                append_text(summary.function_records, ",\"definitions\":[],\"mean_inclusive_ns\":0,\"mean_self_ns\":0,\"inclusive_percent\":0.0,\"self_percent\":0.0}")


        def append_call_record(summary: mutable CaptureSummary&, data: darray[u8]&, cursor: mutable usize&, stop: usize) -> void can[Abort.Panic, Memory.Allocate]:
            caller_field: mutable darray[u8] = []
            callee_field: mutable darray[u8] = []
            calls_field: mutable darray[u8] = []
            completed_field: mutable darray[u8] = []
            inclusive_field: mutable darray[u8] = []
            cursor <- protocol_field_into(data, cursor, stop, &caller_field)
            cursor <- protocol_field_into(data, cursor, stop, &callee_field)
            cursor <- protocol_field_into(data, cursor, stop, &calls_field)
            cursor <- protocol_field_into(data, cursor, stop, &completed_field)
            cursor <- protocol_field_into(data, cursor, stop, &inclusive_field)
            if caller_field.count == 0 or callee_field.count == 0 or not protocol_unsigned(calls_field) or not protocol_unsigned(completed_field) or not protocol_unsigned(inclusive_field):
                summary.malformed <- true
                summary.malformed_code <- 2
                return
            append_record_separator(summary.call_edge_records)
            append_text(summary.call_edge_records, "{\"caller\":")
            append_json_string(summary.call_edge_records, caller_field)
            append_text(summary.call_edge_records, ",\"callee\":")
            append_json_string(summary.call_edge_records, callee_field)
            append_text(summary.call_edge_records, ",\"call_events\":")
            append_protocol_number(summary.call_edge_records, calls_field)
            append_text(summary.call_edge_records, ",\"completed_calls\":")
            append_protocol_number(summary.call_edge_records, completed_field)
            append_text(summary.call_edge_records, ",\"inclusive_ns\":")
            append_protocol_number(summary.call_edge_records, inclusive_field)
            append_text(summary.call_edge_records, "}")


        def append_stack_record(summary: mutable CaptureSummary&, data: darray[u8]&, cursor: mutable usize&, stop: usize) -> void can[Abort.Panic, Memory.Allocate]:
            stack_field: mutable darray[u8] = []
            calls_field: mutable darray[u8] = []
            completed_field: mutable darray[u8] = []
            self_field: mutable darray[u8] = []
            cursor <- protocol_field_into(data, cursor, stop, &stack_field)
            cursor <- protocol_field_into(data, cursor, stop, &calls_field)
            cursor <- protocol_field_into(data, cursor, stop, &completed_field)
            cursor <- protocol_field_into(data, cursor, stop, &self_field)
            if stack_field.count == 0 or not protocol_unsigned(calls_field) or not protocol_unsigned(completed_field) or not protocol_unsigned(self_field):
                summary.malformed <- true
                summary.malformed_code <- 3
                return
            append_record_separator(summary.stack_records)
            append_text(summary.stack_records, "{\"stack\":")
            append_json_string(summary.stack_records, stack_field)
            append_text(summary.stack_records, ",\"call_events\":")
            append_protocol_number(summary.stack_records, calls_field)
            append_text(summary.stack_records, ",\"completed_calls\":")
            append_protocol_number(summary.stack_records, completed_field)
            append_text(summary.stack_records, ",\"self_ns\":")
            append_protocol_number(summary.stack_records, self_field)
            append_text(summary.stack_records, "}")


        def append_event_record(summary: mutable CaptureSummary&, data: darray[u8]&, cursor: mutable usize&, stop: usize, source: darray[u8]&) -> void can[Abort.Panic, Memory.Allocate]:
            sequence_field: mutable darray[u8] = []
            kind_field: mutable darray[u8] = []
            function_field: mutable darray[u8] = []
            line_field: mutable darray[u8] = []
            variable_field: mutable darray[u8] = []
            signed_field: mutable darray[u8] = []
            value_field: mutable darray[u8] = []
            cursor <- protocol_field_into(data, cursor, stop, &sequence_field)
            cursor <- protocol_field_into(data, cursor, stop, &kind_field)
            cursor <- protocol_field_into(data, cursor, stop, &function_field)
            cursor <- protocol_field_into(data, cursor, stop, &line_field)
            cursor <- protocol_field_into(data, cursor, stop, &variable_field)
            cursor <- protocol_field_into(data, cursor, stop, &signed_field)
            cursor <- protocol_field_into(data, cursor, stop, &value_field)
            kind_name: mutable sview = ""
            if protocol_field_is(kind_field, "1"):
                kind_name <- "statement"
            elif protocol_field_is(kind_field, "2"):
                kind_name <- "value"
            elif protocol_field_is(kind_field, "3"):
                kind_name <- "function"
            else:
                summary.malformed <- true
                summary.malformed_code <- 4
                return
            signed_value: bool = protocol_field_is(signed_field, "1")
            valid: mutable bool = protocol_unsigned(sequence_field) and function_field.count > 0 and protocol_unsigned(line_field)
            valid <- valid and (protocol_field_is(signed_field, "0") or signed_value)
            valid <- valid and protocol_signed(value_field, false)
            if not signed_value:
                valid <- valid and protocol_unsigned(value_field)
            if not valid:
                summary.malformed <- true
                summary.malformed_code <- 4
                return
            append_record_separator(summary.event_records)
            append_text(summary.event_records, "{\"sequence\":")
            append_protocol_number(summary.event_records, sequence_field)
            append_text(summary.event_records, ",\"kind\":\"")
            append_text(summary.event_records, kind_name)
            append_text(summary.event_records, "\",\"function\":")
            append_json_string(summary.event_records, function_field)
            append_text(summary.event_records, ",\"line\":")
            append_protocol_number(summary.event_records, line_field)
            append_text(summary.event_records, ",\"variable\":")
            if protocol_field_is(variable_field, "-"):
                append_text(summary.event_records, "null")
            else:
                append_json_string(summary.event_records, variable_field)
            append_text(summary.event_records, ",\"signed\":")
            append_text(summary.event_records, "true" if signed_value else "false")
            append_text(summary.event_records, ",\"value\":")
            append_protocol_number(summary.event_records, value_field)
            append_text(summary.event_records, ",\"compiler_line\":")
            append_protocol_number(summary.event_records, line_field)
            append_text(summary.event_records, ",\"source\":")
            append_json_string(summary.event_records, source)
            append_text(summary.event_records, ",\"source_text\":null")
            append_text(summary.event_records, "}")


        def parse_protocol_number(data: darray[u8]&, cursor: mutable usize&, stop: usize) -> i64:
            value: mutable i64 = 0
            while cursor < stop and data[cursor] >= 48 and data[cursor] <= 57 |cursor, value, data|:
                value <- value * 10 + (data[cursor] - 48).i64()
                cursor <- cursor + 1.usize()
            cursor <- cursor + 1.usize() if cursor < stop and data[cursor] == 9
            return value
        
        
        def parse_capture(data: darray[u8]&, source: darray[u8]&) -> CaptureSummary:
            summary: mutable CaptureSummary = CaptureSummary{
                events: 0,
                locations: 0,
                statement_events: 0,
                value_events: 0,
                function_events: 0,
                dropped: 0,
                max_stack_depth: 0,
                stack_overflow_entries: 0,
                thread_count: 0,
                trace_enabled: 0,
                trace_captured: 0,
                trace_omitted: 0,
                trace_limit: 0,
                location_records: [],
                function_records: [],
                call_edge_records: [],
                stack_records: [],
                event_records: [],
                malformed: false,
                malformed_code: 0,
            }
            meta_prefix: sview = "ELISA_PROFILE\t1\tmeta\t"
            trace_prefix: sview = "ELISA_PROFILE\t1\ttrace\t"
            line_start: mutable usize = 0.usize()
            while line_start < data.count |line_start, data, summary|:
                line_stop: mutable usize = line_start
                while line_stop < data.count and data[line_stop] != 10 |line_stop, data|:
                    line_stop <- line_stop + 1.usize()
                if line_prefix(data, line_start, line_stop, meta_prefix):
                    cursor: mutable usize = line_start + profiler_ffi_sview_len(meta_prefix)
                    summary.events <- parse_protocol_number(data, &cursor, line_stop)
                    summary.locations <- parse_protocol_number(data, &cursor, line_stop)
                    summary.dropped <- parse_protocol_number(data, &cursor, line_stop)
                    summary.max_stack_depth <- parse_protocol_number(data, &cursor, line_stop)
                    summary.stack_overflow_entries <- parse_protocol_number(data, &cursor, line_stop)
                    summary.thread_count <- parse_protocol_number(data, &cursor, line_stop)
                elif line_prefix(data, line_start, line_stop, trace_prefix):
                    cursor: mutable usize = line_start + profiler_ffi_sview_len(trace_prefix)
                    summary.trace_enabled <- parse_protocol_number(data, &cursor, line_stop)
                    summary.trace_captured <- parse_protocol_number(data, &cursor, line_stop)
                    summary.trace_omitted <- parse_protocol_number(data, &cursor, line_stop)
                    summary.trace_limit <- parse_protocol_number(data, &cursor, line_stop)
                elif line_prefix(data, line_start, line_stop, "ELISA_PROFILE\t1\tlocation\t"):
                    cursor: mutable usize = line_start + profiler_ffi_sview_len("ELISA_PROFILE\t1\tlocation\t")
                    append_location_record(&summary, data, &cursor, line_stop, source)
                elif line_prefix(data, line_start, line_stop, "ELISA_PROFILE\t1\tcall\t"):
                    cursor: mutable usize = line_start + profiler_ffi_sview_len("ELISA_PROFILE\t1\tcall\t")
                    append_call_record(&summary, data, &cursor, line_stop)
                elif line_prefix(data, line_start, line_stop, "ELISA_PROFILE\t1\tstack\t"):
                    cursor: mutable usize = line_start + profiler_ffi_sview_len("ELISA_PROFILE\t1\tstack\t")
                    append_stack_record(&summary, data, &cursor, line_stop)
                elif line_prefix(data, line_start, line_stop, "ELISA_PROFILE\t1\tpath\t"):
                    cursor: mutable usize = line_start + profiler_ffi_sview_len("ELISA_PROFILE\t1\tpath\t")
                    append_event_record(&summary, data, &cursor, line_stop, source)
                elif line_prefix(data, line_start, line_stop, "ELISA_PROFILE\t1\t"):
                    summary.malformed <- true
                line_start <- line_stop + 1.usize()
            return summary
        
        
        def system_exit_code(status: i64) -> i64:
            return 127 if status < 0
            return status / 256 if status % 256 == 0 else 128 + (status % 256)
        
        
        def append_detail_arrays(buffer: mutable darray[u8]&, summary: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "\"functions\":[")
            buffer.extend(summary.function_records)
            append_text(buffer, "],\"call_edges\":[")
            buffer.extend(summary.call_edge_records)
            append_text(buffer, "],\"stacks\":[")
            buffer.extend(summary.stack_records)
            append_text(buffer, "],\"locations\":[")
            buffer.extend(summary.location_records)
            append_text(buffer, "]")


        def append_report(
            buffer: mutable darray[u8]&, source: darray[u8]&, compiler_root: darray[u8]&, runtime_object: darray[u8]&, summary: CaptureSummary,
            exit_code: i64, opt_level: i64, event_trace: bool, recent_path: bool, program_stderr: darray[u8]&, execution_ns: i64, compile_ns: i64
        ) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "{\"schema_version\":1,\"source\":")
            append_json_string(buffer, source)
            append_text(buffer, ",\"compiler\":{\"root\":")
            append_json_string(buffer, compiler_root)
            append_text(buffer, ",\"branch\":\"native-elisa\",\"commit\":\"native-transition\",\"dirty\":false,\"runtime_object\":")
            append_json_string(buffer, runtime_object)
            append_text(buffer, "},\"summary\":{\"events\":")
            append_i64(buffer, summary.events)
            append_text(buffer, ",\"locations\":")
            append_i64(buffer, summary.locations)
            append_text(buffer, ",\"dropped\":")
            append_i64(buffer, summary.dropped)
            append_text(buffer, ",\"statement_events\":")
            append_i64(buffer, summary.statement_events)
            append_text(buffer, ",\"value_events\":")
            append_i64(buffer, summary.value_events)
            append_text(buffer, ",\"function_events\":")
            append_i64(buffer, summary.function_events)
            append_text(buffer, ",\"max_stack_depth\":")
            append_i64(buffer, summary.max_stack_depth)
            append_text(buffer, ",\"stack_overflow_entries\":")
            append_i64(buffer, summary.stack_overflow_entries)
            append_text(buffer, ",\"thread_count\":")
            append_i64(buffer, summary.thread_count)
            append_text(buffer, ",\"trace_events_captured\":")
            append_i64(buffer, summary.trace_captured)
            append_text(buffer, ",\"trace_events_omitted\":")
            append_i64(buffer, summary.trace_omitted)
            append_text(buffer, ",\"trace_event_limit\":")
            if not event_trace:
                append_text(buffer, "null")
            else:
                append_i64(buffer, summary.trace_limit)
            append_text(buffer, ",\"trace_complete\":")
            if not event_trace:
                append_text(buffer, "null")
            else:
                append_text(buffer, "true" if summary.trace_omitted == 0 and summary.trace_captured == summary.events else "false")
            append_text(buffer, "},\"source_mapping\":{\"mode\":\"native-summary\",\"mapped_locations\":0,\"unmapped_locations\":")
            append_i64(buffer, summary.locations)
            append_text(buffer, "},\"run\":{\"exit_code\":")
            append_i64(buffer, exit_code)
            append_text(buffer, ",\"signal\":null,\"location_timing\":true,\"timing_clock\":\"wall\",\"event_trace_enabled\":")
            append_text(buffer, "true" if event_trace else "false")
            append_text(buffer, ",\"trace_events_captured\":")
            append_i64(buffer, summary.trace_captured)
            append_text(buffer, ",\"trace_events_omitted\":")
            append_i64(buffer, summary.trace_omitted)
            append_text(buffer, ",\"trace_event_limit\":")
            if not event_trace:
                append_text(buffer, "null")
            else:
                append_i64(buffer, summary.trace_limit)
            append_text(buffer, ",\"trace_complete\":")
            if not event_trace:
                append_text(buffer, "null")
            else:
                append_text(buffer, "true" if summary.trace_omitted == 0 and summary.trace_captured == summary.events else "false")
            append_text(buffer, ",\"opt_level\":\"-O")
            append_i64(buffer, opt_level)
            append_text(buffer, "\",\"execution_ms\":")
            append_millis(buffer, execution_ns)
            append_text(buffer, ",\"timeout_s\":null,\"execution_ms_min\":")
            append_millis(buffer, execution_ns)
            append_text(buffer, ",\"execution_ms_mean\":")
            append_millis(buffer, execution_ns)
            append_text(buffer, ",\"execution_ms_max\":")
            append_millis(buffer, execution_ns)
            append_text(buffer, ",\"execution_ms_median\":")
            append_millis(buffer, execution_ns)
            append_text(buffer, ",\"execution_ms_stdev\":0.0,\"cpu_user_ms\":null,\"cpu_system_ms\":null,\"cpu_ms\":null,\"peak_rss_bytes\":null,\"warmup_ms\":0.0,\"warmup_repetitions\":0,\"requested_repetitions\":1,\"completed_repetitions\":1,\"successful_repetitions\":")
            append_text(buffer, "1" if exit_code == 0 else "0")
            append_text(buffer, ",\"failed_repetitions\":")
            append_text(buffer, "0" if exit_code == 0 else "1")
            append_text(buffer, ",\"measurement_repetitions\":1,\"measurement_basis\":\"")
            append_text(buffer, "successful" if exit_code == 0 else "all_completed")
            append_text(buffer, "\",\"repetitions\":[{\"repetition\":1,\"requested_repetitions\":1,\"exit_code\":")
            append_i64(buffer, exit_code)
            append_text(buffer, ",\"signal\":null,\"execution_ms\":")
            append_millis(buffer, execution_ns)
            append_text(buffer, ",\"timed_out\":false,\"cpu_user_ms\":null,\"cpu_system_ms\":null,\"cpu_ms\":null,\"peak_rss_bytes\":null,\"trace_events\":")
            append_i64(buffer, summary.events)
            append_text(buffer, ",\"trace_locations\":")
            append_i64(buffer, summary.locations)
            append_text(buffer, ",\"trace_dropped\":")
            append_i64(buffer, summary.dropped)
            append_text(buffer, ",\"trace_threads\":")
            append_i64(buffer, summary.thread_count)
            append_text(buffer, ",\"trace_max_stack_depth\":")
            append_i64(buffer, summary.max_stack_depth)
            append_text(buffer, ",\"trace_stack_overflow_entries\":")
            append_i64(buffer, summary.stack_overflow_entries)
            append_text(buffer, ",\"trace_events_captured\":")
            append_i64(buffer, summary.trace_captured)
            append_text(buffer, ",\"trace_events_omitted\":")
            append_i64(buffer, summary.trace_omitted)
            append_text(buffer, ",\"trace_event_limit\":")
            if not event_trace:
                append_text(buffer, "null")
            else:
                append_i64(buffer, summary.trace_limit)
            append_text(buffer, ",\"trace_complete\":")
            if not event_trace:
                append_text(buffer, "null")
            else:
                append_text(buffer, "true" if summary.trace_omitted == 0 and summary.trace_captured == summary.events else "false")
            if event_trace:
                append_text(buffer, ",\"event_trace\":[")
                buffer.extend(summary.event_records)
                append_text(buffer, "]")
            elif recent_path:
                append_text(buffer, ",\"recent_events\":[")
                buffer.extend(summary.event_records)
                append_text(buffer, "]")
            append_text(buffer, "}],\"compile_ms\":")
            append_millis(buffer, compile_ns)
            append_text(buffer, "},")
            append_detail_arrays(buffer, summary)
            if program_stderr.count > 0:
                append_text(buffer, ",\"program_stderr\":")
                append_json_string(buffer, program_stderr)
            append_text(buffer, "}\n")


        def append_text_report(buffer: mutable darray[u8]&, source: darray[u8]&, summary: CaptureSummary, exit_code: i64, event_trace: bool, recent_path: bool, execution_ns: i64, compile_ns: i64) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "Elisa profiler\nsource: ")
            for index in 0..<source.count |buffer, source|:
                buffer.push(source[index])
            append_text(buffer, "\nstatus: ")
            append_text(buffer, "ok\n" if exit_code == 0 else "target failed\n")
            append_text(buffer, "events: ")
            append_i64(buffer, summary.events)
            append_text(buffer, "\nlocations: ")
            append_i64(buffer, summary.locations)
            append_text(buffer, "\nstatement events: ")
            append_i64(buffer, summary.statement_events)
            append_text(buffer, "\nvalue events: ")
            append_i64(buffer, summary.value_events)
            append_text(buffer, "\nfunction events: ")
            append_i64(buffer, summary.function_events)
            append_text(buffer, "\nthreads: ")
            append_i64(buffer, summary.thread_count)
            append_text(buffer, "\ndropped: ")
            append_i64(buffer, summary.dropped)
            append_text(buffer, "\nexecution: ")
            append_millis(buffer, execution_ns)
            append_text(buffer, " ms\ncompile: ")
            append_millis(buffer, compile_ns)
            append_text(buffer, " ms\n")
            if event_trace:
                append_text(buffer, "event trace: ")
                append_i64(buffer, summary.trace_captured)
                append_text(buffer, " captured, ")
                append_i64(buffer, summary.trace_omitted)
                append_text(buffer, " omitted\n")
            elif recent_path:
                append_text(buffer, "recent path events: ")
                append_i64(buffer, summary.event_records.count)
                append_text(buffer, "\n")


        def doctor(argc: i64, slots: mutable cstr&&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            output_path: mutable darray[u8] = []
            index: mutable i64 = 2
            while index < argc |index, slots, output_path|:
                argument: cstr = slots[index].cast[cstr]
                if profiler_ffi_strcmp(argument, "--format") == 0:
                    return report_error("doctor supports only --format json") if index + 1 >= argc or profiler_ffi_strcmp(slots[index + 1].cast[cstr], "json") != 0
                    index <- index + 2
                    continue
                if profiler_ffi_strcmp(argument, "--output") == 0 or profiler_ffi_strcmp(argument, "-o") == 0:
                    return report_error("--output requires a path") if index + 1 >= argc
                    copy_cstr(output_path, slots[index + 1].cast[cstr])
                    index <- index + 2
                    continue
                return report_error("unknown doctor option")
            compiler_root: mutable darray[u8] = []
            environment_or("ELISA_COMPILER_ROOT", "../elisa-compiler-worktrees/profiler", compiler_root)
            stage1: mutable darray[u8] = []
            environment_or("ELISA_STAGE1_BIN", "../elisa-compiler-worktrees/profiler/bin/elisac-stage1", stage1)
            runtime: mutable darray[u8] = []
            environment_or("ELISA_RUNTIME_OBJ", "../elisa-compiler-worktrees/profiler/build/runtime/elisacore_runtime.o", runtime)
            collector: mutable darray[u8] = []
            environment_or("ELISA_PROFILER_RUNTIME_C", "scripts/profiler_runtime.c", collector)
            compiler_ok: bool = readable_file(compiler_root)
            stage1_ok: bool = executable_available(stage1)
            runtime_ok: bool = readable_file(runtime)
            collector_ok: bool = readable_file(collector)
            all_ok: bool = compiler_ok and stage1_ok and runtime_ok and collector_ok
            report: mutable darray[u8] = []
            append_text(report, "{\"ok\":")
            append_text(report, "true" if all_ok else "false")
            append_text(report, ",\"compiler_root\":")
            append_json_string(report, compiler_root)
            append_text(report, ",\"checks\":{\"compiler_root\":")
            append_text(report, "true" if compiler_ok else "false")
            append_text(report, ",\"stage1_binary\":")
            append_text(report, "true" if stage1_ok else "false")
            append_text(report, ",\"runtime_object\":")
            append_text(report, "true" if runtime_ok else "false")
            append_text(report, ",\"collector_source\":")
            append_text(report, "true" if collector_ok else "false")
            append_text(report, "},\"paths\":{\"stage1_binary\":")
            append_json_string(report, stage1)
            append_text(report, ",\"runtime_object\":")
            append_json_string(report, runtime)
            append_text(report, ",\"collector_source\":")
            append_json_string(report, collector)
            append_text(report, "}}\n")
            if output_path.count > 0:
                return 0 if write_file(output_path, report)
                return report_error("could not write doctor report")
            _ = profiler_ffi_write(1, &report[0], report.count) can Console
            return 0 if all_ok else 2


        def report_offline(argc: i64, slots: mutable cstr&&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            return report_error("usage: elisa-profiler report CAPTURE [--format json] [--output PATH]") if argc < 3
            capture_path: mutable darray[u8] = []
            output_path: mutable darray[u8] = []
            format_json: mutable bool = false
            capture_seen: mutable bool = false
            index: mutable i64 = 2
            while index < argc |index, slots, capture_path, output_path, format_json, capture_seen|:
                argument: cstr = slots[index].cast[cstr]
                if profiler_ffi_strcmp(argument, "--format") == 0:
                    return report_error("--format requires json") if index + 1 >= argc or profiler_ffi_strcmp(slots[index + 1].cast[cstr], "json") != 0
                    format_json <- true
                    index <- index + 2
                    continue
                if profiler_ffi_strcmp(argument, "--output") == 0 or profiler_ffi_strcmp(argument, "-o") == 0:
                    return report_error("--output requires a path") if index + 1 >= argc
                    copy_cstr(output_path, slots[index + 1].cast[cstr])
                    index <- index + 2
                    continue
                if argument[0] == 45:
                    return report_error("unknown report option")
                return report_error("report accepts exactly one capture path") if capture_seen
                copy_cstr(capture_path, argument)
                capture_seen <- true
                index <- index + 1
            return report_error("report requires a capture path") if not capture_seen
            return report_error("report requires --format json") if not format_json
            report: darray[u8] = read_file(capture_path)
            return report_error("capture could not be read") if report.count == 0
            if output_path.count > 0:
                return 0 if write_file(output_path, report)
                return report_error("could not write offline report")
            _ = profiler_ffi_write(1, &report[0], report.count) can Console
            return 0
        
        
    public:
        def run(argc: i64, argv: mutable void&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
            return report_error("usage: elisa-profiler profile SOURCE [--format json] [--output PATH] or report CAPTURE [--format json] [--output PATH]") if argc < 2
            slots: mutable cstr&& = argv.cast[mutable cstr&&]
            first: cstr = slots[1].cast[cstr]
            return report_offline(argc, slots) if profiler_ffi_strcmp(first, "report") == 0
            return doctor(argc, slots) if profiler_ffi_strcmp(first, "doctor") == 0
            return report_error("unknown command; use profile or report") if profiler_ffi_strcmp(first, "profile") != 0
            return report_error("usage: elisa-profiler profile SOURCE [--format json] [--output PATH]") if argc < 3
        
            source: mutable darray[u8] = []
            output: mutable darray[u8] = []
            opt_level: mutable i64 = 0
            event_trace: mutable bool = false
            recent_path: mutable bool = false
            format_text: mutable bool = false
            trace_limit: mutable i64 = 1000000
            source_seen: mutable bool = false
            index: mutable i64 = 2
            while index < argc |index, slots, source, output, opt_level, event_trace, recent_path, format_text, trace_limit, source_seen|:
                argument: cstr = slots[index].cast[cstr]
                if profiler_ffi_strcmp(argument, "--format") == 0:
                    return report_error("--format requires json or text") if index + 1 >= argc
                    if profiler_ffi_strcmp(slots[index + 1].cast[cstr], "text") == 0:
                        format_text <- true
                    elif profiler_ffi_strcmp(slots[index + 1].cast[cstr], "json") != 0:
                        return report_error("--format requires json or text")
                    index <- index + 2
                    continue
                if profiler_ffi_strcmp(argument, "--output") == 0 or profiler_ffi_strcmp(argument, "-o") == 0:
                    return report_error("--output requires a path") if index + 1 >= argc
                    copy_cstr(output, slots[index + 1].cast[cstr])
                    index <- index + 2
                    continue
                if profiler_ffi_strcmp(argument, "--event-trace") == 0:
                    event_trace <- true
                    index <- index + 1
                    continue
                if profiler_ffi_strcmp(argument, "--recent-path") == 0:
                    recent_path <- true
                    index <- index + 1
                    continue
                if profiler_ffi_strcmp(argument, "--max-event-trace-events") == 0:
                    return report_error("--max-event-trace-events requires a non-negative integer") if index + 1 >= argc
                    limit_text: cstr = slots[index + 1].cast[cstr]
                    limit_bytes: u8& = limit_text.cast[u8&] can Unsafe.PointerCast
                    limit: mutable i64 = 0
                    limit_cursor: mutable i64 = 0
                    while true |limit_bytes, limit_cursor, limit|:
                        byte_ref: u8& = limit_bytes + limit_cursor
                        byte: u8 = byte_ref
                        break if byte == 0
                        return report_error("--max-event-trace-events requires a non-negative integer") if byte < 48 or byte > 57
                        limit <- limit * 10 + (byte - 48).i64()
                        limit_cursor <- limit_cursor + 1
                    trace_limit <- limit
                    index <- index + 2
                    continue
                if profiler_ffi_strcmp(argument, "-O0") == 0 or profiler_ffi_strcmp(argument, "--opt-level=0") == 0:
                    opt_level <- 0
                    index <- index + 1
                    continue
                if profiler_ffi_strcmp(argument, "-O1") == 0 or profiler_ffi_strcmp(argument, "--opt-level=1") == 0:
                    opt_level <- 1
                    index <- index + 1
                    continue
                if profiler_ffi_strcmp(argument, "-O2") == 0 or profiler_ffi_strcmp(argument, "--opt-level=2") == 0:
                    opt_level <- 2
                    index <- index + 1
                    continue
                if profiler_ffi_strcmp(argument, "-O3") == 0 or profiler_ffi_strcmp(argument, "--opt-level=3") == 0:
                    opt_level <- 3
                    index <- index + 1
                    continue
                if argument[0] == 45:
                    return report_error("unknown option in Elisa-native transition slice")
                return report_error("profile accepts exactly one source path") if source_seen
                copy_cstr(source, argument)
                source_seen <- true
                index <- index + 1
        
            return report_error("profile requires a source path") if not source_seen
            source_check: darray[u8] = read_file(source)
            return report_error("source file could not be read") if source_check.count == 0
        
            compiler_root: mutable darray[u8] = []
            environment_or("ELISA_COMPILER_ROOT", "../elisa-compiler-worktrees/profiler", compiler_root)
            compiler_binary: mutable darray[u8] = []
            environment_or("ELISA_STAGE1_BIN", "../elisa-compiler-worktrees/profiler/bin/elisac-stage1", compiler_binary)
            runtime_object: mutable darray[u8] = []
            environment_or("ELISA_RUNTIME_OBJ", "../elisa-compiler-worktrees/profiler/build/runtime/elisacore_runtime.o", runtime_object)
            compiler_tool: mutable darray[u8] = []
            environment_or("ELISA_CLANG", "clang", compiler_tool)
            objcopy_tool: mutable darray[u8] = []
            environment_or("ELISA_LLVM_OBJCOPY", "llvm-objcopy", objcopy_tool)
            collector_source: mutable darray[u8] = []
            environment_or("ELISA_PROFILER_RUNTIME_C", "scripts/profiler_runtime.c", collector_source)
        
            temporary: mutable darray[u8] = []
            append_text(temporary, "/tmp/elisa-profiler-native-")
            append_i64(temporary, profiler_ffi_getpid())
            target_object: darray[u8] = path_with_suffix(temporary, "/target.o")
            renamed_object: darray[u8] = path_with_suffix(temporary, "/target-renamed.o")
            runtime_collector_object: darray[u8] = path_with_suffix(temporary, "/runtime-collector.o")
            collector_object: darray[u8] = path_with_suffix(temporary, "/profiler-runtime.o")
            executable: darray[u8] = path_with_suffix(temporary, "/profiled-program")
            capture_path: darray[u8] = path_with_suffix(temporary, "/capture.txt")
            compile_error_path: darray[u8] = path_with_suffix(temporary, "/compile.err")
            compile_output_path: darray[u8] = path_with_suffix(temporary, "/compile.out")
            link_error_path: darray[u8] = path_with_suffix(temporary, "/link.err")
            run_output_path: darray[u8] = path_with_suffix(temporary, "/program.out")
            run_error_path: darray[u8] = path_with_suffix(temporary, "/program.err")
            temp_cstr: cstr = make_cstr(temporary)
            return report_error("could not create native profiler temporary directory") if profiler_ffi_mkdir(temp_cstr, 448) != 0
            build_start: ProfilerNativeTimespec = read_monotonic()

            command: mutable darray[u8] = []
            append_shell_quoted(command, compiler_binary)
            append_text(command, " -g -ftrace -O")
            append_i64(command, opt_level)
            append_text(command, " -o ")
            append_shell_quoted(command, target_object)
            append_text(command, " ")
            append_shell_quoted(command, source)
            append_text(command, " > ")
            append_shell_quoted(command, compile_output_path)
            append_text(command, " 2> ")
            append_shell_quoted(command, compile_error_path)
            command.push(0)
            compile_status: i64 = profiler_ffi_system((&command[0]).cast[cstr] can Unsafe.PointerCast)
            if compile_status != 0:
                diagnostics: darray[u8] = read_file(compile_error_path)
                write_stderr(diagnostics)
                cleanup_temp(temporary)
                return report_error("native target compilation failed")
        
            command <- []
            append_shell_quoted(command, objcopy_tool)
            append_text(command, " --redefine-sym _main=_elisa_profile_target_main ")
            append_shell_quoted(command, target_object)
            append_text(command, " ")
            append_shell_quoted(command, renamed_object)
            command.push(0)
            rename_status: mutable i64 = profiler_ffi_system((&command[0]).cast[cstr] can Unsafe.PointerCast)
            if rename_status != 0:
                command <- []
                append_shell_quoted(command, objcopy_tool)
                append_text(command, " --redefine-sym main=elisa_profile_target_main ")
                append_shell_quoted(command, target_object)
                append_text(command, " ")
                append_shell_quoted(command, renamed_object)
                command.push(0)
                rename_status <- profiler_ffi_system((&command[0]).cast[cstr] can Unsafe.PointerCast)
            if rename_status != 0:
                cleanup_temp(temporary)
                return report_error("could not rename target main for collection")

            # The Elisa runtime owns the trace callback implementations. Make a
            # private link copy and localize those callbacks so the C collector can
            # provide the externally-visible definitions without duplicate symbols.
            runtime_bytes: darray[u8] = read_file(runtime_object)
            if runtime_bytes.count == 0:
                cleanup_temp(temporary)
                return report_error("runtime object could not be read")
            runtime_copy_ok: bool = write_file(runtime_collector_object, runtime_bytes)
            if not runtime_copy_ok:
                cleanup_temp(temporary)
                return report_error("could not copy runtime object for collection")
            command <- []
            append_shell_quoted(command, objcopy_tool)
            append_text(command, " --localize-symbol _elisa_trace_record --localize-symbol elisa_trace_record")
            append_text(command, " --localize-symbol _elisa_trace_record_value --localize-symbol elisa_trace_record_value")
            append_text(command, " --localize-symbol _elisa_trace_function_entry --localize-symbol elisa_trace_function_entry")
            append_text(command, " --localize-symbol elisa_trace_function_entry")
            append_text(command, " --localize-symbol _elisa_trace_function_exit --localize-symbol elisa_trace_function_exit")
            append_text(command, " --localize-symbol elisa_trace_function_exit")
            append_text(command, " --localize-symbol _elisa_trace_install_fault_handler --localize-symbol elisa_trace_install_fault_handler ")
            append_shell_quoted(command, runtime_collector_object)
            command.push(0)
            localize_status: i64 = profiler_ffi_system((&command[0]).cast[cstr] can Unsafe.PointerCast)
            if localize_status != 0:
                cleanup_temp(temporary)
                return report_error("could not localize runtime trace callbacks")
        
            command <- []
            append_shell_quoted(command, compiler_tool)
            append_text(command, " -std=c11 -O2 -DELISA_PROFILE_TIMING=1 -fno-builtin -pthread -c -o ")
            append_shell_quoted(command, collector_object)
            append_text(command, " ")
            append_shell_quoted(command, collector_source)
            command.push(0)
            collector_status: i64 = profiler_ffi_system((&command[0]).cast[cstr] can Unsafe.PointerCast)
            if collector_status != 0:
                cleanup_temp(temporary)
                return report_error("could not compile native collector")
        
            command <- []
            append_shell_quoted(command, compiler_tool)
            append_text(command, " -Wl,-dead_strip -pthread -o ")
            append_shell_quoted(command, executable)
            append_text(command, " ")
            append_shell_quoted(command, renamed_object)
            append_text(command, " ")
            append_shell_quoted(command, runtime_collector_object)
            append_text(command, " ")
            append_shell_quoted(command, collector_object)
            append_text(command, " > ")
            append_shell_quoted(command, compile_output_path)
            append_text(command, " 2> ")
            append_shell_quoted(command, link_error_path)
            command.push(0)
            if profiler_ffi_system((&command[0]).cast[cstr] can Unsafe.PointerCast) != 0:
                diagnostics: darray[u8] = read_file(link_error_path)
                write_stderr(diagnostics)
                cleanup_temp(temporary)
                return report_error("could not link instrumented target")
            compile_elapsed_ns: i64 = elapsed_nanoseconds(build_start, read_monotonic())
        
            command <- []
            capture_fd: i64 = open_output_file(capture_path)
            if capture_fd < 0:
                cleanup_temp(temporary)
                return report_error("could not open native collector transport")
            run_result: TargetRunResult = run_target_direct(executable, run_output_path, run_error_path, capture_fd, event_trace, recent_path, trace_limit)
            _ = profiler_ffi_close(capture_fd)
            capture: darray[u8] = read_file(capture_path)
            program_stderr: darray[u8] = read_file(run_error_path)
            summary: CaptureSummary = parse_capture(capture, source)
            if summary.malformed:
                cleanup_temp(temporary)
                return report_protocol_error(summary)
            report: mutable darray[u8] = []
            if format_text:
                append_text_report(report, source, summary, system_exit_code(run_result.status), event_trace, recent_path, run_result.elapsed_ns, compile_elapsed_ns)
            else:
                append_report(report, source, compiler_root, runtime_object, summary, system_exit_code(run_result.status), opt_level, event_trace, recent_path, program_stderr, run_result.elapsed_ns, compile_elapsed_ns)
            cleanup_temp(temporary)
            if output.count > 0:
                return 0 if write_file(output, report)
                return report_error("could not write native profile report")
            _ = profiler_ffi_write(1, &report[0], report.count) can Console
            return system_exit_code(run_result.status)


def main(argc: i64, argv: mutable void&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    return ProfilerNative::run(argc, argv)
