                    copy_cstr(working_directory, slots[index + NATIVE_ONE].cast[cstr])
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--stdin") == NATIVE_ZERO:
                    return report_error("--stdin requires a path") if index + NATIVE_ONE >= argc
                    copy_cstr(stdin_path, slots[index + NATIVE_ONE].cast[cstr])
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--env") == NATIVE_ZERO:
                    return report_error("--env requires KEY=VALUE") if index + NATIVE_ONE >= argc
                    assignment: mutable darray[u8] = []
                    copy_cstr(assignment, slots[index + NATIVE_ONE].cast[cstr])
                    return report_error("--env requires KEY=VALUE") if not environment_assignment_valid(assignment)
                    environment.extend(assignment)
                    environment.push(NATIVE_BYTE_NUL)
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--event-trace") == NATIVE_ZERO:
                    event_trace <- true
                    index <- index + NATIVE_ONE
                    continue
                if profiler_ffi_strcmp(argument, "--recent-path") == NATIVE_ZERO:
                    recent_path <- true
                    index <- index + NATIVE_ONE
                    continue
                if profiler_ffi_strcmp(argument, "--repeat") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "--warmup") == NATIVE_ZERO:
                    return report_error("--repeat/--warmup requires a positive integer") if index + NATIVE_ONE >= argc
                    count_text: cstr = slots[index + NATIVE_ONE].cast[cstr]
                    count: i64 = parse_nonnegative_cstr(count_text)
                    return report_error("--repeat/--warmup requires a non-negative integer") if count < NATIVE_ZERO
                    if profiler_ffi_strcmp(argument, "--repeat") == NATIVE_ZERO:
                        return report_error("--repeat must be at least 1") if count < NATIVE_ONE
                        requested_repetitions <- count
                    else:
                        warmup_repetitions <- count
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--max-event-trace-events") == NATIVE_ZERO:
                    return report_error("--max-event-trace-events requires a non-negative integer") if index + NATIVE_ONE >= argc
                    limit_text: cstr = slots[index + NATIVE_ONE].cast[cstr]
                    limit: i64 = parse_nonnegative_cstr(limit_text)
                    return report_error("--max-event-trace-events requires a non-negative integer") if limit < NATIVE_ZERO
                    trace_limit <- limit
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--max-capture-bytes") == NATIVE_ZERO:
                    return report_error("--max-capture-bytes requires a non-negative integer") if index + NATIVE_ONE >= argc
                    byte_limit_text: cstr = slots[index + NATIVE_ONE].cast[cstr]
                    byte_limit: i64 = parse_nonnegative_cstr(byte_limit_text)
                    return report_error("--max-capture-bytes requires a non-negative integer") if byte_limit < NATIVE_ZERO
                    capture_byte_limit <- byte_limit
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "--timeout") == NATIVE_ZERO:
                    return report_error("--timeout requires a finite positive number of seconds") if index + NATIVE_ONE >= argc
                    timeout_value: i64 = parse_positive_timeout_ns(slots[index + NATIVE_ONE].cast[cstr])
                    return report_error("--timeout requires a finite positive number of seconds") if timeout_value <= NATIVE_ZERO
                    timeout_ns <- timeout_value
                    index <- index + NATIVE_TWO
                    continue
                if profiler_ffi_strcmp(argument, "-O0") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "--opt-level=0") == NATIVE_ZERO:
                    opt_level <- NATIVE_ZERO
                    index <- index + NATIVE_ONE
                    continue
                if profiler_ffi_strcmp(argument, "-O1") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "--opt-level=1") == NATIVE_ZERO:
                    opt_level <- NATIVE_ONE
                    index <- index + NATIVE_ONE
                    continue
                if profiler_ffi_strcmp(argument, "-O2") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "--opt-level=2") == NATIVE_ZERO:
                    opt_level <- NATIVE_TWO
                    index <- index + NATIVE_ONE
                    continue
                if profiler_ffi_strcmp(argument, "-O3") == NATIVE_ZERO or profiler_ffi_strcmp(argument, "--opt-level=3") == NATIVE_ZERO:
                    opt_level <- NATIVE_THREE
                    index <- index + NATIVE_ONE
                    continue
                if argument[NATIVE_ZERO.usize()] == NATIVE_BYTE_MINUS:
                    return report_error("unknown option in Elisa-native profiler")
                return report_error("profile accepts exactly one source path") if source_seen
                copy_cstr(source, argument)
                source_seen <- true
