                    cleanup_temp(temporary)
                    return report_error("could not open native collector transport for warmup")
                warmup_result: TargetRunResult = run_target_direct(executable, target_arguments, run_output_path, run_error_path, working_directory, stdin_path, environment, capture_fd, collector_status_path, mode, sample_period_microseconds, false, false, NATIVE_ZERO, capture_byte_limit, timeout_ns)
                _ = profiler_ffi_close(capture_fd)
                warmup_result.collector_status <- read_collector_status(collector_status_path)
                warmup_ns <- native_saturating_add(warmup_ns, warmup_result.elapsed_ns)
                if warmup_result.status != NATIVE_ZERO or warmup_result.collector_status >= NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE:
                    cleanup_temp(temporary)
                    return report_error("native profiler warmup failed")
                if not write_progress(progress_path, "warmup_complete", warmup_index, warmup_repetitions, warmup_result.elapsed_ns, summary):
                    cleanup_temp(temporary)
                    return report_error("could not write profiler progress")
                warmup_index <- warmup_index + NATIVE_ONE

            program_stdout: mutable darray[u8] = []
            program_stdout_truncated: mutable bool = false
            program_stderr: mutable darray[u8] = []
            program_stderr_truncated: mutable bool = false
            overall_status: mutable i64 = NATIVE_ZERO
            completed_repetitions: mutable i64 = NATIVE_ZERO
            successful_repetitions: mutable i64 = NATIVE_ZERO
            failed_repetitions: mutable i64 = NATIVE_ZERO
            overall_timed_out: mutable bool = false
            repetition: mutable i64 = NATIVE_ONE
            while repetition <= requested_repetitions |repetition, summary, repetition_records, all_execution_times, measurement_execution_times, all_cpu_user_times, all_cpu_system_times, all_peak_rss_values, all_resource_availability, measurement_cpu_user_times, measurement_cpu_system_times, measurement_peak_rss_values, measurement_resource_availability, program_stdout, program_stdout_truncated, program_stderr, program_stderr_truncated, overall_status, completed_repetitions, successful_repetitions, failed_repetitions, overall_timed_out, last_capture_bytes, last_valid_frames, last_valid_capture_bytes|:
                if not write_progress(progress_path, "capture_started", repetition, requested_repetitions, NATIVE_ZERO, summary):
                    cleanup_temp(temporary)
                    return report_error("could not write profiler progress")
                capture_fd: i64 = open_output_file(capture_path)
                if capture_fd < NATIVE_ZERO:
                    cleanup_temp(temporary)
                    return report_error("could not open native collector transport")
                run_result: TargetRunResult = run_target_direct(executable, target_arguments, run_output_path, run_error_path, working_directory, stdin_path, environment, capture_fd, collector_status_path, mode, sample_period_microseconds, event_trace, recent_path, trace_limit, capture_byte_limit, timeout_ns)
                _ = profiler_ffi_close(capture_fd)
                run_result.collector_status <- read_collector_status(collector_status_path)
                capture: darray[u8] = read_file(capture_path)
                current_summary: mutable CaptureSummary = empty_capture_summary()
                if capture.count == NATIVE_ZERO.usize():
                    if not run_result.timed_out:
                        cleanup_temp(temporary)
                        return report_error("native target produced no collector capture")
                else:
                    current_summary <- parse_capture(capture, display_source, path_maps, source_map_data, source_map.flat_lines, source_map.source_lines, run_result.timed_out, repetition, not protocol_field_is(mode, "sample"))
                    if current_summary.malformed:
                        cleanup_temp(temporary)
                        return report_protocol_json_error(current_summary) if not format_text and not format_folded and not format_html and not format_speedscope else report_protocol_error(current_summary)
                    if run_result.status == NATIVE_ZERO and run_result.collector_status == NATIVE_COLLECTOR_STATUS_UNKNOWN and (not current_summary.capture_started or not current_summary.capture_complete):
                        cleanup_temp(temporary)
                        return report_error("native collector capture missing a complete frame")
                current_summary.collector_status <- run_result.collector_status
                last_capture_bytes <- capture.count.i64()
                last_valid_frames <- current_summary.valid_frames
                last_valid_capture_bytes <- current_summary.valid_capture_bytes
                current_stdout_truncated: mutable bool = false
                current_stdout: darray[u8] = read_bounded_file(run_output_path, NATIVE_MAX_PROGRAM_OUTPUT_BYTES, &current_stdout_truncated)
                append_program_output(&program_stdout, current_stdout, &program_stdout_truncated)
                program_stdout_truncated <- true if current_stdout_truncated
                current_stderr_truncated: mutable bool = false
                current_stderr: darray[u8] = read_bounded_file(run_error_path, NATIVE_MAX_PROGRAM_OUTPUT_BYTES, &current_stderr_truncated)
                append_program_output(&program_stderr, current_stderr, &program_stderr_truncated)
                program_stderr_truncated <- true if current_stderr_truncated
                merge_capture_summary(&summary, current_summary)
                append_repetition_record(&repetition_records, repetition, requested_repetitions, run_result, current_summary, event_trace, recent_path)
                all_execution_times.push(run_result.elapsed_ns)
                all_cpu_user_times.push(run_result.cpu_user_ns)
                all_cpu_system_times.push(run_result.cpu_system_ns)
                all_peak_rss_values.push(run_result.peak_rss_bytes)
                all_resource_availability.push(NATIVE_ONE if run_result.resource_available else NATIVE_ZERO)
                completed_repetitions <- completed_repetitions + NATIVE_ONE
                if run_result.status == NATIVE_ZERO:
                    successful_repetitions <- successful_repetitions + NATIVE_ONE
                    measurement_execution_times.push(run_result.elapsed_ns)
                    measurement_cpu_user_times.push(run_result.cpu_user_ns)
                    measurement_cpu_system_times.push(run_result.cpu_system_ns)
                    measurement_peak_rss_values.push(run_result.peak_rss_bytes)
                    measurement_resource_availability.push(NATIVE_ONE if run_result.resource_available else NATIVE_ZERO)
                else:
                    failed_repetitions <- failed_repetitions + NATIVE_ONE
                    overall_status <- run_result.status if overall_status == NATIVE_ZERO
                if run_result.collector_status >= NATIVE_COLLECTOR_STATUS_SAMPLING_FAILURE and overall_status == NATIVE_ZERO:
                    overall_status <- NATIVE_COLLECTOR_FAILURE_STATUS
                overall_timed_out <- true if run_result.timed_out
                if not write_progress(progress_path, "repetition_complete", repetition, requested_repetitions, run_result.elapsed_ns, summary):
                    cleanup_temp(temporary)
                    return report_error("could not write profiler progress")
                if not write_capture_manifest(capture_manifest_path, source, source_check, mode, capture_path, "running", requested_repetitions, completed_repetitions, successful_repetitions, failed_repetitions, summary, last_capture_bytes, last_valid_frames, last_valid_capture_bytes):
                    cleanup_temp(temporary)
                    return report_error("could not update capture manifest")
                repetition <- repetition + NATIVE_ONE

            source_after_run: darray[u8] = read_file(source)
            if not byte_arrays_equal(source_check, source_after_run):
                cleanup_temp(temporary)
                return report_error("source changed during profiling; retry with a stable source file")
            dependency_after_run: darray[u8] = collect_dependency_digest(compiler_binary, source, dependency_path, compile_output_path, compile_error_path)
            if dependency_after_run.count == NATIVE_ZERO.usize() or not byte_arrays_equal(dependency_digest, dependency_after_run):
                cleanup_temp(temporary)
                return report_error("source dependency tree changed during profiling; retry with stable sources")
            if not write_progress(progress_path, "rendering", completed_repetitions, requested_repetitions, NATIVE_ZERO, summary):
                cleanup_temp(temporary)
                return report_error("could not write profiler progress")
            metric_times: mutable darray[i64] = []
            if measurement_execution_times.count > 0:
                metric_times.extend(measurement_execution_times)
            else:
                metric_times.extend(all_execution_times)
            selected_cpu_user_times: mutable darray[i64] = []
            selected_cpu_system_times: mutable darray[i64] = []
            selected_peak_rss_values: mutable darray[i64] = []
            selected_resource_availability: mutable darray[i64] = []
            if successful_repetitions > NATIVE_ZERO:
                selected_cpu_user_times.extend(measurement_cpu_user_times)
                selected_cpu_system_times.extend(measurement_cpu_system_times)
                selected_peak_rss_values.extend(measurement_peak_rss_values)
                selected_resource_availability.extend(measurement_resource_availability)
            else:
                selected_cpu_user_times.extend(all_cpu_user_times)
                selected_cpu_system_times.extend(all_cpu_system_times)
                selected_peak_rss_values.extend(all_peak_rss_values)
                selected_resource_availability.extend(all_resource_availability)
            resource_metrics_available: mutable bool = selected_resource_availability.count == metric_times.count
            if resource_metrics_available:
                for index in 0..<selected_resource_availability.count |index, selected_resource_availability, resource_metrics_available|:
                    resource_metrics_available <- false if selected_resource_availability[index] == NATIVE_ZERO
            sort_i64(metric_times)
            total_execution_ns: mutable i64 = NATIVE_ZERO
            for index in 0..<metric_times.count |index, metric_times, total_execution_ns|:
                total_execution_ns <- native_saturating_add(total_execution_ns, metric_times[index])
            execution_min_ns: i64 = metric_times[0]
            execution_max_ns: i64 = metric_times[metric_times.count - 1.usize()]
            execution_median_ns: mutable i64 = metric_times[metric_times.count / 2.usize()]
            if metric_times.count % NATIVE_TWO.usize() == NATIVE_ZERO.usize():
                execution_median_ns <- native_saturating_add(metric_times[metric_times.count / NATIVE_TWO.usize() - NATIVE_ONE.usize()], metric_times[metric_times.count / NATIVE_TWO.usize()]) / NATIVE_TWO
            execution_mean_ns: i64 = total_execution_ns / metric_times.count.i64()
            mean_micros: i64 = execution_mean_ns / NATIVE_NANOS_PER_MICROSECOND
            variance: mutable i64 = NATIVE_ZERO
            for index in 0..<metric_times.count |index, metric_times, variance, mean_micros|:
                difference: i64 = metric_times[index] / NATIVE_NANOS_PER_MICROSECOND - mean_micros
                variance <- native_saturating_add(variance, native_saturating_square(difference))
            variance <- variance / (metric_times.count.i64() - NATIVE_ONE) if metric_times.count.i64() > NATIVE_MIN_CONFIDENCE_SAMPLES - NATIVE_ONE
            execution_stdev_ns: i64 = integer_sqrt(variance) * NATIVE_NANOS_PER_MICROSECOND
            execution_ci95_available: bool = metric_times.count.i64() >= NATIVE_MIN_CONFIDENCE_SAMPLES
            execution_ci95_half_width_ns: i64 = native_confidence_half_width(execution_stdev_ns, metric_times.count.i64())
            execution_ci95_low_ns: i64 = execution_mean_ns - execution_ci95_half_width_ns if execution_mean_ns > execution_ci95_half_width_ns else NATIVE_ZERO
            execution_ci95_high_ns: i64 = native_saturating_add(execution_mean_ns, execution_ci95_half_width_ns)
            cpu_user_ns: mutable i64 = NATIVE_ZERO
            cpu_system_ns: mutable i64 = NATIVE_ZERO
            peak_rss_bytes: mutable i64 = NATIVE_ZERO
            if resource_metrics_available:
                for index in 0..<selected_cpu_user_times.count |index, selected_cpu_user_times, cpu_user_ns|:
                    cpu_user_ns <- native_saturating_add(cpu_user_ns, selected_cpu_user_times[index])
                for index in 0..<selected_cpu_system_times.count |index, selected_cpu_system_times, cpu_system_ns|:
                    cpu_system_ns <- native_saturating_add(cpu_system_ns, selected_cpu_system_times[index])
                for index in 0..<selected_peak_rss_values.count |index, selected_peak_rss_values, peak_rss_bytes|:
                    peak_rss_bytes <- selected_peak_rss_values[index] if selected_peak_rss_values[index] > peak_rss_bytes
            final_exit_code: i64 = system_exit_code(overall_status)
            report: mutable darray[u8] = []
            if format_text:
                append_text_report(report, display_source, mode, summary, final_exit_code, overall_status, overall_timed_out, timeout_ns, event_trace, recent_path, total_execution_ns, compile_elapsed_ns, program_stdout, program_stdout_truncated, program_stderr, program_stderr_truncated)
            elif format_folded:
                append_folded_report(report, summary)
            elif format_speedscope:
                append_speedscope_report(report, display_source, summary.folded_records, not protocol_field_is(mode, "sample"), protocol_field_is(mode, "sample"))
            elif format_html:
                append_html_report(report, display_source, source_check, dependency_digest, mode, host, summary, final_exit_code, overall_status, overall_timed_out, timeout_ns, total_execution_ns, execution_mean_ns, compile_elapsed_ns, cpu_user_ns, cpu_system_ns, peak_rss_bytes, resource_metrics_available, completed_repetitions, successful_repetitions, program_stdout, program_stdout_truncated, program_stderr, program_stderr_truncated, working_directory, stdin_path, environment, target_arguments, random_seed, random_seed_source)
            else:
                append_report(report, display_source, source_check, embed_source, mode, compiler_root, compiler_branch, compiler_commit, compiler_dirty, compiler_manifest, compiler_stage1, stage1_digest, runtime_object, runtime_digest, build_cache, build_kind, prebuilt_executable, host, summary, overall_status, opt_level, event_trace, recent_path, overall_timed_out, false, timeout_ns, program_stdout, program_stdout_truncated, program_stderr, program_stderr_truncated, total_execution_ns, compile_elapsed_ns, repetition_records, requested_repetitions, completed_repetitions, successful_repetitions, failed_repetitions, warmup_repetitions, warmup_ns, execution_min_ns, execution_mean_ns, execution_max_ns, execution_median_ns, execution_stdev_ns, execution_ci95_low_ns, execution_ci95_high_ns, execution_ci95_available, cpu_user_ns, cpu_system_ns, peak_rss_bytes, resource_metrics_available, dependency_digest, working_directory, stdin_path, environment, target_arguments, random_seed, random_seed_source)
            artifact: mutable darray[u8] = []
            if artifact_output.count > NATIVE_ZERO.usize():
                append_profile_artifact(&artifact, report)
            manifest_state: mutable sview = "complete"
            manifest_state <- "partial" if overall_timed_out or failed_repetitions > NATIVE_ZERO or not summary.capture_complete
            return report_error("could not finalize capture manifest") if not write_capture_manifest(capture_manifest_path, source, source_check, mode, capture_path, "finalizing", requested_repetitions, completed_repetitions, successful_repetitions, failed_repetitions, summary, last_capture_bytes, last_valid_frames, last_valid_capture_bytes)
            cleanup_temp(temporary)
            if artifact_output.count > NATIVE_ZERO.usize():
                return report_error("could not write profile artifact") if not write_file(artifact_output, artifact)
            if output.count > NATIVE_ZERO.usize():
                return report_error("could not write native profile report") if not write_file(output, report)
            return report_error("could not complete capture manifest") if not write_capture_manifest(capture_manifest_path, source, source_check, mode, capture_path, manifest_state, requested_repetitions, completed_repetitions, successful_repetitions, failed_repetitions, summary, last_capture_bytes, last_valid_frames, last_valid_capture_bytes)
            return report_error("could not write profiler progress") if not write_progress(progress_path, "complete", completed_repetitions, requested_repetitions, total_execution_ns, summary)
            return final_exit_code if output.count > NATIVE_ZERO.usize()
            _ = write_all_fd(NATIVE_STANDARD_OUTPUT, report) can Console
            return final_exit_code


def main(argc: i64, argv: mutable void&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    return ProfilerNative::run(argc, argv)
