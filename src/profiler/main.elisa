            opt_level: mutable i64 = NATIVE_ZERO
            event_trace: mutable bool = false
            recent_path: mutable bool = false
            format_text: mutable bool = false
            format_folded: mutable bool = false
            format_html: mutable bool = false
            format_speedscope: mutable bool = false
            mode: mutable darray[u8] = []
            append_text(mode, "full")
            mode_seen: mutable bool = false
