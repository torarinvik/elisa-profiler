            return report_error("profile requires a source path") if not source_seen
            if diagnostic_mode:
                event_trace <- true
                recent_path <- false
            return report_error("--artifact-output requires --format json") if artifact_output.count > NATIVE_ZERO.usize() and (format_text or format_folded or format_html or format_speedscope)
            source_check: darray[u8] = read_file(source)
            return report_error("source file could not be read") if source_check.count == NATIVE_ZERO.usize()
        
            compiler_root: mutable darray[u8] = []
            environment_or("ELISA_COMPILER_ROOT", "../elisa-compiler-worktrees/profiler", compiler_root)
            compiler_binary: mutable darray[u8] = []
            environment_or("ELISA_STAGE1_BIN", "../elisa-compiler-worktrees/profiler/bin/elisac-stage1", compiler_binary)
            runtime_object: mutable darray[u8] = []
            environment_or("ELISA_RUNTIME_OBJ", "../elisa-compiler-worktrees/profiler/build/runtime/elisacore_runtime.o", runtime_object)
            compiler_tool: mutable darray[u8] = []
            environment_or("ELISA_CLANG", "clang", compiler_tool)
            objcopy_tool: mutable darray[u8] = []
            environment_or("ELISA_LLVM_OBJCOPY", "llvm-objcopy", objcopy_tool)
            git_tool: mutable darray[u8] = []
            environment_or("ELISA_GIT", "git", git_tool)
            collector_source: mutable darray[u8] = []
            environment_or("ELISA_PROFILER_RUNTIME_C", "scripts/profiler_runtime.c", collector_source)
        
            temporary: mutable darray[u8] = []
            append_text(temporary, "/tmp/elisa-profiler-native-")
            append_i64(temporary, profiler_ffi_getpid())
            nonce: ProfilerNativeTimespec = read_monotonic()
            append_text(temporary, "-")
            append_i64(temporary, nonce.seconds)
            append_text(temporary, "-")
            append_i64(temporary, nonce.nanoseconds)
            target_object: darray[u8] = path_with_suffix(temporary, "/target.o")
            renamed_object: darray[u8] = path_with_suffix(temporary, "/target-renamed.o")
            runtime_collector_object: darray[u8] = path_with_suffix(temporary, "/runtime-collector.o")
            collector_object: darray[u8] = path_with_suffix(temporary, "/profiler-runtime.o")
            executable: darray[u8] = path_with_suffix(temporary, "/profiled-program")
            capture_path: darray[u8] = path_with_suffix(temporary, "/capture.txt")
            compile_error_path: darray[u8] = path_with_suffix(temporary, "/compile.err")
            compile_output_path: darray[u8] = path_with_suffix(temporary, "/compile.out")
            link_error_path: darray[u8] = path_with_suffix(temporary, "/link.err")
            run_output_path: darray[u8] = path_with_suffix(temporary, "/program.out")
            run_error_path: darray[u8] = path_with_suffix(temporary, "/program.err")
            compiler_branch_path: darray[u8] = path_with_suffix(temporary, "/compiler-branch")
            compiler_commit_path: darray[u8] = path_with_suffix(temporary, "/compiler-commit")
            compiler_dirty_path: darray[u8] = path_with_suffix(temporary, "/compiler-dirty")
            compiler_metadata_error_path: darray[u8] = path_with_suffix(temporary, "/compiler-metadata.err")
            temporary_cstr: mutable darray[u8] = []
            temporary_cstr.extend(temporary)
            temporary_cstr.push(NATIVE_BYTE_NUL)
            temporary_cstr_pointer: cstr = (&temporary_cstr[0]).cast[cstr] can Unsafe.PointerCast
            return report_error("could not create native profiler temporary directory") if profiler_ffi_mkdir(temporary_cstr_pointer, NATIVE_DIRECTORY_MODE) != NATIVE_ZERO
            build_start: ProfilerNativeTimespec = read_monotonic()

            command_arguments: mutable darray[darray[u8]] = []
            append_command_argument(command_arguments, "-g")
            append_command_argument(command_arguments, "-ftrace")
            append_command_i64_argument(command_arguments, "-O", opt_level)
            append_command_argument(command_arguments, "-o")
            append_command_path_argument(command_arguments, target_object)
            append_command_path_argument(command_arguments, source)
            compile_status: i64 = run_tool_direct(compiler_binary, command_arguments, compile_output_path, compile_error_path)
            if compile_status != NATIVE_ZERO:
                diagnostics: darray[u8] = read_file(compile_error_path)
                write_stderr(diagnostics)
                cleanup_temp(temporary)
                return report_error("native target compilation failed")
            source_after_compile: darray[u8] = read_file(source)
            if not byte_arrays_equal(source_check, source_after_compile):
                cleanup_temp(temporary)
                return report_error("source changed while the target was compiling; retry with a stable source file")
        
            command_arguments <- []
            append_command_argument(command_arguments, "--redefine-sym")
            append_command_argument(command_arguments, "_main=_elisa_profile_target_main")
            append_command_path_argument(command_arguments, target_object)
            append_command_path_argument(command_arguments, renamed_object)
            rename_status: mutable i64 = run_tool_direct(objcopy_tool, command_arguments, compile_output_path, compile_error_path)
            if rename_status != NATIVE_ZERO:
                command_arguments <- []
                append_command_argument(command_arguments, "--redefine-sym")
                append_command_argument(command_arguments, "main=elisa_profile_target_main")
                append_command_path_argument(command_arguments, target_object)
                append_command_path_argument(command_arguments, renamed_object)
                rename_status <- run_tool_direct(objcopy_tool, command_arguments, compile_output_path, compile_error_path)
            if rename_status != NATIVE_ZERO:
                cleanup_temp(temporary)
                return report_error("could not rename target main for collection")

            # The Elisa runtime owns the trace callback implementations. Make a
            # private link copy and localize those callbacks so the C collector can
            # provide the externally-visible definitions without duplicate symbols.
            runtime_bytes: darray[u8] = read_file(runtime_object)
            if runtime_bytes.count == NATIVE_ZERO.usize():
                cleanup_temp(temporary)
                return report_error("runtime object could not be read")
            runtime_copy_ok: bool = write_file(runtime_collector_object, runtime_bytes)
            if not runtime_copy_ok:
                cleanup_temp(temporary)
                return report_error("could not copy runtime object for collection")
            command_arguments <- []
            append_command_argument(command_arguments, "--localize-symbol")
            append_command_argument(command_arguments, "_elisa_trace_record")
            append_command_argument(command_arguments, "--localize-symbol")
            append_command_argument(command_arguments, "elisa_trace_record")
            append_command_argument(command_arguments, "--localize-symbol")
            append_command_argument(command_arguments, "_elisa_trace_record_value")
            append_command_argument(command_arguments, "--localize-symbol")
            append_command_argument(command_arguments, "elisa_trace_record_value")
            append_command_argument(command_arguments, "--localize-symbol")
            append_command_argument(command_arguments, "_elisa_trace_function_entry")
            append_command_argument(command_arguments, "--localize-symbol")
            append_command_argument(command_arguments, "elisa_trace_function_entry")
            append_command_argument(command_arguments, "--localize-symbol")
            append_command_argument(command_arguments, "_elisa_trace_function_exit")
            append_command_argument(command_arguments, "--localize-symbol")
            append_command_argument(command_arguments, "elisa_trace_function_exit")
            append_command_argument(command_arguments, "--localize-symbol")
            append_command_argument(command_arguments, "_elisa_trace_install_fault_handler")
            append_command_argument(command_arguments, "--localize-symbol")
            append_command_argument(command_arguments, "elisa_trace_install_fault_handler")
            append_command_path_argument(command_arguments, runtime_collector_object)
            localize_status: i64 = run_tool_direct(objcopy_tool, command_arguments, compile_output_path, compile_error_path)
            if localize_status != NATIVE_ZERO:
                cleanup_temp(temporary)
                return report_error("could not localize runtime trace callbacks")
        
            command_arguments <- []
            append_command_argument(command_arguments, "-std=c11")
            append_command_argument(command_arguments, "-O2")
            append_command_argument(command_arguments, "-DELISA_PROFILE_TIMING=1")
            append_command_argument(command_arguments, "-fno-builtin")
            append_command_argument(command_arguments, "-pthread")
            append_command_argument(command_arguments, "-c")
            append_command_argument(command_arguments, "-o")
            append_command_path_argument(command_arguments, collector_object)
            append_command_path_argument(command_arguments, collector_source)
            collector_status: i64 = run_tool_direct(compiler_tool, command_arguments, compile_output_path, compile_error_path)
            if collector_status != NATIVE_ZERO:
                cleanup_temp(temporary)
                return report_error("could not compile native collector")
        
            command_arguments <- []
            append_command_argument(command_arguments, "-Wl,-dead_strip")
            append_command_argument(command_arguments, "-pthread")
            append_command_argument(command_arguments, "-o")
            append_command_path_argument(command_arguments, executable)
            append_command_path_argument(command_arguments, renamed_object)
            append_command_path_argument(command_arguments, runtime_collector_object)
            append_command_path_argument(command_arguments, collector_object)
            if run_tool_direct(compiler_tool, command_arguments, compile_output_path, link_error_path) != NATIVE_ZERO:
                diagnostics: darray[u8] = read_file(link_error_path)
                write_stderr(diagnostics)
                cleanup_temp(temporary)
                return report_error("could not link instrumented target")
            compile_elapsed_ns: i64 = elapsed_nanoseconds(build_start, read_monotonic())
            compiler_branch: mutable darray[u8] = read_git_metadata(compiler_root, "branch", compiler_branch_path, compiler_metadata_error_path, git_tool)
            if compiler_branch.count == NATIVE_ZERO.usize():
                append_text(compiler_branch, "unknown")
            compiler_commit: mutable darray[u8] = read_git_metadata(compiler_root, "commit", compiler_commit_path, compiler_metadata_error_path, git_tool)
            if compiler_commit.count == NATIVE_ZERO.usize():
                append_text(compiler_commit, "unknown")
            dirty_metadata: darray[u8] = read_git_metadata(compiler_root, "dirty", compiler_dirty_path, compiler_metadata_error_path, git_tool)
            compiler_dirty: bool = dirty_metadata.count > NATIVE_ZERO.usize()
        
            summary: mutable CaptureSummary = empty_capture_summary()
            repetition_records: mutable darray[u8] = []
            all_execution_times: mutable darray[i64] = []
            measurement_execution_times: mutable darray[i64] = []
            all_cpu_user_times: mutable darray[i64] = []
            all_cpu_system_times: mutable darray[i64] = []
            all_peak_rss_values: mutable darray[i64] = []
            all_resource_availability: mutable darray[i64] = []
            measurement_cpu_user_times: mutable darray[i64] = []
            measurement_cpu_system_times: mutable darray[i64] = []
            measurement_peak_rss_values: mutable darray[i64] = []
            measurement_resource_availability: mutable darray[i64] = []
            warmup_ns: mutable i64 = NATIVE_ZERO
            warmup_index: mutable i64 = NATIVE_ONE
            while warmup_index <= warmup_repetitions |warmup_index, warmup_ns|:
                capture_fd: i64 = open_output_file(capture_path)
                if capture_fd < NATIVE_ZERO:
                    cleanup_temp(temporary)
                    return report_error("could not open native collector transport for warmup")
                warmup_result: TargetRunResult = run_target_direct(executable, target_arguments, run_output_path, run_error_path, working_directory, stdin_path, environment, capture_fd, mode, false, false, NATIVE_ZERO, capture_byte_limit, timeout_ns)
                _ = profiler_ffi_close(capture_fd)
                warmup_ns <- warmup_ns + warmup_result.elapsed_ns
                if warmup_result.status != NATIVE_ZERO:
                    cleanup_temp(temporary)
                    return report_error("native profiler warmup failed")
                warmup_index <- warmup_index + 1

            program_stderr: mutable darray[u8] = []
            overall_status: mutable i64 = NATIVE_ZERO
            completed_repetitions: mutable i64 = NATIVE_ZERO
            successful_repetitions: mutable i64 = NATIVE_ZERO
            failed_repetitions: mutable i64 = NATIVE_ZERO
            overall_timed_out: mutable bool = false
            repetition: mutable i64 = NATIVE_ONE
            while repetition <= requested_repetitions |repetition, summary, repetition_records, all_execution_times, measurement_execution_times, all_cpu_user_times, all_cpu_system_times, all_peak_rss_values, all_resource_availability, measurement_cpu_user_times, measurement_cpu_system_times, measurement_peak_rss_values, measurement_resource_availability, program_stderr, overall_status, completed_repetitions, successful_repetitions, failed_repetitions, overall_timed_out|:
                capture_fd: i64 = open_output_file(capture_path)
                if capture_fd < NATIVE_ZERO:
                    cleanup_temp(temporary)
                    return report_error("could not open native collector transport")
                run_result: TargetRunResult = run_target_direct(executable, target_arguments, run_output_path, run_error_path, working_directory, stdin_path, environment, capture_fd, mode, event_trace, recent_path, trace_limit, capture_byte_limit, timeout_ns)
                _ = profiler_ffi_close(capture_fd)
                capture: darray[u8] = read_file(capture_path)
                current_summary: mutable CaptureSummary = empty_capture_summary()
                if capture.count == NATIVE_ZERO.usize():
                    if not run_result.timed_out:
                        cleanup_temp(temporary)
                        return report_error("native target produced no collector capture")
                else:
                    current_summary <- parse_capture(capture, source)
                    if current_summary.malformed:
                        cleanup_temp(temporary)
                        return report_protocol_error(current_summary)
                    if run_result.status == NATIVE_ZERO and (not current_summary.capture_started or not current_summary.capture_complete):
                        cleanup_temp(temporary)
                        return report_error("native collector capture missing a complete frame")
                current_stderr: darray[u8] = read_file(run_error_path)
                if current_stderr.count > 0:
                    if program_stderr.count > NATIVE_ZERO.usize():
                        program_stderr.push(NATIVE_BYTE_NEWLINE)
                    program_stderr.extend(current_stderr)
                merge_capture_summary(&summary, current_summary)
                append_repetition_record(&repetition_records, repetition, requested_repetitions, run_result, current_summary, event_trace, recent_path)
                all_execution_times.push(run_result.elapsed_ns)
                all_cpu_user_times.push(run_result.cpu_user_ns)
                all_cpu_system_times.push(run_result.cpu_system_ns)
                all_peak_rss_values.push(run_result.peak_rss_bytes)
                all_resource_availability.push(NATIVE_ONE if run_result.resource_available else NATIVE_ZERO)
                completed_repetitions <- completed_repetitions + 1
                if run_result.status == NATIVE_ZERO:
                    successful_repetitions <- successful_repetitions + 1
                    measurement_execution_times.push(run_result.elapsed_ns)
                    measurement_cpu_user_times.push(run_result.cpu_user_ns)
                    measurement_cpu_system_times.push(run_result.cpu_system_ns)
                    measurement_peak_rss_values.push(run_result.peak_rss_bytes)
                    measurement_resource_availability.push(NATIVE_ONE if run_result.resource_available else NATIVE_ZERO)
                else:
                    failed_repetitions <- failed_repetitions + 1
                    overall_status <- run_result.status if overall_status == NATIVE_ZERO
                overall_timed_out <- true if run_result.timed_out
                repetition <- repetition + 1

            metric_times: mutable darray[i64] = []
            if measurement_execution_times.count > 0:
                metric_times.extend(measurement_execution_times)
            else:
                metric_times.extend(all_execution_times)
            selected_cpu_user_times: mutable darray[i64] = []
            selected_cpu_system_times: mutable darray[i64] = []
            selected_peak_rss_values: mutable darray[i64] = []
            selected_resource_availability: mutable darray[i64] = []
            if successful_repetitions > NATIVE_ZERO:
                selected_cpu_user_times.extend(measurement_cpu_user_times)
                selected_cpu_system_times.extend(measurement_cpu_system_times)
                selected_peak_rss_values.extend(measurement_peak_rss_values)
                selected_resource_availability.extend(measurement_resource_availability)
            else:
                selected_cpu_user_times.extend(all_cpu_user_times)
                selected_cpu_system_times.extend(all_cpu_system_times)
                selected_peak_rss_values.extend(all_peak_rss_values)
                selected_resource_availability.extend(all_resource_availability)
            resource_metrics_available: mutable bool = selected_resource_availability.count == metric_times.count
            if resource_metrics_available:
                for index in 0..<selected_resource_availability.count |index, selected_resource_availability, resource_metrics_available|:
                    resource_metrics_available <- false if selected_resource_availability[index] == NATIVE_ZERO
            sort_i64(metric_times)
            total_execution_ns: mutable i64 = NATIVE_ZERO
            for index in 0..<metric_times.count |index, metric_times, total_execution_ns|:
                total_execution_ns <- total_execution_ns + metric_times[index]
            execution_min_ns: i64 = metric_times[0]
            execution_max_ns: i64 = metric_times[metric_times.count - 1.usize()]
            execution_median_ns: mutable i64 = metric_times[metric_times.count / 2.usize()]
            if metric_times.count % NATIVE_TWO.usize() == NATIVE_ZERO.usize():
                execution_median_ns <- (metric_times[metric_times.count / NATIVE_TWO.usize() - NATIVE_ONE.usize()] + metric_times[metric_times.count / NATIVE_TWO.usize()]) / NATIVE_TWO
            execution_mean_ns: i64 = total_execution_ns / metric_times.count.i64()
            mean_micros: i64 = execution_mean_ns / NATIVE_NANOS_PER_MICROSECOND
            variance: mutable i64 = NATIVE_ZERO
            for index in 0..<metric_times.count |index, metric_times, variance, mean_micros|:
                difference: i64 = metric_times[index] / NATIVE_NANOS_PER_MICROSECOND - mean_micros
                variance <- variance + difference * difference
            variance <- variance / metric_times.count.i64()
            execution_stdev_ns: i64 = integer_sqrt(variance) * NATIVE_NANOS_PER_MICROSECOND
            cpu_user_ns: mutable i64 = NATIVE_ZERO
            cpu_system_ns: mutable i64 = NATIVE_ZERO
            peak_rss_bytes: mutable i64 = NATIVE_ZERO
            if resource_metrics_available:
                for index in 0..<selected_cpu_user_times.count |index, selected_cpu_user_times, cpu_user_ns|:
                    cpu_user_ns <- cpu_user_ns + selected_cpu_user_times[index]
                for index in 0..<selected_cpu_system_times.count |index, selected_cpu_system_times, cpu_system_ns|:
                    cpu_system_ns <- cpu_system_ns + selected_cpu_system_times[index]
                for index in 0..<selected_peak_rss_values.count |index, selected_peak_rss_values, peak_rss_bytes|:
                    peak_rss_bytes <- selected_peak_rss_values[index] if selected_peak_rss_values[index] > peak_rss_bytes
            final_exit_code: i64 = system_exit_code(overall_status)
            report: mutable darray[u8] = []
            if format_text:
                append_text_report(report, source, mode, summary, final_exit_code, overall_status, overall_timed_out, timeout_ns, event_trace, recent_path, total_execution_ns, compile_elapsed_ns)
            elif format_folded:
                append_folded_report(report, summary)
            elif format_speedscope:
                append_speedscope_report(report, source, summary.folded_records, true)
            elif format_html:
                append_html_report(report, source, mode, summary, final_exit_code, overall_status, overall_timed_out, timeout_ns, total_execution_ns, compile_elapsed_ns)
            else:
                append_report(report, source, source_check, mode, compiler_root, compiler_branch, compiler_commit, compiler_dirty, runtime_object, summary, overall_status, opt_level, event_trace, recent_path, overall_timed_out, timeout_ns, program_stderr, total_execution_ns, compile_elapsed_ns, repetition_records, requested_repetitions, completed_repetitions, successful_repetitions, failed_repetitions, warmup_repetitions, warmup_ns, execution_min_ns, execution_mean_ns, execution_max_ns, execution_median_ns, execution_stdev_ns, cpu_user_ns, cpu_system_ns, peak_rss_bytes, resource_metrics_available, working_directory, stdin_path, environment, target_arguments)
            artifact: mutable darray[u8] = []
            if artifact_output.count > NATIVE_ZERO.usize():
                append_profile_artifact(&artifact, report)
            cleanup_temp(temporary)
            if artifact_output.count > NATIVE_ZERO.usize():
                return report_error("could not write profile artifact") if not write_file(artifact_output, artifact)
            if output.count > NATIVE_ZERO.usize():
                return report_error("could not write native profile report") if not write_file(output, report)
                return final_exit_code
            _ = write_all_fd(NATIVE_STANDARD_OUTPUT, report) can Console
            return final_exit_code


def main(argc: i64, argv: mutable void&) -> i64 can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast, Console]:
    return ProfilerNative::run(argc, argv)
