# Explicit feature claims for a capture.
#
# The profiler must never make a missing runtime hook look like a zero-valued
# measurement. This module is deliberately small and private: it owns the
# capability vocabulary emitted into reports, while the collector and compiler
# remain responsible for producing the evidence named here.
extend ProfilerNative:
    private:
        def allocation_abi_flag_count(evidence: darray[i64]&, mask: i64) -> i64 can[Abort.Panic]:
            count: mutable i64 = NATIVE_ZERO
            for flags in evidence |count, mask|:
                if flags >= NATIVE_ZERO and flags / mask % NATIVE_TWO == NATIVE_ONE:
                    count <- native_saturating_add(count, NATIVE_ONE)
            return count

        def append_allocation_abi_description(buffer: mutable darray[u8]&, evidence: darray[i64]&) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "Allocation hook ABI: ")
            if evidence.count == NATIVE_ZERO.usize():
                append_text(buffer, "unknown; no measured repetition metadata is available.")
                return
            missing: mutable i64 = NATIVE_ZERO
            for flags in evidence |missing|:
                missing <- native_saturating_add(missing, NATIVE_ONE) if flags < NATIVE_ZERO
            append_text(buffer, "measured repetitions: ")
            append_i64(buffer, evidence.count.i64())
            append_text(buffer, "; negotiated v1: ")
            append_i64(buffer, allocation_abi_flag_count(evidence, NATIVE_ALLOCATION_ABI_NEGOTIATED))
            append_text(buffer, "; v1 calls: ")
            append_i64(buffer, allocation_abi_flag_count(evidence, NATIVE_ALLOCATION_ABI_VERSIONED_CALL))
            append_text(buffer, "; legacy calls: ")
            append_i64(buffer, allocation_abi_flag_count(evidence, NATIVE_ALLOCATION_ABI_LEGACY))
            append_text(buffer, "; rejected versions: ")
            rejected: i64 = allocation_abi_flag_count(evidence, NATIVE_ALLOCATION_ABI_REJECTED)
            append_i64(buffer, rejected)
            append_text(buffer, "; metadata unavailable: ")
            append_i64(buffer, missing)
            append_text(buffer, ". Counts overlap and describe repetitions, not allocation events. Missing metadata is unknown, not zero; negotiation does not prove complete allocation coverage.")
            if rejected > NATIVE_ZERO:
                append_text(buffer, " Unsupported hook ABI requested: use a producer supporting exact ABI v1 or a collector supporting the producer's version.")

        def allocation_collection_enabled(mode: darray[u8]&) -> bool:
            return protocol_field_is(mode, "full") or protocol_field_is(mode, "diagnostic")

        def allocation_hook_observed(records: i64, dropped: i64) -> bool:
            return records > NATIVE_ZERO or dropped > NATIVE_ZERO

        def append_allocation_capability_description(buffer: mutable darray[u8]&, mode: darray[u8]&, records: i64, dropped: i64) -> void can[Abort.Panic, Memory.Allocate]:
            if not allocation_collection_enabled(mode):
                append_text(buffer, "allocation disabled (mode_not_selected)")
            elif allocation_hook_observed(records, dropped):
                append_text(buffer, "allocation active (elisa_arena_hooks observed; completeness not implied)")
            else:
                append_text(buffer, "allocation unconfirmed (no allocation hook evidence; not a zero-allocation measurement)")

        def append_capability_text_summary(buffer: mutable darray[u8]&, mode: darray[u8]&, summary: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "capability boundary: sampling active (SIGPROF instrumented Elisa stacks only); " if protocol_field_is(mode, "sample") else "capability boundary: sampling disabled; ")
            append_allocation_capability_description(buffer, mode, summary.allocation_record_count, summary.allocation_dropped)
            append_text(buffer, "; tasks unsupported (task_lifecycle_hooks_unavailable); identity ")
            append_text(buffer, "compiler_stable_ids (compiler_issued_function_and_location_ids)" if summary.stable_ids_available else "source_name_fallback (compiler_stable_ids_unavailable)")
            append_text(buffer, "\n")
            append_allocation_abi_description(buffer, summary.allocation_abi_evidence)
            append_text(buffer, "\n")


        def append_capability_html_summary(buffer: mutable darray[u8]&, mode: darray[u8]&, summary: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, "<section><h2>Capability boundary</h2><p>These are evidence limits, not zero measurements.</p><ul><li><strong>Sampling:</strong> active — SIGPROF samples the active instrumented Elisa stack only.</li>" if protocol_field_is(mode, "sample") else "<section><h2>Capability boundary</h2><p>These are evidence limits, not zero measurements.</p><ul><li><strong>Sampling:</strong> disabled for this collection mode.</li>")
            append_text(buffer, "<li>")
            append_allocation_capability_description(buffer, mode, summary.allocation_record_count, summary.allocation_dropped)
            append_text(buffer, "</li>")
            append_text(buffer, "<li><strong>Tasks:</strong> unsupported — task lifecycle hooks are unavailable.</li><li><strong>Identity:</strong> ")
            append_text(buffer, "compiler stable IDs — compiler-issued function and location IDs were observed." if summary.stable_ids_available else "source-name fallback — compiler stable IDs are unavailable.")
            append_text(buffer, "</li></ul></section>")
            append_text(buffer, "<p>")
            append_allocation_abi_description(buffer, summary.allocation_abi_evidence)
            append_text(buffer, "</p>")


        def append_collection_capabilities(buffer: mutable darray[u8]&, mode: darray[u8]&, event_trace: bool, recent_path: bool, summary: CaptureSummary) -> void can[Abort.Panic, Memory.Allocate]:
            append_text(buffer, ",\"capabilities\":{\"event_classes\":[")
            if protocol_field_is(mode, "functions"):
                append_text(buffer, "\"function\"")
            elif protocol_field_is(mode, "statements"):
                append_text(buffer, "\"function\",\"statement\"")
            elif protocol_field_is(mode, "values"):
                append_text(buffer, "\"function\",\"value\"")
            elif protocol_field_is(mode, "sample"):
                append_text(buffer, "\"sample\"")
            else:
                append_text(buffer, "\"function\",\"statement\",\"value\"")
            append_text(buffer, "],\"trace\":")
            append_text(buffer, "\"full\"" if event_trace else "\"disabled\"")
            append_text(buffer, ",\"transport\":{\"framing\":\"record\",\"checksum\":\"fnv1a64\",\"sequence\":\"strict\"}")
            append_text(buffer, ",\"recent_path\":")
            append_text(buffer, "\"last_256\"" if recent_path else "\"disabled\"")
            append_text(buffer, ",\"timing\":\"cpu\",\"sampling\":\"instrumented_cpu\"" if protocol_field_is(mode, "sample") else ",\"timing\":\"wall\",\"sampling\":\"disabled\"")
            append_text(buffer, ",\"sampling_detail\":{\"status\":\"active\",\"reason\":\"sigprof_itimer_prof\",\"scope\":\"instrumented_call_stack\"}" if protocol_field_is(mode, "sample") else ",\"sampling_detail\":{\"status\":\"disabled\",\"reason\":\"mode_not_selected\",\"scope\":\"none\"}")
            if not allocation_collection_enabled(mode):
                append_text(buffer, ",\"allocation\":{\"status\":\"disabled\",\"reason\":\"mode_not_selected\",\"scope\":\"none\"}")
            elif allocation_hook_observed(summary.allocation_record_count, summary.allocation_dropped):
                append_text(buffer, ",\"allocation\":{\"status\":\"active\",\"reason\":\"elisa_arena_hooks\",\"scope\":\"capture\"}")
            else:
                append_text(buffer, ",\"allocation\":{\"status\":\"unconfirmed\",\"reason\":\"no_allocation_hook_evidence\",\"scope\":\"none\"}")
            append_text(buffer, ",\"tasks\":{\"status\":\"unsupported\",\"reason\":\"task_lifecycle_hooks_unavailable\",\"scope\":\"none\"}")
            append_text(buffer, ",\"identity\":{\"status\":\"")
            append_text(buffer, "compiler_stable_ids\",\"reason\":\"compiler_issued_function_and_location_ids\"" if summary.stable_ids_available else "source_name_fallback\",\"reason\":\"compiler_stable_ids_unavailable\"")
            if summary.stable_ids_available:
                append_text(buffer, ",\"namespace\":\"")
                append_text(buffer, "elisa.compiler.trace")
                append_text(buffer, "\",\"version\":")
                append_i64(buffer, NATIVE_TRACE_ID_VERSION)
            else:
                append_text(buffer, ",\"namespace\":null,\"version\":null")
            append_text(buffer, ",\"scope\":\"capture\"}")
            append_text(buffer, ",\"detail_limits\":{\"locations\":")
            append_i64(buffer, summary.location_limit)
            append_text(buffer, ",\"call_edges\":")
            append_i64(buffer, summary.call_edge_limit)
            append_text(buffer, ",\"stacks\":")
            append_i64(buffer, summary.stack_limit)
            append_text(buffer, ",\"capture_bytes\":")
            append_i64(buffer, summary.capture_byte_limit)
            append_text(buffer, "}}")
