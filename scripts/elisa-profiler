#!/usr/bin/env bash
# Transitional path for callers that used the original script location.
#
# User-facing profiling is native Elisa code. The Python implementation lives
# at scripts/elisa-profiler-legacy.py only as a migration oracle for fixtures;
# this launcher never falls back to it.
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
NATIVE_PROFILER="${ELISA_NATIVE_PROFILER_BIN:-$ROOT/bin/elisa-profiler}"
export ELISA_COMPILER_ROOT="${ELISA_COMPILER_ROOT:-$ROOT/../elisa-compiler-worktrees/profiler}"
export ELISA_STAGE1_BIN="${ELISA_STAGE1_BIN:-$ELISA_COMPILER_ROOT/bin/elisac-stage1}"
export ELISA_RUNTIME_OBJ="${ELISA_RUNTIME_OBJ:-$ELISA_COMPILER_ROOT/build/runtime/elisacore_runtime.o}"
export ELISA_PROFILER_RUNTIME_C="${ELISA_PROFILER_RUNTIME_C:-$ROOT/scripts/profiler_runtime.c}"

if [[ ! -x "$NATIVE_PROFILER" ]]; then
    echo "native Elisa profiler is unavailable: $NATIVE_PROFILER" >&2
    echo "build it with: make profiler-native" >&2
    exit 2
fi

exec "$NATIVE_PROFILER" "$@"
