#!/usr/bin/env python3
"""Compile, run, and report an instrumented Elisa program."""

from __future__ import annotations

import argparse
import json
import math
import os
from html import escape
from pathlib import Path
import re
import shutil
import signal
import statistics
import subprocess
import sys
import tempfile
import time
from collections import defaultdict
from typing import Any, NoReturn

try:
    import resource
except ImportError:  # pragma: no cover - resource is unavailable on some platforms.
    resource = None  # type: ignore[assignment]


ROOT = Path(__file__).resolve().parent.parent
DEFAULT_COMPILER_ROOT = ROOT.parent / "elisa-compiler-worktrees" / "profiler"
DEFAULT_STAGE0_CORE = ROOT.parent.parent / "Go projects" / "structpy-tree"
INCLUDE_RE = re.compile(r'^[ \t]*(?:#\s*)?include[ \t]+"([^"]+)"[ \t]*$')
MAX_RSS_RE = re.compile(r"^\s*(\d+)\s+maximum resident set size\s*$")


class ProfilerError(Exception):
    pass


def executable(value: str | None, candidates: list[Path], name: str) -> str:
    if value:
        path = Path(value)
        if path.is_file() and os.access(path, os.X_OK):
            return str(path)
        found = shutil.which(value)
        if found:
            return found
    for candidate in candidates:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    found = shutil.which(name)
    if found:
        return found
    raise ProfilerError(f"could not find {name}; set the corresponding LLVM tool environment variable")


def compiler_tools() -> tuple[str, str, str]:
    llvm_config_value = os.environ.get("LLVM_CONFIG", "/opt/homebrew/opt/llvm/bin/llvm-config")
    llvm_config = Path(llvm_config_value)
    llvm_bin = Path(os.environ.get("ELISA_LLVM_BIN_DIR", str(llvm_config.parent)))
    clang = executable(
        os.environ.get("ELISA_CLANG"),
        [llvm_bin / "clang", Path("/usr/bin/clang")],
        "clang",
    )
    objcopy = executable(
        os.environ.get("ELISA_LLVM_OBJCOPY"),
        [llvm_bin / "llvm-objcopy"],
        "llvm-objcopy",
    )
    nm = executable(
        os.environ.get("ELISA_LLVM_NM"),
        [llvm_bin / "llvm-nm", Path("/usr/bin/nm")],
        "nm",
    )
    return clang, objcopy, nm


def run_command(command: list[str], *, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, env=env, text=True, capture_output=True, check=False)


def signal_process_group(process: subprocess.Popen[bytes], signal_number: int) -> None:
    if os.name == "posix":
        try:
            os.killpg(process.pid, signal_number)
            return
        except ProcessLookupError:
            return
        except OSError:
            pass
    process.send_signal(signal_number)


def measured_resource_file(
    temp_root: Path, repetition: int, timeout: float | None
) -> Path | None:
    if (
        timeout is not None
        or sys.platform != "darwin"
        or not os.access("/usr/bin/time", os.X_OK)
    ):
        return None
    return temp_root / f"run-{repetition}.time"


def parse_resource_report(resource_path: Path | None) -> dict[str, float | int]:
    resources: dict[str, float | int] = {}
    if resource_path is None or not resource_path.is_file():
        return resources
    for line in resource_path.read_text(encoding="utf-8", errors="replace").splitlines():
        match = MAX_RSS_RE.match(line)
        if match:
            resources["peak_rss_bytes"] = int(match.group(1))
    return resources


def execute_program(
    executable_path: Path,
    timeout: float | None,
    resource_path: Path | None = None,
    env: dict[str, str] | None = None,
) -> tuple[int, bytes, bytes, bool, dict[str, float | int]]:
    command = [str(executable_path)]
    if resource_path is not None:
        command = ["/usr/bin/time", "-l", "-o", str(resource_path), *command]
    process = subprocess.Popen(
        command,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=os.name == "posix",
    )
    timed_out = False
    try:
        stdout, stderr = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        signal_process_group(process, signal.SIGTERM)
        try:
            stdout, stderr = process.communicate(timeout=2)
        except subprocess.TimeoutExpired:
            signal_process_group(process, signal.SIGKILL)
            stdout, stderr = process.communicate()
    return process.returncode, stdout, stderr, timed_out, parse_resource_report(resource_path)


def child_cpu_usage() -> tuple[float, float] | None:
    if resource is None:
        return None
    usage = resource.getrusage(resource.RUSAGE_CHILDREN)
    return usage.ru_utime, usage.ru_stime


def child_cpu_delta(
    before: tuple[float, float] | None, after: tuple[float, float] | None
) -> tuple[float, float] | None:
    if before is None or after is None:
        return None
    return (
        max(0.0, (after[0] - before[0]) * 1000.0),
        max(0.0, (after[1] - before[1]) * 1000.0),
    )


def git_value(root: Path, *arguments: str, fallback: str = "unknown") -> str:
    result = run_command(["git", "-C", str(root), *arguments])
    if result.returncode == 0:
        value = result.stdout.strip()
        if value:
            return value
    return fallback


def compiler_metadata(compiler_root: Path, runtime_object: Path) -> dict[str, Any]:
    status = git_value(compiler_root, "status", "--porcelain", fallback="")
    return {
        "root": str(compiler_root),
        "branch": git_value(compiler_root, "branch", "--show-current"),
        "commit": git_value(compiler_root, "rev-parse", "HEAD"),
        "dirty": bool(status),
        "runtime_object": str(runtime_object),
    }


def ensure_runtime(
    compiler_root: Path,
    runtime_object: Path,
    stage0_core: Path,
    *,
    rebuild: bool,
    env: dict[str, str],
) -> None:
    if runtime_object.is_file() and not rebuild and not runtime_sources_newer(
        compiler_root, runtime_object
    ):
        return
    build_script = compiler_root / "scripts" / "build_runtime_object.sh"
    if not build_script.is_file():
        raise ProfilerError(f"runtime builder is missing: {build_script}")
    stage0_binary = stage0_core / "compiler" / "bin" / "elisac"
    if not stage0_binary.is_file():
        raise ProfilerError(
            f"stage0 compiler is missing: {stage0_binary}; set ELISA_STAGE0_CORE or build the local stage0 compiler"
        )
    build_env = env.copy()
    build_env["ELISA_CORE"] = str(stage0_core)
    build_env["ELISA_RUNTIME_OBJ"] = str(runtime_object)
    result = run_command([str(build_script)], env=build_env)
    if result.returncode != 0 or not runtime_object.is_file():
        message = result.stderr.strip() or result.stdout.strip() or "runtime build failed"
        raise ProfilerError(message)


def runtime_sources_newer(compiler_root: Path, runtime_object: Path) -> bool:
    """Return whether a source that contributes to the cached runtime is newer."""
    try:
        runtime_mtime = runtime_object.stat().st_mtime_ns
    except OSError:
        return True
    runtime_source_root = compiler_root / "elisacore_std"
    if not runtime_source_root.is_dir():
        return False
    try:
        for source in runtime_source_root.rglob("*"):
            if source.is_file() and source.suffix in {".elisa", ".elisai"}:
                if source.stat().st_mtime_ns > runtime_mtime:
                    return True
    except OSError:
        # Let the actual builder report an actionable error if a source disappears
        # during the dependency scan.
        return True
    return False


def defined_symbols(nm: str, object_path: Path) -> set[str]:
    result = run_command([nm, "-g", str(object_path)])
    if result.returncode != 0:
        raise ProfilerError(f"nm failed for {object_path}: {result.stderr.strip()}")
    symbols: set[str] = set()
    for line in result.stdout.splitlines():
        fields = line.split()
        if fields:
            symbols.add(fields[-1])
    return symbols


def prepare_target(
    objcopy: str,
    nm: str,
    target_object: Path,
    runtime_object: Path,
    renamed_target: Path,
    collector_runtime: Path,
) -> None:
    target_symbols = defined_symbols(nm, target_object)
    main_symbol = "_main" if "_main" in target_symbols else "main"
    if main_symbol not in target_symbols:
        raise ProfilerError(f"compiled Elisa object does not export main: {target_object}")
    target_name = "_elisa_profile_target_main" if main_symbol.startswith("_") else "elisa_profile_target_main"
    result = run_command(
        [
            objcopy,
            "--redefine-sym",
            f"{main_symbol}={target_name}",
            str(target_object),
            str(renamed_target),
        ]
    )
    if result.returncode != 0:
        raise ProfilerError(f"could not rename Elisa main: {result.stderr.strip()}")

    shutil.copyfile(runtime_object, collector_runtime)
    runtime_symbols = defined_symbols(nm, collector_runtime)
    trace_symbols = [
        symbol
        for symbol in ("_elisa_trace_record", "elisa_trace_record")
        if symbol in runtime_symbols
    ]
    trace_value_symbols = [
        symbol
        for symbol in ("_elisa_trace_record_value", "elisa_trace_record_value")
        if symbol in runtime_symbols
    ]
    trace_entry_symbols = [
        symbol
        for symbol in ("_elisa_trace_function_entry", "elisa_trace_function_entry")
        if symbol in runtime_symbols
    ]
    trace_exit_symbols = [
        symbol
        for symbol in ("_elisa_trace_function_exit", "elisa_trace_function_exit")
        if symbol in runtime_symbols
    ]
    trace_install_symbols = [
        symbol
        for symbol in ("_elisa_trace_install_fault_handler", "elisa_trace_install_fault_handler")
        if symbol in runtime_symbols
    ]
    localize = (
        trace_symbols
        + trace_value_symbols
        + trace_entry_symbols
        + trace_exit_symbols
        + trace_install_symbols
    )
    if not localize:
        raise ProfilerError(f"runtime object has no trace callbacks: {runtime_object}")
    command = [objcopy]
    for symbol in localize:
        command.extend(["--localize-symbol", symbol])
    command.extend([str(collector_runtime)])
    result = run_command(command)
    if result.returncode != 0:
        raise ProfilerError(f"could not localize runtime trace callbacks: {result.stderr.strip()}")


def parse_protocol_int(value: str, line: str) -> int:
    try:
        return int(value)
    except ValueError as error:
        raise ProfilerError(f"malformed profiler runtime record: {line}") from error


def parse_profile(
    stderr: str, *, allow_missing: bool = False
) -> tuple[
    dict[str, int],
    list[dict[str, Any]],
    list[dict[str, Any]],
    list[dict[str, Any]],
    str,
    list[dict[str, Any]],
    dict[str, Any] | None,
]:
    meta: dict[str, int] | None = None
    locations: list[dict[str, Any]] = []
    call_edges: list[dict[str, Any]] = []
    stacks: list[dict[str, Any]] = []
    recent_events: list[dict[str, Any]] = []
    active_stack: dict[str, Any] | None = None
    program_stderr: list[str] = []
    for line in stderr.splitlines():
        if not line.startswith("ELISA_PROFILE\t"):
            program_stderr.append(line)
            continue
        fields = line.split("\t")
        if len(fields) < 2 or fields[1] != "1":
            raise ProfilerError(f"unsupported profiler runtime protocol version: {line}")
        if len(fields) in (6, 8, 9) and fields[2] == "meta":
            meta = {
                "events": parse_protocol_int(fields[3], line),
                "locations": parse_protocol_int(fields[4], line),
                "dropped": parse_protocol_int(fields[5], line),
            }
            if len(fields) == 8:
                meta["max_stack_depth"] = parse_protocol_int(fields[6], line)
                meta["stack_overflow_entries"] = parse_protocol_int(fields[7], line)
                meta["thread_count"] = 1 if meta["events"] else 0
            elif len(fields) == 9:
                meta["max_stack_depth"] = parse_protocol_int(fields[6], line)
                meta["stack_overflow_entries"] = parse_protocol_int(fields[7], line)
                meta["thread_count"] = parse_protocol_int(fields[8], line)
            continue
        if len(fields) == 10 and fields[2] == "path":
            kind = parse_protocol_int(fields[4], line)
            if kind not in (1, 2, 3):
                raise ProfilerError(f"unknown profiler path kind: {line}")
            if fields[8] not in ("0", "1"):
                raise ProfilerError(f"invalid profiler path signedness flag: {line}")
            recent_events.append(
                {
                    "sequence": parse_protocol_int(fields[3], line),
                    "kind": {1: "statement", 2: "value", 3: "function"}[kind],
                    "function": fields[5],
                    "line": parse_protocol_int(fields[6], line),
                    "variable": None if fields[7] == "-" else fields[7],
                    "signed": fields[8] == "1",
                    "value": parse_protocol_int(fields[9], line),
                }
            )
            continue
        if len(fields) == 6 and fields[2] == "active":
            active_stack = {
                "tracked_depth": parse_protocol_int(fields[3], line),
                "overflow_depth": parse_protocol_int(fields[4], line),
                "stack": [] if fields[5] == "-" else fields[5].split(";"),
            }
            continue
        if len(fields) == 8 and fields[2] == "call":
            call_edges.append(
                {
                    "caller": fields[3],
                    "callee": fields[4],
                    "call_events": parse_protocol_int(fields[5], line),
                    "completed_calls": parse_protocol_int(fields[6], line),
                    "inclusive_ns": parse_protocol_int(fields[7], line),
                }
            )
            continue
        if len(fields) == 7 and fields[2] == "stack":
            stacks.append(
                {
                    "stack": fields[3],
                    "call_events": parse_protocol_int(fields[4], line),
                    "completed_calls": parse_protocol_int(fields[5], line),
                    "self_ns": parse_protocol_int(fields[6], line),
                }
            )
            continue
        if len(fields) != 15 or fields[2] != "location":
            raise ProfilerError(f"malformed profiler runtime record: {line}")
        kind = parse_protocol_int(fields[3], line)
        if kind not in (1, 2, 3):
            raise ProfilerError(f"unknown profiler location kind: {line}")
        if fields[8] not in ("0", "1"):
            raise ProfilerError(f"invalid profiler signedness flag: {line}")
        location: dict[str, Any] = {
            "kind": {1: "statement", 2: "value", 3: "function"}[kind],
            "function": fields[4],
            "line": parse_protocol_int(fields[5], line),
            "count": parse_protocol_int(fields[6], line),
        }
        location["interval_ns"] = parse_protocol_int(fields[13], line)
        location["max_interval_ns"] = parse_protocol_int(fields[14], line)
        if kind == 2:
            location["variable"] = None if fields[7] == "-" else fields[7]
            location["signed"] = fields[8] == "1"
            location["minimum"] = parse_protocol_int(fields[9], line)
            location["maximum"] = parse_protocol_int(fields[10], line)
            location["sum"] = None if fields[11] == "overflow" else parse_protocol_int(fields[11], line)
            location["last"] = parse_protocol_int(fields[12], line)
        elif kind == 3:
            # Function locations reuse the fixed-width collector record: fields 9–11
            # carry inclusive duration, self duration, and completed return count.
            location["inclusive_ns"] = parse_protocol_int(fields[9], line)
            location["self_ns"] = parse_protocol_int(fields[10], line)
            location["completed_calls"] = parse_protocol_int(fields[11], line)
        locations.append(location)
    if meta is None:
        if allow_missing:
            return (
                {
                    "events": 0,
                    "locations": 0,
                    "dropped": 0,
                    "max_stack_depth": 0,
                    "stack_overflow_entries": 0,
                    "thread_count": 0,
                },
                [],
                [],
                [],
                stderr,
                recent_events,
                active_stack,
            )
        raise ProfilerError("profile runtime produced no ELISA_PROFILE metadata")
    return (
        meta,
        locations,
        call_edges,
        stacks,
        "\n".join(program_stderr) + ("\n" if program_stderr else ""),
        recent_events,
        active_stack,
    )


def merge_profiles(
    results: list[
        tuple[
            dict[str, int],
            list[dict[str, Any]],
            list[dict[str, Any]],
            list[dict[str, Any]],
            str,
            list[dict[str, Any]],
            dict[str, Any] | None,
        ]
    ],
) -> tuple[
    dict[str, int],
    list[dict[str, Any]],
    list[dict[str, Any]],
    list[dict[str, Any]],
    str,
    list[dict[str, Any]],
    dict[str, Any] | None,
]:
    merged: dict[tuple[str, str, int, str | None, bool], dict[str, Any]] = {}
    merged_call_edges: dict[tuple[str, str], dict[str, Any]] = {}
    merged_stacks: dict[str, dict[str, Any]] = {}
    events = 0
    dropped = 0
    max_stack_depth = 0
    stack_overflow_entries = 0
    thread_count = 0
    recent_events: list[dict[str, Any]] = []
    active_stack: dict[str, Any] | None = None
    program_stderr: list[str] = []
    for repetition, (meta, locations, call_edges, stacks, stderr, path, current_stack) in enumerate(results, start=1):
        events += meta["events"]
        dropped += meta["dropped"]
        max_stack_depth = max(max_stack_depth, meta.get("max_stack_depth", 0))
        stack_overflow_entries += meta.get("stack_overflow_entries", 0)
        thread_count = max(thread_count, meta.get("thread_count", 0))
        if stderr:
            program_stderr.append(f"run {repetition}:\n{stderr.rstrip()}")
        if path:
            recent_events = path
        if current_stack is not None:
            active_stack = current_stack
        for location in locations:
            key = (
                location["kind"],
                location["function"],
                location["line"],
                location.get("variable"),
                location.get("signed", False),
            )
            if key not in merged:
                merged[key] = dict(location)
                continue
            combined = merged[key]
            combined["count"] += location["count"]
            combined["interval_ns"] += location["interval_ns"]
            combined["max_interval_ns"] = max(
                combined["max_interval_ns"], location["max_interval_ns"]
            )
            if location["kind"] == "value":
                combined["minimum"] = min(combined["minimum"], location["minimum"])
                combined["maximum"] = max(combined["maximum"], location["maximum"])
                combined["last"] = location["last"]
                if combined["sum"] is None or location["sum"] is None:
                    combined["sum"] = None
                else:
                    combined["sum"] += location["sum"]
            elif location["kind"] == "function":
                combined["inclusive_ns"] += location["inclusive_ns"]
                combined["self_ns"] += location["self_ns"]
                combined["completed_calls"] += location["completed_calls"]
        for call_edge in call_edges:
            key = (call_edge["caller"], call_edge["callee"])
            if key not in merged_call_edges:
                merged_call_edges[key] = dict(call_edge)
                continue
            combined_edge = merged_call_edges[key]
            combined_edge["call_events"] += call_edge["call_events"]
            combined_edge["completed_calls"] += call_edge["completed_calls"]
            combined_edge["inclusive_ns"] += call_edge["inclusive_ns"]
        for stack in stacks:
            key = stack["stack"]
            if key not in merged_stacks:
                merged_stacks[key] = dict(stack)
                continue
            combined_stack = merged_stacks[key]
            combined_stack["call_events"] += stack["call_events"]
            combined_stack["completed_calls"] += stack["completed_calls"]
            combined_stack["self_ns"] += stack["self_ns"]
    locations = sorted(
        merged.values(),
        key=lambda location: (
            -location["count"],
            location["line"],
            location["function"],
            location["kind"],
            location.get("variable") or "",
            location.get("signed", False),
        ),
    )
    call_edges = sorted(
        merged_call_edges.values(),
        key=lambda call_edge: (
            -call_edge["call_events"],
            call_edge["caller"],
            call_edge["callee"],
        ),
    )
    stacks = sorted(
        merged_stacks.values(),
        key=lambda stack: (
            -stack["self_ns"],
            -stack["call_events"],
            stack["stack"],
        ),
    )
    return (
        {
            "events": events,
            "locations": len(locations),
            "dropped": dropped,
            "max_stack_depth": max_stack_depth,
            "stack_overflow_entries": stack_overflow_entries,
            "thread_count": thread_count,
        },
        locations,
        call_edges,
        stacks,
        "\n\n".join(program_stderr) + ("\n" if program_stderr else ""),
        recent_events,
        active_stack,
    )


def source_line_map(source: Path) -> list[tuple[Path, int, str]]:
    seen: set[Path] = set()

    def flatten(path: Path, stack: list[Path]) -> list[tuple[Path, int, str]]:
        path = path.resolve()
        if path in stack:
            raise ProfilerError(f"cyclic include while mapping profile locations: {path}")
        if path in seen:
            return []
        seen.add(path)
        try:
            contents = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as error:
            raise ProfilerError(f"could not read source for profile mapping: {path}: {error}") from error
        mapped: list[tuple[Path, int, str]] = []
        for line_number, line in enumerate(contents.splitlines(keepends=True), start=1):
            match = INCLUDE_RE.match(line.rstrip("\n"))
            if match:
                include_path = Path(match.group(1))
                if not include_path.is_absolute():
                    include_path = path.parent / include_path
                mapped.extend(flatten(include_path, [*stack, path]))
            else:
                mapped.append((path, line_number, line.rstrip("\r\n")))
        return mapped

    return flatten(source, [])


def add_source_context(source: Path, locations: list[dict[str, Any]]) -> dict[str, Any]:
    mapping_error: str | None = None
    try:
        mapped_lines = source_line_map(source)
    except ProfilerError as error:
        mapped_lines = []
        mapping_error = str(error)
    mapped_count = 0
    for location in locations:
        compiler_line = location["line"]
        location["compiler_line"] = compiler_line
        if 0 < compiler_line <= len(mapped_lines):
            mapped_path, mapped_line, source_text = mapped_lines[compiler_line - 1]
            location["line"] = mapped_line
            location["source"] = str(mapped_path)
            location["source_text"] = source_text.rstrip()
            mapped_count += 1
        else:
            location["source"] = str(source)
            location["source_text"] = None
    mapping = {
        "mode": "include-aware" if mapping_error is None else "fallback",
        "mapped_locations": mapped_count,
        "unmapped_locations": len(locations) - mapped_count,
    }
    if mapping_error is not None:
        mapping["error"] = mapping_error
    return mapping


def function_definition_label(function: dict[str, Any]) -> str:
    return ", ".join(
        f"{Path(definition['source']).name}:{definition['line']}"
        for definition in function.get("definitions", [])
    )


def repetition_status(repetition: dict[str, Any]) -> str:
    if repetition["timed_out"]:
        return "timeout"
    if repetition["signal"] is not None:
        return f"signal {repetition['signal']}"
    return f"exit {repetition['exit_code']}"


def text_report(report: dict[str, Any], top: int) -> str:
    summary = report["summary"]
    run = report["run"]
    lines = [
        f"Elisa profile: {report['source']}",
        (
            f"exit={run['exit_code'] if run['exit_code'] is not None else 'signal ' + str(run['signal'])} "
            f"opt={run['opt_level']} "
            f"warmups={run['warmup_repetitions']} "
            f"runs={run['completed_repetitions']}/{run['requested_repetitions']} "
            f"successful={run['successful_repetitions']} "
            f"basis={run['measurement_basis']} "
            f"execution={run['execution_ms']:.3f} ms "
            f"mean={run['execution_ms_mean']:.3f} ms "
            f"compile={run['compile_ms']:.3f} ms "
            f"min={run['execution_ms_min']:.3f} ms "
            f"median={run['execution_ms_median']:.3f} ms "
            f"max={run['execution_ms_max']:.3f} ms "
            f"stdev={run['execution_ms_stdev']:.3f} ms "
            f"events={summary['events']} "
            f"(statement={summary['statement_events']}, value={summary['value_events']}, "
            f"function={summary['function_events']}) "
            f"locations={summary['locations']} dropped={summary['dropped']} "
            f"threads={summary['thread_count']} "
            f"stack-depth={summary['max_stack_depth']} "
            f"stack-overflow={summary['stack_overflow_entries']}"
        ),
        "",
    ]
    if run["timeout_s"] is not None:
        lines[1] += f" timeout={run['timeout_s']}s"
    if run["cpu_ms"] is not None:
        lines[1] += (
            f" cpu={run['cpu_ms']:.3f} ms"
            f" (user={run['cpu_user_ms']:.3f}, sys={run['cpu_system_ms']:.3f})"
        )
    if run["peak_rss_bytes"] is not None:
        lines[1] += f" peak-rss={run['peak_rss_bytes'] / (1024 * 1024):.2f} MiB"
    lines.extend(["", "Measured repetitions:"])
    for repetition in run["repetitions"]:
        detail = (
            f"  run {repetition['repetition']}: {repetition_status(repetition)}, "
            f"wall={repetition['execution_ms']:.3f} ms"
        )
        if repetition["cpu_ms"] is not None:
            detail += f", cpu={repetition['cpu_ms']:.3f} ms"
        if repetition["peak_rss_bytes"] is not None:
            detail += (
                f", peak-rss={repetition['peak_rss_bytes'] / (1024 * 1024):.2f} MiB"
            )
        detail += (
            f", trace={repetition['trace_events']} events"
            f", threads={repetition['trace_threads']}"
            f", dropped={repetition['trace_dropped']}"
        )
        lines.append(detail)
    display_locations = report["locations"]
    if run["location_timing"]:
        display_locations = sorted(
            display_locations,
            key=lambda location: (
                -location["interval_ns"],
                -location["max_interval_ns"],
                -location["count"],
                location["line"],
                location["function"],
            ),
        )
    if display_locations:
        lines.append(f"Hot locations (top {min(top, len(display_locations))}):")
        for location in display_locations[:top]:
            label = f"{location['function']}:{location['line']} {location['kind']}"
            if location["kind"] == "value":
                label += f" {location.get('variable') or '<value>'}"
            source_text = location.get("source_text")
            if source_text:
                label += f"  {source_text.strip()}"
            detail = f"{location['count']} event(s)"
            if location["kind"] == "value":
                detail += (
                    f", min={location['minimum']}, max={location['maximum']}, "
                    f"last={location['last']}"
                )
            if report["run"]["location_timing"]:
                detail += (
                    f", attributed={location['interval_ns'] / 1_000_000:.3f} ms"
                    f", max-gap={location['max_interval_ns'] / 1_000_000:.3f} ms"
                )
            lines.append(f"  {detail:>34}  {label}")
    else:
        lines.append("Hot locations: none recorded")

    lines.extend(["", "Function totals:"])
    display_functions = report["functions"]
    if run["location_timing"]:
        display_functions = sorted(
            display_functions,
            key=lambda function: (
                -function["inclusive_ns"],
                -function["self_ns"],
                -function["events"],
                function["function"],
            ),
        )
    for function in display_functions:
        definition_label = function_definition_label(function)
        lines.append(
            f"  {function['events']:>12}  {function['function']}"
            f" (calls={function['call_events']}, completed={function['completed_calls']})"
        )
        if definition_label:
            lines[-1] += f" [defined at {definition_label}]"
        if run["location_timing"]:
            lines[-1] += (
                f", inclusive={function['inclusive_ns'] / 1_000_000:.3f} ms"
                f" ({function['inclusive_percent']:.1f}%)"
                f", self={function['self_ns'] / 1_000_000:.3f} ms"
                f" ({function['self_percent']:.1f}%)"
                f", mean={function['mean_inclusive_ns'] / 1_000_000:.3f} ms"
                f", attributed={function['interval_ns'] / 1_000_000:.3f} ms"
                f", max-gap={function['max_interval_ns'] / 1_000_000:.3f} ms"
            )
    if report["call_edges"]:
        shown_edges = report["call_edges"][:top]
        lines.extend(["", f"Call graph (top {len(shown_edges)}):"])
        for call_edge in shown_edges:
            detail = (
                f"calls={call_edge['call_events']}, "
                f"completed={call_edge['completed_calls']}"
            )
            if run["location_timing"]:
                detail += f", inclusive={call_edge['inclusive_ns'] / 1_000_000:.3f} ms"
            lines.append(
                f"  {call_edge['caller']} -> {call_edge['callee']} ({detail})"
            )
    recent_events = report.get("recent_events", [])
    if recent_events:
        shown_events = recent_events[-top:]
        lines.extend(
            [
                "",
                (
                    "Recent execution path "
                    f"(oldest to newest; last {len(shown_events)} event(s)):"
                ),
            ]
        )
        for event in shown_events:
            label = f"{event['function']}:{event['line']} {event['kind']}"
            if event["kind"] == "value":
                label += f" {event.get('variable') or '<value>'}={event['value']}"
            source_text = event.get("source_text")
            if source_text:
                label += f"  {source_text.strip()}"
            lines.append(f"  {label}")
    active_stack = report.get("active_stack")
    if active_stack is not None:
        stack_label = ";".join(active_stack["stack"]) or "<empty>"
        lines.extend(
            [
                "",
                "Active call stack at termination:",
                (
                    f"  tracked={active_stack['tracked_depth']} "
                    f"overflow={active_stack['overflow_depth']}  {stack_label}"
                ),
            ]
        )
    if report.get("program_stderr"):
        lines.extend(["", "Program stderr:", report["program_stderr"].rstrip()])
    return "\n".join(lines) + "\n"


def html_table(title: str, headers: list[str], rows: list[list[object]]) -> str:
    if not rows:
        return (
            f"<section><h2>{escape(title)}</h2>"
            '<p class="muted">No data recorded.</p></section>'
        )
    header_html = "".join(f"<th>{escape(header)}</th>" for header in headers)
    row_html = []
    for row in rows:
        cells = "".join(f"<td>{escape(str(cell))}</td>" for cell in row)
        row_html.append(f"<tr>{cells}</tr>")
    return (
        f"<section><h2>{escape(title)}</h2>"
        '<div class="table-wrap"><table data-sortable><thead><tr>'
        f"{header_html}</tr></thead><tbody>{''.join(row_html)}</tbody></table></div></section>"
    )


def html_report(report: dict[str, Any], top: int) -> str:
    summary = report["summary"]
    run = report["run"]
    status = (
        str(run["exit_code"])
        if run["exit_code"] is not None
        else f"signal {run['signal']}"
    )
    if any(repetition["timed_out"] for repetition in run["repetitions"]):
        status = "timed out"
    cpu = (
        "unavailable"
        if run["cpu_ms"] is None
        else f"{run['cpu_ms']:.3f} ms"
    )
    peak_rss = (
        "unavailable"
        if run["peak_rss_bytes"] is None
        else f"{run['peak_rss_bytes'] / (1024 * 1024):.2f} MiB"
    )
    compile_time = f"{run['compile_ms']:.3f} ms"
    display_locations = list(report["locations"])
    if run["location_timing"]:
        display_locations.sort(
            key=lambda location: (
                -location["interval_ns"],
                -location["max_interval_ns"],
                -location["count"],
                location["line"],
                location["function"],
            )
        )
    display_functions = list(report["functions"])
    if run["location_timing"]:
        display_functions.sort(
            key=lambda function: (
                -function["inclusive_ns"],
                -function["self_ns"],
                -function["events"],
                function["function"],
            )
        )
    location_rows = []
    for location in display_locations[:top]:
        variable = location.get("variable") or ""
        timing = (
            f"{location['interval_ns'] / 1_000_000:.3f} ms"
            if run["location_timing"]
            else ""
        )
        location_rows.append(
            [
                location["function"],
                location["line"],
                location["kind"],
                variable,
                location["count"],
                timing,
                location.get("source_text") or location.get("source", ""),
            ]
        )
    function_rows = []
    for function in display_functions:
        timing = (
            f"{function['inclusive_ns'] / 1_000_000:.3f} ms"
            if run["location_timing"]
            else ""
        )
        self_timing = (
            f"{function['self_ns'] / 1_000_000:.3f} ms"
            if run["location_timing"]
            else ""
        )
        function_rows.append(
            [
                function["function"],
                function["events"],
                function["call_events"],
                function["completed_calls"],
                function_definition_label(function),
                timing,
                self_timing,
                (
                    f"{function['inclusive_percent']:.1f}%"
                    if run["location_timing"]
                    else ""
                ),
            ]
        )
    edge_rows = [
        [
            edge["caller"],
            edge["callee"],
            edge["call_events"],
            edge["completed_calls"],
            (
                f"{edge['inclusive_ns'] / 1_000_000:.3f} ms"
                if run["location_timing"]
                else ""
            ),
        ]
        for edge in report["call_edges"][:top]
    ]
    stack_rows = [
        [
            stack["stack"],
            stack["call_events"],
            stack["completed_calls"],
            (
                f"{stack['self_ns'] / 1_000_000:.3f} ms"
                if run["location_timing"]
                else ""
            ),
        ]
        for stack in report["stacks"][:top]
    ]
    recent_rows = [
        [
            event["sequence"],
            event["function"],
            event["line"],
            event["kind"],
            event.get("variable") or "",
            event["value"],
            event.get("source_text") or "",
        ]
        for event in report.get("recent_events", [])[-top:]
    ]
    repetition_rows = []
    for repetition in run["repetitions"]:
        repetition_rows.append(
            [
                f"run {repetition['repetition']}",
                repetition_status(repetition),
                f"{repetition['execution_ms']:.3f} ms",
                (
                    f"{repetition['cpu_ms']:.3f} ms"
                    if repetition["cpu_ms"] is not None
                    else "unavailable"
                ),
                (
                    f"{repetition['peak_rss_bytes'] / (1024 * 1024):.2f} MiB"
                    if repetition["peak_rss_bytes"] is not None
                    else "unavailable"
                ),
                repetition["trace_events"],
                repetition["trace_threads"],
                repetition["trace_dropped"],
            ]
        )
    sections = [
        html_table(
            "Measured repetitions",
            ["Run", "Status", "Wall time", "CPU", "Peak RSS", "Trace events", "Threads", "Dropped"],
            repetition_rows,
        ),
        html_table(
            f"Hot locations (top {min(top, len(display_locations))})",
            ["Function", "Line", "Kind", "Variable", "Events", "Attributed", "Source"],
            location_rows,
        ),
        html_table(
            "Function totals",
            [
                "Function",
                "Events",
                "Calls",
                "Completed",
                "Definition",
                "Inclusive",
                "Self",
                "Root %",
            ],
            function_rows,
        ),
        html_table(
            f"Call graph (top {min(top, len(report['call_edges']))})",
            ["Caller", "Callee", "Calls", "Completed", "Inclusive"],
            edge_rows,
        ),
        html_table(
            f"Folded stacks (top {min(top, len(report['stacks']))})",
            ["Stack", "Calls", "Completed", "Self"],
            stack_rows,
        ),
    ]
    if recent_rows:
        sections.append(
            html_table(
                f"Recent execution path (last {len(recent_rows)} events)",
                ["Sequence", "Function", "Line", "Kind", "Variable", "Value", "Source"],
                recent_rows,
            )
        )
    active_stack = report.get("active_stack")
    if active_stack is not None:
        stack_label = ";".join(active_stack["stack"]) or "<empty>"
        sections.append(
            "<section><h2>Active call stack at termination</h2>"
            f"<p>Tracked depth: {active_stack['tracked_depth']} · "
            f"overflow depth: {active_stack['overflow_depth']}</p>"
            f"<pre>{escape(stack_label)}</pre></section>"
        )
    stderr = report.get("program_stderr")
    if stderr:
        sections.append(
            f"<section><h2>Program stderr</h2><pre>{escape(stderr.rstrip())}</pre></section>"
        )
    compiler = report["compiler"]
    return "\n".join(
        [
            "<!doctype html>",
            '<html lang="en"><head><meta charset="utf-8">',
            '<meta name="viewport" content="width=device-width, initial-scale=1">',
            f"<title>Elisa profile — {escape(report['source'])}</title>",
            """<style>
:root { color-scheme: light dark; font: 15px/1.45 -apple-system, BlinkMacSystemFont, sans-serif; }
body { margin: 0; background: #f5f7fa; color: #182230; }
main { max-width: 1500px; margin: 0 auto; padding: 28px; }
h1 { margin: 0 0 4px; font-size: 26px; }
h2 { margin: 28px 0 10px; font-size: 18px; }
.subtitle, .muted { color: #667085; }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin: 22px 0; }
.card { background: white; border: 1px solid #d8dee8; border-radius: 10px; padding: 14px; }
.card-label { color: #667085; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
.card-value { font-size: 20px; font-weight: 650; margin-top: 4px; }
.table-wrap { overflow-x: auto; background: white; border: 1px solid #d8dee8; border-radius: 10px; }
table { border-collapse: collapse; min-width: 720px; width: 100%; }
th, td { border-bottom: 1px solid #e9edf3; padding: 9px 11px; text-align: left; vertical-align: top; }
th { background: #eef2f7; cursor: pointer; position: sticky; top: 0; }
tbody tr:last-child td { border-bottom: 0; }
td:nth-child(2), td:nth-child(3), td:nth-child(5), td:nth-child(6) { white-space: nowrap; }
pre { background: #111827; color: #e5e7eb; border-radius: 10px; padding: 14px; overflow: auto; }
footer { border-top: 1px solid #d8dee8; margin-top: 30px; padding-top: 14px; color: #667085; font-size: 12px; }
@media (prefers-color-scheme: dark) {
  body { background: #111827; color: #e5e7eb; }
  .card, .table-wrap { background: #1f2937; border-color: #374151; }
  th { background: #374151; }
  th, td { border-color: #374151; }
  .subtitle, .muted, .card-label, footer { color: #9ca3af; }
}
</style>""",
            """<script>
document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll("table[data-sortable]").forEach(table => {
    const body = table.tBodies[0];
    table.querySelectorAll("th").forEach((header, index) => {
      header.addEventListener("click", () => {
        const direction = header.dataset.direction === "ascending" ? -1 : 1;
        header.dataset.direction = direction === 1 ? "ascending" : "descending";
        [...body.rows].sort((left, right) => {
          const a = left.cells[index].textContent.trim();
          const b = right.cells[index].textContent.trim();
          const an = Number(a.replace(/[^0-9.+-]/g, ""));
          const bn = Number(b.replace(/[^0-9.+-]/g, ""));
          if (Number.isFinite(an) && Number.isFinite(bn) && a !== "" && b !== "") {
            return (an - bn) * direction;
          }
          return a.localeCompare(b) * direction;
        }).forEach(row => body.appendChild(row));
      });
    });
  });
});
</script>""",
            "</head><body><main>",
            f"<h1>Elisa profile</h1><p class=\"subtitle\">{escape(report['source'])}</p>",
            '<div class="cards">',
            f'<div class="card"><div class="card-label">Status</div><div class="card-value">{escape(status)}</div></div>',
            f'<div class="card"><div class="card-label">Optimization</div><div class="card-value">{escape(run["opt_level"])}</div></div>',
            f'<div class="card"><div class="card-label">Events</div><div class="card-value">{summary["events"]}</div></div>',
            f'<div class="card"><div class="card-label">Execution</div><div class="card-value">{run["execution_ms_mean"]:.3f} ms</div></div>',
            f'<div class="card"><div class="card-label">Compile</div><div class="card-value">{escape(compile_time)}</div></div>',
            f'<div class="card"><div class="card-label">Successful runs</div><div class="card-value">{run["successful_repetitions"]}/{run["completed_repetitions"]}</div></div>',
            f'<div class="card"><div class="card-label">Aggregate basis</div><div class="card-value">{escape(run["measurement_basis"])}</div></div>',
            f'<div class="card"><div class="card-label">CPU</div><div class="card-value">{escape(cpu)}</div></div>',
            f'<div class="card"><div class="card-label">Peak RSS</div><div class="card-value">{escape(peak_rss)}</div></div>',
            f'<div class="card"><div class="card-label">Locations</div><div class="card-value">{summary["locations"]}</div></div>',
            f'<div class="card"><div class="card-label">Threads</div><div class="card-value">{summary["thread_count"]}</div></div>',
            f'<div class="card"><div class="card-label">Max stack depth</div><div class="card-value">{summary["max_stack_depth"]}</div></div>',
            f'<div class="card"><div class="card-label">Stack overflows</div><div class="card-value">{summary["stack_overflow_entries"]}</div></div>',
            "</div>",
            *sections,
            f"<footer>Schema {report['schema_version']} · compiler {escape(compiler['commit'])} · optimization {escape(run['opt_level'])} · timing {'enabled' if run['location_timing'] else 'disabled'}</footer>",
            "</main></body></html>",
        ]
    ) + "\n"


def folded_report(report: dict[str, Any]) -> str:
    """Render stack aggregates in the collapsed-stack format used by flamegraphs."""
    lines: list[str] = []
    for stack in report["stacks"]:
        weight = stack["self_ns"] if report["run"]["location_timing"] else stack["call_events"]
        if weight > 0:
            lines.append(f"{stack['stack']} {weight}")
    return "\n".join(lines) + ("\n" if lines else "")


def speedscope_report(report: dict[str, Any]) -> str:
    """Render aggregate stacks as a Speedscope sampled profile."""
    frame_indexes: dict[str, int] = {}
    frames: list[dict[str, str]] = []
    samples: list[list[int]] = []
    weights: list[int] = []
    timing = report["run"]["location_timing"]
    for stack in report["stacks"]:
        weight = stack["self_ns"] if timing else stack["call_events"]
        if weight <= 0:
            continue
        stack_frames: list[int] = []
        for function in stack["stack"].split(";"):
            if function not in frame_indexes:
                frame_indexes[function] = len(frames)
                frames.append({"name": function})
            stack_frames.append(frame_indexes[function])
        if stack_frames:
            samples.append(stack_frames)
            weights.append(weight)
    profile = {
        "type": "sampled",
        "name": str(report["source"]),
        "unit": "nanoseconds" if timing else "none",
        "startValue": 0,
        "endValue": sum(weights),
        "samples": samples,
        "weights": weights,
    }
    return json.dumps(
        {
            "$schema": "https://www.speedscope.app/file-format-schema.json",
            "name": str(report["source"]),
            "activeProfileIndex": 0,
            "exporter": "elisa-profiler",
            "shared": {"frames": frames},
            "profiles": [profile],
        },
        indent=2,
    ) + "\n"


def load_profile_report(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(
            path.read_text(encoding="utf-8"),
            parse_constant=reject_json_constant,
        )
    except (OSError, UnicodeError, ValueError) as error:
        raise ProfilerError(f"could not read profile report {path}: {error}") from error
    if not isinstance(value, dict):
        raise ProfilerError(f"profile report is not an object: {path}")
    if value.get("schema_version") != 1:
        raise ProfilerError(f"unsupported profile schema in {path}: {value.get('schema_version')!r}")
    required_sections = (
        "source",
        "compiler",
        "summary",
        "source_mapping",
        "run",
        "functions",
        "call_edges",
        "stacks",
        "locations",
    )
    missing = [section for section in required_sections if section not in value]
    if missing:
        raise ProfilerError(
            f"profile report is missing required sections in {path}: {', '.join(missing)}"
        )
    if not isinstance(value.get("run"), dict):
        raise ProfilerError(f"profile report has no run object: {path}")
    if not isinstance(value.get("summary"), dict):
        raise ProfilerError(f"profile report has no summary object: {path}")
    if not isinstance(value.get("compiler"), dict):
        raise ProfilerError(f"profile report has no compiler object: {path}")
    for section in ("functions", "call_edges", "stacks", "locations"):
        if not isinstance(value.get(section), list):
            raise ProfilerError(f"profile report section {section!r} is not an array: {path}")
    validate_profile_report(value, path)
    return value


def reject_json_constant(value: str) -> Any:
    raise ValueError(f"non-finite JSON number {value}")


def invalid_profile_field(path: Path, field: str, expected: str) -> NoReturn:
    raise ProfilerError(f"invalid profile report {path}: {field} must be {expected}")


def validate_profile_integer(
    value: Any, path: Path, field: str, *, allow_null: bool = True
) -> None:
    if value is None and allow_null:
        return
    if not isinstance(value, int) or isinstance(value, bool):
        invalid_profile_field(path, field, "an integer or null" if allow_null else "an integer")


def validate_profile_number(value: Any, path: Path, field: str) -> None:
    if value is None:
        return
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        invalid_profile_field(path, field, "a finite number or null")
    if isinstance(value, float) and not math.isfinite(value):
        invalid_profile_field(path, field, "a finite number or null")


def validate_profile_string(value: Any, path: Path, field: str, *, allow_null: bool = True) -> None:
    if value is None and allow_null:
        return
    if not isinstance(value, str):
        invalid_profile_field(path, field, "a string or null" if allow_null else "a string")


def validate_profile_report(report: dict[str, Any], path: Path) -> None:
    if not isinstance(report.get("source"), str):
        invalid_profile_field(path, "source", "a string")

    for field in ("events",):
        if field in report["summary"]:
            validate_profile_integer(report["summary"][field], path, f"summary.{field}", allow_null=False)

    run = report["run"]
    for field in ("exit_code", "signal"):
        if field in run:
            validate_profile_integer(run[field], path, f"run.{field}")
    for field in ("completed_repetitions", "successful_repetitions", "failed_repetitions"):
        if field in run:
            validate_profile_integer(run[field], path, f"run.{field}", allow_null=False)
    for field in ("execution_ms_mean", "compile_ms", "cpu_ms", "peak_rss_bytes"):
        if field in run:
            validate_profile_number(run[field], path, f"run.{field}")
    if "opt_level" in run:
        validate_profile_string(run["opt_level"], path, "run.opt_level")
    if "measurement_basis" in run:
        validate_profile_string(run["measurement_basis"], path, "run.measurement_basis")
    if "location_timing" in run and not isinstance(run["location_timing"], bool):
        invalid_profile_field(path, "run.location_timing", "a boolean")
    repetitions = run.get("repetitions")
    if "repetitions" in run:
        if not isinstance(repetitions, list):
            invalid_profile_field(path, "run.repetitions", "an array")
        for index, repetition in enumerate(repetitions):
            field_prefix = f"run.repetitions[{index}]"
            if not isinstance(repetition, dict):
                invalid_profile_field(path, field_prefix, "an object")
            for field in ("exit_code", "signal"):
                if field in repetition:
                    validate_profile_integer(repetition[field], path, f"{field_prefix}.{field}")
            if "timed_out" in repetition and not isinstance(repetition["timed_out"], bool):
                invalid_profile_field(path, f"{field_prefix}.timed_out", "a boolean")

    for section in ("functions", "call_edges", "stacks", "locations"):
        for index, item in enumerate(report[section]):
            if not isinstance(item, dict):
                invalid_profile_field(path, f"{section}[{index}]", "an object")

    function_metric_names = (
        "events",
        "call_events",
        "completed_calls",
        "inclusive_ns",
        "self_ns",
        "interval_ns",
        "max_interval_ns",
    )
    for index, function in enumerate(report["functions"]):
        field_prefix = f"functions[{index}]"
        validate_profile_string(function.get("function"), path, f"{field_prefix}.function", allow_null=False)
        for field in function_metric_names:
            if field in function:
                validate_profile_number(function[field], path, f"{field_prefix}.{field}")

    call_edge_metric_names = ("call_events", "completed_calls", "inclusive_ns")
    for index, edge in enumerate(report["call_edges"]):
        field_prefix = f"call_edges[{index}]"
        validate_profile_string(edge.get("caller"), path, f"{field_prefix}.caller", allow_null=False)
        validate_profile_string(edge.get("callee"), path, f"{field_prefix}.callee", allow_null=False)
        for field in call_edge_metric_names:
            if field in edge:
                validate_profile_number(edge[field], path, f"{field_prefix}.{field}")

    location_metric_names = ("count", "interval_ns", "max_interval_ns")
    for index, location in enumerate(report["locations"]):
        field_prefix = f"locations[{index}]"
        validate_profile_string(location.get("source"), path, f"{field_prefix}.source")
        validate_profile_string(location.get("function"), path, f"{field_prefix}.function", allow_null=False)
        validate_profile_string(location.get("kind"), path, f"{field_prefix}.kind", allow_null=False)
        if location.get("kind") not in ("statement", "value", "function"):
            invalid_profile_field(path, f"{field_prefix}.kind", "a known location kind")
        for field in ("line", "compiler_line"):
            if field in location:
                validate_profile_integer(location[field], path, f"{field_prefix}.{field}", allow_null=False)
        if "variable" in location:
            validate_profile_string(location["variable"], path, f"{field_prefix}.variable")
        if "signed" in location and not isinstance(location["signed"], bool):
            invalid_profile_field(path, f"{field_prefix}.signed", "a boolean")
        for field in location_metric_names:
            if field in location:
                validate_profile_number(location[field], path, f"{field_prefix}.{field}")


def profile_numeric_value(report: dict[str, Any], section: str, name: str) -> int | float | None:
    values = report.get(section)
    if not isinstance(values, dict):
        return None
    value = values.get(name)
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        return value
    return None


def comparison_metric(
    baseline: int | float | None, candidate: int | float | None
) -> dict[str, int | float | None]:
    if baseline is None or candidate is None:
        return {"baseline": baseline, "candidate": candidate, "delta": None, "percent": None}
    delta = candidate - baseline
    percent = delta * 100.0 / abs(baseline) if baseline != 0 else (0.0 if candidate == 0 else None)
    return {
        "baseline": baseline,
        "candidate": candidate,
        "delta": delta,
        "percent": percent,
    }


def comparison_increased(metric: dict[str, int | float | None], threshold: float) -> bool:
    baseline = metric["baseline"]
    candidate = metric["candidate"]
    percent = metric["percent"]
    if baseline is None or candidate is None:
        return False
    if baseline == 0:
        return candidate > 0
    return percent is not None and percent > threshold


def profile_function_map(report: dict[str, Any]) -> dict[str, dict[str, Any]]:
    functions: dict[str, dict[str, Any]] = {}
    for function in report.get("functions", []):
        if isinstance(function, dict) and isinstance(function.get("function"), str):
            functions[function["function"]] = function
    return functions


def profile_call_edge_map(report: dict[str, Any]) -> dict[tuple[str, str], dict[str, Any]]:
    edges: dict[tuple[str, str], dict[str, Any]] = {}
    for edge in report.get("call_edges", []):
        if not isinstance(edge, dict):
            continue
        caller = edge.get("caller")
        callee = edge.get("callee")
        if isinstance(caller, str) and isinstance(callee, str):
            edges[(caller, callee)] = edge
    return edges


def profile_location_map(report: dict[str, Any]) -> dict[tuple[Any, ...], dict[str, Any]]:
    locations: dict[tuple[Any, ...], dict[str, Any]] = {}
    for location in report.get("locations", []):
        if not isinstance(location, dict):
            continue
        function = location.get("function")
        kind = location.get("kind")
        if not isinstance(function, str) or not isinstance(kind, str):
            continue
        key = (
            location.get("source"),
            location.get("line", location.get("compiler_line")),
            function,
            kind,
            location.get("variable"),
            location.get("signed", False),
        )
        locations[key] = location
    return locations


def profile_run_failed(report: dict[str, Any]) -> bool:
    run = report.get("run")
    if not isinstance(run, dict):
        return True
    if run.get("exit_code") != 0 or run.get("signal") is not None:
        return True
    repetitions = run.get("repetitions", [])
    return any(
        isinstance(repetition, dict)
        and (
            repetition.get("timed_out")
            or repetition.get("signal") is not None
            or (
                repetition.get("exit_code") is not None
                and repetition.get("exit_code") != 0
            )
        )
        for repetition in repetitions
    )


def comparison_identity(report: dict[str, Any], path: Path) -> dict[str, Any]:
    run = report["run"]
    return {
        "path": str(path.resolve()),
        "source": report.get("source"),
        "compiler": report.get("compiler", {}),
        "opt_level": run.get("opt_level"),
        "location_timing": run.get("location_timing"),
        "completed_repetitions": run.get("completed_repetitions"),
        "successful_repetitions": run.get("successful_repetitions"),
        "failed_repetitions": run.get("failed_repetitions"),
        "measurement_basis": run.get("measurement_basis"),
    }


def build_comparison_report(
    baseline_path: Path, candidate_path: Path, threshold_percent: float
) -> dict[str, Any]:
    baseline = load_profile_report(baseline_path)
    candidate = load_profile_report(candidate_path)
    if profile_run_failed(baseline):
        raise ProfilerError(f"baseline profile did not complete successfully: {baseline_path}")
    run_metric_names = {
        "execution_ms_mean": "run",
        "compile_ms": "run",
        "cpu_ms": "run",
        "peak_rss_bytes": "run",
        "events": "summary",
    }
    metrics = {
        name: comparison_metric(
            profile_numeric_value(baseline, section, name),
            profile_numeric_value(candidate, section, name),
        )
        for name, section in run_metric_names.items()
    }
    function_metric_names = (
        "events",
        "call_events",
        "completed_calls",
        "inclusive_ns",
        "self_ns",
        "interval_ns",
        "max_interval_ns",
    )
    baseline_functions = profile_function_map(baseline)
    candidate_functions = profile_function_map(candidate)
    function_changes: list[dict[str, Any]] = []
    for function_name in sorted(set(baseline_functions) | set(candidate_functions)):
        baseline_function = baseline_functions.get(function_name, {})
        candidate_function = candidate_functions.get(function_name, {})
        function_change: dict[str, Any] = {"function": function_name}
        for metric_name in function_metric_names:
            function_change[metric_name] = comparison_metric(
                baseline_function.get(metric_name), candidate_function.get(metric_name)
            )
        function_changes.append(function_change)
    function_changes.sort(
        key=lambda change: (
            -abs(change["inclusive_ns"]["delta"] or 0),
            -abs(change["events"]["delta"] or 0),
            change["function"],
        )
    )
    location_metric_names = ("count", "interval_ns", "max_interval_ns")
    baseline_locations = profile_location_map(baseline)
    candidate_locations = profile_location_map(candidate)
    location_changes: list[dict[str, Any]] = []
    for location_key in sorted(set(baseline_locations) | set(candidate_locations), key=str):
        baseline_location = baseline_locations.get(location_key, {})
        candidate_location = candidate_locations.get(location_key, {})
        source, line, function, kind, variable, signed = location_key
        location_change: dict[str, Any] = {
            "source": source,
            "line": line,
            "function": function,
            "kind": kind,
            "variable": variable,
            "signed": signed,
        }
        for metric_name in location_metric_names:
            location_change[metric_name] = comparison_metric(
                baseline_location.get(metric_name), candidate_location.get(metric_name)
            )
        location_changes.append(location_change)
    location_changes.sort(
        key=lambda change: (
            -abs(change["interval_ns"]["delta"] or 0),
            -abs(change["count"]["delta"] or 0),
            str(change["source"]),
            change["line"] if isinstance(change["line"], int) else -1,
            change["function"],
        )
    )

    call_edge_metric_names = ("call_events", "completed_calls", "inclusive_ns")
    baseline_call_edges = profile_call_edge_map(baseline)
    candidate_call_edges = profile_call_edge_map(candidate)
    call_edge_changes: list[dict[str, Any]] = []
    for edge_key in sorted(
        set(baseline_call_edges) | set(candidate_call_edges), key=str
    ):
        baseline_edge = baseline_call_edges.get(edge_key, {})
        candidate_edge = candidate_call_edges.get(edge_key, {})
        caller, callee = edge_key
        edge_change: dict[str, Any] = {"caller": caller, "callee": callee}
        for metric_name in call_edge_metric_names:
            edge_change[metric_name] = comparison_metric(
                baseline_edge.get(metric_name), candidate_edge.get(metric_name)
            )
        call_edge_changes.append(edge_change)
    call_edge_changes.sort(
        key=lambda change: (
            -abs(change["inclusive_ns"]["delta"] or 0),
            -abs(change["call_events"]["delta"] or 0),
            change["caller"],
            change["callee"],
        )
    )

    regressions: list[dict[str, Any]] = []
    for metric_name in ("execution_ms_mean", "compile_ms", "cpu_ms", "peak_rss_bytes"):
        metric = metrics[metric_name]
        percent = metric["percent"]
        if comparison_increased(metric, threshold_percent):
            message = (
                f"run {metric_name} became non-zero"
                if metric["baseline"] == 0
                else f"run {metric_name} increased by more than {threshold_percent:g}%"
            )
            regressions.append(
                {
                    "scope": "run",
                    "metric": metric_name,
                    "baseline": metric["baseline"],
                    "candidate": metric["candidate"],
                    "delta": metric["delta"],
                    "percent": percent,
                    "message": message,
                }
            )
    for function_change in function_changes:
        metric = function_change["inclusive_ns"]
        percent = metric["percent"]
        if comparison_increased(metric, threshold_percent):
            message = (
                f"function {function_change['function']} became non-zero"
                if metric["baseline"] == 0
                else (
                    f"function {function_change['function']} inclusive time increased "
                    f"by more than {threshold_percent:g}%"
                )
            )
            regressions.append(
                {
                    "scope": "function",
                    "function": function_change["function"],
                    "metric": "inclusive_ns",
                    "baseline": metric["baseline"],
                    "candidate": metric["candidate"],
                    "delta": metric["delta"],
                    "percent": percent,
                    "message": message,
                }
            )
    for location_change in location_changes:
        metric = location_change["interval_ns"]
        percent = metric["percent"]
        if comparison_increased(metric, threshold_percent):
            location_label = (
                f"{location_change['function']}:{location_change['line']}"
            )
            message = (
                f"location {location_label} became non-zero"
                if metric["baseline"] == 0
                else (
                    f"location {location_label} interval increased by more than "
                    f"{threshold_percent:g}%"
                )
            )
            regressions.append(
                {
                    "scope": "location",
                    "source": location_change["source"],
                    "line": location_change["line"],
                    "function": location_change["function"],
                    "metric": "interval_ns",
                    "baseline": metric["baseline"],
                    "candidate": metric["candidate"],
                    "delta": metric["delta"],
                    "percent": percent,
                    "message": message,
                }
            )

    for call_edge_change in call_edge_changes:
        metric = call_edge_change["inclusive_ns"]
        percent = metric["percent"]
        if comparison_increased(metric, threshold_percent):
            edge_label = f"{call_edge_change['caller']} -> {call_edge_change['callee']}"
            message = (
                f"call edge {edge_label} became non-zero"
                if metric["baseline"] == 0
                else (
                    f"call edge {edge_label} inclusive time increased by more than "
                    f"{threshold_percent:g}%"
                )
            )
            regressions.append(
                {
                    "scope": "call_edge",
                    "caller": call_edge_change["caller"],
                    "callee": call_edge_change["callee"],
                    "metric": "inclusive_ns",
                    "baseline": metric["baseline"],
                    "candidate": metric["candidate"],
                    "delta": metric["delta"],
                    "percent": percent,
                    "message": message,
                }
            )
    candidate_run = candidate["run"]
    candidate_failed = profile_run_failed(candidate)
    if candidate_failed:
        regressions.append(
            {
                "scope": "run",
                "metric": "status",
                "baseline": baseline["run"].get("exit_code"),
                "candidate": candidate_run.get("exit_code"),
                "delta": None,
                "percent": None,
                "message": "candidate profile did not complete successfully",
            }
        )
    warnings: list[str] = []
    if baseline.get("source") != candidate.get("source"):
        warnings.append("baseline and candidate use different source paths")
    if baseline["run"].get("location_timing") != candidate_run.get("location_timing"):
        warnings.append("baseline and candidate use different location-timing settings")
    baseline_successful = baseline["run"].get("successful_repetitions")
    candidate_successful = candidate_run.get("successful_repetitions")
    if (
        isinstance(baseline_successful, int)
        and isinstance(candidate_successful, int)
        and baseline_successful != candidate_successful
    ):
        warnings.append(
            "baseline and candidate use different successful repetition counts"
        )
    baseline_basis = baseline["run"].get("measurement_basis")
    candidate_basis = candidate_run.get("measurement_basis")
    if (
        isinstance(baseline_basis, str)
        and isinstance(candidate_basis, str)
        and baseline_basis != candidate_basis
    ):
        warnings.append("baseline and candidate use different aggregate measurement bases")
    baseline_compiler = baseline.get("compiler")
    candidate_compiler = candidate.get("compiler")
    if isinstance(baseline_compiler, dict) and isinstance(candidate_compiler, dict):
        if baseline_compiler.get("commit") != candidate_compiler.get("commit"):
            warnings.append("baseline and candidate use different compiler commits")
        if baseline_compiler.get("branch") != candidate_compiler.get("branch"):
            warnings.append("baseline and candidate use different compiler branches")
        if baseline_compiler.get("dirty") != candidate_compiler.get("dirty"):
            warnings.append("baseline and candidate use different compiler dirty states")
    return {
        "schema_version": 1,
        "kind": "profile_comparison",
        "baseline": comparison_identity(baseline, baseline_path),
        "candidate": comparison_identity(candidate, candidate_path),
        "threshold_percent": threshold_percent,
        "metrics": metrics,
        "functions": function_changes,
        "locations": location_changes,
        "call_edges": call_edge_changes,
        "warnings": warnings,
        "regressions": regressions,
        "status": "regression" if regressions else "ok",
    }


def comparison_metric_text(metric: dict[str, Any], unit: str = "") -> str:
    baseline = metric["baseline"]
    candidate = metric["candidate"]
    delta = metric["delta"]
    percent = metric["percent"]
    if baseline is None or candidate is None:
        return "unavailable"
    if percent is None and baseline == 0 and candidate != 0:
        percent_text = "new"
    else:
        percent_text = "n/a" if percent is None else f"{percent:+.1f}%"
    if unit == "MiB":
        baseline_text = f"{baseline / (1024 * 1024):.2f} MiB"
        candidate_text = f"{candidate / (1024 * 1024):.2f} MiB"
        delta_text = f"{delta / (1024 * 1024):+.2f} MiB"
    elif unit:
        baseline_text = f"{baseline:.3f} {unit}"
        candidate_text = f"{candidate:.3f} {unit}"
        delta_text = f"{delta:+.3f} {unit}"
    else:
        baseline_text = f"{baseline:g}"
        candidate_text = f"{candidate:g}"
        delta_text = f"{delta:+g}"
    return f"{baseline_text} -> {candidate_text} ({delta_text}, {percent_text})"


def comparison_sample_text(identity: dict[str, Any]) -> str:
    successful = identity.get("successful_repetitions")
    completed = identity.get("completed_repetitions")
    if isinstance(successful, int) and isinstance(completed, int):
        return f"{successful}/{completed} successful repetitions"
    return "successful repetition count unavailable"


def comparison_text(report: dict[str, Any], top: int) -> str:
    baseline = report["baseline"]
    candidate = report["candidate"]
    lines = [
        "Elisa profile comparison",
        f"baseline: {baseline['path']} ({baseline.get('opt_level') or 'unknown opt level'}; {comparison_sample_text(baseline)})",
        f"candidate: {candidate['path']} ({candidate.get('opt_level') or 'unknown opt level'}; {comparison_sample_text(candidate)})",
        f"status: {report['status']} (threshold {report['threshold_percent']:g}%)",
        "",
        "Run metrics:",
        f"  wall mean: {comparison_metric_text(report['metrics']['execution_ms_mean'], 'ms')}",
        f"  compile: {comparison_metric_text(report['metrics']['compile_ms'], 'ms')}",
        f"  CPU: {comparison_metric_text(report['metrics']['cpu_ms'], 'ms')}",
        f"  peak RSS: {comparison_metric_text(report['metrics']['peak_rss_bytes'], 'MiB')}",
        f"  events: {comparison_metric_text(report['metrics']['events'])}",
        "",
        f"Function changes (top {min(top, len(report['functions']))}):",
    ]
    for function in report["functions"][:top]:
        timing = comparison_metric_text(function["inclusive_ns"], "ns")
        events = comparison_metric_text(function["events"])
        lines.append(f"  {function['function']}: inclusive={timing}; events={events}")
    if not report["functions"]:
        lines.append("  none recorded")
    lines.extend(
        [
            "",
            f"Source locations (top {min(top, len(report['locations']))}):",
        ]
    )
    for location in report["locations"][:top]:
        source = Path(location["source"]).name if location["source"] else "<unknown>"
        label = f"{source}:{location['line']} {location['function']} {location['kind']}"
        if location.get("variable"):
            label += f" {location['variable']}"
        timing = comparison_metric_text(location["interval_ns"], "ns")
        events = comparison_metric_text(location["count"])
        lines.append(f"  {label}: interval={timing}; events={events}")
    if not report["locations"]:
        lines.append("  none recorded")
    lines.extend(
        [
            "",
            f"Call-edge changes (top {min(top, len(report['call_edges']))}):",
        ]
    )
    for call_edge in report["call_edges"][:top]:
        timing = comparison_metric_text(call_edge["inclusive_ns"], "ns")
        calls = comparison_metric_text(call_edge["call_events"])
        lines.append(
            f"  {call_edge['caller']} -> {call_edge['callee']}: "
            f"inclusive={timing}; calls={calls}"
        )
    if not report["call_edges"]:
        lines.append("  none recorded")
    if report["warnings"]:
        lines.extend(["", "Warnings:"])
        lines.extend(f"  - {warning}" for warning in report["warnings"])
    if report["regressions"]:
        lines.extend(["", "Regressions:"])
        lines.extend(f"  - {regression['message']}" for regression in report["regressions"])
    return "\n".join(lines) + "\n"


def comparison_html(report: dict[str, Any], top: int) -> str:
    baseline = report["baseline"]
    candidate = report["candidate"]
    metric_rows = [
        ["Wall mean", comparison_metric_text(report["metrics"]["execution_ms_mean"], "ms")],
        ["Compile", comparison_metric_text(report["metrics"]["compile_ms"], "ms")],
        ["CPU", comparison_metric_text(report["metrics"]["cpu_ms"], "ms")],
        ["Peak RSS", comparison_metric_text(report["metrics"]["peak_rss_bytes"], "MiB")],
        ["Events", comparison_metric_text(report["metrics"]["events"])],
    ]
    function_rows = [
        [
            function["function"],
            comparison_metric_text(function["inclusive_ns"], "ns"),
            comparison_metric_text(function["events"]),
            comparison_metric_text(function["completed_calls"]),
        ]
        for function in report["functions"][:top]
    ]
    location_rows = []
    for location in report["locations"][:top]:
        source = Path(location["source"]).name if location["source"] else "<unknown>"
        location_rows.append(
            [
                f"{source}:{location['line']}",
                location["function"],
                location["kind"],
                location.get("variable") or "",
                comparison_metric_text(location["interval_ns"], "ns"),
                comparison_metric_text(location["count"]),
            ]
        )
    call_edge_rows = [
        [
            f"{call_edge['caller']} -> {call_edge['callee']}",
            comparison_metric_text(call_edge["inclusive_ns"], "ns"),
            comparison_metric_text(call_edge["call_events"]),
            comparison_metric_text(call_edge["completed_calls"]),
        ]
        for call_edge in report["call_edges"][:top]
    ]
    sections = [
        html_table("Run metrics", ["Metric", "Baseline → Candidate"], metric_rows),
        html_table(
            f"Function changes (top {min(top, len(report['functions']))})",
            ["Function", "Inclusive", "Events", "Completed calls"],
            function_rows,
        ),
        html_table(
            f"Source-location changes (top {min(top, len(report['locations']))})",
            ["Location", "Function", "Kind", "Variable", "Interval", "Events"],
            location_rows,
        ),
        html_table(
            f"Call-edge changes (top {min(top, len(report['call_edges']))})",
            ["Call edge", "Inclusive", "Calls", "Completed calls"],
            call_edge_rows,
        ),
    ]
    if report["warnings"]:
        warning_rows = [[warning] for warning in report["warnings"]]
        sections.append(html_table("Warnings", ["Message"], warning_rows))
    if report["regressions"]:
        regression_rows = [
            [regression["scope"], regression["metric"], regression["message"]]
            for regression in report["regressions"]
        ]
        sections.append(html_table("Regressions", ["Scope", "Metric", "Message"], regression_rows))
    status = report["status"]
    return "\n".join(
        [
            "<!doctype html>",
            '<html lang="en"><head><meta charset="utf-8">',
            '<meta name="viewport" content="width=device-width, initial-scale=1">',
            "<title>Elisa profile comparison</title>",
            """<style>
:root { color-scheme: light dark; font: 15px/1.45 -apple-system, BlinkMacSystemFont, sans-serif; }
body { margin: 0; background: #f5f7fa; color: #182230; }
main { max-width: 1500px; margin: 0 auto; padding: 28px; }
h1 { margin: 0 0 4px; font-size: 26px; }
.subtitle, .muted { color: #667085; }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 10px; margin: 22px 0; }
.card { background: white; border: 1px solid #d8dee8; border-radius: 10px; padding: 14px; }
.card-label { color: #667085; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; }
.card-value { font-size: 18px; font-weight: 650; margin-top: 4px; overflow-wrap: anywhere; }
h2 { margin: 28px 0 10px; font-size: 18px; }
.table-wrap { overflow-x: auto; background: white; border: 1px solid #d8dee8; border-radius: 10px; }
table { border-collapse: collapse; min-width: 720px; width: 100%; }
th, td { border-bottom: 1px solid #e9edf3; padding: 9px 11px; text-align: left; vertical-align: top; }
th { background: #eef2f7; }
tbody tr:last-child td { border-bottom: 0; }
footer { border-top: 1px solid #d8dee8; margin-top: 30px; padding-top: 14px; color: #667085; font-size: 12px; }
@media (prefers-color-scheme: dark) {
  body { background: #111827; color: #e5e7eb; }
  .card, .table-wrap { background: #1f2937; border-color: #374151; }
  th, td { border-color: #374151; }
  th { background: #374151; }
  .subtitle, .muted, .card-label, footer { color: #9ca3af; }
}
</style>""",
            """<script>
document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll("table[data-sortable]").forEach(table => {
    const body = table.tBodies[0];
    table.querySelectorAll("th").forEach((header, index) => {
      header.addEventListener("click", () => {
        const direction = header.dataset.direction === "ascending" ? -1 : 1;
        header.dataset.direction = direction === 1 ? "ascending" : "descending";
        [...body.rows].sort((left, right) => {
          const a = left.cells[index].textContent.trim();
          const b = right.cells[index].textContent.trim();
          const an = Number(a.replace(/[^0-9.+-]/g, ""));
          const bn = Number(b.replace(/[^0-9.+-]/g, ""));
          if (Number.isFinite(an) && Number.isFinite(bn) && a !== "" && b !== "") {
            return (an - bn) * direction;
          }
          return a.localeCompare(b) * direction;
        }).forEach(row => body.appendChild(row));
      });
    });
  });
});
</script>""",
            "</head><body><main>",
            "<h1>Elisa profile comparison</h1>",
            f'<p class="subtitle">{escape(baseline["path"])} → {escape(candidate["path"])}</p>',
            '<div class="cards">',
            f'<div class="card"><div class="card-label">Status</div><div class="card-value">{escape(status)}</div></div>',
            f'<div class="card"><div class="card-label">Threshold</div><div class="card-value">{report["threshold_percent"]:g}%</div></div>',
            f'<div class="card"><div class="card-label">Baseline</div><div class="card-value">{escape(str(baseline.get("opt_level") or "unknown"))}</div></div>',
            f'<div class="card"><div class="card-label">Candidate</div><div class="card-value">{escape(str(candidate.get("opt_level") or "unknown"))}</div></div>',
            f'<div class="card"><div class="card-label">Baseline samples</div><div class="card-value">{escape(comparison_sample_text(baseline))}</div></div>',
            f'<div class="card"><div class="card-label">Candidate samples</div><div class="card-value">{escape(comparison_sample_text(candidate))}</div></div>',
            "</div>",
            *sections,
            f"<footer>Comparison schema {report['schema_version']}</footer>",
            "</main></body></html>",
        ]
    ) + "\n"


def build_report(
    source: Path,
    compiler: dict[str, Any],
    meta: dict[str, int],
    locations: list[dict[str, Any]],
    call_edges: list[dict[str, Any]],
    stacks: list[dict[str, Any]],
    *,
    exit_code: int | None,
    signal: int | None,
    run_records: list[dict[str, Any]],
    warmup_ms: float,
    warmup_repetitions: int,
    timeout_s: float | None,
    location_timing: bool,
    opt_level: str,
    compile_ms: float,
    program_stderr: str,
    temp_root: Path | None,
    recent_events: list[dict[str, Any]],
    active_stack: dict[str, Any] | None,
) -> dict[str, Any]:
    source_mapping = add_source_context(source, locations)
    add_source_context(source, recent_events)
    for record in run_records:
        record_recent_events = record.get("recent_events")
        if isinstance(record_recent_events, list) and record_recent_events is not recent_events:
            add_source_context(source, record_recent_events)
    function_stats: defaultdict[str, dict[str, Any]] = defaultdict(
        lambda: {
            "events": 0,
            "statement_events": 0,
            "value_events": 0,
            "call_events": 0,
            "locations": 0,
            "interval_ns": 0,
            "max_interval_ns": 0,
            "inclusive_ns": 0,
            "self_ns": 0,
            "completed_calls": 0,
            "definitions": [],
        }
    )
    for location in locations:
        stats = function_stats[location["function"]]
        stats["events"] += location["count"]
        stats["locations"] += 1
        stats["interval_ns"] += location["interval_ns"]
        stats["max_interval_ns"] = max(
            stats["max_interval_ns"], location["max_interval_ns"]
        )
        if location["kind"] == "value":
            stats["value_events"] += location["count"]
        elif location["kind"] == "function":
            stats["call_events"] += location["count"]
            stats["inclusive_ns"] += location["inclusive_ns"]
            stats["self_ns"] += location["self_ns"]
            stats["completed_calls"] += location["completed_calls"]
            definition = {
                "source": location["source"],
                "line": location["line"],
                "compiler_line": location["compiler_line"],
                "source_text": location.get("source_text"),
            }
            if definition not in stats["definitions"]:
                stats["definitions"].append(definition)
        else:
            stats["statement_events"] += location["count"]
    summary = dict(meta)
    summary["statement_events"] = sum(
        location["count"] for location in locations if location["kind"] == "statement"
    )
    summary["value_events"] = sum(
        location["count"] for location in locations if location["kind"] == "value"
    )
    summary["function_events"] = sum(
        location["count"] for location in locations if location["kind"] == "function"
    )
    called_function_names = {call_edge["callee"] for call_edge in call_edges}
    root_inclusive_ns = sum(
        stats["inclusive_ns"]
        for function_name, stats in function_stats.items()
        if function_name not in called_function_names
    )
    for stats in function_stats.values():
        completed_calls = stats["completed_calls"]
        stats["mean_inclusive_ns"] = (
            stats["inclusive_ns"] // completed_calls if completed_calls else 0
        )
        stats["mean_self_ns"] = stats["self_ns"] // completed_calls if completed_calls else 0
        stats["inclusive_percent"] = (
            stats["inclusive_ns"] * 100.0 / root_inclusive_ns
            if root_inclusive_ns
            else 0.0
        )
        stats["self_percent"] = (
            stats["self_ns"] * 100.0 / root_inclusive_ns if root_inclusive_ns else 0.0
        )
    functions = [
        {"function": function_name, **stats}
        for function_name, stats in sorted(
            function_stats.items(), key=lambda item: (-item[1]["events"], item[0])
        )
    ]
    successful_records = [
        record
        for record in run_records
        if record["exit_code"] == 0
        and record["signal"] is None
        and not record["timed_out"]
    ]
    measurement_records = successful_records or run_records
    cpu_user_values = [
        record["cpu_user_ms"]
        for record in measurement_records
        if record["cpu_user_ms"] is not None
    ]
    cpu_system_values = [
        record["cpu_system_ms"]
        for record in measurement_records
        if record["cpu_system_ms"] is not None
    ]
    peak_rss_values = [
        record["peak_rss_bytes"]
        for record in measurement_records
        if record["peak_rss_bytes"] is not None
    ]
    cpu_user_ms = sum(cpu_user_values) if cpu_user_values else None
    cpu_system_ms = sum(cpu_system_values) if cpu_system_values else None
    cpu_ms = (
        cpu_user_ms + cpu_system_ms
        if cpu_user_ms is not None and cpu_system_ms is not None
        else None
    )
    execution_times = [record["execution_ms"] for record in measurement_records]
    execution_ms = sum(execution_times)
    measurement_basis = "successful" if successful_records else "all_completed"
    report: dict[str, Any] = {
        "schema_version": 1,
        "source": str(source),
        "compiler": compiler,
        "summary": summary,
        "source_mapping": source_mapping,
        "run": {
            "exit_code": exit_code,
            "signal": signal,
            "location_timing": location_timing,
            "opt_level": opt_level,
            "execution_ms": execution_ms,
            "timeout_s": timeout_s,
            "execution_ms_min": min(execution_times),
            "execution_ms_mean": execution_ms / len(execution_times),
            "execution_ms_max": max(execution_times),
            "execution_ms_median": statistics.median(execution_times),
            "execution_ms_stdev": statistics.pstdev(execution_times),
            "cpu_user_ms": cpu_user_ms,
            "cpu_system_ms": cpu_system_ms,
            "cpu_ms": cpu_ms,
            "peak_rss_bytes": max(peak_rss_values) if peak_rss_values else None,
            "warmup_ms": warmup_ms,
            "warmup_repetitions": warmup_repetitions,
            "requested_repetitions": run_records[-1]["requested_repetitions"],
            "completed_repetitions": len(run_records),
            "successful_repetitions": len(successful_records),
            "failed_repetitions": len(run_records) - len(successful_records),
            "measurement_repetitions": len(measurement_records),
            "measurement_basis": measurement_basis,
            "repetitions": run_records,
            "compile_ms": compile_ms,
        },
        "functions": functions,
        "call_edges": call_edges,
        "stacks": stacks,
        "locations": locations,
    }
    if program_stderr:
        report["program_stderr"] = program_stderr
    if recent_events:
        report["recent_events"] = recent_events
    if active_stack is not None:
        report["active_stack"] = active_stack
    if temp_root is not None:
        report["artifacts"] = {"build_directory": str(temp_root)}
    return report


def parse_compare_arguments(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="elisa-profiler compare",
        description="Compare two JSON profiler reports for performance regressions.",
    )
    parser.add_argument("baseline", type=Path, help="baseline JSON profile")
    parser.add_argument("candidate", type=Path, help="candidate JSON profile")
    parser.add_argument(
        "--format", choices=("text", "json", "html"), default="text", help="comparison output format"
    )
    parser.add_argument("-o", "--output", type=Path, help="write the comparison to this file")
    parser.add_argument(
        "--top", type=int, default=20, help="number of function and location changes in text output"
    )
    parser.add_argument(
        "--threshold",
        type=float,
        default=10.0,
        help="percentage increase that counts as a regression (default: 10)",
    )
    parser.add_argument(
        "--fail-on-regression",
        action="store_true",
        help="return status 1 when a metric, function, or location exceeds the threshold",
    )
    args = parser.parse_args(argv)
    if args.top < 1:
        parser.error("--top must be positive")
    if not math.isfinite(args.threshold) or args.threshold < 0:
        parser.error("--threshold must be a finite non-negative number")
    args.baseline = args.baseline.resolve()
    args.candidate = args.candidate.resolve()
    if args.output is not None:
        args.output = args.output.resolve()
    args.command = "compare"
    return args


def parse_arguments(argv: list[str]) -> argparse.Namespace:
    if argv and argv[0] == "compare":
        return parse_compare_arguments(argv[1:])
    if argv and argv[0] == "profile":
        argv = argv[1:]
    parser = argparse.ArgumentParser(
        prog="elisa-profiler",
        description="Compile and run an Elisa program with source-location tracing.",
    )
    parser.add_argument("source", type=Path, help="Elisa source file containing main() -> i64")
    parser.add_argument("-o", "--output", type=Path, help="write the report to this file")
    parser.add_argument(
        "--format", choices=("text", "json", "folded", "html", "speedscope"), default="text"
    )
    parser.add_argument("--top", type=int, default=20, help="number of hot locations in text output")
    parser.add_argument("--repeat", type=int, default=1, help="number of measured executions (default: 1)")
    parser.add_argument("--warmup", type=int, default=0, help="number of unreported executions before measuring")
    parser.add_argument("--timeout", type=float, help="maximum seconds per execution")
    parser.add_argument(
        "--location-timing",
        action="store_true",
        help="attribute wall time between trace events to source locations",
    )
    parser.add_argument(
        "--recent-path",
        action="store_true",
        help="include the last 256 trace events for each measured run",
    )
    parser.add_argument("--opt-level", choices=("0", "1", "2", "3"), default="0")
    parser.add_argument(
        "--compiler-root",
        type=Path,
        default=Path(os.environ.get("ELISA_COMPILER_ROOT", DEFAULT_COMPILER_ROOT)),
    )
    parser.add_argument("--runtime-object", type=Path)
    parser.add_argument("--stage0-core", type=Path, default=Path(os.environ.get("ELISA_STAGE0_CORE", DEFAULT_STAGE0_CORE)))
    parser.add_argument("--rebuild-runtime", action="store_true")
    parser.add_argument("--show-output", action="store_true", help="forward target stdout/stderr to profiler stderr")
    parser.add_argument("--keep-temp", action="store_true", help="keep generated objects and executable")
    parser.add_argument("--version", action="version", version="elisa-profiler 0.1")
    args = parser.parse_args(argv)
    if args.top < 1:
        parser.error("--top must be positive")
    if args.repeat < 1:
        parser.error("--repeat must be positive")
    if args.warmup < 0:
        parser.error("--warmup cannot be negative")
    if args.timeout is not None and (not math.isfinite(args.timeout) or args.timeout <= 0):
        parser.error("--timeout must be a finite positive number")
    args.source = args.source.resolve()
    args.compiler_root = args.compiler_root.resolve()
    args.stage0_core = args.stage0_core.resolve()
    if args.runtime_object is None:
        args.runtime_object = args.compiler_root / "build" / "runtime" / "elisacore_runtime.o"
    else:
        args.runtime_object = args.runtime_object.resolve()
    args.command = "profile"
    return args


def profile(args: argparse.Namespace) -> int:
    if not args.source.is_file():
        raise ProfilerError(f"source file does not exist: {args.source}")
    compiler_script = ROOT / "scripts" / "elisa-compiler"
    if not compiler_script.is_file():
        raise ProfilerError(f"compiler wrapper is missing: {compiler_script}")
    stage1_script = args.compiler_root / "scripts" / "elisac_stage1.sh"
    if not stage1_script.is_file():
        raise ProfilerError(f"compiler worktree is missing: {args.compiler_root}")

    clang, objcopy, nm = compiler_tools()
    env = os.environ.copy()
    env["ELISA_COMPILER_ROOT"] = str(args.compiler_root)
    env["ELISA_PROFILE_RECENT_PATH"] = "1" if args.recent_path else "0"
    ensure_runtime(
        args.compiler_root,
        args.runtime_object,
        args.stage0_core,
        rebuild=args.rebuild_runtime,
        env=env,
    )

    temp_root = Path(tempfile.mkdtemp(prefix="elisa-profiler-"))
    try:
        target_object = temp_root / "target.o"
        renamed_target = temp_root / "target-renamed.o"
        collector_runtime = temp_root / "runtime-collector.o"
        collector_object = temp_root / "profiler-runtime.o"
        executable_path = temp_root / "profiled-program"
        compile_start = time.perf_counter_ns()
        compile_result = run_command(
            [
                str(compiler_script),
                "-g",
                "-ftrace",
                f"-O{args.opt_level}",
                "-o",
                str(target_object),
                str(args.source),
            ],
            env=env,
        )
        compile_ms = (time.perf_counter_ns() - compile_start) / 1_000_000
        if compile_result.returncode != 0:
            message = compile_result.stderr.strip() or compile_result.stdout.strip() or "Elisa compilation failed"
            raise ProfilerError(message)

        prepare_target(
            objcopy,
            nm,
            target_object,
            args.runtime_object,
            renamed_target,
            collector_runtime,
        )
        compile_shim = run_command(
            [
                clang,
                "-std=c11",
                "-O2",
                *(["-DELISA_PROFILE_TIMING=1"] if args.location_timing else []),
                "-fno-builtin",
                "-pthread",
                "-c",
                "-o",
                str(collector_object),
                str(ROOT / "scripts" / "profiler_runtime.c"),
            ],
            env=env,
        )
        if compile_shim.returncode != 0:
            raise ProfilerError(f"profiler runtime failed to compile: {compile_shim.stderr.strip()}")

        link_flags = ["-Wl,-dead_strip"] if sys.platform == "darwin" else ["-Wl,--gc-sections"]
        if sys.platform == "darwin":
            link_flags.append("-Wl,-stack_size,0x20000000")
        link_result = run_command(
            [
                clang,
                *link_flags,
                "-pthread",
                "-o",
                str(executable_path),
                str(renamed_target),
                str(collector_runtime),
                str(collector_object),
            ],
            env=env,
        )
        if link_result.returncode != 0:
            raise ProfilerError(f"could not link profiled program: {link_result.stderr.strip()}")

        warmup_ms = 0.0
        for repetition in range(1, args.warmup + 1):
            warmup_start = time.perf_counter_ns()
            warmup_status, _, _, warmup_timed_out, _ = execute_program(
                executable_path, args.timeout, env=env
            )
            warmup_ms += (time.perf_counter_ns() - warmup_start) / 1_000_000
            if warmup_status != 0 or warmup_timed_out:
                warmup_status = (
                    f"signal {-warmup_status}"
                    if warmup_status < 0
                    else f"exit {warmup_status}"
                )
                raise ProfilerError(f"warmup run {repetition} failed with {warmup_status}")

        profile_results: list[
            tuple[
                dict[str, int],
                list[dict[str, Any]],
                list[dict[str, Any]],
                list[dict[str, Any]],
                str,
                list[dict[str, Any]],
                dict[str, Any] | None,
            ]
        ] = []
        run_records: list[dict[str, Any]] = []
        run_stdout: list[str] = []
        run_stderr: list[str] = []
        for repetition in range(1, args.repeat + 1):
            execution_start = time.perf_counter_ns()
            cpu_before = child_cpu_usage()
            resource_path = measured_resource_file(temp_root, repetition, args.timeout)
            run_status, run_stdout_bytes, run_stderr_bytes, run_timed_out, resources = execute_program(
                executable_path, args.timeout, resource_path, env
            )
            cpu_after = child_cpu_usage()
            cpu_delta = child_cpu_delta(cpu_before, cpu_after)
            peak_rss_bytes = resources.get("peak_rss_bytes")
            execution_ms = (time.perf_counter_ns() - execution_start) / 1_000_000
            stderr = run_stderr_bytes.decode("utf-8", errors="replace")
            (
                meta,
                locations,
                call_edges,
                stacks,
                program_stderr,
                recent_events,
                active_stack,
            ) = parse_profile(
                stderr,
                allow_missing=run_status < 0 or run_timed_out,
            )
            run_record = {
                "repetition": repetition,
                "requested_repetitions": args.repeat,
                "exit_code": run_status if run_status >= 0 else None,
                "signal": -run_status if run_status < 0 else None,
                "execution_ms": execution_ms,
                "timed_out": run_timed_out,
                "cpu_user_ms": cpu_delta[0] if cpu_delta is not None else None,
                "cpu_system_ms": cpu_delta[1] if cpu_delta is not None else None,
                "cpu_ms": sum(cpu_delta) if cpu_delta is not None else None,
                "peak_rss_bytes": peak_rss_bytes,
                "trace_events": meta["events"],
                "trace_locations": meta["locations"],
                "trace_dropped": meta["dropped"],
                "trace_threads": meta.get("thread_count", 0),
                "trace_max_stack_depth": meta.get("max_stack_depth", 0),
                "trace_stack_overflow_entries": meta.get("stack_overflow_entries", 0),
            }
            if recent_events:
                run_record["recent_events"] = recent_events
            run_records.append(run_record)
            profile_results.append(
                (
                    meta,
                    locations,
                    call_edges,
                    stacks,
                    program_stderr,
                    recent_events,
                    active_stack,
                )
            )
            run_stdout.append(run_stdout_bytes.decode("utf-8", errors="replace"))
            run_stderr.append(program_stderr)
            if run_status != 0 or run_timed_out:
                break

        (
            meta,
            locations,
            call_edges,
            stacks,
            program_stderr,
            recent_events,
            active_stack,
        ) = merge_profiles(profile_results)
        failed_run = next(
            (
                record
                for record in run_records
                if record["timed_out"]
                or record["signal"] is not None
                or record["exit_code"] != 0
            ),
            None,
        )
        if failed_run is None:
            exit_code = 0
            signal = None
        elif failed_run["timed_out"]:
            exit_code = None
            signal = failed_run["signal"] or 15
        else:
            exit_code = failed_run["exit_code"]
            signal = failed_run["signal"]
        report = build_report(
            args.source,
            compiler_metadata(args.compiler_root, args.runtime_object),
            meta,
            locations,
            call_edges,
            stacks,
            exit_code=exit_code,
            signal=signal,
            run_records=run_records,
            warmup_ms=warmup_ms,
            warmup_repetitions=args.warmup,
            timeout_s=args.timeout,
            location_timing=args.location_timing,
            opt_level=f"-O{args.opt_level}",
            compile_ms=compile_ms,
            program_stderr="" if args.show_output else program_stderr,
            temp_root=temp_root if args.keep_temp else None,
            recent_events=recent_events,
            active_stack=active_stack,
        )
        if args.format == "json":
            rendered = json.dumps(report, indent=2, sort_keys=False) + "\n"
        elif args.format == "folded":
            rendered = folded_report(report)
        elif args.format == "speedscope":
            rendered = speedscope_report(report)
        elif args.format == "html":
            rendered = html_report(report, args.top)
        else:
            rendered = text_report(report, args.top)
        if args.output:
            args.output.parent.mkdir(parents=True, exist_ok=True)
            args.output.write_text(rendered, encoding="utf-8")
        else:
            sys.stdout.write(rendered)
        if args.show_output:
            for repetition, stdout in enumerate(run_stdout, start=1):
                if stdout:
                    sys.stderr.write(f"Program stdout (run {repetition}):\n{stdout}")
            for repetition, stderr in enumerate(run_stderr, start=1):
                if stderr:
                    sys.stderr.write(f"Program stderr (run {repetition}):\n{stderr}")
        if signal is not None:
            return 128 + signal
        return exit_code
    finally:
        if not args.keep_temp:
            shutil.rmtree(temp_root, ignore_errors=True)


def compare_profiles(args: argparse.Namespace) -> int:
    comparison = build_comparison_report(args.baseline, args.candidate, args.threshold)
    if args.format == "json":
        rendered = json.dumps(comparison, indent=2, sort_keys=False) + "\n"
    elif args.format == "html":
        rendered = comparison_html(comparison, args.top)
    else:
        rendered = comparison_text(comparison, args.top)
    if args.output is not None:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(rendered, encoding="utf-8")
    else:
        sys.stdout.write(rendered)
    if args.fail_on_regression and comparison["status"] != "ok":
        return 1
    return 0


def main(argv: list[str] | None = None) -> int:
    try:
        args = parse_arguments(sys.argv[1:] if argv is None else argv)
        if args.command == "compare":
            return compare_profiles(args)
        return profile(args)
    except ProfilerError as error:
        print(f"elisa-profiler: {error}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("elisa-profiler: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
