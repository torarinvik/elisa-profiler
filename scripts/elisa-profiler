#!/usr/bin/env python3
"""Compile, run, and report an instrumented Elisa program."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import statistics
import subprocess
import sys
import tempfile
import time
from collections import defaultdict
from typing import Any


ROOT = Path(__file__).resolve().parent.parent
DEFAULT_COMPILER_ROOT = ROOT.parent / "elisa-compiler-worktrees" / "profiler"
DEFAULT_STAGE0_CORE = ROOT.parent.parent / "Go projects" / "structpy-tree"
INCLUDE_RE = re.compile(r'^[ \t]*(?:#\s*)?include[ \t]+"([^"]+)"[ \t]*$')


class ProfilerError(Exception):
    pass


def executable(value: str | None, candidates: list[Path], name: str) -> str:
    if value:
        path = Path(value)
        if path.is_file() and os.access(path, os.X_OK):
            return str(path)
        found = shutil.which(value)
        if found:
            return found
    for candidate in candidates:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    found = shutil.which(name)
    if found:
        return found
    raise ProfilerError(f"could not find {name}; set the corresponding LLVM tool environment variable")


def compiler_tools() -> tuple[str, str, str]:
    llvm_config_value = os.environ.get("LLVM_CONFIG", "/opt/homebrew/opt/llvm/bin/llvm-config")
    llvm_config = Path(llvm_config_value)
    llvm_bin = Path(os.environ.get("ELISA_LLVM_BIN_DIR", str(llvm_config.parent)))
    clang = executable(
        os.environ.get("ELISA_CLANG"),
        [llvm_bin / "clang", Path("/usr/bin/clang")],
        "clang",
    )
    objcopy = executable(
        os.environ.get("ELISA_LLVM_OBJCOPY"),
        [llvm_bin / "llvm-objcopy"],
        "llvm-objcopy",
    )
    nm = executable(
        os.environ.get("ELISA_LLVM_NM"),
        [llvm_bin / "llvm-nm", Path("/usr/bin/nm")],
        "nm",
    )
    return clang, objcopy, nm


def run_command(command: list[str], *, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, env=env, text=True, capture_output=True, check=False)


def execute_program(executable_path: Path, timeout: float | None) -> tuple[int, bytes, bytes, bool]:
    process = subprocess.Popen([str(executable_path)], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    timed_out = False
    try:
        stdout, stderr = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        process.terminate()
        try:
            stdout, stderr = process.communicate(timeout=2)
        except subprocess.TimeoutExpired:
            process.kill()
            stdout, stderr = process.communicate()
    return process.returncode, stdout, stderr, timed_out


def git_value(root: Path, *arguments: str, fallback: str = "unknown") -> str:
    result = run_command(["git", "-C", str(root), *arguments])
    if result.returncode == 0:
        value = result.stdout.strip()
        if value:
            return value
    return fallback


def compiler_metadata(compiler_root: Path, runtime_object: Path) -> dict[str, Any]:
    status = git_value(compiler_root, "status", "--porcelain", fallback="")
    return {
        "root": str(compiler_root),
        "branch": git_value(compiler_root, "branch", "--show-current"),
        "commit": git_value(compiler_root, "rev-parse", "HEAD"),
        "dirty": bool(status),
        "runtime_object": str(runtime_object),
    }


def ensure_runtime(
    compiler_root: Path,
    runtime_object: Path,
    stage0_core: Path,
    *,
    rebuild: bool,
    env: dict[str, str],
) -> None:
    if runtime_object.is_file() and not rebuild:
        return
    build_script = compiler_root / "scripts" / "build_runtime_object.sh"
    if not build_script.is_file():
        raise ProfilerError(f"runtime builder is missing: {build_script}")
    stage0_binary = stage0_core / "compiler" / "bin" / "elisac"
    if not stage0_binary.is_file():
        raise ProfilerError(
            f"stage0 compiler is missing: {stage0_binary}; set ELISA_STAGE0_CORE or build the local stage0 compiler"
        )
    build_env = env.copy()
    build_env["ELISA_CORE"] = str(stage0_core)
    build_env["ELISA_RUNTIME_OBJ"] = str(runtime_object)
    result = run_command([str(build_script)], env=build_env)
    if result.returncode != 0 or not runtime_object.is_file():
        message = result.stderr.strip() or result.stdout.strip() or "runtime build failed"
        raise ProfilerError(message)


def defined_symbols(nm: str, object_path: Path) -> set[str]:
    result = run_command([nm, "-g", str(object_path)])
    if result.returncode != 0:
        raise ProfilerError(f"nm failed for {object_path}: {result.stderr.strip()}")
    symbols: set[str] = set()
    for line in result.stdout.splitlines():
        fields = line.split()
        if fields:
            symbols.add(fields[-1])
    return symbols


def prepare_target(
    objcopy: str,
    nm: str,
    target_object: Path,
    runtime_object: Path,
    renamed_target: Path,
    collector_runtime: Path,
) -> None:
    target_symbols = defined_symbols(nm, target_object)
    main_symbol = "_main" if "_main" in target_symbols else "main"
    if main_symbol not in target_symbols:
        raise ProfilerError(f"compiled Elisa object does not export main: {target_object}")
    target_name = "_elisa_profile_target_main" if main_symbol.startswith("_") else "elisa_profile_target_main"
    result = run_command(
        [
            objcopy,
            "--redefine-sym",
            f"{main_symbol}={target_name}",
            str(target_object),
            str(renamed_target),
        ]
    )
    if result.returncode != 0:
        raise ProfilerError(f"could not rename Elisa main: {result.stderr.strip()}")

    shutil.copyfile(runtime_object, collector_runtime)
    runtime_symbols = defined_symbols(nm, collector_runtime)
    trace_symbols = [
        symbol
        for symbol in ("_elisa_trace_record", "elisa_trace_record")
        if symbol in runtime_symbols
    ]
    trace_value_symbols = [
        symbol
        for symbol in ("_elisa_trace_record_value", "elisa_trace_record_value")
        if symbol in runtime_symbols
    ]
    trace_install_symbols = [
        symbol
        for symbol in ("_elisa_trace_install_fault_handler", "elisa_trace_install_fault_handler")
        if symbol in runtime_symbols
    ]
    localize = trace_symbols + trace_value_symbols + trace_install_symbols
    if not localize:
        raise ProfilerError(f"runtime object has no trace callbacks: {runtime_object}")
    command = [objcopy]
    for symbol in localize:
        command.extend(["--localize-symbol", symbol])
    command.extend([str(collector_runtime)])
    result = run_command(command)
    if result.returncode != 0:
        raise ProfilerError(f"could not localize runtime trace callbacks: {result.stderr.strip()}")


def parse_profile(
    stderr: str, *, allow_missing: bool = False
) -> tuple[dict[str, int], list[dict[str, Any]], str, list[dict[str, Any]]]:
    meta: dict[str, int] | None = None
    locations: list[dict[str, Any]] = []
    recent_events: list[dict[str, Any]] = []
    program_stderr: list[str] = []
    for line in stderr.splitlines():
        if not line.startswith("ELISA_PROFILE\t"):
            program_stderr.append(line)
            continue
        fields = line.split("\t")
        if len(fields) == 6 and fields[2] == "meta":
            meta = {
                "events": int(fields[3]),
                "locations": int(fields[4]),
                "dropped": int(fields[5]),
            }
            continue
        if len(fields) == 10 and fields[2] == "path":
            kind = int(fields[4])
            if kind not in (1, 2):
                raise ProfilerError(f"unknown profiler path kind: {line}")
            if fields[8] not in ("0", "1"):
                raise ProfilerError(f"invalid profiler path signedness flag: {line}")
            recent_events.append(
                {
                    "sequence": int(fields[3]),
                    "kind": "value" if kind == 2 else "statement",
                    "function": fields[5],
                    "line": int(fields[6]),
                    "variable": None if fields[7] == "-" else fields[7],
                    "signed": fields[8] == "1",
                    "value": int(fields[9]),
                }
            )
            continue
        if len(fields) != 15 or fields[2] != "location":
            raise ProfilerError(f"malformed profiler runtime record: {line}")
        kind = int(fields[3])
        if kind not in (1, 2):
            raise ProfilerError(f"unknown profiler location kind: {line}")
        location: dict[str, Any] = {
            "kind": "value" if kind == 2 else "statement",
            "function": fields[4],
            "line": int(fields[5]),
            "count": int(fields[6]),
        }
        location["interval_ns"] = int(fields[13])
        location["max_interval_ns"] = int(fields[14])
        if kind == 2:
            location["variable"] = None if fields[7] == "-" else fields[7]
            if fields[8] not in ("0", "1"):
                raise ProfilerError(f"invalid profiler signedness flag: {line}")
            location["signed"] = fields[8] == "1"
            location["minimum"] = int(fields[9])
            location["maximum"] = int(fields[10])
            location["sum"] = None if fields[11] == "overflow" else int(fields[11])
            location["last"] = int(fields[12])
        locations.append(location)
    if meta is None:
        if allow_missing:
            return {"events": 0, "locations": 0, "dropped": 0}, [], stderr, recent_events
        raise ProfilerError("profile runtime produced no ELISA_PROFILE metadata")
    return (
        meta,
        locations,
        "\n".join(program_stderr) + ("\n" if program_stderr else ""),
        recent_events,
    )


def merge_profiles(
    results: list[tuple[dict[str, int], list[dict[str, Any]], str, list[dict[str, Any]]]],
) -> tuple[dict[str, int], list[dict[str, Any]], str, list[dict[str, Any]]]:
    merged: dict[tuple[str, str, int, str | None], dict[str, Any]] = {}
    events = 0
    dropped = 0
    recent_events: list[dict[str, Any]] = []
    program_stderr: list[str] = []
    for repetition, (meta, locations, stderr, path) in enumerate(results, start=1):
        events += meta["events"]
        dropped += meta["dropped"]
        if stderr:
            program_stderr.append(f"run {repetition}:\n{stderr.rstrip()}")
        if path:
            recent_events = path
        for location in locations:
            key = (
                location["kind"],
                location["function"],
                location["line"],
                location.get("variable"),
                location.get("signed", False),
            )
            if key not in merged:
                merged[key] = dict(location)
                continue
            combined = merged[key]
            combined["count"] += location["count"]
            combined["interval_ns"] += location["interval_ns"]
            combined["max_interval_ns"] = max(
                combined["max_interval_ns"], location["max_interval_ns"]
            )
            if location["kind"] == "value":
                combined["minimum"] = min(combined["minimum"], location["minimum"])
                combined["maximum"] = max(combined["maximum"], location["maximum"])
                combined["last"] = location["last"]
                if combined["sum"] is None or location["sum"] is None:
                    combined["sum"] = None
                else:
                    combined["sum"] += location["sum"]
    locations = sorted(
        merged.values(),
        key=lambda location: (-location["count"], location["line"], location["function"]),
    )
    return (
        {"events": events, "locations": len(locations), "dropped": dropped},
        locations,
        "\n\n".join(program_stderr) + ("\n" if program_stderr else ""),
        recent_events,
    )


def source_line_map(source: Path) -> list[tuple[Path, int, str]]:
    seen: set[Path] = set()

    def flatten(path: Path, stack: list[Path]) -> list[tuple[Path, int, str]]:
        path = path.resolve()
        if path in seen:
            return []
        if path in stack:
            raise ProfilerError(f"cyclic include while mapping profile locations: {path}")
        seen.add(path)
        try:
            contents = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as error:
            raise ProfilerError(f"could not read source for profile mapping: {path}: {error}") from error
        mapped: list[tuple[Path, int, str]] = []
        for line_number, line in enumerate(contents.splitlines(keepends=True), start=1):
            match = INCLUDE_RE.match(line.rstrip("\n"))
            if match:
                include_path = Path(match.group(1))
                if not include_path.is_absolute():
                    include_path = path.parent / include_path
                mapped.extend(flatten(include_path, [*stack, path]))
            else:
                mapped.append((path, line_number, line.rstrip("\r\n")))
        return mapped

    return flatten(source, [])


def add_source_context(source: Path, locations: list[dict[str, Any]]) -> dict[str, Any]:
    mapping_error: str | None = None
    try:
        mapped_lines = source_line_map(source)
    except ProfilerError as error:
        mapped_lines = []
        mapping_error = str(error)
    mapped_count = 0
    for location in locations:
        compiler_line = location["line"]
        location["compiler_line"] = compiler_line
        if 0 < compiler_line <= len(mapped_lines):
            mapped_path, mapped_line, source_text = mapped_lines[compiler_line - 1]
            location["line"] = mapped_line
            location["source"] = str(mapped_path)
            location["source_text"] = source_text.rstrip()
            mapped_count += 1
        else:
            location["source"] = str(source)
            location["source_text"] = None
    mapping = {
        "mode": "include-aware" if mapping_error is None else "fallback",
        "mapped_locations": mapped_count,
        "unmapped_locations": len(locations) - mapped_count,
    }
    if mapping_error is not None:
        mapping["error"] = mapping_error
    return mapping


def text_report(report: dict[str, Any], top: int) -> str:
    summary = report["summary"]
    run = report["run"]
    lines = [
        f"Elisa profile: {report['source']}",
        (
            f"exit={run['exit_code'] if run['exit_code'] is not None else 'signal ' + str(run['signal'])} "
            f"warmups={run['warmup_repetitions']} "
            f"runs={run['completed_repetitions']}/{run['requested_repetitions']} "
            f"execution={run['execution_ms']:.3f} ms mean={run['execution_ms_mean']:.3f} ms "
            f"events={summary['events']} "
            f"(statement={summary['statement_events']}, value={summary['value_events']}) "
            f"locations={summary['locations']} dropped={summary['dropped']}"
        ),
        "",
    ]
    if run["timeout_s"] is not None:
        lines[1] += f" timeout={run['timeout_s']}s"
    if report["locations"]:
        lines.append(f"Hot locations (top {min(top, len(report['locations']))}):")
        for location in report["locations"][:top]:
            label = f"{location['function']}:{location['line']} {location['kind']}"
            if location["kind"] == "value":
                label += f" {location.get('variable') or '<value>'}"
            source_text = location.get("source_text")
            if source_text:
                label += f"  {source_text.strip()}"
            detail = f"{location['count']} event(s)"
            if location["kind"] == "value":
                detail += (
                    f", min={location['minimum']}, max={location['maximum']}, "
                    f"last={location['last']}"
                )
            if report["run"]["location_timing"]:
                detail += (
                    f", attributed={location['interval_ns'] / 1_000_000:.3f} ms"
                    f", max-gap={location['max_interval_ns'] / 1_000_000:.3f} ms"
                )
            lines.append(f"  {detail:>34}  {label}")
    else:
        lines.append("Hot locations: none recorded")

    function_counts: defaultdict[str, int] = defaultdict(int)
    for location in report["locations"]:
        function_counts[location["function"]] += location["count"]
    lines.extend(["", "Function totals:"])
    for function_name, count in sorted(function_counts.items(), key=lambda item: (-item[1], item[0])):
        lines.append(f"  {count:>12}  {function_name}")
    recent_events = report.get("recent_events", [])
    if recent_events:
        shown_events = recent_events[-top:]
        lines.extend(
            [
                "",
                (
                    "Recent execution path "
                    f"(oldest to newest; last {len(shown_events)} event(s)):"
                ),
            ]
        )
        for event in shown_events:
            label = f"{event['function']}:{event['line']} {event['kind']}"
            if event["kind"] == "value":
                label += f" {event.get('variable') or '<value>'}={event['value']}"
            source_text = event.get("source_text")
            if source_text:
                label += f"  {source_text.strip()}"
            lines.append(f"  {label}")
    if report.get("program_stderr"):
        lines.extend(["", "Program stderr:", report["program_stderr"].rstrip()])
    return "\n".join(lines) + "\n"


def build_report(
    source: Path,
    compiler: dict[str, Any],
    meta: dict[str, int],
    locations: list[dict[str, Any]],
    *,
    exit_code: int | None,
    signal: int | None,
    run_records: list[dict[str, Any]],
    warmup_ms: float,
    warmup_repetitions: int,
    timeout_s: float | None,
    location_timing: bool,
    compile_ms: float,
    program_stderr: str,
    temp_root: Path | None,
    recent_events: list[dict[str, Any]],
) -> dict[str, Any]:
    source_mapping = add_source_context(source, locations)
    add_source_context(source, recent_events)
    function_stats: defaultdict[str, dict[str, int]] = defaultdict(
        lambda: {"events": 0, "statement_events": 0, "value_events": 0, "locations": 0}
    )
    for location in locations:
        stats = function_stats[location["function"]]
        stats["events"] += location["count"]
        stats["locations"] += 1
        if location["kind"] == "value":
            stats["value_events"] += location["count"]
        else:
            stats["statement_events"] += location["count"]
    summary = dict(meta)
    summary["statement_events"] = sum(
        location["count"] for location in locations if location["kind"] == "statement"
    )
    summary["value_events"] = sum(
        location["count"] for location in locations if location["kind"] == "value"
    )
    functions = [
        {"function": function_name, **stats}
        for function_name, stats in sorted(
            function_stats.items(), key=lambda item: (-item[1]["events"], item[0])
        )
    ]
    execution_times = [record["execution_ms"] for record in run_records]
    execution_ms = sum(execution_times)
    report: dict[str, Any] = {
        "schema_version": 1,
        "source": str(source),
        "compiler": compiler,
        "summary": summary,
        "source_mapping": source_mapping,
        "run": {
            "exit_code": exit_code,
            "signal": signal,
            "location_timing": location_timing,
            "execution_ms": execution_ms,
            "timeout_s": timeout_s,
            "execution_ms_min": min(execution_times),
            "execution_ms_mean": execution_ms / len(execution_times),
            "execution_ms_max": max(execution_times),
            "execution_ms_median": statistics.median(execution_times),
            "execution_ms_stdev": statistics.pstdev(execution_times),
            "warmup_ms": warmup_ms,
            "warmup_repetitions": warmup_repetitions,
            "requested_repetitions": run_records[-1]["requested_repetitions"],
            "completed_repetitions": len(run_records),
            "repetitions": run_records,
            "compile_ms": compile_ms,
        },
        "functions": functions,
        "locations": locations,
    }
    if program_stderr:
        report["program_stderr"] = program_stderr
    if recent_events:
        report["recent_events"] = recent_events
    if temp_root is not None:
        report["artifacts"] = {"build_directory": str(temp_root)}
    return report


def parse_arguments(argv: list[str]) -> argparse.Namespace:
    if argv and argv[0] == "profile":
        argv = argv[1:]
    parser = argparse.ArgumentParser(
        prog="elisa-profiler",
        description="Compile and run an Elisa program with source-location tracing.",
    )
    parser.add_argument("source", type=Path, help="Elisa source file containing main() -> i64")
    parser.add_argument("-o", "--output", type=Path, help="write the report to this file")
    parser.add_argument("--format", choices=("text", "json"), default="text")
    parser.add_argument("--top", type=int, default=20, help="number of hot locations in text output")
    parser.add_argument("--repeat", type=int, default=1, help="number of measured executions (default: 1)")
    parser.add_argument("--warmup", type=int, default=0, help="number of unreported executions before measuring")
    parser.add_argument("--timeout", type=float, help="maximum seconds per execution")
    parser.add_argument(
        "--location-timing",
        action="store_true",
        help="attribute wall time between trace events to source locations",
    )
    parser.add_argument("--opt-level", choices=("0", "1", "2", "3"), default="0")
    parser.add_argument(
        "--compiler-root",
        type=Path,
        default=Path(os.environ.get("ELISA_COMPILER_ROOT", DEFAULT_COMPILER_ROOT)),
    )
    parser.add_argument("--runtime-object", type=Path)
    parser.add_argument("--stage0-core", type=Path, default=Path(os.environ.get("ELISA_STAGE0_CORE", DEFAULT_STAGE0_CORE)))
    parser.add_argument("--rebuild-runtime", action="store_true")
    parser.add_argument("--show-output", action="store_true", help="forward target stdout/stderr to profiler stderr")
    parser.add_argument("--keep-temp", action="store_true", help="keep generated objects and executable")
    parser.add_argument("--version", action="version", version="elisa-profiler 0.1")
    args = parser.parse_args(argv)
    if args.top < 1:
        parser.error("--top must be positive")
    if args.repeat < 1:
        parser.error("--repeat must be positive")
    if args.warmup < 0:
        parser.error("--warmup cannot be negative")
    if args.timeout is not None and args.timeout <= 0:
        parser.error("--timeout must be positive")
    args.source = args.source.resolve()
    args.compiler_root = args.compiler_root.resolve()
    args.stage0_core = args.stage0_core.resolve()
    if args.runtime_object is None:
        args.runtime_object = args.compiler_root / "build" / "runtime" / "elisacore_runtime.o"
    else:
        args.runtime_object = args.runtime_object.resolve()
    return args


def profile(args: argparse.Namespace) -> int:
    if not args.source.is_file():
        raise ProfilerError(f"source file does not exist: {args.source}")
    compiler_script = ROOT / "scripts" / "elisa-compiler"
    if not compiler_script.is_file():
        raise ProfilerError(f"compiler wrapper is missing: {compiler_script}")
    stage1_script = args.compiler_root / "scripts" / "elisac_stage1.sh"
    if not stage1_script.is_file():
        raise ProfilerError(f"compiler worktree is missing: {args.compiler_root}")

    clang, objcopy, nm = compiler_tools()
    env = os.environ.copy()
    env["ELISA_COMPILER_ROOT"] = str(args.compiler_root)
    ensure_runtime(
        args.compiler_root,
        args.runtime_object,
        args.stage0_core,
        rebuild=args.rebuild_runtime,
        env=env,
    )

    temp_root = Path(tempfile.mkdtemp(prefix="elisa-profiler-"))
    try:
        target_object = temp_root / "target.o"
        renamed_target = temp_root / "target-renamed.o"
        collector_runtime = temp_root / "runtime-collector.o"
        collector_object = temp_root / "profiler-runtime.o"
        executable_path = temp_root / "profiled-program"
        compile_start = time.perf_counter_ns()
        compile_result = run_command(
            [
                str(compiler_script),
                "-g",
                "-ftrace",
                f"-O{args.opt_level}",
                "-o",
                str(target_object),
                str(args.source),
            ],
            env=env,
        )
        compile_ms = (time.perf_counter_ns() - compile_start) / 1_000_000
        if compile_result.returncode != 0:
            message = compile_result.stderr.strip() or compile_result.stdout.strip() or "Elisa compilation failed"
            raise ProfilerError(message)

        prepare_target(
            objcopy,
            nm,
            target_object,
            args.runtime_object,
            renamed_target,
            collector_runtime,
        )
        compile_shim = run_command(
            [
                clang,
                "-std=c11",
                "-O2",
                *(["-DELISA_PROFILE_TIMING=1"] if args.location_timing else []),
                "-fno-builtin",
                "-pthread",
                "-c",
                "-o",
                str(collector_object),
                str(ROOT / "scripts" / "profiler_runtime.c"),
            ],
            env=env,
        )
        if compile_shim.returncode != 0:
            raise ProfilerError(f"profiler runtime failed to compile: {compile_shim.stderr.strip()}")

        link_flags = ["-Wl,-dead_strip"] if sys.platform == "darwin" else ["-Wl,--gc-sections"]
        if sys.platform == "darwin":
            link_flags.append("-Wl,-stack_size,0x20000000")
        link_result = run_command(
            [
                clang,
                *link_flags,
                "-pthread",
                "-o",
                str(executable_path),
                str(renamed_target),
                str(collector_runtime),
                str(collector_object),
            ],
            env=env,
        )
        if link_result.returncode != 0:
            raise ProfilerError(f"could not link profiled program: {link_result.stderr.strip()}")

        warmup_ms = 0.0
        for repetition in range(1, args.warmup + 1):
            warmup_start = time.perf_counter_ns()
            warmup_status, _, _, warmup_timed_out = execute_program(executable_path, args.timeout)
            warmup_ms += (time.perf_counter_ns() - warmup_start) / 1_000_000
            if warmup_status != 0 or warmup_timed_out:
                warmup_status = (
                    f"signal {-warmup_status}"
                    if warmup_status < 0
                    else f"exit {warmup_status}"
                )
                raise ProfilerError(f"warmup run {repetition} failed with {warmup_status}")

        profile_results: list[
            tuple[dict[str, int], list[dict[str, Any]], str, list[dict[str, Any]]]
        ] = []
        run_records: list[dict[str, Any]] = []
        run_stdout: list[str] = []
        run_stderr: list[str] = []
        for repetition in range(1, args.repeat + 1):
            execution_start = time.perf_counter_ns()
            run_status, run_stdout_bytes, run_stderr_bytes, run_timed_out = execute_program(
                executable_path, args.timeout
            )
            execution_ms = (time.perf_counter_ns() - execution_start) / 1_000_000
            stderr = run_stderr_bytes.decode("utf-8", errors="replace")
            meta, locations, program_stderr, recent_events = parse_profile(
                stderr,
                allow_missing=run_status < 0 or run_timed_out,
            )
            run_record = {
                "repetition": repetition,
                "requested_repetitions": args.repeat,
                "exit_code": run_status if run_status >= 0 else None,
                "signal": -run_status if run_status < 0 else None,
                "execution_ms": execution_ms,
                "timed_out": run_timed_out,
            }
            run_records.append(run_record)
            profile_results.append((meta, locations, program_stderr, recent_events))
            run_stdout.append(run_stdout_bytes.decode("utf-8", errors="replace"))
            run_stderr.append(program_stderr)
            if run_status != 0 or run_timed_out:
                break

        meta, locations, program_stderr, recent_events = merge_profiles(profile_results)
        failed_run = next(
            (
                record
                for record in run_records
                if record["timed_out"]
                or record["signal"] is not None
                or record["exit_code"] != 0
            ),
            None,
        )
        if failed_run is None:
            exit_code = 0
            signal = None
        elif failed_run["timed_out"]:
            exit_code = None
            signal = failed_run["signal"] or 15
        else:
            exit_code = failed_run["exit_code"]
            signal = failed_run["signal"]
        report = build_report(
            args.source,
            compiler_metadata(args.compiler_root, args.runtime_object),
            meta,
            locations,
            exit_code=exit_code,
            signal=signal,
            run_records=run_records,
            warmup_ms=warmup_ms,
            warmup_repetitions=args.warmup,
            timeout_s=args.timeout,
            location_timing=args.location_timing,
            compile_ms=compile_ms,
            program_stderr="" if args.show_output else program_stderr,
            temp_root=temp_root if args.keep_temp else None,
            recent_events=recent_events,
        )
        rendered = (
            json.dumps(report, indent=2, sort_keys=False) + "\n"
            if args.format == "json"
            else text_report(report, args.top)
        )
        if args.output:
            args.output.parent.mkdir(parents=True, exist_ok=True)
            args.output.write_text(rendered, encoding="utf-8")
        else:
            sys.stdout.write(rendered)
        if args.show_output:
            for repetition, stdout in enumerate(run_stdout, start=1):
                if stdout:
                    sys.stderr.write(f"Program stdout (run {repetition}):\n{stdout}")
            for repetition, stderr in enumerate(run_stderr, start=1):
                if stderr:
                    sys.stderr.write(f"Program stderr (run {repetition}):\n{stderr}")
        if signal is not None:
            return 128 + signal
        return exit_code
    finally:
        if not args.keep_temp:
            shutil.rmtree(temp_root, ignore_errors=True)


def main(argv: list[str] | None = None) -> int:
    try:
        args = parse_arguments(sys.argv[1:] if argv is None else argv)
        return profile(args)
    except ProfilerError as error:
        print(f"elisa-profiler: {error}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("elisa-profiler: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
